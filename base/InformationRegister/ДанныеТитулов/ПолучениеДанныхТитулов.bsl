
//DynamicDirective

Процедура ПолучитьДанныеТитулов(Форма, МенеджерВременныхТаблиц)
	
	ЗапросДанных = Новый Запрос;
	ЗапросДанных.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	ЗапросДанных.Текст =
	"ВЫБРАТЬ
	|	ESD_ДанныеТитулов.Период КАК Период,
	|	ESD_ДанныеТитулов.СсылкаНаДокумент КАК СсылкаНаДокумент,
	|	ESD_ДанныеТитулов.ТипТитула КАК ТипТитула,
	|	ESD_ДанныеТитулов.ИдентификаторТитула КАК ИдентификаторТитула,
	|	ESD_ДанныеТитулов.Основной КАК Основной,
	|	ESD_ДанныеТитулов.Данные КАК Данные,
	|	ESD_ДанныеТитулов.Просмотрено КАК Просмотрено,
	|	ESD_ДанныеТитулов.ТипТитулаОтказа КАК ТипТитулаОтказа
	|ПОМЕСТИТЬ ДанныеТитулов
	|ИЗ
	|	РегистрСведений.ESD_ДанныеТитулов КАК ESD_ДанныеТитулов
	|ГДЕ
	|	ESD_ДанныеТитулов.СсылкаНаДокумент = &СсылкаНаДокумент";
	
	ЗапросДанных.Текст = СтрЗаменить(ЗапросДанных.Текст, "ESD_ДанныеТитулов", ДанныеТитулов());
	
	ЗапросДанных.УстановитьПараметр("СсылкаНаДокумент", Форма.СсылкаНаЭТрН);
	
	ЗапросДанных.Выполнить();
	
КонецПроцедуры

