
Функция КартинкаИнтерфейсаСервер(Форма, ИмяКартинки) Экспорт
	
	ИмяКартинкиБиблиотеки = СтрЗаменить(ИмяКартинки, "ESD", "Saby");

	Если Форма = Неопределено Тогда
		Картинка = Неопределено;
	Иначе
		
		Если ТипЗнч(Форма) = Тип("ФормаКлиентскогоПриложения") И Форма.ЭтоВО Тогда			
			Картинка = Форма.Элементы[ИмяКартинкиБиблиотеки].Картинка;			
		Иначе 				
			Картинка = БиблиотекаКартинок[ИмяКартинкиБиблиотеки];			
		КонецЕсли;	
		
	КонецЕсли;	
		
	Возврат Картинка;
	
КонецФункции

