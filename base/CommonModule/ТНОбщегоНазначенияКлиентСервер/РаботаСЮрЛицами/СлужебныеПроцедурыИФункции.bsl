Процедура ДанныеЮрЛиц_ИНН_ФизЛицо_ПроверитьКонтрольнуюСумму(ИНН, Ошибки, Отказ = Ложь)
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Коэффициенты11_ = ДанныеЮрЛиц_ИНН_Коэффициенты11();
	КонтрольнаяЦифра11_ = 11;
	Коэффициенты12_ = ДанныеЮрЛиц_ИНН_Коэффициенты12();
	КонтрольнаяЦифра12_ = 12;
	РезультатПроверки_ = ДанныеЮрЛиц_ИНН_КонтрольнаяЦифра(ИНН, Коэффициенты11_) = Число(Сред(ИНН, КонтрольнаяЦифра11_, 1))
		И ДанныеЮрЛиц_ИНН_КонтрольнаяЦифра(ИНН, Коэффициенты12_) = Число(Сред(ИНН, КонтрольнаяЦифра12_, 1));
	Если Не РезультатПроверки_ Тогда
		Ошибки.Добавить(ДанныеЮрЛиц_ИНН_СообщениеОшибки_КонтрольнаяСумма());
