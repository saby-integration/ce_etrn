//DynamicDirective

Процедура ДанныеЮрЛиц_ИНН_ПроверитьТолькоЦифры(ИНН, Ошибки, Отказ)
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если Не СтрокаСостоитИзЦифр(ИНН) Тогда
		Ошибки.Добавить(ДанныеЮрЛиц_ИНН_СообщениеОшибки_ТолькоЦифры());
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

//DynamicDirective

Функция ДанныеЮрЛиц_ИНН_КонтрольнаяЦифра(ИНН, КоэффициентыСтрокой)
	Сумма = 0;
	Коэффициенты = СтрРазделитьЭПД(КоэффициентыСтрокой, ",");
	Для Индекс = 0 По Коэффициенты.ВГраница() Цикл
		Сумма = Сумма + Число(Сред(ИНН, Индекс + 1, 1)) * Число(Коэффициенты[Индекс]);
	КонецЦикла;
	
	Множитель1 = 11;
	Множитель2 = 10;
	Возврат Сумма % Множитель1 % Множитель2;
КонецФункции  

//DynamicDirective

Функция ДанныеЮрЛиц_ИНН_Коэффициенты10()
	Возврат "2,4,10,3,5,9,4,6,8";
КонецФункции

