
//DynamicDirective

Процедура ДанныеЮрЛиц_ИНН_ЮрЛицо_Проверить(ИНН, Ошибки, Отказ = Ложь)
	ДанныеЮрЛиц_ИНН_ЮрЛицо_ПроверитьКоличествоЦифр(ИНН, Ошибки, Отказ);
	ДанныеЮрЛиц_ИНН_ПроверитьТолькоЦифры(ИНН, Ошибки, Отказ);
	ДанныеЮрЛиц_ИНН_ЮрЛицо_ПроверитьКонтрольнуюСумму(ИНН, Ошибки, Отказ);
КонецПроцедуры

//DynamicDirective

Процедура ДанныеЮрЛиц_ИНН_ЮрЛицо_ПроверитьКоличествоЦифр(ИНН, Ошибки, Отказ = Ложь)
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	КолвоСимволов_ = 10; 
	Если СтрДлина(ИНН) <> КолвоСимволов_ Тогда
		СообщениеОшибки = ДанныеЮрЛиц_ИНН_СообщениеОшибки_КоличествоЦифрЮрЛицо();
		Ошибки.Добавить(СообщениеОшибки);
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

//DynamicDirective

Процедура ДанныеЮрЛиц_ИНН_ЮрЛицо_ПроверитьКонтрольнуюСумму(ИНН, Ошибки, Отказ = Ложь)
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Коэффициенты10_ = ДанныеЮрЛиц_ИНН_Коэффициенты10();
	КонтрольнаяЦифра10_ = 10;
	РезультатПроверки_ = ДанныеЮрЛиц_ИНН_КонтрольнаяЦифра(ИНН, Коэффициенты10_) = Число(Сред(ИНН, КонтрольнаяЦифра10_, 1));
	Если Не РезультатПроверки_ Тогда
		Ошибки.Добавить(ДанныеЮрЛиц_ИНН_СообщениеОшибки_КонтрольнаяСумма());
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

