
//DynamicDirective

Функция СтрРазделитьЭПД(Знач ИсходнаяСтрока, Разделитель, ВключатьПустые = Истина, СоставнойРазделитель = Ложь) Экспорт
	
	Если СоставнойРазделитель Тогда
		
		ТекущаяСтрока = ИсходнаяСтрока;
		РезультатФункции = Новый Массив;
		ПозицияРазделителя = Найти(ТекущаяСтрока, Разделитель);
		Пока ПозицияРазделителя > 0 Цикл
			ЧастьСтроки = Лев(ТекущаяСтрока, ПозицияРазделителя - 1);
			Если ЗначениеЗаполнено(ЧастьСтроки) Или ВключатьПустые Тогда
				РезультатФункции.Добавить(ЧастьСтроки);
			КонецЕсли;
			ТекущаяСтрока = Прав(ТекущаяСтрока, СтрДлина(ТекущаяСтрока) - (ПозицияРазделителя - 1) - СтрДлина(Разделитель));
			ПозицияРазделителя = Найти(ТекущаяСтрока, Разделитель);
		КонецЦикла;
		Если ЗначениеЗаполнено(ТекущаяСтрока) Или ВключатьПустые Тогда
			РезультатФункции.Добавить(ТекущаяСтрока);
		КонецЕсли;
		Возврат РезультатФункции;
		
	Иначе
		Возврат СтрРазделить(ИсходнаяСтрока, Разделитель, ВключатьПустые);
	КонецЕсли;
	
КонецФункции

//DynamicDirective

Функция СтрСоединитьЭПД(Знач Строки, Разделитель = "") Экспорт
	Возврат СтрСоединить(Строки, Разделитель);
КонецФункции

