//DynamicDirective
// Проверяет, является ли строка уникальным идентификатором.
// В качестве уникального идентификатора предполагается строка вида
// "XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX", где X = [0..9,a..f].
//
// Параметры:
//  Строка - Строка - проверяемая строка.
//
// Возвращаемое значение:
//  Булево - Истина, если переданная строка является уникальным идентификатором.
Функция ЭтоУникальныйИдентификатор(Знач Строка) Экспорт
	ДлинаСтроки = СтрДлина(Строка);
	Шаблон = "XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX";
	
	Если СтрДлина(Шаблон) <> ДлинаСтроки Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КодЦифры_48 	= 48; // 0
	КодЦифры_57 	= 57; // 9
	КодБуквы_97 	= 97; // a
	КодБуквы_102 	= 102; // f
	КодБуквы_65		= 65; // A
	КодБуквы_70		= 70; // F
	КодБуквы_88 	= 88; // X
	КодДефис_45 	= 45; // - 
	
	Для Позиция = 1 По ДлинаСтроки Цикл
		КодСимволаШаблон = КодСимвола(Шаблон, Позиция);
		КодСимволаСтрока = КодСимвола(Строка, Позиция);
		
		Если КодСимволаШаблон = КодБуквы_88 // X
			И ((КодСимволаСтрока < КодЦифры_48 ИЛИ КодСимволаСтрока > КодЦифры_57) // 0..9
				И (КодСимволаСтрока < КодБуквы_97 ИЛИ КодСимволаСтрока > КодБуквы_102) // a..f
				И (КодСимволаСтрока < КодБуквы_65 ИЛИ КодСимволаСтрока > КодБуквы_70) // A..F
			) ИЛИ КодСимволаШаблон = КодДефис_45 И КодСимволаСтрока <> КодДефис_45 // - 
		Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
КонецФункции

#КонецОбласти // СлужебныйПрограммныйИнтерфейс

