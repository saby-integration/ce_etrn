Функция ИдентификаторКоллекции(Коллекция, ЭлементКоллекции)
	
	Если ТипЗнч(Коллекция) = Тип("ДанныеФормыКоллекция") Тогда
		Результат = ЭлементКоллекции.ПолучитьИдентификатор();
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Массив") Тогда
		Результат = Коллекция.Найти(ЭлементКоллекции);
	ИначеЕсли ТипЗнч(Коллекция) = Тип("ТаблицаЗначений") Тогда
		Результат = Коллекция.Индекс(ЭлементКоллекции);
	Иначе
		Результат = 0;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НайтиПоИдентификаторуУниверсально(Коллекция, Идентификатор)
	
	Если ТипЗнч(Коллекция) = Тип("ДанныеФормыКоллекция") Тогда
		Возврат Коллекция.НайтиПоИдентификатору(Идентификатор);
	Иначе
		Возврат Коллекция[Идентификатор];
	КонецЕсли;
	
КонецФункции

