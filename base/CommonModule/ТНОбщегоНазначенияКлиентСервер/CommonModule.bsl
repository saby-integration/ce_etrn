Функция СообщениеПользователю(
		Знач ТекстСообщенияПользователю,
		Знач КлючДанных,
		Знач Поле = "",
		Знач ПутьКДанным = "",
		ЭтоОбъект = Ложь) Экспорт
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщенияПользователю;
	
	Если Не ПустаяСтрока(Поле) Тогда
		Сообщение.Поле = Поле;
	КонецЕсли;
	
	Если ЭтоОбъект Тогда
		Сообщение.УстановитьДанные(КлючДанных);
	Иначе
		Сообщение.КлючДанных = КлючДанных;
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(ПутьКДанным) Тогда
		Сообщение.ПутьКДанным = ПутьКДанным;
	КонецЕсли;
		
	Возврат Сообщение;
	
КонецФункции

#Область ДанныеФункции

Функция ДанныеФункции(ТекстФормулы) Экспорт
	
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("Имя",       "");
	РезультатФункции.Вставить("Параметры", Новый Массив);
	
	ПозицияСкобки = Найти(ТекстФормулы, "(");
	РезультатФункции.Имя = Лев(ТекстФормулы, ПозицияСкобки - 1);
	
	ТекстПараметров = Прав(ТекстФормулы, СтрДлина(ТекстФормулы) - ПозицияСкобки);
	
	Индекс = СтрДлина(ТекстПараметров);
	Пока 0 < Индекс Цикл
		СимволСКонца = Сред(ТекстПараметров, Индекс, 1);
		Если СимволСКонца = ")" Тогда
			ТекстПараметров = Лев(ТекстПараметров, Индекс - 1);
			Прервать;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
	РезультатФункции.Параметры = РазделитьПараметры(ТекстПараметров);
	
	Возврат РезультатФункции;
	
КонецФункции

Функция РазделитьПараметры(ТекстПараметров, Разделитель = ",") Экспорт
	
	РезультатФункции = Новый Массив;
	
	СтрокаПараметров = ТекстПараметров;
	
	// Для проверки на четность
	Два = 2;
	
	НомерСимвола = 1;
	КоличествоКавычек = 0;
	ЧислоСкобок = 0;
	Пока НомерСимвола <= СтрДлина(СтрокаПараметров) Цикл
		ТекущийСимвол = Сред(СтрокаПараметров, НомерСимвола, 1);
		Если ТекущийСимвол = """" Тогда
			КоличествоКавычек = КоличествоКавычек + 1;
		КонецЕсли;
		Если ТекущийСимвол = "(" Тогда
			ЧислоСкобок = ЧислоСкобок + 1;
		КонецЕсли;
		Если ТекущийСимвол = ")" Тогда
			ЧислоСкобок = ЧислоСкобок - 1;
		КонецЕсли;
		Если ТекущийСимвол = Разделитель Тогда
			Если КоличествоКавычек % Два = 0 И ЧислоСкобок = 0 Тогда
				ТекущийПараметр = СокрЛП(Лев(СтрокаПараметров, НомерСимвола - 1));
				РезультатФункции.Добавить(ТекущийПараметр);
				СтрокаПараметров = Прав(СтрокаПараметров, СтрДлина(СтрокаПараметров) - НомерСимвола);
				НомерСимвола = 1;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		НомерСимвола = НомерСимвола + 1;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(СтрокаПараметров) Тогда
		РезультатФункции.Добавить(СокрЛП(СтрокаПараметров));
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ДопустимыйПараметрФункции(ИмяПараметра) Экспорт
	
	РезультатФункции = СокрЛП(ИмяПараметра);
	
	НедопустимыеСимволы = Новый Массив;
	НедопустимыеСимволы.Добавить(" ");
	НедопустимыеСимволы.Добавить(".");
	
	Для Каждого НедопустимыйСимвол Из НедопустимыеСимволы Цикл
		РезультатФункции = СтрЗаменить(РезультатФункции, НедопустимыйСимвол, "_");
	КонецЦикла;
	
	Возврат РезультатФункции;
	
КонецФункции

