
//DynamicDirective 

Функция ЯщикиЭДО_СтруктураОписания() Экспорт
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("Идентификатор", "");
	РезультатФункции.Вставить("Оператор",      "");
	РезультатФункции.Вставить("Основной",      Ложь);
	РезультатФункции.Вставить("Роуминг",       Ложь);
	РезультатФункции.Вставить("Комментарий",   "");

	Возврат РезультатФункции;
КонецФункции

//DynamicDirective 

Функция ЯщикиЭДО_УчастникЮрЛицо_СтруктураОписания() Экспорт
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("ИНН",      "");
	РезультатФункции.Вставить("КПП",      "");
	РезультатФункции.Вставить("Название", "");

	Возврат РезультатФункции;
КонецФункции

//DynamicDirective 

Функция ЯщикиЭДО_УчастникФизЛицо_СтруктураОписания() Экспорт
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("ЧастноеЛицо", "Да");
	РезультатФункции.Вставить("ИНН",         "");
	РезультатФункции.Вставить("Фамилия",     "");
	РезультатФункции.Вставить("Имя",         "");

	Возврат РезультатФункции;
КонецФункции

//DynamicDirective

Функция ЯщикиЭДО_Загрузка_ПараметрыЮрЛица(ОснованиеЗаполнения = Неопределено) Экспорт
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("ЮрФизЛицоСтрокой",        "ЮрЛицо");
	РезультатФункции.Вставить("ИНН",                     "");
	РезультатФункции.Вставить("КПП",                     "");
	РезультатФункции.Вставить("НаименованиеОрганизации", "");
	РезультатФункции.Вставить("Фамилия",                 "");
	РезультатФункции.Вставить("Имя",                     "");

	Если ОснованиеЗаполнения <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(РезультатФункции, ОснованиеЗаполнения);
	КонецЕсли;

	Возврат РезультатФункции;
КонецФункции

//DynamicDirective 

Функция ЯщикиЭДО_Загрузка_ПараметрыМетода(Участник, ОтветНаКлиенте = Неопределено, context_params = Неопределено) Экспорт
	РезультатФункции = Новый Структура("Участник, ОтветНаКлиенте, context_params",
		Участник, ОтветНаКлиенте, context_params);

	Возврат РезультатФункции;
КонецФункции  

//DynamicDirective  

Функция ЯщикиЭДО_Загрузка_ПараметрыУчастника(ПараметрыЮрЛица) Экспорт
	РезультатФункции = Новый Структура("ДопПоля", "СписокИдентификаторов,СФилиалами");

	Если ПараметрыЮрЛица.ЮрФизЛицоСтрокой = "ЮрЛицо" Тогда
		СвЮЛ_ = ЯщикиЭДО_УчастникЮрЛицо_СтруктураОписания();
		ЗаполнитьЗначенияСвойств(СвЮЛ_, ПараметрыЮрЛица);
		СвЮЛ_.Название = ПараметрыЮрЛица.НаименованиеОрганизации;
		РезультатФункции.Вставить("СвЮЛ", СвЮЛ_);
	Иначе
		СвФЛ_ = ЯщикиЭДО_УчастникФизЛицо_СтруктураОписания();
		ЗаполнитьЗначенияСвойств(СвФЛ_, ПараметрыЮрЛица);
		Если ПараметрыЮрЛица.ЮрФизЛицоСтрокой = "ИндивидуальныйПредприниматель" Тогда
			СвФЛ_.ЧастноеЛицо = "Нет";
		КонецЕсли;
		РезультатФункции.Вставить("СвФЛ", СвФЛ_);
	КонецЕсли;

	Возврат РезультатФункции;
КонецФункции

