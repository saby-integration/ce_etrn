
// Выполняет выгрузку печатной формы и обновляет ссылку на PDF
//
// Параметры:
//	ПараметрыЗагрузкиФайловSaby - Структура - параметры загрузки данных файлов из Saby
//
//DynamicDirective
Процедура SabyОбновитьСсылкуНаПечатнуюФорму(ПараметрыЗагрузкиФайловSaby) Экспорт
	ПараметрыОбновления = SabyПараметрыОбновленияДанныхФайлов(ПараметрыЗагрузкиФайловSaby);
	
	РезультатОбновления = МодульКода("ESD_ТНВыгрузкаСервер")
		.ВыгрузитьПечатнуюФорму(ПараметрыОбновления, ПараметрыЗагрузкиФайловSaby.context_params);
	Если РезультатОбновления.Итог.Успех Тогда		
		ДанныеДокументаСБИС = РезультатОбновления.Успешные[0];		
		ПараметрыЗагрузкиФайловSaby["СсылкаНаPDF"] = ДанныеДокументаСБИС["СсылкаНаPDF"];
	КонецЕсли;
КонецПроцедуры

