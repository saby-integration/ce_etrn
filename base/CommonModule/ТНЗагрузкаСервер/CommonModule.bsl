	СтруктураОпасногоГруза.АварийнаяТемпература = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(
		СтрокаОпасн, "ТемператураАварийная", "");
		
	// Радиоактивный	
