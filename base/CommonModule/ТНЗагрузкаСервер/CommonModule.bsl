		СтрокаОпасн, "ВзрывчатыйМассаНеттоДляВсех", "");
	
	ЗаполнитьОбщиеПараметрыОпасногоГруза(СтруктураОпасногоГруза, СтрокаОпасн);
	
	МодульКода("Справочники.ESD_ОпасныеГрузы").ЗаполнитьОпасныйГруз(СтруктураОпасногоГруза);
	
	Возврат СтруктураОпасногоГруза;
	
КонецФункции

Процедура ЗаполнитьОбщиеПараметрыОпасногоГруза(СтруктураОпасногоГруза, СтрокаОпасн)
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	
	СтруктураОпасногоГруза.НомерООН = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(
		СтрокаОпасн, "НомерООН", "");
	СтруктураОпасногоГруза.ФизИХимФорма = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(
		СтрокаОпасн, "ФизХимФорма", "");
	СтруктураОпасногоГруза.ТранспортныйИндекс = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(
		СтрокаОпасн, "ТранспортныйИндекс", "");
	СтруктураОпасногоГруза.ЗнакОпасности = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(
		СтрокаОпасн, "ЗнакОпасности", "");
	СтруктураОпасногоГруза.ИндексБезопасности = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(
		СтрокаОпасн, "ИндексБезопасности", "");
	СтруктураОпасногоГруза.ОпознавательныйЗнак = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(
		СтрокаОпасн, "ОпознавательныйЗнак", "");
	СтруктураОпасногоГруза.ПроцентСмеси = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(
		СтрокаОпасн, "ПроцентныйСоставСмеси", "");
	СтруктураОпасногоГруза.Комментарий = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(
		СтрокаОпасн, "Описание", "");
	СтруктураОпасногоГруза.КлассификационныйКод = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(
		СтрокаОпасн, "КлассификационныйКод", "");
	
	КодОграниченияПроездТуннеля = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(
		СтрокаОпасн, "КодОграниченияПроездТуннеля", "");
	МодульПеречисленияОграничений = МодульКода("Перечисления.ESD_КодыОграниченийПроездаЧерезТуннели");
	СтруктураОпасногоГруза.ОграничениеПроездаЧерезТуннели = МодульПеречисленияОграничений.ОграничениеПроездаПоКоду(
		КодОграниченияПроездТуннеля);
	
	СтруктураОпасногоГруза.ДатаИстеченияУдержания = МодульКода("ESD_ТНОбщегоНазначенияСервер").ПреобразоватьСтрокуВДатуЭПД(
		СтрокаОпасн["ДатаИстеченияУдержания"]);
	
КонецПроцедуры

Процедура ДобавитьНовыеОпасныеГрузы(ДляДокумента, Результат)
	
	Если Результат = Неопределено
		Или Не МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ЕстьРеквизитИлиСвойство(ДляДокумента, "ОпасныеГрузы") Тогда
		Возврат;
	КонецЕсли;
	
	МассивОпасныхГрузов = ДляДокумента["ОпасныеГрузы"];
	
	Если Не ЗначениеЗаполнено(МассивОпасныхГрузов) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтруктураОпасногоГруза Из МассивОпасныхГрузов Цикл
		Если СтруктураОпасногоГруза.Новый Тогда
			Результат.НовыеОпасныеГрузы.Добавить(СтруктураОпасногоГруза);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ЗагрузкаГруза

Процедура ЗагрузитьПараметрыГруза(СтруктураГруза, ПараметрыГруза)
	
	Если Не ЗначениеЗаполнено(ПараметрыГруза) Тогда
		Возврат;
	КонецЕсли;
	
	ESDОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	
	КоличествоПаллет = ESDОбщегоНазначенияКлиентСервер.ЧислоИзСтроки(ПараметрыГруза["КоличествоПаллет"]);
	КоличествоМест   = ESDОбщегоНазначенияКлиентСервер.ЧислоИзСтроки(ПараметрыГруза["КоличествоМест"]);
	
	МассаБрутто = ESDОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(ПараметрыГруза, "Масса.Брутто");
	МассаБрутто = ESDОбщегоНазначенияКлиентСервер.ЧислоИзСтроки(МассаБрутто);
	МассаНетто  = ESDОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(ПараметрыГруза, "Масса.Нетто");
	МассаНетто  = ESDОбщегоНазначенияКлиентСервер.ЧислоИзСтроки(МассаНетто);
	
	СтруктураГруза.Вставить("КоличествоПаллет", КоличествоПаллет);
	СтруктураГруза.Вставить("Количество",       КоличествоМест);
	СтруктураГруза.Вставить("МассаБрутто",      МассаБрутто);
	СтруктураГруза.Вставить("МассаНетто",       МассаНетто);
	СтруктураГруза.Вставить("Длина",            ESDОбщегоНазначенияКлиентСервер.ЧислоИзСтроки(ПараметрыГруза["Длина"]));
	СтруктураГруза.Вставить("Высота",           ESDОбщегоНазначенияКлиентСервер.ЧислоИзСтроки(ПараметрыГруза["Высота"]));
	СтруктураГруза.Вставить("Ширина",           ESDОбщегоНазначенияКлиентСервер.ЧислоИзСтроки(ПараметрыГруза["Ширина"]));
	СтруктураГруза.Вставить("Объем",            ESDОбщегоНазначенияКлиентСервер.ЧислоИзСтроки(ПараметрыГруза["Объем"]));
	СтруктураГруза.Вставить("Плотность",        ESDОбщегоНазначенияКлиентСервер.ЧислоИзСтроки(ПараметрыГруза["Плотность"]));
	
КонецПроцедуры

Процедура ЗагрузитьКонтейнеры(Контейнеры, ДляДокумента, КлючСтроки_Грузы)
	
	Если Не ЗначениеЗаполнено(Контейнеры) Тогда 
		Возврат;
	КонецЕсли;
	
	Для Каждого Контейнер Из Контейнеры Цикл
		КоличествоКонтейнеров = Контейнер["Количество"];
		Для Каждого СтрокаКонт Из Контейнер["Номер"] Цикл
			
			СтруктураКонтейнера = Новый Структура;
			СтруктураКонтейнера.Вставить("Номер",            СтрокаКонт["Значение"]);
			СтруктураКонтейнера.Вставить("КлючСтроки_Грузы", КлючСтроки_Грузы);
			СтруктураКонтейнера.Вставить("Количество",       1);
			
			Если ЗначениеЗаполнено(КоличествоКонтейнеров) Тогда 
				СтруктураКонтейнера.Количество = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ЧислоИзСтроки(КоличествоКонтейнеров);
			КонецЕсли;
			
			ДляДокумента.Контейнеры.Добавить(СтруктураКонтейнера);
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьМаркировки(Маркировка, ДляДокумента, КлючСтроки_Грузы)
	
	Если Не ЗначениеЗаполнено(Маркировка) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаМарк Из Маркировка Цикл
		
		СтруктураМаркировка = Новый Структура;
		СтруктураМаркировка.Вставить("Значение",         СтрокаМарк["Значение"]);
		СтруктураМаркировка.Вставить("КлючСтроки_Грузы", КлючСтроки_Грузы);
		ДляДокумента.Маркировки.Добавить(СтруктураМаркировка);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьОпасныеГрузы(ОпасныйГруз, ДляДокумента, КлючСтроки_Грузы)
	
	Если Не ЗначениеЗаполнено(ОпасныйГруз) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаОпасн Из ОпасныйГруз Цикл
		
		СтруктураОпасногоГруза = СтруктураОпасногоГруза(СтрокаОпасн);
		Если СтруктураОпасногоГруза = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураОпасногоГруза.КлючСтроки_Грузы = КлючСтроки_Грузы;
		
		ДляДокумента.ОпасныеГрузы.Добавить(СтруктураОпасногоГруза);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьСведенияГИС(СведенияГИС, ДляДокумента, СтруктураГруза, КлючСтроки_Грузы)
	
	Если Не ЗначениеЗаполнено(СведенияГИС) Тогда  
		Возврат;
	КонецЕсли;
	
	СтруктураГруза.Вставить("НаименованиеГосСистемы",   СведенияГИС["Наименование"]);
	СтруктураГруза.Вставить("УчетнаяЕдиницаГосСистемы", СведенияГИС["УчетнаяЕдиница"]);
	СтруктураГруза.Вставить("ИнаяИнформацияГосСистемы", СведенияГИС["ДругаяИнформация"]);
	
	Для Каждого СтрокаГос Из СведенияГИС["Идентификатор"] Цикл
		
		СтруктураГосСистемы = Новый Структура;
		СтруктураГосСистемы.Вставить("КлючСтроки_Грузы", КлючСтроки_Грузы);
		СтруктураГосСистемы.Вставить("Идентификатор",    СтрокаГос["Значение"]);
		
		ДляДокумента.СведенияГосСистем.Добавить(СтруктураГосСистемы);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьАдресаПунктовГруза(АдресаПунктов, ДляДокумента, КлючСтроки_Грузы)
	
	Если Не ЗначениеЗаполнено(АдресаПунктов) Тогда 
		Возврат;
	КонецЕсли;
	МодульОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	
	Для Каждого АдресПункта Из АдресаПунктов Цикл
		СтруктураПунктГруза = Новый Структура;
		СтруктураПунктГруза.Вставить("КлючСтроки_Грузы", КлючСтроки_Грузы);

		КоличествоГрузовыхМест = АдресПункта["КоличествоГрузовыхМест"]; 
		Если ЗначениеЗаполнено(КоличествоГрузовыхМест) Тогда 
			 КоличествоГрузовыхМест = МодульОбщегоНазначенияКлиентСервер.ЧислоИзСтроки(КоличествоГрузовыхМест);
			 СтруктураПунктГруза.Вставить("КоличествоГрузовыхМест", КоличествоГрузовыхМест);
		КонецЕсли;
		
		ПорядковыйНомерПунктаВыгрузки = АдресПункта["ПорядковыйНомерПунктаВыгрузки"];
		Если ЗначениеЗаполнено(ПорядковыйНомерПунктаВыгрузки) Тогда 
			 ПорядковыйНомерПунктаВыгрузки = МодульОбщегоНазначенияКлиентСервер.ЧислоИзСтроки(ПорядковыйНомерПунктаВыгрузки);
			 СтруктураПунктГруза.Вставить("Выгрузка_КлючСтроки", ПорядковыйНомерПунктаВыгрузки);
		КонецЕсли;
		
		ПорядковыйНомерПунктаПогрузки = АдресПункта["ПорядковыйНомерПунктаПогрузки"];
		Если ЗначениеЗаполнено(ПорядковыйНомерПунктаПогрузки) Тогда 
			 ПорядковыйНомерПунктаПогрузки = МодульОбщегоНазначенияКлиентСервер.ЧислоИзСтроки(ПорядковыйНомерПунктаПогрузки);
			 СтруктураПунктГруза.Вставить("Погрузка_КлючСтроки", ПорядковыйНомерПунктаПогрузки);
		КонецЕсли;
		
		ДляДокумента.Груз_АдресаПунктов.Добавить(СтруктураПунктГруза);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьДанныеГруза_ТранспортнаяНакладная(Груз, СтруктураГруза, ДляДокумента,
		КлючСтроки_Грузы, ЗагрузкаСОнлайна)
	
	Контейнеры = Груз["Контейнер"];
	Если ЗначениеЗаполнено(Контейнеры) Тогда
		ТипГруза = ЗначениеМетаданных("ESD_ТипГруза.Контейнер");
	Иначе
		ТипГруза = ЗначениеМетаданных("ESD_ТипГруза.Груз");
	КонецЕсли;
	
	СтруктураГруза.Вставить("Тип", ТипГруза);
	
	ЗагрузитьКонтейнеры(Контейнеры, ДляДокумента, КлючСтроки_Грузы);
	
	ЗагрузитьМаркировки(Груз["Маркировка"], ДляДокумента, КлючСтроки_Грузы);
	
	ЗагрузитьОпасныеГрузы(Груз["ОпасныйГруз"], ДляДокумента, КлючСтроки_Грузы);
	
	ЗагрузитьСведенияГИС(Груз["СведенияГИС"], ДляДокумента, СтруктураГруза, КлючСтроки_Грузы);
	
	ESDОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	Стоимость = ESDОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(Груз, "Стоимость.ВключаяНДС");
	Если ЗначениеЗаполнено(Стоимость) Тогда
		Стоимость = ESDОбщегоНазначенияКлиентСервер.ЧислоИзСтроки(Стоимость);
	Иначе
		Стоимость = 0;
	КонецЕсли;
	СтруктураГруза.Вставить("Стоимость", Стоимость);
	
	СтруктураГруза.Вставить("Валюта", ВалютаПоДаннымОнлайна(Груз, ЗагрузкаСОнлайна));
	
КонецПроцедуры

Процедура ЗагрузитьДанныеГруза_ЗаказНаПеревозку(ДляДокумента, Груз, СтруктураГруза, КлючСтроки_Грузы)
	
	ЭтоКонтейнер = ?(ЗначениеЗаполнено(Груз["ГруженностьКонтейнера"]), Истина, Ложь);
	Если ЭтоКонтейнер Тогда
		ТипГруза = ЗначениеМетаданных("ESD_ТипГруза.Контейнер");
	Иначе
		ТипГруза = ЗначениеМетаданных("ESD_ТипГруза.Груз");
	КонецЕсли;
	
	РаспределениеПоДлине = ?(Груз["РаспределениеПоДлинеПлатформы"] = "0", Истина, Ложь);
	Делимость            = ?(Груз["Делимость"] = "1",                     Истина, Ложь);
	ПогрузкаВодителем    = ?(Груз["ПогрузкаВодителем"] = "0",             Истина, Ложь);
	
	СтруктураГруза.Вставить("Тип",                           ТипГруза);
	СтруктураГруза.Вставить("РаспределениеПоДлинеПлатформы", РаспределениеПоДлине);
	СтруктураГруза.Вставить("Делимость",                     Делимость);
	СтруктураГруза.Вставить("ПогрузкаВодителем",             ПогрузкаВодителем);
	
	СтруктураГруза.Вставить(
		"МетодОпределенияМассы",
		МодульКода("Перечисления.ESD_МетодОпределенияМассы").МетодОпределенияМассыПоКоду(Груз["МетодОпределенияМассы"]));
		
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	
	ОпасныйГруз = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(Груз, "ОпасныйГруз");
	
	// пока нет единого формата по ОГ - загружаем отдельным алгоритмом
	СтруктураОпасногоГруза = СтруктураОпасногоГруза_ЗаказНаПеревозку(ОпасныйГруз);
	Если СтруктураОпасногоГруза <> Неопределено Тогда
		СтруктураГруза.Вставить("ОпасныйГруз", СтруктураОпасногоГруза.ОпасныйГруз);
	КонецЕсли;
	
	// Заказчик и договор
	Заказчик = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(Груз, "Заказчик");
	Договор  = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(Груз, "Договор");
	
	Если ЗначениеЗаполнено(Заказчик) Тогда
		
		ДанныеЗаказчика = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ШаблонДанныхЮрЛица();
		ЗагрузитьДанныеЮрЛиц(ДляДокумента, Заказчик, "Заказчик", ДанныеЗаказчика);
		
		СтруктураГруза.Вставить("ЗаказчикСтрока",         ДанныеЗаказчика.НаименованиеОрганизации);
		СтруктураГруза.Вставить("КлючСтроки_ДанныеЮрЛиц", ДанныеЗаказчика.КлючСтроки);
		
		Если ЗначениеЗаполнено(Договор) И ЗначениеЗаполнено(Договор["Номер"]) Тогда
			СсылкаНаДоговор = СсылкаНаДокументЭПД(ДляДокумента, Договор, ЗначениеМетаданных("ESD_ТипыДокумента.ДоговорПеревозки"));
			СтруктураГруза.Вставить("Договор", СсылкаНаДоговор);
		КонецЕсли;
		
	КонецЕсли;
	
	АдресаПунктов = Груз["ПунктыПогрузкиВыгрузки"];
	
	ЗагрузитьАдресаПунктовГруза(АдресаПунктов, ДляДокумента, КлючСтроки_Грузы);
	
КонецПроцедуры

Процедура ОчиститьТаблицуГрузов(ОбъектДок, ИмяТаблицы, ДопПараметры)
	
	Если ДопПараметры <> Неопределено И Не ДопПараметры.ЭтоПервоеОснование Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ОбъектДок[ИмяТаблицы]) = Тип("Массив") Тогда
		ОбъектДок[ИмяТаблицы] = Новый Массив;
	Иначе
		ОбъектДок[ИмяТаблицы].Очистить();
	КонецЕсли;
	
КонецПроцедуры

Процедура СохранитьНоменклатуруСтроки(ОбъектДок, СтруктураСтрокиТаблицы, ДопПараметры)
	
	Если ДопПараметры = Неопределено Или ДопПараметры.ЗагрузкаСОнлайна Тогда
		Возврат;
	КонецЕсли;
	
	Если СтруктураСтрокиТаблицы.Номенклатура <> Неопределено Тогда
		ДопПараметры.НоменклатураГруза.Вставить(ОбъектДок.Грузы.Количество() - 1, СтруктураСтрокиТаблицы.Номенклатура);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти // ЗагрузкаГруза

Процедура УдалитьСтрокиТаблицыИзМассива(ТаблицаДляУдаления, МассивСтрокДляУдаления)
	
	ЭтоМассив = ТипЗнч(ТаблицаДляУдаления) = Тип("Массив");
	
	Для Каждого СтрокаДляУдаления Из МассивСтрокДляУдаления Цикл
		Если ЭтоМассив Тогда
			ИндексЗаписи = ТаблицаДляУдаления.Найти(СтрокаДляУдаления);
			ТаблицаДляУдаления.Удалить(ИндексЗаписи);
		Иначе
			ТаблицаДляУдаления.Удалить(СтрокаДляУдаления);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОчисткаОтветственныхЛицПоРоли(ОбъектДок, РольОтветственного, ЭтоВодитель)
	
	МодульТНКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	
	ОтборОтветственных = Новый Структура;
	ОтборОтветственных.Вставить("Роль", РольОтветственного);
	МассивСтрокДляУдаления = МодульТНКлиентСервер.НайтиСтрокиУниверсально(
		ОбъектДок.ОтветственныеЛица, ОтборОтветственных);
			
	Если ЭтоВодитель Тогда
		
		// Очистим путевые листы		
		Если ТипЗнч(ОбъектДок) = Тип("Структура") Тогда 						
			
			// в случае ВО зачищаем Документы ЭПД			
			Для Каждого СтрокаВодитель Из МассивСтрокДляУдаления Цикл
				УдалитьДокументыЭПДПоКлючу(ОбъектДок, "КлючСтроки_ОтветственныеЛица", СтрокаВодитель.КлючСтроки);
			КонецЦикла;
			
		Иначе	
			Если МодульТНКлиентСервер.ЕстьРеквизитИлиСвойство(ОбъектДок, "ПутевыеЛисты") Тогда
				ОбъектДок.ПутевыеЛисты.Очистить();
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	// удалим ответственных
	УдалитьСтрокиТаблицыИзМассива(ОбъектДок.ОтветственныеЛица, МассивСтрокДляУдаления);

КонецПроцедуры

Процедура УстановитьНовыеКлючиСвязиПутевыхЛистов(ОбъектДок, СтруктураОтветственного, НовыйКлючСтроки)
	
	// Сменим ключи связей Путевых листов
	Для Каждого СтруктураПутевогоЛиста Из СтруктураОтветственного.ПутевыеЛисты Цикл
		
		СтрокаПутевогоЛиста = ДобавитьИЗаполнитьСтроку(
			ОбъектДок.ПутевыеЛисты, СтруктураПутевогоЛиста, "КлючСтроки_ОтветственныеЛица");
		СтрокаПутевогоЛиста.КлючСтроки_ОтветственныеЛица = НовыйКлючСтроки;
		
		Если МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ЕстьРеквизитИлиСвойство(ОбъектДок, "ДокументыЭПД") Тогда
			СтрокаПутевогоЛиста = ДобавитьИЗаполнитьСтроку(
				ОбъектДок.ДокументыЭПД, СтруктураПутевогоЛиста, "КлючСтроки_ОтветственныеЛица");
			СтрокаПутевогоЛиста.КлючСтроки_ОтветственныеЛица = НовыйКлючСтроки;
		КонецЕсли;
		
		// Сменим ключи связи документов ЭПД
		Если Не ЗначениеЗаполнено(СтруктураОтветственного.КлючСтроки) Тогда
			Продолжить;
		КонецЕсли;	
		
		Если ТипЗнч(ОбъектДок) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;	
		
		Отбор = Новый Структура;
		Отбор.Вставить("КлючСтроки_ОтветственныеЛица", СтруктураОтветственного.КлючСтроки);
		
		СтрокиДокументовЭПД = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").НайтиСтрокиУниверсально(ОбъектДок.ДокументыЭПД, Отбор);
		Для Каждого СтрокаЭПД Из СтрокиДокументовЭПД Цикл	
			СтрокаЭПД.КлючСтроки_ОтветственныеЛица = НовыйКлючСтроки; 
		КонецЦикла;
		
	КонецЦикла;	
		
КонецПроцедуры	

