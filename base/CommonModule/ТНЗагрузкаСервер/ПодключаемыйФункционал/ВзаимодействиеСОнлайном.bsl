Процедура Подключаемый_ПослеСохраненияДокумента(ОбъектДокумента, ПараметрыЗагрузки, ОбщиеПараметрыЗагрузки, ДополнительныеПараметры)
	Подключаемый_ПослеСохраненияДокумента_ЗаписатьДополнительныеСведения(ОбъектДокумента, ПараметрыЗагрузки, ДополнительныеПараметры.ПараметрыСтатус);
