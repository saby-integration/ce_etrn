
// Получение и обработка данных документа из Saby
//
// Параметры:
//	ПараметрыЗагрузки - Соответствие - параметры загрузки документа
//	ОбщиеПараметрыЗагрузки - Соответствие - общие параметры загрузки документа
//	Результат - Структура - описание результата загрузки документа
//
//DynamicDirective
Процедура SabyЗагрузитьДанныеДокумента(ПараметрыЗагрузки, ОбщиеПараметрыЗагрузки, Результат) Экспорт
	// Для ВО - там сначала загружаются данные, а потом идет сюда для обработки. Сделано для того, чтоб сильно не ломать логику	
	Если ЗначениеЗаполнено(ПараметрыЗагрузки.ДанныеДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	// Загружаем данные документа
	SabyДанныеДокумента = SabyПолныеДанныеДокумента(ПараметрыЗагрузки, ОбщиеПараметрыЗагрузки, Результат);
	Если Не ЗначениеЗаполнено(SabyДанныеДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	// Создаем копию документа
	Документ = Новый Соответствие(Новый ФиксированноеСоответствие(SabyДанныеДокумента));
	// Подготавливаем данные
	Документ.Вставить("Событие",     Новый Массив);
	Документ.Вставить("Вложения",    Новый Соответствие);
	Документ.Вставить("Подстановки", Новый Соответствие);
	Документ.Вставить("ИдТитулов",   Новый Соответствие);
	Документ.Вставить("КомментарийПоследнегоТитула", "");
	
	// Формируем параметры обработки документа
	ПараметрыОбработки = SabyПараметрыОбработкиДокумента();
	ЗаполнитьЗначенияСвойств(ПараметрыОбработки, ПараметрыЗагрузки); 
	
	// Выполняем обработку
	SabyОбработатьДанныеДокумента(Документ, SabyДанныеДокумента, ПараметрыОбработки, Результат);
	
	ПараметрыЗагрузки.ДанныеДокумента = Документ;	
КонецПроцедуры

// Получение полных данных документа из Saby
//
// Параметры:
//	ПараметрыЗагрузки - Соответствие - параметры загрузки документа
//	ОбщиеПараметрыЗагрузки - Соответствие - общие параметры загрузки документа
//	Результат - Структура - описание результата загрузки документа
//
// Возвращаемое значение:
//	Структура - загруженные данные документа из Saby
//
//DynamicDirective
Функция SabyПолныеДанныеДокумента(ПараметрыЗагрузки, ОбщиеПараметрыЗагрузки, Результат) Экспорт
	МодульТНОбщегоНазначенияКлиентСервер = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер");
	Ошибки = МодульТНОбщегоНазначенияКлиентСервер.СтруктураОшибок(ПараметрыЗагрузки.ИмяМетаданных);
	
	ДопПоля = "ДопДействия,ТекущиеЭтапы,Подстановки,Расширение,Стороны,ИдентификаторУчастника";
	// Стороны - обогащают посдстановки данными по ответсвенным МО, ТО, выезд и заезд
	// ЗаменаВодителя - обогащает данные ид замены водителя - основания и документа замены
	Если ПараметрыЗагрузки.ИмяМетаданных = ПутевойЛистКлиент() Тогда 
		ДопПоля = ДопПоля + ",ЗаменаВодителя";
	ИначеЕсли ПараметрыЗагрузки.ИмяМетаданных = ЗаказНаПеревозкуКлиент() Тогда
		ДопПоля = ДопПоля + ",ГИС_УИД";
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ДопПоля", ДопПоля);
	
	Попытка
		РезультатSaby = ЗагрузитьДанныеДокументаИзSaby(ПараметрыЗагрузки, ДополнительныеПараметры, ОбщиеПараметрыЗагрузки);
		Если НЕ РезультатSaby.Успешно Тогда
			ВызватьИсключение РезультатSaby.Данные;
		КонецЕсли;
		
		ДанныеДокумента = РезультатSaby.Данные;
	Исключение
		ИнфоОшибки = ИнформацияОбОшибке();
		ТекстОшибки = ВыполнитьНаСервере("ESD_ТНОбщегоНазначенияСервер.ПричинаОшибкиИзЯдра", ИнфоОшибки.Описание);
		Ошибки = ВыполнитьНаСервере("ESD_ТНОбщегоНазначенияСервер.ДобавитьОшибкуПользователю", Ошибки, Неопределено, ТекстОшибки);
		КлючСоответствия = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер").КлючСсылка(ПараметрыЗагрузки.Ссылка);
		Результат.Ошибки.Вставить(КлючСоответствия, Ошибки); 
		
		ДанныеДокумента = Неопределено;
	КонецПопытки;
	
	Возврат ДанныеДокумента;
КонецФункции

// Обработка полученных данных документа из Saby
//
// Параметры:
//	Документ - Соответствие - объект обработанного документа из Saby
//	ДанныеSaby - Соответствие - объект полученных данных из Saby
//	ПараметрыОбработки - Структура - параметры обработки документа
//	Результат - Структура - описание результата загрузки документа
//
//DynamicDirective
Процедура SabyОбработатьДанныеДокумента(Документ, ДанныеSaby, ПараметрыОбработки, Результат = Неопределено)
	SabyОбработатьСобытияДокумента(Документ, ДанныеSaby, ПараметрыОбработки);
	
	ДанныеПодстановок = ДанныеSaby["Подстановки"];	
	Если ЗначениеЗаполнено(ДанныеПодстановок) Тогда
		Для Каждого Подстановки Из ДанныеПодстановок Цикл
			ДанныеПодстановки = Новый Структура("КодТитулаОнлайна, Значения", Подстановки.Ключ, Подстановки.Значение);
			ДобавитьПодстановкуТитула(Документ, ДанныеПодстановки, ПараметрыОбработки);
		КонецЦикла;
	КонецЕсли;
	
	Если Результат <> Неопределено Тогда
		МодульТНОбщегоНазначенияКлиентСервер = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер");
		Ошибки = МодульТНОбщегоНазначенияКлиентСервер.СтруктураОшибок(ПараметрыОбработки.ИмяМетаданных);
		Для Каждого Ошибка Из ПараметрыОбработки.Ошибки Цикл
			Ошибки = ВыполнитьНаСервере("ESD_ТНОбщегоНазначенияСервер.ДобавитьОшибкуПользователю", Ошибки, Неопределено, Ошибка.Значение);
			КлючСоответствия = МодульТНОбщегоНазначенияКлиентСервер.КлючСсылка(ПараметрыОбработки.Ссылка);
			Результат.Ошибки.Вставить(КлючСоответствия, Ошибки); 	
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

// Обработка полученных событий документа из Saby
//
// Параметры:
//	Документ - Соответствие - объект обработанного документа из Saby
//	ДанныеSaby - Соответствие - объект события из Saby
//	ПараметрыОбработки - Структура - параметры обработки документа
//
//DynamicDirective
Процедура SabyОбработатьСобытияДокумента(Документ, ДанныеSaby, ПараметрыОбработки)
	СобытияSaby = ДанныеSaby["Событие"];
	Если Не ЗначениеЗаполнено(СобытияSaby) Тогда
		Возврат;
	КонецЕсли;
	
	// Предопределим списки обработанных данных из "событий"
	События = Документ["Событие"];
	Вложения = Документ["Вложения"];
	
	// Обрабатываем события с онлайна
	Для Каждого СобытиеSaby Из СобытияSaby Цикл
		Событие = SabyСобытиеДокумента(СобытиеSaby);
		События.Добавить(Событие);
		
		Если ПараметрыОбработки.ОбрабатыватьВложения Тогда
			// На основании события собираем вложения
			ДобавитьВложения(Вложения, Событие, ПараметрыОбработки);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Получение параметров загрузки документа из Saby
//
// Возвращаемое значение:
//	Структура - параметры загрузки документа из Saby
//
//DynamicDirective
Функция SabyПараметрыОбработкиДокумента()
	Результат = Новый Структура;
	Результат.Вставить("Ссылка", Неопределено);
	Результат.Вставить("ИмяМетаданных", "");
	Результат.Вставить("ОбрабатыватьВложения", Истина);
	Результат.Вставить("ОбрабатыватьПодстановки", Истина);
	Результат.Вставить("Ошибки", Новый Структура);
	
	Возврат Результат;
КонецФункции

// Получение обработанной структуры события документа Saby
//
// Параметры:
//	ДанныеSaby - Соответствие - структура полученных данных события из Saby
//
// Возвращаемое значение:
//	Соответствие - обработанный объект события документа
//
//DynamicDirective
Функция SabyСобытиеДокумента(ДанныеSaby)
	ДатаВремяДокумента = ВыполнитьНаСервере("ESD_ТНОбщегоНазначенияСервер.ПреобразоватьСтрокуВДатуЭПД", 
		ДанныеSaby["ДатаВремяДокумента"]);
	ДатаВремя          = ВыполнитьНаСервере("ESD_ТНОбщегоНазначенияСервер.ПреобразоватьСтрокуВДатуЭПД", 
		ДанныеSaby["ДатаВремя"]);
		
	СобытиеСоответствие = Новый Соответствие;
	СобытиеСоответствие.Вставить("ДатаВремя",          ДатаВремя);
	СобытиеСоответствие.Вставить("ДатаВремяДокумента", ДатаВремяДокумента);
	СобытиеСоответствие.Вставить("Идентификатор",      ДанныеSaby["Идентификатор"]);
	СобытиеСоответствие.Вставить("Название",           ДанныеSaby["Название"]);
	СобытиеСоответствие.Вставить("Комментарий",        ДанныеSaby["Комментарий"]);
	СобытиеСоответствие.Вставить("Исполнитель",        Новый Соответствие);
	СобытиеСоответствие.Вставить("Действие",           Новый Соответствие);
	
	ДанныеИсполнителяSaby = ДанныеSaby["Исполнитель"];
	Если ЗначениеЗаполнено(ДанныеИсполнителяSaby) Тогда
		ДанныеИсполнителя = СобытиеСоответствие["Исполнитель"];
		ДанныеИсполнителя.Вставить("Идентификатор", ДанныеИсполнителяSaby["Идентификатор"]);
		ДанныеИсполнителя.Вставить("Фамилия",       ДанныеИсполнителяSaby["Фамилия"]);
		ДанныеИсполнителя.Вставить("Имя",           ДанныеИсполнителяSaby["Имя"]);
		ДанныеИсполнителя.Вставить("Отчество",      ДанныеИсполнителяSaby["Отчество"]);	
	КонецЕсли;
	
	ДанныеДействияSaby = ДанныеSaby["Действие"];
	Если ЗначениеЗаполнено(ДанныеДействияSaby) Тогда
		ДанныеДействия = СобытиеСоответствие["Действие"];
		ДанныеДействия.Вставить("Идентификатор", ДанныеДействияSaby["Идентификатор"]);
		ДанныеДействия.Вставить("Название",      ДанныеДействияSaby["Название"]);
	КонецЕсли;
	
	СписокВложений = ДанныеSaby["Вложение"];
	СобытиеСоответствие.Вставить("Вложение", СписокВложений);
	SabyДополнитьДанныеСобытияИзВложений(СобытиеСоответствие, СписокВложений);
	
	Возврат СобытиеСоответствие;
КонецФункции

// Дополнение события из списка структур вложений документа Saby
//
// Параметры:
//	Событие - Соответствие - объект обработанного события
//	СписокВложений - Массив - массив вложений документа Saby
//
//DynamicDirective
Процедура SabyДополнитьДанныеСобытияИзВложений(Событие, СписокВложений)
	Если Не ЗначениеЗаполнено(СписокВложений) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеИсполнителя = Событие["Исполнитель"];
	// При отсутствии исполнителя подтягиваем ФИО из подписи
	Если Не ЗначениеЗаполнено(ДанныеИсполнителя) Тогда
		// Получим последнее вложение из списка
		Вложение = СписокВложений[СписокВложений.ВГраница()];
		// На основании "подписи" заполняем данные исполнителя
		СписокПодписей = Вложение["Подпись"];
		Если ЗначениеЗаполнено(СписокПодписей) Тогда
			ДанныеПодписи = СписокПодписей[СписокПодписей.ВГраница()];
			
			МодульТНОбщегоНазначенияКлиентСервер = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер");
			ПодписантФИО = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(ДанныеПодписи, "Сертификат.ФИО", "");
			ДанныеИсполнителя.Вставить("Фамилия", ПодписантФИО);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

//DynamicDirective
Функция ИдСбисДокумента(ПараметрыЗагрузки)
	ИДСбис = "";

	ПараметрыЗагрузки.Свойство("ИДСбис", ИДСбис);
	Если ЗначениеЗаполнено(ИДСбис) Тогда
		Возврат ИДСбис;
	КонецЕсли;
	
	Если ТипЗнч(ПараметрыЗагрузки.Ссылка) = Тип("Структура") Тогда
		ИДСбис = ПараметрыЗагрузки.Ссылка.Идентификатор;
	Иначе	
		ДанныеСостояния = ВыполнитьНаСервере("ESD_ТНОбщегоНазначенияСервер.ДанныеСостоянияОбъекта", ПараметрыЗагрузки.Ссылка);
		Если ДанныеСостояния <> Неопределено Тогда 
			
			Если МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер").ЕстьРеквизитИлиСвойство(ДанныеСостояния, "UID") Тогда 
				ИДСбис = ДанныеСостояния.UID;
			Иначе 
				ИДСбис = ДанныеСостояния.ИД;
			КонецЕсли;	
			
			ПараметрыЗагрузки.Вставить("ТипИсточника", ДанныеСостояния.ТипИсточника);
			ПараметрыЗагрузки.Вставить("ИдентификаторИсточника", ДанныеСостояния.ИдентификаторИсточника);
			ПараметрыЗагрузки.Вставить("Ссылка", ДанныеСостояния.Ссылка);		
		КонецЕсли;	
	КонецЕсли;
	
	Возврат ИДСбис;
КонецФункции

// Получение имени файла без расшинения
//
// Параметры:
//	ИмяФайла - Строка - имя файла из поля данных Saby
//	МодульТНОбщегоНазначенияКлиентСервер - ОбщийМодуль - ссылка на общий модуль "ESD_ОбщегоНазначенияКлиентСервер"
//
// Возвращаемое значение:
//  Строка - имя файла без расширения
//	
//DynamicDirective
Функция ИмяФайлаБезРасширения(ИмяФайла, МодульТНОбщегоНазначенияКлиентСервер = Неопределено)
	ИмяФайлаБезРасширения = "";
	Если ПустаяСтрока(ИмяФайла) Тогда
		Возврат ИмяФайлаБезРасширения;
	КонецЕсли;
	
	Если МодульТНОбщегоНазначенияКлиентСервер = Неопределено Тогда
		// BSLLS:FunctionOutParameter-off
		МодульТНОбщегоНазначенияКлиентСервер = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер");
		// BSLLS:FunctionOutParameter-on
	КонецЕсли;
	
	СоставИмяФайла = МодульТНОбщегоНазначенияКлиентСервер.СтрРазделитьЭПД(ИмяФайла, ".");
	ИмяФайлаБезРасширения = СоставИмяФайла[0];
	
	Возврат ИмяФайлаБезРасширения;
КонецФункции

//DynamicDirective

Функция РаспознаваниеВУ(ДопПараметры, Знач ОбщиеПараметрыЗагрузки = Неопределено) Экспорт
	Если ДопПараметры.ОтветНаКлиенте <> Неопределено Тогда
		Возврат ДопПараметры.ОтветНаКлиенте;
	КонецЕсли;
	
	Если ОбщиеПараметрыЗагрузки = Неопределено Тогда
		ОбщиеПараметрыЗагрузки = МодульКода("ESD_ТНОбщегоНазначенияСервер").ОбщиеПараметрыВыгрузкиЗагрузки(
			ДопПараметры.context_params);
	КонецЕсли;
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("Файл", ДопПараметры.ЗакодированныеДД);
	
	ИмяМетода = "sabyEmployee.RecognizeDriverLicense";
	
	Ответ = ВыполнитьМетодAPI(ИмяМетода, ПараметрыМетода, ОбщиеПараметрыЗагрузки);	
	Если Ответ.Ошибка Тогда	
		Ошибка   = Истина;
		Описание = Ответ.ОписаниеОшибки;	
	ИначеЕсли Не ЗначениеЗаполнено(Ответ.Результат) Или Не ЗначениеЗаполнено(Ответ.Результат["result"]) Тогда	
		Ошибка   = Истина;
		Описание = "Ошибка выполнения распознавания ВУ / " + ИмяМетода;	
	Иначе
		Ошибка = Ложь;
	КонецЕсли;
	
	Попытка	
		// заберем только распознанные данные 
		ДанныеВУ = Ответ.Результат["result"]["RecognizedData"]["fields"];
		Ответ.Результат = ДанныеВУ;	
	Исключение	
		Ошибка = Истина;
		Описание = "Ошибка обработки результата распознавания ВУ / " + ИмяМетода;	
	КонецПопытки;
	
	Если Ошибка Тогда 	
		ВыполнитьНаСервере("ESD_ТНОбщегоНазначенияСервер.ЗаписатьОшибкуВЖурналРегистрации",
			Неопределено,
			"Не удалось выполнить распознавание ВУ / " + ИмяМетода,
			Описание);	
	КонецЕсли;
	
	Возврат Ответ;
КонецФункции

//DynamicDirective

Функция ЗагрузитьДанныеТСПоРегНомеру(ДопПараметры, Знач ОбщиеПараметрыЗагрузки = Неопределено) Экспорт
	
	Если ДопПараметры.ОтветНаКлиенте <> Неопределено Тогда
		Возврат ДопПараметры.ОтветНаКлиенте;
	КонецЕсли;
	
	Если ОбщиеПараметрыЗагрузки = Неопределено Тогда
		ОбщиеПараметрыЗагрузки = МодульКода("ESD_ТНОбщегоНазначенияСервер").ОбщиеПараметрыВыгрузкиЗагрузки(
			ДопПараметры.context_params);
	КонецЕсли;
	
	ВнутренниеПараметрыМетода = Новый Структура;
	ВнутренниеПараметрыМетода.Вставить("filter", Новый Структура("RegNumber", ДопПараметры.РегистрационныйНомер));
	ВнутренниеПараметрыМетода.Вставить("limit",  1);
	ВнутренниеПараметрыМетода.Вставить("page",   0);
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("params", ВнутренниеПараметрыМетода);
	
	ИмяМетода = "sabyVehicle.GetList";
	
	Ответ = ВыполнитьМетодAPI(ИмяМетода, ПараметрыМетода, ОбщиеПараметрыЗагрузки);
	
	Если Ответ.Ошибка Тогда 
		
		Ответ.Результат = Ответ.ОписаниеОшибки;
		
		ВыполнитьНаСервере("ESD_ТНОбщегоНазначенияСервер.ЗаписатьОшибкуВЖурналРегистрации",
			Неопределено,
			"Не удалось выполнить загрузку данных по регистрационному номеру / " + ИмяМетода,
			Ответ.ОписаниеОшибки);
			
	Иначе
		
		НайденныеМашины = Ответ.Результат["result"]["cars"];
		Если НайденныеМашины.Количество() > 0 Тогда
			Ответ.Результат = НайденныеМашины[0];
		Иначе
			Ответ.Результат = "Заполнение не выполнено. Не найдены данные транспортного средства по указанному регистрационному номеру.";
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ответ.Результат;
	
КонецФункции

//DynamicDirective

