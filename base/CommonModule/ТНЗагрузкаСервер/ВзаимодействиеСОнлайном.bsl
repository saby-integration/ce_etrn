КонецФункции

// Получает дату из подстановок указанного титула, полученного с онлайна.
//
// Параметры:
//  ДанныеПодстановки - Соответствие - значение подстановок с онлайна.
//  КодТитула - Строка - код титула, для которого получаем дату.
//  ПараметрыОбработки - Структура - параметры обработки данных Saby.
//
// Возвращаемое значение:
//   Дата - значение даты
//
//DynamicDirective
Функция ОбработкаДанных_Подстановки_Дата(ДанныеПодстановки, КодТитула, ПараметрыОбработки)
	ДатаСтрокой = МодульКодаКлиент("Документы." + ПараметрыОбработки.ИмяМетаданных)
		.СформироватьДатуИзТитулаПодстановки(ДанныеПодстановки, КодТитула);
	Если Не ЗначениеЗаполнено(ДатаСтрокой) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РезультатФункции = ВыполнитьНаСервере("ESD_ТНОбщегоНазначенияСервер.ПреобразоватьСтрокуВДатуЭПД", ДатаСтрокой);
	Возврат РезультатФункции;
КонецФункции

// Получает идентификатор из подстановок указанного титула, полученного с онлайна.
//
// Параметры:
//  ДанныеПодстановки - Соответствие - значение подстановок с онлайна.
//  КодТитула - Строка - кода титула, для которого получаем дату.
//
// Возвращаемое значение:
//  Строка - идентификатор титула
//
//DynamicDirective
Функция ОбработкаДанных_Подстановки_Идентификатор(ДанныеПодстановки, КодТитула)
	Если КодТитула = "1115113" Тогда
		ИдФайл = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер").ЗначениеИзКоллекции(
			ДанныеПодстановки, "Документ.Данные.ИдФайл", "");
	ИначеЕсли КодТитула <> "" Тогда
		ИдФайл = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер").ЗначениеИзКоллекции(
			ДанныеПодстановки[КодТитула], "Файл.ИдФайл", "");
	Иначе
		Возврат "";
	КонецЕсли;
	
	РезультатФункции = Прав(ИдФайл, 36);
	Возврат РезультатФункции;
КонецФункции

// Обработка и добавление вложений события в отдельную коллекцию
//
// Параметры:
//	Вложения - Массив - список обработанных вложений
//	Событие - Соответствие - обработанное событие документа Saby
//	ПараметрыОбработки - Структура - параметры обработки данных
//
//DynamicDirective
Процедура ДобавитьВложения(Вложения, Событие, ПараметрыОбработки)
	ВложенияСОнлайна = Событие["Вложение"];
	Если ВложенияСОнлайна = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НазваниеЭтапа = Событие["Название"];
	
	КлючДатаВремя = "ДатаВремя";
	КлючИдентификатор = "Идентификатор";
	КлючКомментарий = "Комментарий";
	
	ДатаВремя_ = Событие[КлючДатаВремя];
	Комментарий_ = Событие[КлючКомментарий];
	
	МодульESD_ОбщегоНазначенияКлиентСервер = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер");
	МодульESD_ОбщегоНазначенияСервер = МодульКодаКлиент("ESD_ТНОбщегоНазначенияСервер");
	Для Каждого Вложение Из ВложенияСОнлайна Цикл	
		Если ПараметрыОбработки.ИмяМетаданных = ТранспортнаяНакладнаяКлиент() Тогда
			ИмяФайла = МодульESD_ОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(Вложение, "Файл.Имя", "");
			КлючСоответствияВложения = ИмяФайлаБезРасширения(ИмяФайла, МодульESD_ОбщегоНазначенияКлиентСервер);
		Иначе
			КлючСоответствияВложения = Вложение["Подтип"];
			// Если "Подтип" не заполнен, попробуем вытащить подтип (код титула) через название этапа
			Если ПустаяСтрока(КлючСоответствияВложения) И Не ПустаяСтрока(НазваниеЭтапа) Тогда
				ЗначениеЭтапа = МодульESD_ОбщегоНазначенияСервер
					.РезультатФункцииТитулов(ПараметрыОбработки.ИмяМетаданных, "ЗначениеПоЭтапу", НазваниеЭтапа);
				КлючСоответствияВложения = МодульESD_ОбщегоНазначенияСервер
					.РезультатФункцииТитулов(ПараметрыОбработки.ИмяМетаданных, "ПредставленияТитула", ЗначениеЭтапа)["КодТитула"];
			КонецЕсли;
		КонецЕсли;
		
		СтруктураВложения = Вложения[КлючСоответствияВложения];
		Если СтруктураВложения = Неопределено Тогда
			СтруктураВложения = Новый Соответствие;
			СтруктураВложения.Вставить(КлючДатаВремя,     Дата(1, 1, 1));
			СтруктураВложения.Вставить(КлючИдентификатор, "");
			СтруктураВложения.Вставить(КлючКомментарий,   "");
			Вложения.Вставить(КлючСоответствияВложения, СтруктураВложения);	
		КонецЕсли;
	
		Если СтруктураВложения[КлючДатаВремя] < ДатаВремя_ Тогда
			СтруктураВложения[КлючДатаВремя]     = ДатаВремя_;
			СтруктураВложения[КлючКомментарий]   = Комментарий_;
			СтруктураВложения[КлючИдентификатор] = Вложение[КлючИдентификатор];
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры

// Обработка и добавление подстановок титула
//
// Параметры:
//	ИзмененияПоДокументу - Соотвествие - объект документа
//	ДанныеПодстановки - Соответствие - обработанные данные подстановки из вложений
//	ПараметрыОбработки - Структура - параметры обработки данных
//
// BSLLS:CognitiveComplexity-off
//
//DynamicDirective
Процедура ДобавитьПодстановкуТитула(ИзмененияПоДокументу, ДанныеПодстановки, ПараметрыОбработки)
	КодТитулаОнлайна = ДанныеПодстановки.КодТитулаОнлайна;
	ЗначенияПодстановок = ДанныеПодстановки.Значения;
	
	ПредставлениеТитула = ВыполнитьНаСервере("ESD_ТНОбщегоНазначенияСервер.РезультатФункцииТитулов", 
		ПараметрыОбработки.ИмяМетаданных, "ПредставлениеПоИмениПодстановки", КодТитулаОнлайна);
	Если Не ЗначениеЗаполнено(ПредставлениеТитула.КодТитула) Тогда
		Возврат;
	КонецЕсли;
	
	Модуль_ТНОбщегоНазначенияКлиентСервер = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер");
	МассивПодстановок = Модуль_ТНОбщегоНазначенияКлиентСервер.ЗначениеВМассив(ЗначенияПодстановок);
	Для Каждого ДанныеТитула Из МассивПодстановок Цикл
		КлючСоответствияВложения = КлючСоответствияВложения(ДанныеТитула);
		Если КлючСоответствияВложения = Неопределено Тогда
			КлючСоответствияВложения = ПредставлениеТитула.КодТитула;
		КонецЕсли;
	
		СтруктураВложения = ИзмененияПоДокументу["Вложения"][КлючСоответствияВложения];
		Если СтруктураВложения <> Неопределено Тогда
			// Дополним данные титула данными из соответствующего вложения
			ДобавитьДанныеИзВложения(ДанныеТитула, СтруктураВложения);
		КонецЕсли;
		
		ДополнитьДанныеИзПодстановки(ДанныеТитула, ПредставлениеТитула.КодТитула, ПараметрыОбработки);
		Подключаемый_ОбработкаДанныхТитула(ИзмененияПоДокументу, ПредставлениеТитула.ТипТитула, ДанныеТитула);
		Если ЕстьОшибкаПриЗагрузкеДанныхТитулов(ДанныеТитула, Модуль_ТНОбщегоНазначенияКлиентСервер) Тогда
			Продолжить;
		КонецЕсли;
		
		УдалитьНеиспользуемуюИнформациюВПодстановках(ДанныеТитула, ПредставлениеТитула);
		
		МассивТитулов = ИзмененияПоДокументу["Подстановки"][КодТитулаОнлайна];
		Если МассивТитулов = Неопределено Тогда
			МассивТитулов = Новый Массив;
			ИзмененияПоДокументу["Подстановки"].Вставить(КодТитулаОнлайна, МассивТитулов);
		КонецЕсли;
		
		ИдентификаторВложения = ДанныеТитула["ИдентификаторВложенияТитула"];
		Если ИдентификаторВложения = "" Тогда
			ИдентификаторВложения = ПредставлениеТитула.ИмяПодстановки;
		КонецЕсли;
		
		ИндексТитула = ИзмененияПоДокументу["ИдТитулов"][ИдентификаторВложения];
		Если ИндексТитула = Неопределено Тогда
			МассивТитулов.Добавить(ДанныеТитула);
			ИзмененияПоДокументу["ИдТитулов"].Вставить(ИдентификаторВложения, МассивТитулов.ВГраница());
		Иначе
			Если МассивТитулов.Количество() Тогда 
				МассивТитулов[ИндексТитула] = ДанныеТитула;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
// BSLLS:CognitiveComplexity-on

//DynamicDirective
Функция ЕстьОшибкаПриЗагрузкеДанныхТитулов(ДанныеТитула, Модуль_ТНОбщегоНазначенияКлиентСервер)
	
	Возврат ЗначениеЗаполнено(ДанныеТитула["ИдентификаторВложенияТитула"]) // для отрицательного закрытия титулов путевого листа
		И Не Модуль_ТНОбщегоНазначенияКлиентСервер.ЭтоУникальныйИдентификатор(ДанныеТитула["ИдентификаторВложенияТитула"]);
	
КонецФункции

// Получение "ключа" соответствия вложения и подстановки
//
// Параметры:
//	ДанныеТитула - Соответствие - данные титула из подстановки Saby
//
// Возвращаемое значение:
//	Строка - ключ соответствия
//
//DynamicDirective
Функция КлючСоответствияВложения(ДанныеТитула)
	
	МодульВыполнения = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер");
	
	РезультатФункции = МодульВыполнения.ЗначениеИзКоллекции(ДанныеТитула, "Файл.ИмяФайлаБезРасширения");
		
	Если РезультатФункции = Неопределено Тогда
		РезультатФункции = МодульВыполнения.ЗначениеИзКоллекции(ДанныеТитула, "Документ.Дополнительная информация.Имя файла");
	КонецЕсли;
	
	Если РезультатФункции = Неопределено Тогда
		РезультатФункции = МодульВыполнения.ЗначениеИзКоллекции(ДанныеТитула, "Документ.Данные.НаимДок");
	КонецЕсли;		
		
	Возврат РезультатФункции;
	
КонецФункции

// Получение и запись данных из вложения Saby в коллекцию
//
// Параметры:
//	Соответствие - Соответствие - коллекция, куда добавляются данные
//	ДанныеВложения - Соответствие - источник данных
//
//DynamicDirective
Процедура ДобавитьДанныеИзВложения(Соответствие, ДанныеВложения)
	// Перенесем данные вложения в подстановку
	Соответствие.Вставить("Комментарий", ДанныеВложения["Комментарий"]);
	ДобавитьДатуИзВложения(Соответствие, ДанныеВложения);
	ДобавитьИдентификаторИзВложения(Соответствие, ДанныеВложения);
КонецПроцедуры

// Получение и запись даты из вложения Saby в коллекцию
//
// Параметры:
//	Соответствие - Соответствие - коллекция, куда добавляются данные
//	ДанныеВложения - Соответствие - источник данных
//
//DynamicDirective
Процедура ДобавитьДатуИзВложения(Соответствие, ДанныеВложения)
	Если Соответствие["ДатаВложенияТитула"] <> Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	Соответствие.Вставить("ДатаВложенияТитула", 
		ВыполнитьНаСервере("ESD_ТНОбщегоНазначенияСервер.ПреобразоватьСтрокуВДатуЭПД", ДанныеВложения["ДатаВремя"]));
КонецПроцедуры
	
// Получение и запись идентификатора из вложения Saby в коллекцию
//
// Параметры:
//	Соответствие - Соответствие - коллекция, куда добавляются данные
//	ДанныеВложения - Соответствие - источник данных
//
//DynamicDirective
Процедура ДобавитьИдентификаторИзВложения(Соответствие, ДанныеВложения)
	Если Соответствие["ИдентификаторВложенияТитула"] <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Соответствие.Вставить("ИдентификаторВложенияТитула", ДанныеВложения["Идентификатор"]);
КонецПроцедуры

// Обработка и запись данных из подстановки Saby
//
// Параметры:
//	ДанныеПодстановки - Соответствие - данные подстановки Saby
//	КодТитула - Строка - код титула, к которой относится подстановка
//	ПараметрыОбработки - Структура - параметры обработки данных Saby
//
//DynamicDirective
Процедура ДополнитьДанныеИзПодстановки(ДанныеПодстановки, КодТитула, ПараметрыОбработки)
	Дата_ = ОбработкаДанных_Подстановки_Дата(ДанныеПодстановки, КодТитула, ПараметрыОбработки);
	Если ЗначениеЗаполнено(Дата_) Тогда
		ДанныеПодстановки.Вставить("ДатаВложенияТитула", Дата_);
	КонецЕсли;
	
	Если ДанныеПодстановки["ИдентификаторВложенияТитула"] = Неопределено Тогда
		ДанныеПодстановки.Вставить("ИдентификаторВложенияТитула", 
			ОбработкаДанных_Подстановки_Идентификатор(ДанныеПодстановки, КодТитула));
	КонецЕсли;
КонецПроцедуры

// Возвращает структуру параметров результата взаимодействия с Saby
//
// Параметры:
//	Ошибка - Булево - признак ошибки
//	Данные - Произвольно - данные Saby
//
// Возвращаемое значение:
//	Структура - параметры результата
//
//DynamicDirective
Функция SabyРезультатВзаимодействияСОнлайном(Ошибка = Ложь, Данные = Неопределено)
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("Ошибка", Ошибка);
	РезультатФункции.Вставить("Данные", Данные);
	
	Возврат РезультатФункции;
КонецФункции

