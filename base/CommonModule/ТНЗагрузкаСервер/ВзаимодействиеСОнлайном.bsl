#КонецОбласти // include_etrn_base_CommonModule_ТНЗагрузкаСервер_ДополнительныйФункционал_ВзаимодействиеСОнлайном_СлужебныйПрограммныйИнтерфейс

// Загружает данные из Saby по переданному адресу
//
// Параметры:
//	ПараметрыЗагрузки - Структура - параметры подключения Saby
//	Адрес - Строка - адрес загрузки данных из Saby
//
// Возвращаемое значение:
//	Произвольно - коллекция полученных данных из Saby
//	
//DynamicDirective
Функция SabyЗагрузитьДанныеПоСсылке(ПараметрыЗагрузки, Адрес)
	РезультатОбменаSaby = ПараметрыЗагрузки.ОбъектОбработки.local_helper_download_from_link(
		ПараметрыЗагрузки.context_params, Адрес);
		
	Если ТипЗнч(РезультатОбменаSaby) = Тип("Структура") Тогда
		Подключаемый_ЗагрузкаИзSaby_ПослеВыполненияОбмена("local_helper_download_from_link"
			, Новый Структура("Адрес", Адрес)
			, РезультатОбменаSaby 
			, ПараметрыЗагрузки.context_params
		);
	КонецЕсли;
			
	Возврат РезультатОбменаSaby;
КонецФункции

// Получает справочные данные с онлайна.
//
// Параметры:
//  ИмяСправочника - Строка - наименование справочника, который необходимо получить с онлайна.
//  ОбщиеПараметрыЗагрузки - Структура - общие параметры загрузки
//
// Возвращаемое значение:
//   Массив - данные зависят от справочника, получаемого с онлайна.
//
//DynamicDirective
Функция СправочникСОнлайна(ИмяСправочника, ОбщиеПараметрыЗагрузки) Экспорт
	// Импорт модуля "ESD_Record"
	мRecord = МодульКодаКлиент("ESD_Record");
	// Создание структуры Record
	Record = мRecord.AppendField(ИмяСправочника, "Справочник", мRecord.tString());
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("ДопПоля",    Новый Массив);
	ПараметрыМетода.Вставить("Фильтр",     мRecord.Expand(Record));
	ПараметрыМетода.Вставить("Сортировка", null);
	ПараметрыМетода.Вставить("Навигация",  null);
	
	Метод = "Классификаторы.ПолучитьСправочникЦеликом";
	ДопПараметры = Новый Структура("protocol", 6);
	
	РезультатSaby = ВыполнитьМетодSaby(Метод, ПараметрыМетода, ДопПараметры, ОбщиеПараметрыЗагрузки); 
	Если РезультатSaby.Ошибка Тогда
		ВызватьИсключение "Ошибка при загрузке данных справочника """ + ИмяСправочника + """: 
			|" + РезультатSaby.ОписаниеОшибки;
	КонецЕсли;

	Результат = РезультатSaby["Результат"];
	Возврат Результат["result"]["d"];
КонецФункции

// Загрузка данных ЭПД из Saby
//
// Параметры:
//	ОбщиеПараметрыЗагрузки - Структура - параметры подключения к Saby
//	ПараметрыМетода - Структура - параметры загрузки данных
//
// Возвращаемое значение:
//	Структура, Соответствие - коллекция обработанных данных, полученных из Saby
//
//DynamicDirective
Функция ВыполнитьМетодSaby_ПрочитатьДокумент(ОбщиеПараметрыЗагрузки, ПараметрыМетода)
	Перем ОбъектОбработки_, context_params;
	
	Если Не ОбщиеПараметрыЗагрузки.Свойство("ОбъектОбработки", ОбъектОбработки_) Тогда
		ОбъектОбработки_ = МодульКода("ESD_ТНОбщегоНазначенияСервер").ОбъектОбработки();
	КонецЕсли;
	Если Не ОбщиеПараметрыЗагрузки.Свойство("context_params", context_params) Тогда
		context_params = МодульКода("ESD_ТНОбщегоНазначенияСервер").ПроверитьНаличиеПараметровПодключенияЭПД();
	КонецЕсли;		
	
	РезультатОбменаSaby = ОбъектОбработки_.local_helper_read_document(
		context_params, ПараметрыМетода);
		
	Подключаемый_ЗагрузкаИзSaby_ПослеВыполненияОбмена("СБИС.ПрочитатьДокумент", 
		ПараметрыМетода, РезультатОбменаSaby, context_params);
	
	Возврат РезультатОбменаSaby;
КонецФункции

// Обертка над методом "ВыполнитьМетодAPI"
//
// Параметры:
//  Метод - Строка - имя метода.
//  Параметры - Структура - параметры метода.
//	ДополнительныеПараметры - Структура - дополнительные параметры метода.
//	ОбщиеПараметрыЗагрузки - Структура - общие параметры загрузки
//
// Возвращаемое значение:
//   Структура - структура результата запроса.
//
//DynamicDirective
Функция ВыполнитьМетодSaby(Метод, Параметры, Знач ДополнительныеПараметры = Неопределено, ОбщиеПараметрыЗагрузки = Неопределено) Экспорт
	// BSLLS:FunctionOutParameter-off
	Если ОбщиеПараметрыЗагрузки = Неопределено Тогда
		МодульТНОбщегоНазначенияСервер = МодульКода("ESD_ТНОбщегоНазначенияСервер");
		ОбщиеПараметрыЗагрузки = МодульТНОбщегоНазначенияСервер.ОбщиеПараметрыВыгрузкиЗагрузки();
	КонецЕсли;
	// BSLLS:FunctionOutParameter-on
	
	Если ДополнительныеПараметры = Неопределено Тогда
		ДополнительныеПараметры = Новый Структура("protocol", 7);
	КонецЕсли;

	РезультатAPI = ВыполнитьМетодAPI(Метод 
		, Параметры
		, ОбщиеПараметрыЗагрузки
		, ДополнительныеПараметры
	);
	
	Возврат РезультатAPI;
КонецФункции

// Получает данные документа из СБИС.
//
// Параметры:
//  Параметры - Структура - структура обязательных параметров для получения данных из СБИС (ссылка,имяметаданных)
//  ДополнительныеПараметры - Структура - структура дополнительных параметров метода
//  ОбщиеПараметрыЗагрузки - Структура - общие параметры загрузки.
//
// Возвращаемое значение:
//   Структура - структура результата запроса.
//
//DynamicDirective
Функция ЗагрузитьДанныеДокументаИзSaby(Параметры, ДополнительныеПараметры = Неопределено, ОбщиеПараметрыЗагрузки = Неопределено) Экспорт
	Перем SabyID, ДопПоля;
	Результат = Новый Структура("Успешно,Данные", Истина, Неопределено);
	
	SabyID = ИдСбисДокумента(Параметры);
	Если НЕ ЗначениеЗаполнено(SabyID) Тогда 
		Результат.Данные = "У документа нет идентификатора Saby, обновление данных невозможно!";
		Результат.Успешно = Ложь;
		Возврат Результат;
	КонецЕсли;
	Параметры.Вставить("ИДСбис", SabyID); 
	
	// BSLLS:FunctionOutParameter-off
	Если ОбщиеПараметрыЗагрузки = Неопределено Тогда
		МодульТНОбщегоНазначенияСервер = МодульКода("ESD_ТНОбщегоНазначенияСервер");
		ОбщиеПараметрыЗагрузки = МодульТНОбщегоНазначенияСервер.ОбщиеПараметрыВыгрузкиЗагрузки();
	КонецЕсли;
	// BSLLS:FunctionOutParameter-on
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
		ДополнительныеПараметры.Свойство("ДопПоля", ДопПоля);
	КонецЕсли;
	
	Если ТипЗнч(ДопПоля) <> Тип("Строка") Тогда
		ДопПоля = "";
	КонецЕсли;
	
	ПараметрыМетода = Новый Структура("Идентификатор,ДопПоля", SabyID, ДопПоля);
	Попытка
		РезультатСБИС = ВыполнитьМетодSaby_ПрочитатьДокумент(ОбщиеПараметрыЗагрузки, ПараметрыМетода);
		Результат.Данные = РезультатСБИС;
	Исключение
		ИнфоОшибки = ИнформацияОбОшибке();
		ТекстОшибки = ВыполнитьНаСервере("ESD_ТНОбщегоНазначенияСервер.ПричинаОшибкиИзЯдра", ИнфоОшибки.Описание);
		Результат.Данные = ТекстОшибки;
		Результат.Успешно = Ложь;
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

