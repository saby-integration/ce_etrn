
Процедура ДинСписокДокументов_Отбор_ДокументОснование_ИзменитьОтображение(Форма, Список, ВидимостьОтбора = Истина) Экспорт
	ИмяРеквизита_ = ESD_ОбщийФункционалКлиентСервер.ДинСписокДокументов_Отбор_ДокументОснование_ИмяРеквизита();
	Если ESD_ТНОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойство(Форма.Элементы, ИмяРеквизита_) Тогда
		Форма.Элементы[ИмяРеквизита_].Видимость = ВидимостьОтбора;
		ДинСписокДокументов_Отбор_ДокументОснование_Применить(Форма, Список);
	КонецЕсли;
КонецПроцедуры

Процедура ДинСписокДокументов_Отбор_ДокументОснование_НачалоВыбора(Форма) Экспорт
	ИмяРеквизита_ = ESD_ОбщийФункционалКлиентСервер.ДинСписокДокументов_Отбор_ДокументОснование_ИмяРеквизита();
	Если Форма[ИмяРеквизита_] = Неопределено Тогда
		ДинСписокДокументов_Отбор_ДокументОснование_ОткрытьФормуВыбораТипа(Форма);
	Иначе
		ПолноеИмяМетаданных_ = ESD_ТНОбщегоНазначенияСервер.ПолноеИмяМетаданныхПоЗначению(Форма[ИмяРеквизита_]);
		ДинСписокДокументов_Отбор_ДокументОснование_ОткрытьФормуВыбораЗначения(Форма, ПолноеИмяМетаданных_);
	КонецЕсли;
КонецПроцедуры

Процедура ДинСписокДокументов_Отбор_ДокументОснование_ОткрытьФормуВыбораТипа(Форма) Экспорт
	ИмяОповещения_	 = ESD_ОбщийФункционалКлиентСервер.
		ДинСписокДокументов_Отбор_ДокументОснование_ПослеВыбораТипа_ИмяОповещения();
	Оповещение_		 = Новый ОписаниеОповещения(ИмяОповещения_, Форма);
	ПараметрыФормы_	 = Новый Структура;
	ПараметрыФормы_.Вставить("ЭтоДобавлениеСопоставления", Истина);
	ПараметрыФормы_.Вставить("ТипМетаданных", "Документы");
	ОткрытьФорму(
		"ОбщаяФорма.ESD_ВыборТиповЭПД",
		ПараметрыФормы_,
		Форма, , , ,
		Оповещение_,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

Процедура ДинСписокДокументов_Отбор_ДокументОснование_ОткрытьФормуВыбораЗначения(Форма, ИмяМетаданных) Экспорт
	ИмяОповещения_	 = ESD_ОбщийФункционалКлиентСервер.
		ДинСписокДокументов_Отбор_ДокументОснование_ПослеВыбораЗначения_ИмяОповещения();
	ФормаВыбора_	 = ESD_ТНОбщегоНазначенияКлиентСервер.ИмяФормыВыбораПоМетаданным(ИмяМетаданных);
	Оповещение_		 = Новый ОписаниеОповещения(ИмяОповещения_, Форма);
	ОткрытьФорму(ФормаВыбора_, ,
		Форма, , , ,
		Оповещение_,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

Процедура ДинСписокДокументов_Отбор_ДокументОснование_ОбработатьВыборТипа(Форма, Список, РезультатВыбора) Экспорт
	ДинСписокДокументов_Отбор_ДокументОснование_УстановитьПустуюСсылку(Форма, РезультатВыбора.ПолноеИмя);
	ДинСписокДокументов_Отбор_ДокументОснование_ОткрытьФормуВыбораЗначения(Форма, РезультатВыбора.ПолноеИмя);
КонецПроцедуры

Процедура ДинСписокДокументов_Отбор_ДокументОснование_ОбработатьВыборЗначения(Форма, Список, РезультатВыбора) Экспорт
	ДинСписокДокументов_Отбор_ДокументОснование_УстановитьЗначение(Форма, РезультатВыбора);
	ДинСписокДокументов_Отбор_ДокументОснование_Применить(Форма, Список);
КонецПроцедуры

Процедура ДинСписокДокументов_Отбор_ДокументОснование_УстановитьПустуюСсылку(Форма, ИмяМетаданных) Экспорт
	ПутьПустаяСсылка_ = ESD_ТНОбщегоНазначенияКлиентСервер.СтрШаблонЭПД("%1.ПустаяСсылка", ИмяМетаданных);
	ДинСписокДокументов_Отбор_ДокументОснование_УстановитьЗначение(Форма, ПредопределенноеЗначение(ПутьПустаяСсылка_));
КонецПроцедуры

Процедура ДинСписокДокументов_Отбор_ДокументОснование_УстановитьЗначение(Форма, Значение) Экспорт
	ИмяРеквизита_		 = ESD_ОбщийФункционалКлиентСервер.ДинСписокДокументов_Отбор_ДокументОснование_ИмяРеквизита();
	Форма[ИмяРеквизита_] = Значение;
КонецПроцедуры

Процедура ДинСписокДокументов_Отбор_ДокументОснование_Применить(Форма, Список) Экспорт
	ИмяРеквизита_ = ESD_ОбщийФункционалКлиентСервер.ДинСписокДокументов_Отбор_ДокументОснование_ИмяРеквизита();
	Если ЗначениеЗаполнено(Форма[ИмяРеквизита_]) И Форма.Элементы[ИмяРеквизита_].Видимость Тогда
		ПараметрыОснования_ = ESD_ОбщийФункционалКлиентСервер.
			ДинСписокДокументов_Отбор_ДокументОснование_Параметры(Форма[ИмяРеквизита_]);
		ESD_ОбщийФункционалКлиентСервер.ДинСписокДокументов_УстановитьЭлементОтбора(
			Список, ПараметрыОснования_.ОснованиеМетаданные, "ДокументОснование_ОбъектМетаданных");
		ESD_ОбщийФункционалКлиентСервер.ДинСписокДокументов_УстановитьЭлементОтбора(
			Список, ПараметрыОснования_.ОснованиеИдентификатор, "ДокументОснование_Идентификатор");
	Иначе
		ESD_ОбщийФункционалКлиентСервер.ДинСписокДокументов_УстановитьЭлементОтбора(
			Список, Неопределено, "ДокументОснование_ОбъектМетаданных");
		ESD_ОбщийФункционалКлиентСервер.ДинСписокДокументов_УстановитьЭлементОтбора(
			Список, Неопределено, "ДокументОснование_Идентификатор");
	КонецЕсли;
КонецПроцедуры
