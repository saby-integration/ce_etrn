
Процедура ДинСписокДокументов_Отборы_ДокументОснование_ИзменитьОтображение(Форма, Список, ВидимостьОтбора = Истина) Экспорт
	ИмяРеквизита_ = ESD_ОбщийФункционалКлиентСервер.ДинСписокДокументов_Отборы_ДокументОснование_ИмяРеквизита();
	Если Не ESD_ТНОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойство(Форма.Элементы, ИмяРеквизита_) Тогда
		Возврат;
	КонецЕсли;
	
	// Очистим значение отбора
	Форма[ИмяРеквизита_] = Неопределено;
	// Изменим видимость соответсвующего поля отбора
	Форма.Элементы[ИмяРеквизита_].Видимость = ВидимостьОтбора;
	// Применим отбор
	ДинСписокДокументов_Отборы_ДокументОснование_Применить(Форма, Список);
КонецПроцедуры

Процедура ДинСписокДокументов_Отборы_ДокументОснование_НачалоВыбора(Форма) Экспорт
	ИмяРеквизита_ = ESD_ОбщийФункционалКлиентСервер.ДинСписокДокументов_Отборы_ДокументОснование_ИмяРеквизита();
	Если Форма[ИмяРеквизита_] = Неопределено Тогда
		ДинСписокДокументов_Отборы_ДокументОснование_ОткрытьФормуВыбораТипа(Форма);
	Иначе
		ПолноеИмяМетаданных_ = ESD_ТНОбщегоНазначенияСервер.ПолноеИмяМетаданныхПоЗначению(Форма[ИмяРеквизита_]);
		ДинСписокДокументов_Отборы_ДокументОснование_ОткрытьФормуВыбораЗначения(Форма, ПолноеИмяМетаданных_);
	КонецЕсли;
КонецПроцедуры

Процедура ДинСписокДокументов_Отборы_ДокументОснование_ОткрытьФормуВыбораТипа(Форма) Экспорт
	ИмяОповещения_ = ESD_ОбщийФункционалКлиентСервер.
		ДинСписокДокументов_Отборы_ДокументОснование_ПослеВыбораТипа_ИмяОповещения();
	Оповещение_     = Новый ОписаниеОповещения(ИмяОповещения_, Форма);
	ПараметрыФормы_ = Новый Структура;
	ПараметрыФормы_.Вставить("ЭтоДобавлениеСопоставления", Истина);
	ПараметрыФормы_.Вставить("ТипМетаданных", "Документ,Справочник");
	ОткрытьФорму(
		"ОбщаяФорма.ESD_ВыборТиповЭПД",
		ПараметрыФормы_,
		Форма, , , ,
		Оповещение_,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

Процедура ДинСписокДокументов_Отборы_ДокументОснование_ОткрытьФормуВыбораЗначения(Форма, ИмяМетаданных) Экспорт
	ИмяРеквизита_     = ESD_ОбщийФункционалКлиентСервер.ДинСписокДокументов_Отборы_ДокументОснование_ИмяРеквизита();
	ЭлементРеквизита_ = Форма.Элементы.Найти(ИмяРеквизита_);
	Если ЭлементРеквизита_ = Неопределено Тогда
		ESD_ТНОбщегоНазначенияКлиент.СообщитьПользователю(
			"Нет возможности открыть форму. Поле отбора документа основания не найдено.");
		Возврат;
	КонецЕсли;
	ФормаВыбора_    = ESD_ТНОбщегоНазначенияКлиентСервер.ИмяФормыВыбораПоМетаданным(ИмяМетаданных);
	ПараметрыФормы_ = Новый Структура("РежимВыбора", Истина);
	ОткрытьФорму(ФормаВыбора_,
		ПараметрыФормы_,
		ЭлементРеквизита_, , , , ,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

Процедура ДинСписокДокументов_Отборы_ДокументОснование_ОбработатьВыборТипа(Форма, Список, РезультатВыбора) Экспорт
	ДинСписокДокументов_Отборы_ДокументОснование_УстановитьПустуюСсылку(Форма, РезультатВыбора.ПолноеИмя);
	ДинСписокДокументов_Отборы_ДокументОснование_ОткрытьФормуВыбораЗначения(Форма, РезультатВыбора.ПолноеИмя);
КонецПроцедуры

Процедура ДинСписокДокументов_Отборы_ДокументОснование_ОбработатьВыборЗначения(Форма, Список, РезультатВыбора) Экспорт
	ДинСписокДокументов_Отборы_ДокументОснование_УстановитьЗначение(Форма, РезультатВыбора);
	ДинСписокДокументов_Отборы_ДокументОснование_Применить(Форма, Список);
КонецПроцедуры

Процедура ДинСписокДокументов_Отборы_ДокументОснование_УстановитьПустуюСсылку(Форма, ИмяМетаданных) Экспорт
	ПутьПустаяСсылка_ = ESD_ТНОбщегоНазначенияКлиентСервер.СтрШаблонЭПД("%1.ПустаяСсылка", ИмяМетаданных);
	ДинСписокДокументов_Отборы_ДокументОснование_УстановитьЗначение(Форма, ПредопределенноеЗначение(ПутьПустаяСсылка_));
КонецПроцедуры

Процедура ДинСписокДокументов_Отборы_ДокументОснование_УстановитьЗначение(Форма, Значение) Экспорт
	ИмяРеквизита_		 = ESD_ОбщийФункционалКлиентСервер.ДинСписокДокументов_Отборы_ДокументОснование_ИмяРеквизита();
	Форма[ИмяРеквизита_] = Значение;
КонецПроцедуры

Процедура ДинСписокДокументов_Отборы_ДокументОснование_Применить(Форма, Список) Экспорт
	ИмяРеквизита_ = ESD_ОбщийФункционалКлиентСервер.ДинСписокДокументов_Отборы_ДокументОснование_ИмяРеквизита();
	Если ЗначениеЗаполнено(Форма[ИмяРеквизита_]) И Форма.Элементы[ИмяРеквизита_].Видимость Тогда
		ПараметрыОснования_ = ESD_ОбщийФункционалКлиентСервер.
			ДинСписокДокументов_Отборы_ДокументОснование_Параметры(Форма[ИмяРеквизита_]);
	Иначе
		ПараметрыОснования_ = ESD_ОбщийФункционалКлиентСервер.
			ДинСписокДокументов_Отборы_ДокументОснование_Параметры();
	КонецЕсли;
	
	ESD_ОбщийФункционалКлиентСервер.ДинСписокДокументов_УстановитьЭлементОтбора(
		Список, ПараметрыОснования_.ОснованиеМетаданные, "ДокументОснование_ОбъектМетаданных");
	ESD_ОбщийФункционалКлиентСервер.ДинСписокДокументов_УстановитьЭлементОтбора(
		Список, ПараметрыОснования_.ОснованиеИдентификатор, "ДокументОснование_Идентификатор");
КонецПроцедуры

