
Процедура СоздатьНаОсновании_СтруктураДанныхSaby_ПоручениеЭкспедитору(ДанныеЗаполнения, 
	ПараметрыОткрытияФормы = Неопределено
) Экспорт
	// Формируем параметры заполнения ЭПД с "Вид" = "СтруктураДанных"
	ПараметрыЗаполнения_ = ESD_ОбщийФункционалКлиентСервер
		.СоздатьНаОсновании_ПараметрыЗаполнения_СтруктураДанныхSaby(ДанныеЗаполнения);
	
	// Получаем имя открываемого объекта
	Имя_ = ESD_ОбщийФункционалКлиентСервер.СоздатьНаОсновании_ИмяОбъекта_ПоручениеЭкспедитору();
	
	// Передаем в общий метод создания и открытия формы
	СоздатьНаОсновании(Имя_, ПараметрыЗаполнения_, ПараметрыОткрытияФормы); 
КонецПроцедуры

Процедура СоздатьНаОсновании(ИмяОбъекта, ПараметрыЗаполнения, 
	Знач ПараметрыОткрытияФормы = Неопределено
) Экспорт
	// Обрабатываем отсутствие параметров открыти формы - формируем структуру значений "по умолчанию"
	Если ПараметрыОткрытияФормы = Неопределено Тогда
		ПараметрыОткрытияФормы = ESD_ОбщийФункционалКлиентСервер.СоздатьНаОсновании_ПараметрыОткрытияФормы();
	КонецЕсли;
	
	// Сформируем имя открываемой формы объекта
	ИмяФормы_ = ИмяОбъекта + ".ФормаОбъекта"; 
	
	// Сформируем параметры формы
	// Укажем параметры заполнения в служебном параметре
	ПараметрыФормы_ = Новый Структура("ЗначенияЗаполнения", ПараметрыЗаполнения);
	
	// Выполняем метод открытия формы
	ОткрытьФорму(ИмяФормы_, 
		ПараметрыФормы_, 
		ПараметрыОткрытияФормы.Владелец, 
		, 
		, 
		, 
		ПараметрыОткрытияФормы.ОповещениеПриЗакрытии, 
		ПараметрыОткрытияФормы.РежимОткрытияОкна);
КонецПроцедуры

