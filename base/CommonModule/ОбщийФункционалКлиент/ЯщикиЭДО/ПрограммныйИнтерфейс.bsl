
Процедура ЯщикиЭДО_Открыть(ДанныеУчастника, Оповещение, Владелец) Экспорт
	ИмяФормы_ = "Обработка.ESD_Компоненты.Форма.ЯщикиЭДО";

	ПараметрыФормы_ = Новый Структура("ИсточникДанных", ДанныеУчастника);
	ДополнительныеПараметры_ = Новый Структура("Оповещение", Оповещение);

	#Если ТолстыйКлиентОбычноеПриложение Или ТолстыйКлиентУправляемоеПриложение Тогда
		// BSLLS:GetFormMethod-off
		Форма_ = ПолучитьФорму(ИмяФормы_, ПараметрыФормы_, Владелец);
		// BSLLS:GetFormMethod-on
		Если Форма_ = Неопределено Тогда
			Возврат;
		КонецЕсли;

		ЯщикиЭДО_Открыть_ОбработатьРезультат(Форма_.ОткрытьМодально(), ДополнительныеПараметры_);
	#Иначе
		Оповещение_ = Новый ОписаниеОповещения("ЯщикиЭДО_Открыть_ОбработатьРезультат",
			ESD_ОбщийФункционалКлиент, ДополнительныеПараметры_);
		ОткрытьФорму(ИмяФормы_, ПараметрыФормы_, Владелец, , , , Оповещение_,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	#КонецЕсли
КонецПроцедуры

