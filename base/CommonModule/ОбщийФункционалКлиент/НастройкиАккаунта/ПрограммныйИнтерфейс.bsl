
Процедура НастройкиАккаунта_НашаОрганизация_Выбрать(Форма, Владелец, context_params = Неопределено) Экспорт
	// Определим базовое оповещение
	ПараметрыОповещения_ = Новый Структура("Форма", Форма);
	Оповещение_ = Новый ОписаниеОповещения("НастройкиАккаунта_НашаОрганизация_ЗавершениеВыбора",
		ESD_ОбщийФункционалКлиент, 
		ПараметрыОповещения_);
		
	// Сформируем структуру параметров
	Параметры_ = ESD_КомпонентыКлиент.НашаОрганизация_ОткрытьФорму_Параметры(context_params);
	// Сформируем структуру доп. параметров
	ДополнительныеПараметры_ = ESD_КомпонентыКлиент.НашаОрганизация_ОткрытьФорму_ДополнительныеПараметры(Оповещение_);
	// Откроем форму выбора "нашей организации"
	ESD_КомпонентыКлиент.НашаОрганизация_ОткрытьФорму(Параметры_, ДополнительныеПараметры_, Владелец);
КонецПроцедуры

Процедура НастройкиАккаунта_НашаОрганизация_Очистить(Форма) Экспорт
	// Очистим значение соответствующей настройки аккаунта
	НастройкиАккаунта_НашаОрганизация_Применить(Форма, Неопределено);
КонецПроцедуры

