
Процедура СлужебнаяИнформация_Комментарий_Открыть(Форма) Экспорт
	Заголовок_ = "Служебная информация";
	Комментарий_ = Форма.Объект.Служебный_Комментарий;

	Если Не Форма.ТолькоПросмотр Тогда
		ДополнительныеПараметры_ = Новый Структура("Форма", Форма);
		Оповещение_ = Новый ОписаниеОповещения("СлужебнаяИнформация_Комментарий_ОбработатьРезультатОткрытия",
			ESD_ОбщийФункционалКлиент, ДополнительныеПараметры_);
		ПоказатьВводСтроки(Оповещение_, Комментарий_, Заголовок_, 0, Истина); 
	Иначе                                    
		#Если ТолстыйКлиентОбычноеПриложение Или ТолстыйКлиентУправляемоеПриложение Тогда
		// BSLLS:UsingSynchronousCalls-off
		ОткрытьЗначение(Комментарий_);
		// BSLLS:UsingSynchronousCalls-on
		#Иначе
			ПоказатьЗначение(, Комментарий_);
		#КонецЕсли
	КонецЕсли;
КонецПроцедуры

