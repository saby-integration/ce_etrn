
Процедура СоздатьНаОсновании_Заполнить(ОбъектЗаполнения, ПараметрыЗаполнения) Экспорт
	// Создадим эталонную структуру параметров заполнения
	ПараметрыЗаполнения_ = ESD_ОбщийФункционалКлиентСервер.СоздатьНаОсновании_Параметры();
	// Перенесем значения переданных параметров заполнения в эталонную структуру
	ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения_, ПараметрыЗаполнения);
	
	// Обработаем наличие адреса временного хранилища данных заполнения
	Если ЗначениеЗаполнено(ПараметрыЗаполнения_.ДанныеЗаполнения_АдресВременногоХранилища) Тогда
		// Получим и заполним данные заполнения из временного хранилища 1С
		ПараметрыЗаполнения_.Данные = ПолучитьИзВременногоХранилища(
			ПараметрыЗаполнения_.Данные_АдресВременногоХранилища);
		Попытка
			УдалитьИзВременногоХранилища(ПараметрыЗаполнения_.Данные_АдресВременногоХранилища);
		// BSLLS:MissingCodeTryCatchEx-off
		Исключение
		КонецПопытки;
		// BSLLS:MissingCodeTryCatchEx-on
	КонецЕсли;
	// Удалим служебный параметр
	ПараметрыЗаполнения_.Удалить("ДанныеЗаполнения_АдресВременногоХранилища");
	
	// Выполним попытку заполнения на основании структуры данных
	СоздатьНаОсновании_Заполнить_СтруктураДанныхSaby(ОбъектЗаполнения, ПараметрыЗаполнения_);	
КонецПроцедуры

Процедура СоздатьНаОсновании_Заполнить_СтруктураДанныхSaby(ОбъектЗаполнения, ПараметрыЗаполнения) Экспорт
	// Получим эталонное значение "вида"
	Вид_ = ESD_ОбщийФункционалКлиентСервер.СоздатьНаОсновании_ВидПараметров_СтруктураДанныхSaby();
	// Проверим и обработаем расхождение "видов"
	Если ПараметрыЗаполнения.Вид <> Вид_ Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		// Выполним попытку заполнения объекта ЭПД на основании структуры данных Saby
		ОбъектЗаполнения.ЗаполнениеНаОсновании_СтруктураДанных(
			ПараметрыЗаполнения.Данные, 
			ПараметрыЗаполнения.ДополнительныеПараметры);	
	Исключение
		// Получим объект ошибки
		ИнформацияОбОшибке_ = ИнформацияОбОшибке();
		// Получим подробное представление ошибки 
		ТекстОшибки_ = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке_);
		// Отобразим ошибку пользователю
		ESD_ТНОбщегоНазначенияСервер.СообщитьПользователюСервер(ТекстОшибки_);
	КонецПопытки;
КонецПроцедуры

