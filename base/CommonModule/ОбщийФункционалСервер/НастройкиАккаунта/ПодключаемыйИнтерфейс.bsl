
Процедура НастройкиАккаунта_Инициализация(Форма, ГруппаВладелец) Экспорт
	ГруппаКонтейнер = НастройкиАккаунта_Контейнер_ДобавитьНаФорму(Форма, ГруппаВладелец);
	НастройкиАккаунта_СоздатьЭлементы(Форма, ГруппаКонтейнер);
	НастройкиАкканута_Загрузить(Форма);
КонецПроцедуры

Процедура НастройкиАккаунта_СоздатьЭлементы(Форма, ГруппаВладелец) Экспорт
	НастройкиАккаунта_НашаОрганизация_СоздатьЭлементы(Форма, ГруппаВладелец); 
КонецПроцедуры

Процедура НастройкиАкканута_Загрузить(Форма) Экспорт
	НастройкиАккаунта_НашаОрганизация_ЗаполнитьНаФорме(Форма);
КонецПроцедуры

Функция НастройкиАккаунта_Контейнер_ДобавитьНаФорму(Форма, ГруппаВладелец) Экспорт
	ИмяГруппы = "НастройкиАккаунта_Контейнер";
	ГруппаФормы = Форма.Элементы.Найти(ИмяГруппы);
	Если ГруппаФормы = Неопределено Тогда
		ГруппаФормы = Форма.Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"), ГруппаВладелец);
		ГруппаФормы.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаФормы.Поведение = ПоведениеОбычнойГруппы.Обычное;
		ГруппаФормы.Отображение = ОтображениеОбычнойГруппы.Нет;
		ГруппаФормы.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		ГруппаФормы.РастягиватьПоВертикали = Ложь;
		ГруппаФормы.ОтображатьЗаголовок = Ложь;
	КонецЕсли;
	
	Возврат ГруппаФормы;
КонецФункции

#Область НашаОрганизация

Функция НастройкиАккаунта_НашаОрганизация_СоздатьРеквизиты(Форма) Экспорт
	НовыеРеквизиты = Новый Массив;
	
	ИмяРеквизита_ = ESD_ОбщийФункционалКлиентСервер.НастройкиАккаунта_НашаОрганизация_ИмяРеквизита();
	Если ESD_ТНОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойство(Форма, ИмяРеквизита_) Тогда
		Возврат НовыеРеквизиты;
	КонецЕсли;

	НовыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяРеквизита_, Новый ОписаниеТипов("Строка")));

	Форма.ИзменитьРеквизиты(НовыеРеквизиты);
	
	Возврат НовыеРеквизиты;
КонецФункции

Функция НастройкиАккаунта_НашаОрганизация_СоздатьЭлементы(Форма, ГруппаВладелец) Экспорт 
	НастройкиАккаунта_НашаОрганизация_СоздатьРеквизиты(Форма);
	
	ИмяЭлемента_ = ESD_ОбщийФункционалКлиентСервер.НастройкиАккаунта_НашаОрганизация_ИмяРеквизита();
	
	ИмяГруппы_ = "Группа" + ИмяЭлемента_;
	ГруппаФормы_ = Форма.Элементы.Найти(ИмяГруппы_);
	Если ГруппаФормы_ = Неопределено Тогда
		ГруппаФормы_ = Форма.Элементы.Добавить(ИмяГруппы_, Тип("ГруппаФормы"), ГруппаВладелец);
		ГруппаФормы_.Вид                  = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаФормы_.Группировка          = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
		ГруппаФормы_.Отображение          = ОтображениеОбычнойГруппы.Нет;
		ГруппаФормы_.Подсказка 			  = НастройкиАккаунта_НашаОрганизация_ТекстПодсказки();
		ГруппаФормы_.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСнизу;
		ГруппаФормы_.ОтображатьЗаголовок  = Ложь;
	Иначе
		ГруппаФормы_ = ГруппаВладелец;
	КонецЕсли;
	
	ЭлементФормы = Форма.Элементы.Найти(ИмяЭлемента_);
	Если ЭлементФормы = Неопределено Тогда
		ЭлементФормы = Форма.Элементы.Добавить(ИмяЭлемента_, Тип("ПолеФормы"), ГруппаФормы_);
		ЭлементФормы.Вид                  = ВидПоляФормы.ПолеВвода;
		ЭлементФормы.ПутьКДанным          = ИмяЭлемента_;
		ЭлементФормы.Заголовок            = "Наша организация"; 
		ЭлементФормы.РедактированиеТекста = Ложь;
		ЭлементФормы.КнопкаВыбора         = Истина;
		ЭлементФормы.КнопкаОчистки        = Истина;
		ЭлементФормы.АвтоМаксимальнаяШирина = Ложь;
		ЭлементФормы.РастягиватьПоГоризонтали = Ложь;
		ЭлементФормы.Ширина = 30;
		ЭлементФормы.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Лево;
		ЭлементФормы.УстановитьДействие("НачалоВыбора", "Подключаемый_НастройкиАккаунта_НашаОрганизация_НачалоВыбора");
		ЭлементФормы.УстановитьДействие("Очистка",      "Подключаемый_НастройкиАккаунта_НашаОрганизация_Очистка");
	КонецЕсли;
	
	Возврат ЭлементФормы;
КонецФункции

Функция НастройкиАккаунта_НашаОрганизация_ТекстПодсказки() Экспорт
	Возврат "Организация, от которой будут отправляться ЭПД (в том числе черновики)";	
КонецФункции

Процедура НастройкиАккаунта_НашаОрганизация_ЗаполнитьНаФорме(Форма, Значения = Неопределено) Экспорт
	ИмяРеквизита_ = ESD_ОбщийФункционалКлиентСервер.НастройкиАккаунта_НашаОрганизация_ИмяРеквизита();
	Если Не ESD_ТНОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойство(Форма, ИмяРеквизита_) Тогда
		Возврат;
	КонецЕсли;
	
	Если Значения = Неопределено Тогда
		Значения = ESD_ТНОбщегоНазначенияСервер.НастройкиАккаунта_Загрузить();
	КонецЕсли;
	
	// Из пустой настройки получается пустое описание и пустое представление
	Описание_ = ESD_ОбщийФункционалКлиентСервер.НашаОрганизация_ОписаниеПоРеквизитамВыгрузки(
		Значения.НашаОрганизация);
	Форма[ИмяРеквизита_] = ESD_ОбщийФункционалКлиентСервер.НашаОрганизация_Представление(
		Описание_);
КонецПроцедуры

#КонецОбласти // НашаОрганизация

