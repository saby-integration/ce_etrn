
Процедура ДинСписокДокументов_Основание_Настроить(Список)
	ПараметрыОтбора_ = Список.Параметры.НайтиЗначениеПараметра(
		Новый ПараметрКомпоновкиДанных("Основание_ПараметрыОтбора"));
	Если ПараметрыОтбора_ <> Неопределено Тогда
		Список.Параметры.УстановитьЗначениеПараметра("Основание_ПараметрыОтбора", Ложь);
		Список.Параметры.УстановитьЗначениеПараметра("Основание_Поле", Неопределено);
		
		ПоляОграничения = Новый Массив;
		ПоляОграничения.Добавить("Основание");
		Список.УстановитьОграниченияИспользованияВОтборе(ПоляОграничения);
		Список.УстановитьОграниченияИспользованияВПорядке(ПоляОграничения);
		Список.УстановитьОграниченияИспользованияВГруппировке(ПоляОграничения);
	КонецЕсли;	
КонецПроцедуры

Процедура ДинСписокДокументов_Основание_Заполнить(ДанныеСтроки, Ссылка, ДополнительныеПараметры);
	Если ЗначениеЗаполнено(ДанныеСтроки.ДокументОснование_ОбъектМетаданных)
		И ЗначениеЗаполнено(ДанныеСтроки.ДокументОснование_Идентификатор)
	Тогда
		ДанныеСтроки.Основание = ESD_ТНОбщегоНазначенияСервер.СсылкаНаОбъектОснование(
			ДанныеСтроки.ДокументОснование_ОбъектМетаданных, 
			ДанныеСтроки.ДокументОснование_Идентификатор);
	КонецЕсли;
КонецПроцедуры

