
Функция СлужебнаяИнформация_Комментарий_Инициализация(Форма, ГруппаВладелец, МестоРасположения = Неопределено) Экспорт
	Описание_ = ESD_КомпонентыСервер.Команда_Описание("СлужебнаяИнформация_Комментарий_Открыть", "Служ. информация", ,
		"Подключаемый_СлужебнаяИнформация_Комментарий_Открыть"); 
	Команда_ = ESD_КомпонентыСервер.Команда_Создать(Форма, ГруппаВладелец, Описание_); 
	
	Если МестоРасположения <> Неопределено Тогда
		Форма.Элементы.Переместить(Команда_, ГруппаВладелец, МестоРасположения);	
	КонецЕсли;
	
	Возврат Команда_;
КонецФункции

