
Процедура ОбщиеКоманды_Создать(Форма, ГруппаВладелец = Неопределено) Экспорт
	ОбщиеКоманды_ОтображениеПолей1С_Создать(Форма, ГруппаВладелец);					
КонецПроцедуры

Функция ОбщиеКоманды_ОтображениеПолей1С_Создать(Форма, Знач ГруппаВладелец = Неопределено) Экспорт
	Если ГруппаВладелец = Неопределено Тогда
		ГруппаВладелец = Форма.КоманднаяПанель;
	КонецЕсли;
	
	ИмяКоманды_ = ESD_ОбщийФункционалКлиентСервер.ОбщаяКоманда_ИзменитьВидимостьПолей1С_ИмяКоманды();
	
	ЭлементФормы_ = Форма.Элементы.Найти(ИмяКоманды_);
	Если ЭлементФормы_ <> Неопределено Тогда
		Возврат ЭлементФормы_;
	КонецЕсли;
	
	КомандаФормы_ = Форма.Команды.Добавить(ИмяКоманды_);
	КомандаФормы_.Заголовок = "Отображать поля 1С";
	КомандаФормы_.Действие = "Подключаемый_ИзменитьОтображениеПолей1С";
	
	ЭлементФормы_ = Форма.Элементы.Добавить(ИмяКоманды_, Тип("КнопкаФормы"), ГруппаВладелец);
	ЭлементФормы_.Заголовок = КомандаФормы_.Заголовок;
	ЭлементФормы_.ИмяКоманды = ИмяКоманды_;
	
	ЭлементФормы_.Пометка = Истина;
	
	Возврат ЭлементФормы_;
КонецФункции

