
// Добавляет на форму документа реквизиты, команды и элементы работы с документом-основанием.
//
// Параметры:
//	Форма - ФормаКлиентскогоПриложения - форма документа ESD
//	ГруппаВладелец - ГруппаФормы - группа формы для элементов документа-основания
//
Процедура ДокументОснование_Инициализация(Форма, ГруппаВладелец) Экспорт
	ДокументОснование_РеквизитыФормы_Создать(Форма);
	ДокументОснование_РеквизитыФормы_Заполнить(Форма);
	
	ДокументОснование_Команды_Создать(Форма, ГруппаВладелец);
КонецПроцедуры

// Заполняет реквизит ДокументОснование по объекту и настраивает видимость и доступность элементов
//
// Параметры:
//	Форма - ФормаКлиентскогоПриложения - форма документа ESD, см. ДокументОснование_Инициализация
//
Процедура ДокументОснование_НастроитьЭлементыФормы(Форма) Экспорт
	ОбъектФормы_ = ESD_ТНОбщегоНазначенияКлиентСервер.ФормаОбъект(Форма);

	ОснованиеЗаполнено_ = ЗначениеЗаполнено(ОбъектФормы_.ДокументОснование_Идентификатор);
	Если ОснованиеЗаполнено_ Тогда
		Форма.ДокументОснование = ESD_ТНОбщегоНазначенияСервер.СсылкаНаОбъектОснование(
			ОбъектФормы_.ДокументОснование_ОбъектМетаданных, ОбъектФормы_.ДокументОснование_Идентификатор);
		Форма.Элементы.ДекорацияДокументОснование.Заголовок = СокрЛП(Форма.ДокументОснование);
	Иначе
		Форма.ДокументОснование = Неопределено;
		Форма.Элементы.ДекорацияДокументОснование.Заголовок = "Выбрать документ основание";
	КонецЕсли;
	
	Форма.Элементы.НастройкаДокументовОснований.Видимость    = Ложь;
	
	Попытка
		Редактирование_ = Форма.Подключаемый_ДокументОснование_РедактированиеДоступноНаСервере();
	Исключение
		Редактирование_ = Не Форма.ТолькоПросмотр;
	КонецПопытки;
		
	Форма.Элементы.ГруппаДокументОснование.Видимость         = Редактирование_ Или ОснованиеЗаполнено_;
	Форма.Элементы.ГруппаКомандыДокументаОснования.Видимость = Редактирование_;
	Форма.Элементы.ОчиститьДокументОснование.Видимость       = Редактирование_ И ОснованиеЗаполнено_;
	Форма.Элементы.ОткрытьФормуЗаполнения.Видимость          = ОснованиеЗаполнено_;
КонецПроцедуры 

// Создает новые реквизиты формы под функционал
//
// Параметры:
//	Форма - ФормаКлиентскогоПриложения - форма
//
Процедура ДокументОснование_РеквизитыФормы_Создать(Форма) Экспорт
	ДобавляемыеРеквизиты_ = Новый Массив;
	
	ОписаниеРеквизита_ = СлужебныеРеквизитыФормы_ОписаниеРеквизита("ДокументОснование", 
		Новый ОписаниеТипов);
	РеквизитыФормы_Добавить(ДобавляемыеРеквизиты_, Форма, ОписаниеРеквизита_);
	
	ОписаниеРеквизита_ = СлужебныеРеквизитыФормы_ОписаниеРеквизита("ДокументОснование_РедактированиеДоступно", 
		Новый ОписаниеТипов("Булево"));	
	РеквизитыФормы_Добавить(ДобавляемыеРеквизиты_, Форма, ОписаниеРеквизита_);
	
	ОписаниеРеквизита_ = ДокументОснование_РеквизитФормы_ПараметрыЗаполнения();
	РеквизитыФормы_Добавить(ДобавляемыеРеквизиты_, Форма, ОписаниеРеквизита_);

	Если ДобавляемыеРеквизиты_.Количество() Тогда
		Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты_);
	КонецЕсли;
КонецПроцедуры

// Загружает в служебные реквизиты документа-основания источники предыдущего заполнения.
//
// Параметры:
//	Форма - ФормаКлиентскогоПриложения - форма документа ESD
//
Процедура ДокументОснование_РеквизитыФормы_Заполнить(Форма) Экспорт
	// Первичное заполнение из РС
	ИмяРеквизита_ = ESD_ОбщийФункционалКлиентСервер.ДокументОснование_ПараметрыЗаполнения_ИмяРеквизитаФормы();
	Если Не Форма[ИмяРеквизита_].Количество() Тогда
		Ссылка_ = ESD_ТНОбщегоНазначенияКлиентСервер.ФормаОбъект(Форма).Ссылка;
		Если ЗначениеЗаполнено(Ссылка_) Тогда
			ДанныеЗаполнения_ = ESD_НастройкиСопоставленийСервер.ДанныеЗаполненияНаОсновании(Ссылка_);
			ESD_ОбщийФункционалКлиентСервер.ДокументОснование_ПараметрыЗаполнения_Заполнить(Форма, ДанныеЗаполнения_);
		КонецЕсли;	
	КонецЕсли;
	
	Попытка
		Форма.ДокументОснование_РедактированиеДоступно = 
			Форма.Подключаемый_ДокументОснование_РедактированиеДоступноНаСервере();
	Исключение
		Форма.ДокументОснование_РедактированиеДоступно = Не Форма.ТолькоПросмотр;
	КонецПопытки;
КонецПроцедуры

// Передает объекту источники заполнения документа на основании для записи связи с основанием
//
// Параметры:
//	Форма - ФормаКлиентскогоПриложения - форма документа ESD, см. ДокументОснование_Инициализация
//	ТекущийОбъект - ДокументОбъект - записываемый объект ESD
//
Процедура ДокументОснование_ПередЗаписьюНаСервере(Форма, ТекущийОбъект) Экспорт
	ТаблицаИсточников_ = Форма[ESD_ОбщийФункционалКлиентСервер.ДокументОснование_ПараметрыЗаполнения_ИмяРеквизитаФормы()];
	// Без источников в таблице связь основания запишется по реквизитам основания объекта
	Если ТаблицаИсточников_.Количество() <> 0 Тогда
		ПараметрыЗаполнения_ = ESD_ОбщийФункционалКлиентСервер.ДокументОснование_ПараметрыЗаполнения_Выгрузить(Форма,
			ТекущийОбъект.Метаданные().ПолноеИмя());
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ПараметрыЗаполнения", ПараметрыЗаполнения_);
	КонецЕсли;	
КонецПроцедуры  

