
Функция НастройкиАккаунтов_Загрузить() Экспорт
	РезультатФункции = ESD_ЗагрузитьНастройкиОбъекта(НастройкиАккаунтов_Ключ());
	Если ТипЗнч(РезультатФункции) <> Тип("Соответствие") Тогда
		РезультатФункции = НастройкиАккаунтов_СтруктураОбъекта();
	КонецЕсли;

	Возврат РезультатФункции;
КонецФункции 

Функция НастройкиАккаунта_Загрузить(Знач Аккаунт = Неопределено) Экспорт
	РезультатФункции = НастройкиАккаунта_СтруктураОбъекта();

	Если Не ЗначениеЗаполнено(Аккаунт) Тогда
		Аккаунт = АвторизованныйАккаунтСтрокой();
		Если Не ЗначениеЗаполнено(Аккаунт) Тогда
			Возврат РезультатФункции;
		КонецЕсли;
	КонецЕсли;
	
	СохраненныеНастройки_ = НастройкиАккаунтов_Загрузить().Получить(Аккаунт);
	Если ТипЗнч(СохраненныеНастройки_) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(РезультатФункции, СохраненныеНастройки_);
	КонецЕсли;

	Возврат РезультатФункции;
КонецФункции

Процедура НастройкиАккаунтов_Сохранить(НовыеЗначения) Экспорт
	ESD_СохранитьНастройкиОбъекта(НастройкиАккаунтов_Ключ(), НовыеЗначения);
КонецПроцедуры

Процедура НастройкиАккаунта_Сохранить(НовыеЗначения, Знач Аккаунт = Неопределено) Экспорт
	Если Не ЗначениеЗаполнено(Аккаунт) Тогда
		Аккаунт = АвторизованныйАккаунтСтрокой();
		Если Не ЗначениеЗаполнено(Аккаунт) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ТекущиеНастройки_ = НастройкиАккаунта_Загрузить(Аккаунт);
	ЗаполнитьЗначенияСвойств(ТекущиеНастройки_, НовыеЗначения);

	НастройкиАккаунтов_ = НастройкиАккаунтов_Загрузить();
	НастройкиАккаунтов_.Вставить(Аккаунт, ТекущиеНастройки_);
	НастройкиАккаунтов_Сохранить(НастройкиАккаунтов_);
КонецПроцедуры

Функция НастройкиАккаунта_НашаОрганизация_Загрузить(Аккаунт = Неопределено) Экспорт
	Возврат НастройкиАккаунта_Загрузить(Аккаунт).НашаОрганизация;
КонецФункции

Процедура НастройкиАккаунта_НашаОрганизация_Сохранить(Значение, Аккаунт = Неопределено) Экспорт
	НовыеЗначения_ = Новый Структура("НашаОрганизация", Значение);
	НастройкиАккаунта_Сохранить(НовыеЗначения_, Аккаунт);
КонецПроцедуры

