
Функция НастройкиЭПД_СтруктураОбъекта()
	РезультатФункции = Новый Структура;
	
	НастройкиЭЗЗ_ = НастройкиЭЗЗ_СтруктураОбъекта();
	РезультатФункции.Вставить("ЭЗЗ", НастройкиЭЗЗ_);
	
	Возврат РезультатФункции;
КонецФункции

