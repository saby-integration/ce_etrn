КонецФункции

// Возвращает структуру версии продукта
//
// Параметры:
//  ПереданнаяВерсия - Строка - версия полученная не из кофигурации для разбора.
//
// Возвращаемое значение:
//   Структура - все составные части версии
//
Функция ВерсияПродукта(ПереданнаяВерсия = "") Экспорт
	
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("Наименование",   "");
	РезультатФункции.Вставить("ГодВыпуска",     "");
	РезультатФункции.Вставить("ВерсияПродукта", "");
	РезультатФункции.Вставить("ВерсияСборки",   "");
	РезультатФункции.Вставить("Релиз",          "");
	
	Если ЗначениеЗаполнено(ПереданнаяВерсия) Тогда
		Версия = ПереданнаяВерсия;
	Иначе
		ОбъектОбработки = ОбъектОбработки();
		ОбщиеНастройки = ОбъектОбработки.ОбщиеНастройкиПрочитать();
		Версия = ОбщиеНастройки["VersionInfo"];
	КонецЕсли;
	
	ПозицияРазделителя = СтрДлина(Версия);
	ТекущийСимвол = Сред(Версия, ПозицияРазделителя, 1);
	Пока ПозицияРазделителя > 0 И ТекущийСимвол <> "_" Цикл
		ПозицияРазделителя = ПозицияРазделителя - 1;
		ТекущийСимвол = Сред(Версия, ПозицияРазделителя, 1);
	КонецЦикла;
	
	Если ПозицияРазделителя <> 0 Тогда
		РезультатФункции.Наименование = Лев(Версия, ПозицияРазделителя - 1);
	КонецЕсли;
	
	ЦифроваяВерсия = Сред(Версия, ПозицияРазделителя + 1);
	СоставляющиеВерсии = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрРазделитьЭПД(ЦифроваяВерсия, ".");
	
	ИндексГода           = 0;
	ИндексВерсииПродукта = 1;
	ИндексВерсииСборки   = 2;
	РезультатФункции.ГодВыпуска     = СоставляющиеВерсии[ИндексГода];
	РезультатФункции.ВерсияПродукта = СоставляющиеВерсии[ИндексВерсииПродукта];
	РезультатФункции.ВерсияСборки   = СоставляющиеВерсии[ИндексВерсииСборки];
	
	РезультатФункции.Релиз = РезультатФункции.ГодВыпуска + "." + РезультатФункции.ВерсияПродукта;
	
	Возврат РезультатФункции;
	
КонецФункции

