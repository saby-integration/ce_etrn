Процедура ОставитьТолькоДоступныеПоляПоЭтапу(РезультатРасчетаПолей, ДоступныеПоля) Экспорт
	
	Если ДоступныеПоля.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПоляДляУдаления = Новый Массив;
	Для Каждого КлючЗначение Из РезультатРасчетаПолей Цикл
		Если ДоступныеПоля[КлючЗначение.Ключ] = Неопределено Тогда
			ПоляДляУдаления.Добавить(КлючЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ИмяПоля Из ПоляДляУдаления Цикл
		РезультатРасчетаПолей.Удалить(ИмяПоля);
	КонецЦикла;
	
	РезультатРасчетаПолей.Вставить("ДоступныеПоля", ДоступныеПоля);
	
КонецПроцедуры

#КонецОбласти // ЗаполнениеНаОснованииИспользуяНастройкиСопоставления

// Расчет ссылки на скачивание универсального расширения
// с учетом расширение это или конфигурация
// 
// Параметры:
// 	ИсходнаяСсылка - Строка - исходная ссылка из ядра
// 
// Возвращаемое значение:
// 	Строка - ссылка на скачивание ESD с учетом продукта 
// 
Функция СсылкаНаСкачиваниеУниверсальногоРасширения(ИсходнаяСсылка) Экспорт
	
	СсылкаНаСкачивание = "";
	Если Не ЗначениеЗаполнено(ИсходнаяСсылка) Тогда
		Возврат СсылкаНаСкачивание;
	КонецЕсли;
		
	// в CF нет функциональных опций	
	Если ЭтоCF() Тогда
		ФайлПродукта = "ESD_CF.cf";
	Иначе
		ФайлПродукта = "ESD.cfe";
	КонецЕсли;
	
	СсылкаПоЧастям = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрРазделитьЭПД(ИсходнаяСсылка, "/");
	Если СсылкаПоЧастям.Количество() Тогда
		
		ПоследняяЧасть = СсылкаПоЧастям[СсылкаПоЧастям.ВГраница()];
		СсылкаПоЧастям.Удалить(СсылкаПоЧастям.ВГраница());
		Если СсылкаПоЧастям.Найти(ПоследняяЧасть) = Неопределено Тогда
			СсылкаПоЧастям.Добавить(ПоследняяЧасть);
		КонецЕсли;

		СсылкаПоЧастям.Добавить(ФайлПродукта);
		СсылкаНаСкачивание = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрСоединитьЭПД(СсылкаПоЧастям, "/");
		
	Иначе
		СсылкаНаСкачивание = ИсходнаяСсылка;
	КонецЕсли;	
	
	Возврат СсылкаНаСкачивание;
	
КонецФункции

Процедура ESD_УстановитьНомерДокумента(ОбъектДокумента) Экспорт
	
	Если Не ЗначениеЗаполнено(ОбъектДокумента.Номер) Тогда
		ОбъектДокумента.УстановитьНовыйНомер();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ОбъектДокумента.НомерСбис) Тогда
		ОбъектДокумента.НомерСбис = ОбъектДокумента.Номер;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПоляПредставления(Поля) Экспорт
	
	Поля.Добавить("Дата");
	Поля.Добавить("Номер");
	Поля.Добавить("НомерСбис");
	Поля.Добавить("Ссылка");
	
КонецПроцедуры

Функция ПредставлениеДокумента(Данные) Экспорт
	
	РезультатФункции = "%1 %2 от %3";
	
	Номер = СокрЛП(Данные.НомерСбис);
	Если Не ЗначениеЗаполнено(Номер) Тогда
		Номер = СокрЛП(Данные.Номер);
	КонецЕсли;
	
	РезультатФункции = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрШаблонЭПД(
		РезультатФункции, Данные.Ссылка.Метаданные().Синоним, Номер, Формат(Данные.Дата));
		
	Возврат РезультатФункции;
		
КонецФункции

Процедура ОбновитьНастройкиДоТекущегоРелиза() Экспорт
	
	Если ЭтоУниверсальноеРасширение() Тогда
		Обработки.ESD_ВерсииНастроекСопоставлений.ОбновитьНастройкиДоТекущегоРелиза();
	КонецЕсли;
	
КонецПроцедуры

Функция ЭтоCF() Экспорт
	
	// Для старых конфигураций работающих на CF	
	ИмяОбработки = "ESD_РабочийСтол";	
	Возврат Метаданные.Обработки.Найти(ИмяОбработки) <> Неопределено;
	
КонецФункции

Функция РезультатСозданияДокументов(МассивДокументов, ТипДокумента) Экспорт
		
	ЗаголовокОперации = "Создание документов";
	
	ОбщееКоличество = МассивДокументов.Количество();
	НомерДокумента  = 0;
	Прогресс        = 0;
	СтоПроцентов    = 100;
	
	СтатусыДокументов_ = Новый Соответствие;
	Для Каждого Ссылка Из МассивДокументов Цикл
				
		НомерДокумента = НомерДокумента + 1;
		Статус         = 3; // ошибка
		ТекстОшибки    = "";
		
		ТекстСообщения = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрШаблонЭПД(
			"Документ %1 из %2 ", НомерДокумента, ОбщееКоличество);
		
		МодульКода("ESD_ДлительныеОперации").ЗаписатьПрогрессДлительнойОперации(
			ЗаголовокОперации, ТекстСообщения, Прогресс);
			
		НачатьТранзакцию();
			
		Попытка
			
			ПараметрыВыгрузки = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ПараметрыВыгрузки(Ссылка);
			ПараметрыВыгрузки.ИмяМетаданных = ТипДокумента;
			
			НовыйЗаполненныйДокументЭПД(ПараметрыВыгрузки);
			Статус = 1; // успешно
			
			ЗафиксироватьТранзакцию();
			
		Исключение

		    ОтменитьТранзакцию();
			ТекстОшибки = "Не удалось создать документ на основании : " + СокрЛП(Ссылка);
		
		КонецПопытки;
				
		Данные = Новый Структура();
		Данные.Вставить("Статус", Статус);
		Данные.Вставить("Ошибка", ТекстОшибки);
		
		СтатусыДокументов_.Вставить(Ссылка, Данные);
						
		Прогресс = Окр(НомерДокумента * СтоПроцентов / ОбщееКоличество, 0, РежимОкругления.Окр15как20);
		
	КонецЦикла;
	
	// финальное состояние
	МодульКода("ESD_ДлительныеОперации").ЗаписатьПрогрессДлительнойОперации(
			ЗаголовокОперации,
			"Создание завершено",
			СтоПроцентов);
	
	Возврат СтатусыДокументов_;
	
КонецФункции

Функция СсылкаНаОбъектОснование(ОбъектМетаданных, Идентификатор) Экспорт
	
	Если Не ЗначениеЗаполнено(ОбъектМетаданных)
		Или Не ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	Если Метаданные.Документы.Найти(ОбъектМетаданных) <> Неопределено Тогда
		Менеджер = Документы[ОбъектМетаданных];
	Иначе
		Менеджер = Справочники[ОбъектМетаданных];
	КонецЕсли;
	
	Возврат Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
	
КонецФункции

Функция ОписаниеТипаСсылки(СсылкаНаОбъект) Экспорт
	
	Если ТипЗнч(СсылкаНаОбъект) = Тип("Строка") Тогда
		ИмяТипа = СсылкаНаОбъект;
	Иначе
		ИмяТипа = СсылкаНаОбъект.Метаданные().ПолноеИмя();
	КонецЕсли;
	
	ИмяТипа = СтрЗаменить(ИмяТипа, "Справочник", "СправочникСсылка");
	ИмяТипа = СтрЗаменить(ИмяТипа, "Документ", "ДокументСсылка");
	
	Возврат Новый ОписаниеТипов(ИмяТипа);
	
КонецФункции

Функция ПолныеДанныеСсылкиИзБД(Ссылка) Экспорт
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	МетаданныеСсылки = Ссылка.Метаданные();
	ОписаниеРеквизитов = ОписаниеРеквизитовПоСсылке(МетаданныеСсылки);
	ОписаниеРеквизитов.Вставить("ПолноеИмяМетаданных", МетаданныеСсылки.ПолноеИмя());
	
	ТекстЗапроса = ТекстЗапросаДанныхСсылкиИзБД(ОписаниеРеквизитов);
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СписокСсылок", Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	Возврат РезультатЗапросаДанныхИзБД(Выборка, ОписаниеРеквизитов);	
КонецФункции

Функция ПолныеДанныеСсылокИзБД(СписокСсылок) Экспорт
	Результат = Новый Соответствие;
	
	Если Не ЗначениеЗаполнено(СписокСсылок) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОписанияРеквизитов = Новый Структура;
	Для Каждого Ссылка Из СписокСсылок Цикл
		МетаданныеСсылки = Ссылка.Метаданные();
		ПолноеИмяМетаданных = МетаданныеСсылки.ПолноеИмя();
		ПредставлениеИмениМетаданных = СтрЗаменить(ПолноеИмяМетаданных, ".", "");
		Если ОписанияРеквизитов.Свойство(ПредставлениеИмениМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеРеквизитов = ОписаниеРеквизитовПоСсылке(МетаданныеСсылки);
		ОписаниеРеквизитов.Вставить("ПолноеИмяМетаданных", ПолноеИмяМетаданных);
		ОписанияРеквизитов.Вставить(ПредставлениеИмениМетаданных, ОписаниеРеквизитов); 
	КонецЦикла;
	
	ТекстЗапроса = ТекстЗапросаДанныхСсылокИзБД(ОписанияРеквизитов);
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СписокСсылок", СписокСсылок);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	i = 0;
	Для Каждого КлючЗначение Из ОписанияРеквизитов Цикл
		Выборка = РезультатЗапроса[i].Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(Выборка.Ссылка, РезультатЗапросаДанныхИзБД(Выборка, КлючЗначение.Значение));		
		КонецЦикла;
		i = i + 1;	
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

