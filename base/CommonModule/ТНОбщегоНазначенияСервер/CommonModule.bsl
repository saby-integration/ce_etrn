КонецФункции

Функция ОписаниеКонфигурации(Ключ, Версия)
	
	Имя           = ИменаКонфигураций()[Ключ];
	Представление = ПредставленияКонфигураций()[Ключ];
		
	Описание = Новый Структура;
	Описание.Вставить("Имя",           Имя);
	Описание.Вставить("Представление", Представление);
	Описание.Вставить("Версия",        Версия);
	
	Возврат Описание;
	
КонецФункции

Функция ВерсияПоддержана(МинимальнаяВерсия, ВерсияКонфигурации)
	
	Модуль_ESDКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	
	МинимальнаяПоЧастям = Модуль_ESDКлиентСервер.СтрРазделитьЭПД(МинимальнаяВерсия,  ".");
	ВерсияПоЧастям      = Модуль_ESDКлиентСервер.СтрРазделитьЭПД(ВерсияКонфигурации, ".");
		
	ИндексЧасти = 0;
	Поддержана  = Истина;
	
	Для Каждого ЧастьРелиза Из МинимальнаяПоЧастям Цикл
		
		Если ЧастьРелиза > ВерсияПоЧастям[ИндексЧасти] Тогда 
		  Поддержана = Ложь;
		  Прервать;
		КонецЕсли;
		
		ИндексЧасти = ИндексЧасти + 1;
		
	КонецЦикла;
	
	Возврат Поддержана;
	
КонецФункции

#КонецОбласти // ПоддержаныеКонфигурации

Функция НовыйЗаполненныйДокументЭПД(ПараметрыВыгрузки, ОбъектДокумента = Неопределено, Результат = Неопределено) Экспорт
	
	Модуль_ESDСервер = МодульКода("ESD_ТНОбщегоНазначенияСервер");
	
	МассивОснованийДляЗаполнения = Модуль_ESDСервер.ДанныеОснованийДляЗаполненияНаОснованииINI(ПараметрыВыгрузки.Ссылка);
	
	МассивОснований = Новый Массив;
	Для Каждого СтруктураОснования Из МассивОснованийДляЗаполнения Цикл
		МассивОснований.Добавить(СтруктураОснования.Основание);
	КонецЦикла;
	
	ОбъектЗаполнения = ОбъектДокумента;
	Если ОбъектЗаполнения = Неопределено Тогда
		ОбъектЗаполнения = ОбъектДокумента(ПараметрыВыгрузки, Истина);
	КонецЕсли;
	
	Если Не РезультатФункцииТитулов(ПараметрыВыгрузки.ИмяМетаданных, "ЭтоПервыйТитул", ПараметрыВыгрузки.ТипТитула)
		И ПараметрыВыгрузки.ИмяМетаданных <> ПутевойЛист() И ПараметрыВыгрузки.ИмяМетаданных <> ТранспортнаяНакладная() Тогда
		Возврат ОбъектЗаполнения.Ссылка;
	КонецЕсли;
		
	ТекстОшибки = "Ошибка заполнения документа через ";
	НужноОбработатьОшибкуЗаполненияДокумента = Ложь;
	Если ЭтоУниверсальноеРасширение() Тогда
		СтруктураЗаполнения = СтруктураЗаполненияНаОснованииНовогоРедактора(МассивОснований);
		СтруктураЗаполнения.Вставить("ТипТитула", ПараметрыВыгрузки.ТипТитула);
		
		ОбъектЗаполнения.Заполнить(СтруктураЗаполнения);
		НужноОбработатьОшибкуЗаполненияДокумента = ОбъектЗаполнения.ДополнительныеСвойства.Свойство("ОшибкаСопоставления");
		ТекстОшибки = ТекстОшибки + "сопоставление";	
	Иначе	
		ПредставленияТитула = РезультатФункцииТитулов(
			ПараметрыВыгрузки.ИмяМетаданных, "ПредставленияТитула", ПараметрыВыгрузки.ТипТитула);
		
		// заполнение через ини
		ПараметрыИНИ = Модуль_ESDСервер.ПараметрыЗаполненияПоИНИ(ОбъектЗаполнения, ПараметрыВыгрузки.ИмяМетаданных);
		ПараметрыИНИ.Модуль                   = МодульКода("ESD_ТНОбщегоНазначенияСервер");
		ПараметрыИНИ.ДокументОснование        = ПараметрыВыгрузки.Ссылка;
		ПараметрыИНИ.ПараметрыЗаполнения.Этап = ПредставленияТитула.Представление;
	
		РезультатФункции = Модуль_ESDСервер.ЗаполнитьОбъектПоОснованиямИНИ(ПараметрыИНИ);
		НужноОбработатьОшибкуЗаполненияДокумента = РезультатФункции.Ошибка;
		ТекстОшибки = ТекстОшибки + "ini";	
	КонецЕсли;
	
	ОбъектЗаполнения.ДокументОснование_Идентификатор    = ПараметрыВыгрузки.Ссылка.УникальныйИдентификатор();
	ОбъектЗаполнения.ДокументОснование_ОбъектМетаданных = Модуль_ESDСервер.ИмяМетаданныхДокумента(ПараметрыВыгрузки.Ссылка);
	
	Если ОбъектЗаполнения.ДополнительныеСвойства.Свойство("ЗначенияПоУмолчанию") Тогда
		ЗаполнитьЗначенияСвойств(ОбъектЗаполнения, ОбъектЗаполнения.ДополнительныеСвойства.ЗначенияПоУмолчанию);
	КонецЕсли;
	
	ОбъектЗаполнения.Записать();
	
	Если НужноОбработатьОшибкуЗаполненияДокумента Тогда 
		ОбработатьОшибкуЗаполненияДокумента(ОбъектЗаполнения, ПараметрыВыгрузки, ТекстОшибки, Результат);
	КонецЕсли;
	
	Возврат ОбъектЗаполнения.Ссылка;
	
КонецФункции

Процедура ОбработатьОшибкуЗаполненияДокумента(ОбъектЗаполнения, ПараметрыВыгрузки, ТекстОшибки, Результат = Неопределено)
	
	Если Результат = Неопределено Тогда
		ВызватьИсключение ТекстОшибки;
	Иначе
		Ошибки = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтруктураОшибок(ПараметрыВыгрузки.ИмяМетаданных);
		Ошибки = ВыполнитьНаСервере("ESD_ТНОбщегоНазначенияСервер.ДобавитьОшибкуПользователю", Ошибки, Неопределено, ТекстОшибки);
		КлючСоответствия = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").КлючСсылка(ОбъектЗаполнения.Ссылка);
		Результат.Ошибки.Вставить(КлючСоответствия, Ошибки);
		Если ОбъектЗаполнения.ДополнительныеСвойства.Свойство("ОшибкаСопоставления") Тогда
			Результат.ОшибкаСопоставления = ОбъектЗаполнения.ДополнительныеСвойства.ОшибкаСопоставления;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ОбъектДокумента(ПараметрыВыгрузки, ВыполнитьЗаполнениеПоУмолчанию = Ложь) Экспорт
	
	ЗапросДанных = Новый Запрос;
	ЗапросДанных.Текст =
	"ВЫБРАТЬ
	|	ESD_ТранспортнаяНакладная.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ESD_ТранспортнаяНакладная КАК ESD_ТранспортнаяНакладная
	|ГДЕ
	|	НЕ ESD_ТранспортнаяНакладная.ПометкаУдаления
	|	И ESD_ТранспортнаяНакладная.ДокументОснование_ОбъектМетаданных = &ДокументОснование_ОбъектМетаданных
	|	И ESD_ТранспортнаяНакладная.ДокументОснование_Идентификатор = &ДокументОснование_Идентификатор
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка";
	
	ЗапросДанных.Текст = СтрЗаменить(ЗапросДанных.Текст, "ESD_ТранспортнаяНакладная", ПараметрыВыгрузки.ИмяМетаданных);
	
	ЗапросДанных.УстановитьПараметр("ДокументОснование_ОбъектМетаданных", ПараметрыВыгрузки.Ссылка.Метаданные().Имя);
	ЗапросДанных.УстановитьПараметр(
		"ДокументОснование_Идентификатор", Строка(ПараметрыВыгрузки.Ссылка.УникальныйИдентификатор()));
	
	ВыборкаДанных = ЗапросДанных.Выполнить().Выбрать();
	
	ДанныеСостояния = Неопределено;
	Если ВыборкаДанных.Количество() = 0 Тогда
		ДанныеСостояния = МодульКода("ESD_ТНОбщегоНазначенияСервер").ДанныеСостоянияОбъекта(
			ПараметрыВыгрузки.Ссылка, ПараметрыВыгрузки.ИмяМетаданных, Ложь);
	КонецЕсли;
	
	Если ВыборкаДанных.Следующий() Тогда
		РезультатФункции = ВыборкаДанных.Ссылка.ПолучитьОбъект();
		Если ПараметрыВыгрузки.ЗаменаВодителя Тогда
			РезультатФункции = ДокументЗаменыВодителя(ПараметрыВыгрузки, РезультатФункции);
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(ДанныеСостояния) И ЗначениеЗаполнено(ДанныеСостояния.Ссылка) Тогда
		РезультатФункции = ДанныеСостояния.Ссылка.ПолучитьОбъект();
	Иначе
		РезультатФункции = Документы[ПараметрыВыгрузки.ИмяМетаданных].СоздатьДокумент();
		Если ВыполнитьЗаполнениеПоУмолчанию Тогда
			РезультатФункции.Заполнить(Неопределено);
		КонецЕсли;
		РезультатФункции.УстановитьНовыйНомер();
		РезультатФункции.Дата = ТекущаяДатаСеанса();
		РезультатФункции.Направление = ЗначениеМетаданных("ESD_Направление.Исходящий");
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ДокументЗаменыВодителя(ПараметрыВыгрузки, ТекущийДокументЭПЛ)
	
	Модуль_ESDСервер = МодульКода("ESD_ТНОбщегоНазначенияСервер");
	
	РезультатФункции = Документы[ПараметрыВыгрузки.ИмяМетаданных].СоздатьДокумент();
	РезультатФункции.УстановитьНовыйНомер();
	РезультатФункции.Дата = ТекущаяДатаСеанса();
	РезультатФункции.Направление = ЗначениеМетаданных("ESD_Направление.Исходящий");
	
	Если Не РезультатФункции.ДополнительныеСвойства.Свойство("ЗначенияПоУмолчанию") Тогда
		РезультатФункции.ДополнительныеСвойства.Вставить("ЗначенияПоУмолчанию", Новый Структура);
	КонецЕсли;
	
	ДанныеСостояния = ДанныеСостоянияОбъекта(ТекущийДокументЭПЛ.Ссылка, ПараметрыВыгрузки.ИмяМетаданных);
	
	РезультатФункции.ДополнительныеСвойства.ЗначенияПоУмолчанию.Вставить("ПЛПредыдущий", ДанныеСостояния.ИД);
	РезультатФункции.ДополнительныеСвойства.ЗначенияПоУмолчанию.Вставить(
		"ПризнакНачалаРейса", ЗначениеМетаданных("ESD_ПризнакНачалаРейса.ПриемСдачаПослеСмены"));
	
	Модуль_ESDСервер.УдалитьСвязьОбъекта(ТекущийДокументЭПЛ.Ссылка, ПараметрыВыгрузки.ИмяМетаданных);
	
	ТипТитула = РезультатФункцииТитулов(ПараметрыВыгрузки.ИмяМетаданных, "ПервыйТитул");
	ПредставленияТитула = РезультатФункцииТитулов(ПараметрыВыгрузки.ИмяМетаданных, "ПредставленияТитула", ТипТитула);
	
	ПараметрыВыгрузки.ТипТитула         = ТипТитула;
	ПараметрыВыгрузки.Этап              = ПредставленияТитула.Представление;
	ПараметрыВыгрузки.КодТитула         = ПредставленияТитула.КодТитула;
	ПараметрыВыгрузки.ИдентификаторСБИС = "";
	
	Возврат РезультатФункции;
	
КонецФункции

