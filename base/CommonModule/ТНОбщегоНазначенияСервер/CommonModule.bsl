Функция АдресКонтрагентаИлиОрганизации(ВидИлиТипКИ)
	
	Возврат ВидИлиТипКИ = Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации
		Или ВидИлиТипКИ = Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации
		Или ВидИлиТипКИ = Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента
		Или ВидИлиТипКИ = Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента;
	
КонецФункции

Функция ОписанияОшибок(СписокОшибок)
	
	РезультатФункции = Новый Массив;
	
	Для Каждого СтруктураОшибки Из СписокОшибок Цикл
		
		РезультатФункции.Добавить(СтруктураОшибки.ТекстДляОднойОшибки);
		
	КонецЦикла;
	
	Возврат РезультатФункции;
	
КонецФункции

Процедура ЗаполнитьТаблицуЗначений(Форма, ДанныеЗаполнения, РеквизитФормы, ЗначениеИсточник)
	
	Форма[РеквизитФормы.Имя].Очистить();
	
	Если Не ЗначениеЗаполнено(ЗначениеИсточник) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеИсточник) = Тип("Массив") Тогда
		Массив = ЗначениеИсточник;
	Иначе
		Массив = ЗначениеИзСтрокиВнутр(ЗначениеИсточник);
	КонецЕсли;
	
	ЗаполнениеКолонок(Форма, РеквизитФормы, Массив);
	
КонецПроцедуры

Процедура ЗаполнениеКолонок(Форма, РеквизитФормы, Массив)
	
	Для Каждого Значение Из Массив Цикл 
		
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Продолжить;
		КонецЕсли;	
		
		НС = Форма[РеквизитФормы.Имя].Добавить();
		
		ЕстьОдноименныйРеквизит = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ЕстьРеквизитИлиСвойство(НС, РеквизитФормы.Имя);
		
		Если ТипЗнч(Значение) = Тип("Строка") Тогда
			
			Если ЕстьОдноименныйРеквизит Тогда 
				ИмяКолонки = РеквизитФормы.Имя;
			Иначе 
				ИмяКолонки = Лев(РеквизитФормы.Имя, СтрДлина(РеквизитФормы.Имя) - 1);
			КонецЕсли;
			
			НС[ИмяКолонки] = Значение;
			
		Иначе
			
			// Структура
			Для Каждого КлючЗначение Из Значение Цикл
				НС[КлючЗначение.Ключ] = КлючЗначение.Значение;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция АктивныйЭтапДокумента(Ссылка) Экспорт
	
	ИндексКартинки = 0;
	АктивныйЭтап   = "";
	
	ДанныеСостояния = ДанныеСостоянияОбъекта(Ссылка);
	Если ДанныеСостояния <> Неопределено Тогда
		
		АктивныйЭтап = ДанныеСостояния.АктивныйЭтап;
		
		Состояние = ДанныеСостояния.Состояние;
		
		Если ТипЗнч(Состояние) = Тип("Структура") Тогда						
			ИндексКартинки = Состояние.ИндексКартинки;			
		ИначеЕсли ЗначениеЗаполнено(Состояние) Тогда									
			ИндексКартинки = МодульКода("ESD_ТНОбщегоНазначенияСервер").ЗначениеРеквизитаОбъекта(Состояние, "ИндексКартинки");			
		Иначе
			ИндексКартинки = 0;
		КонецЕсли;
		
	КонецЕсли;
	
	Структура = Новый Структура;
	Структура.Вставить("АктивныйЭтап",   АктивныйЭтап);
	Структура.Вставить("ИндексКартинки", ИндексКартинки);
	Структура.Вставить("Состояние",      Состояние);
	
	Возврат Структура;
	
КонецФункции

Процедура СгрупироватьГрузПоОснованиям(ОбъектЗаполнения, МассивОснований)
	
	СтруктураПараметров = ПараметрыГруппировки();
	НоваяСтруктура      = Новый Структура;
	СтруктураПараметров.Вставить("ГруппировкаНовымРедактором", Истина);
	
	// проверим нужна ли группировка по общим параметрам
	Если НеГруппироватьГруз(ОбъектЗаполнения, НоваяСтруктура, СтруктураПараметров, НоваяСтруктура) Тогда
		Возврат;
    КонецЕсли;
	
	// сформируем общую таблицу по грузу
	ОбщаяТаблицаГрузов = ОбъектЗаполнения.Грузы.Выгрузить();
	ОбщаяТаблицаГрузов.Очистить();
	
	ОбщаяТаблицаГрузов.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		
	Для Каждого Основание Из МассивОснований Цикл
		
		Грузы = Основание["Грузы"];
		Если Не ЗначениеЗаполнено(Грузы) Тогда
			Продолжить;
		КонецЕсли;	
		
		Для Каждого Груз Из Грузы Цикл			
			СтрокаГруза = ОбщаяТаблицаГрузов.Добавить();
			ЗаполнитьЗначенияИзСоответствия(СтрокаГруза, Груз);			
		КонецЦикла;
					
	КонецЦикла;
	
	// есть позиции для группировки
	Если ОбщаяТаблицаГрузов.Количество() Тогда
		
		// сгруппируем итоговую таблицу	
		ГрузыСвернуто = СвернутаяТаблицаГрузов(ОбщаяТаблицаГрузов, СтруктураПараметров);
		
		// заполним итоги
		ЗаполнитьГрузыОбъектаДокумент(ОбъектЗаполнения, ГрузыСвернуто);
		
	КонецЕсли;		
		
КонецПроцедуры

#Область ЗаполнениеНаОснованииINI

Функция РезультатЗаполненияНаОснованииINI(ПараметрыЗаполнения) Экспорт
	
	Если ПараметрыЗаполнения.НаКлиенте Тогда
		РезультатРасчета = ПараметрыЗаполнения.РезультатРасчетаИНИ;
	Иначе
		РезультатРасчета = МодульКода("ESD_ТНОбщегоНазначенияСервер").РезультатРасчетаINI(ПараметрыЗаполнения, ОбъектОбработки());
	КонецЕсли;
	
	Если РезультатРасчета.Результат.Ошибка Тогда
		Возврат РезультатРасчета.Результат;
	Иначе
		РезультатФункции = РезультатРасчета.Результат;
		ДанныеИзИНИ      = РезультатРасчета.ДанныеИзИНИ;
	КонецЕсли;
	
	МодульКода("Документы." + ПараметрыЗаполнения.ИмяМетаданных).СформироватьНовыеОснования(РезультатФункции, ДанныеИзИНИ);
	МодульКода("Документы." + ПараметрыЗаполнения.ИмяМетаданных).ДополнитьПодстановки(ДанныеИзИНИ, ПараметрыЗаполнения);
	
	ТитулДляЗаполнения = РезультатФункцииТитулов(ПараметрыЗаполнения.ИмяМетаданных, "ПервыйТитул");
	Если ЗначениеЗаполнено(ПараметрыЗаполнения.Этап) Тогда
		ТитулДляЗаполнения = РезультатФункцииТитулов(
			ПараметрыЗаполнения.ИмяМетаданных, "ЗначениеПоПредставлению", ПараметрыЗаполнения.Этап);
	КонецЕсли;
	ПредставленияТитула = РезультатФункцииТитулов(ПараметрыЗаполнения.ИмяМетаданных, "ПредставленияТитула", ТитулДляЗаполнения);
	
	МассивПодстановок = Новый Массив;
	МассивПодстановок.Добавить(ДанныеИзИНИ);
	
	Подстановки = Новый Соответствие;
	ПодстановкаТитула = Новый Соответствие;
	ПодстановкаТитула.Вставить(ПредставленияТитула.ИмяПодстановки, МассивПодстановок);
	Подстановки.Вставить("Подстановки", ПодстановкаТитула);
	
	ПараметрыЗагрузки = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ПараметрыЗагрузки();
	ПараметрыЗагрузки.ДанныеДокумента           = Подстановки;
	
	ПараметрыЗагрузки.ИдСбис                    = Неопределено;
	ПараметрыЗагрузки.ИзДокумента               = Истина;
	ПараметрыЗагрузки.ЭтоЗаполнениеСПомощьюINI  = Истина;
	ПараметрыЗагрузки.ЭтоПервоеОснование        = ПараметрыЗаполнения.ЭтоПервоеОснование;
	ПараметрыЗагрузки.ИмяМетаданных             = ПараметрыЗаполнения.ИмяМетаданных;
	ПараметрыЗагрузки.НоменклатураГруза         = ПараметрыЗаполнения.НоменклатураГруза;
	ПараметрыЗагрузки.КлючСтроки                = ПараметрыЗаполнения.КлючСтроки;
	ПараметрыЗагрузки.СопроводительныеДокументы = ПараметрыЗаполнения.СопроводительныеДокументы;
	
	ПараметрыЗаполненияНаОсновании = Новый Структура;
	ПараметрыЗаполненияНаОсновании.Вставить("РольКонтрагента", ПараметрыЗаполнения.РольКонтрагента);
	ПараметрыЗагрузки.ПараметрыОснования = ПараметрыЗаполненияНаОсновании;
	
	Если ПараметрыЗаполнения.ЭтоВыбранныйДокумент Тогда
		ПараметрыЗагрузки.ДокументОснование      = ПараметрыЗаполнения.Основание;
		Если Не ПараметрыЗагрузки.ИзРасширения Тогда
			ПараметрыЗагрузки.ТипИсточника           = ПараметрыЗаполнения.Основание.Метаданные().ПолноеИмя();
			ПараметрыЗагрузки.ИдентификаторИсточника = Строка(ПараметрыЗаполнения.Основание.УникальныйИдентификатор());
		КонецЕсли;
	КонецЕсли;
	
	Если ПараметрыЗаполнения.Свойство("Объект") Тогда
		ПараметрыЗагрузки.Ссылка = ПараметрыЗаполнения.Объект;
		ПараметрыЗагрузки.Вставить("Объект", ПараметрыЗаполнения.Объект);
	Иначе
		ПараметрыЗагрузки.Ссылка = ПараметрыЗаполнения.Ссылка;
	КонецЕсли;
	
	МодульКода("ESD_ТНЗагрузкаСервер").ЗаписатьДанныеДокумента(ПараметрыЗагрузки);
	
	УстановитьЗапретЗаполнения(ПараметрыЗаполнения);
	
	РезультатФункции.ТекстСообщения = "Заполнение на основании завершено";
	
	Если РезультатФункции.Ошибка Тогда
		ЗаписатьОшибкуВЖурналРегистрации(
			ПараметрыЗаполнения.Ссылка,
			"Заполнение не выполнено",
			РезультатФункции.ТекстСообщения);
	КонецЕсли;
	
	РезультатФункции.Вставить("Ссылка",           ПараметрыЗагрузки.Ссылка);
	РезультатФункции.Вставить("ЗапретЗаполнения", ПараметрыЗаполнения.ЗапретЗаполнения);
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ДанныеОснованийДляЗаполненияНаОснованииINI(ДокументОснование, ПараметрыЗаполнения = Неопределено) Экспорт
	
	ШаблонИмениИНИ = "%1";
	Если ПараметрыЗаполнения <> Неопределено Тогда
		ШаблонИмениИНИ = ПараметрыЗаполнения.ШаблонИмениИНИ;
	КонецЕсли;
	
	ИмяМетаданных = ИмяМетаданныхДокумента(ДокументОснование);
	РезультатФункции = Новый Массив;
	ИмяИНИ = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрШаблонЭПД(ШаблонИмениИНИ, ИмяМетаданных);
	РезультатФункции.Добавить(СтруктураОснования(ДокументОснование, ИмяИНИ));
	
	ДобавитьТранспортнуюНакладную(РезультатФункции, ДокументОснование, ШаблонИмениИНИ);
	
	ДобавитьОснованияПоТранспортнойНакладной(РезультатФункции, ДокументОснование, ШаблонИмениИНИ);
	
	ДобавитьОснованияПоПоручениюЭкспедитору(РезультатФункции, ДокументОснование, ШаблонИмениИНИ);
	
	Возврат РезультатФункции;
	
КонецФункции

Процедура ДобавитьТранспортнуюНакладную(МассивОснований, ДокументОснование, ШаблонИмениINI)
	Если Метаданные.Документы.Найти("ТранспортнаяНакладная") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗапросДанных = Новый Запрос;
	ЗапросДанных.Текст =
	"ВЫБРАТЬ
	|	ТранспортнаяНакладная.Ссылка КАК Ссылка 
	|ИЗ
	|	Документ.ТранспортнаяНакладная КАК ТранспортнаяНакладная
	|ГДЕ
	|	ТранспортнаяНакладная.ЗаданиеНаПеревозку = &ДокументОснование";
	
	ЗапросДанных.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	Попытка
		// BSLLS:SetPrivilegedMode-off
		УстановитьПривилегированныйРежим(Истина);
		// BSLLS:SetPrivilegedMode-on
		ВыборкаДанных = ЗапросДанных.Выполнить().Выбрать();
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		Возврат;
	КонецПопытки;
	
	Если ВыборкаДанных.Следующий() Тогда	
		ИмяИНИ = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрШаблонЭПД(ШаблонИмениINI, "ТранспортнаяНакладная");
		МассивОснований.Добавить(СтруктураОснования(ВыборкаДанных.Ссылка, ИмяИНИ));	
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьОснованияПоТранспортнойНакладной(МассивОснований, ДокументОснование, ШаблонИмениINI)
	Если Метаданные.Документы.Найти("ТранспортнаяНакладная") = Неопределено
		Или ТипЗнч(ДокументОснование) <> Тип("ДокументСсылка.ТранспортнаяНакладная") 
	Тогда
		Возврат;
	КонецЕсли;
	
	ЗапросДанных = Новый Запрос;
	ЗапросДанных.Текст =
	"ВЫБРАТЬ
	|	ТранспортнаяНакладнаяДокументыОснования.ДокументОснование КАК Ссылка
	|ИЗ
	|	Документ.ТранспортнаяНакладная.ДокументыОснования КАК ТранспортнаяНакладнаяДокументыОснования
	|ГДЕ
	|	ТранспортнаяНакладнаяДокументыОснования.Ссылка = &ДокументОснование
	|	И НЕ ТранспортнаяНакладнаяДокументыОснования.Ссылка.ПометкаУдаления";
	ЗапросДанных.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	ОтборОснования = Новый Структура("Основание", ДокументОснование);
	СтрокаОснования = МодульТНОбщегоНазначенияКлиентСервер.НайтиСтрокиУниверсально(
		МассивОснований, ОтборОснования)[0];
	ИндексВставки = МассивОснований.Найти(СтрокаОснования);
	
	Попытка
		// BSLLS:SetPrivilegedMode-off
		УстановитьПривилегированныйРежим(Истина);
		// BSLLS:SetPrivilegedMode-on
		ВыборкаДанных = ЗапросДанных.Выполнить().Выбрать();
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		Возврат;
	КонецПопытки;
	
	Пока ВыборкаДанных.Следующий() Цикл	
		ИмяМетаданных = ИмяМетаданныхДокумента(ВыборкаДанных.Ссылка);	
		ИмяИНИ = МодульТНОбщегоНазначенияКлиентСервер.СтрШаблонЭПД(ШаблонИмениINI, ИмяМетаданных);
		МассивОснований.Вставить(ИндексВставки, СтруктураОснования(ВыборкаДанных.Ссылка, ИмяИНИ));	
	КонецЦикла;
	
	ЗапросДанных = Новый Запрос;
	ЗапросДанных.Текст =
	"ВЫБРАТЬ
	|	ТранспортнаяНакладная.ЗаданиеНаПеревозку КАК ЗаданиеНаПеревозку
	|ИЗ
	|	Документ.ТранспортнаяНакладная КАК ТранспортнаяНакладная
	|ГДЕ
	|	ТранспортнаяНакладная.Ссылка = &ДокументОснование
	|	И ТранспортнаяНакладная.ЗаданиеНаПеревозку <> &ПустаяСсылка";
	
	ДокПустаяСсылка = Документы["ЗаданиеНаПеревозку"].ПустаяСсылка();
	ЗапросДанных.УстановитьПараметр("ДокументОснование", ДокументОснование);
	ЗапросДанных.УстановитьПараметр("ПустаяСсылка",      ДокПустаяСсылка);
	
	Попытка
		// BSLLS:SetPrivilegedMode-off
		УстановитьПривилегированныйРежим(Истина);
		// BSLLS:SetPrivilegedMode-on
		ВыборкаДанных = ЗапросДанных.Выполнить().Выбрать();
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		Возврат;
	КонецПопытки;
	
	Если ВыборкаДанных.Следующий() Тогда
		ИмяИНИ = МодульТНОбщегоНазначенияКлиентСервер.СтрШаблонЭПД(ШаблонИмениINI, "ЗаданиеНаПеревозку");
		МассивОснований.Добавить(СтруктураОснования(ВыборкаДанных.ЗаданиеНаПеревозку, ИмяИНИ));
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьОснованияПоПоручениюЭкспедитору(МассивОснований, ДокументОснование, ШаблонИмениINI)
	Если Метаданные.Документы.Найти("ПоручениеЭкспедитору") = Неопределено
		Или ТипЗнч(ДокументОснование) <> Тип("ДокументСсылка.ПоручениеЭкспедитору") Тогда
		Возврат;
	КонецЕсли;
	
	ЗапросДанных = Новый Запрос;
	ЗапросДанных.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаданиеНаПеревозкуРаспоряжения.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаданиеНаПеревозку.Распоряжения КАК ЗаданиеНаПеревозкуРаспоряжения
	|ГДЕ
	|	ЗаданиеНаПеревозкуРаспоряжения.Распоряжение = &Распоряжение";
	ЗапросДанных.УстановитьПараметр("Распоряжение", ДокументОснование);
	
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	ОтборОснования = Новый Структура("Основание", ДокументОснование);
	СтрокаОснования = МодульТНОбщегоНазначенияКлиентСервер.НайтиСтрокиУниверсально(
		МассивОснований, ОтборОснования)[0];
	ИндексВставки = МассивОснований.Найти(СтрокаОснования);
	
	Попытка
		// BSLLS:SetPrivilegedMode-off
		УстановитьПривилегированныйРежим(Истина);
		// BSLLS:SetPrivilegedMode-on
		ВыборкаДанных = ЗапросДанных.Выполнить().Выбрать();
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		Возврат;
	КонецПопытки;
	
	Если ВыборкаДанных.Следующий() Тогда
		ИмяМетаданных = ИмяМетаданныхДокумента(ВыборкаДанных.Ссылка);
		ИмяИНИ = МодульТНОбщегоНазначенияКлиентСервер.СтрШаблонЭПД(ШаблонИмениINI, ИмяМетаданных);
		СтруктураОснования = СтруктураОснования(ВыборкаДанных.Ссылка, ИмяИНИ);
		МассивОснований.Вставить(ИндексВставки, СтруктураОснования);
	КонецЕсли;
	
	ЗапросДанных = Новый Запрос;
	ЗапросДанных.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПоручениеЭкспедиторуОснования.Основание КАК Основание
	|ИЗ
	|	Документ.ПоручениеЭкспедитору.Основания КАК ПоручениеЭкспедиторуОснования
	|ГДЕ
	|	ПоручениеЭкспедиторуОснования.Ссылка = &Ссылка
	|	И ПоручениеЭкспедиторуОснования.Основание ССЫЛКА Документ.ПриобретениеТоваровУслуг";
	
	ЗапросДанных.УстановитьПараметр("Ссылка", ДокументОснование);
	
	Попытка
		ВыборкаДанных = ЗапросДанных.Выполнить().Выбрать();
		// BSLLS:SetPrivilegedMode-off
		УстановитьПривилегированныйРежим(Истина);
		// BSLLS:SetPrivilegedMode-on
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		Возврат;
	КонецПопытки;
	
	Пока ВыборкаДанных.Следующий() Цикл
		ИмяМетаданных = ИмяМетаданныхДокумента(ВыборкаДанных.Основание);
		ИмяИНИ = МодульТНОбщегоНазначенияКлиентСервер.СтрШаблонЭПД(ШаблонИмениINI, ИмяМетаданных);
		СтруктураОснования = СтруктураОснования(ВыборкаДанных.Основание, ИмяИНИ);
		МассивОснований.Вставить(ИндексВставки, СтруктураОснования);
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьЗапретЗаполнения(ПараметрыЗаполнения)
	
	Если ПараметрыЗаполнения.ИмяМетаданных = ТранспортнаяНакладная() Тогда
		МодульКода("Документы." + ПараметрыЗаполнения.ИмяМетаданных).УстановитьЗапретЗаполненияЭТрН(ПараметрыЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

Функция СвернутьГруз(ОбъектСсылка, ПараметрыЗаполнения, РезультатФункции) Экспорт
	
	НоменклатураГруза   = ПараметрыЗаполнения.НоменклатураГруза;
	СтруктураПараметров = ПараметрыГруппировки();
	КолонкаНоменклатура = "Номенклатура";
	                    
	Если ТипЗнч(ОбъектСсылка) = Тип("Структура") Тогда 
		ОбъектДок = ОбъектСсылка;
		Грузы = МодульКода("ESD_ТНОбщегоНазначенияСервер").МассивВТаблицуЗначений(ОбъектДок.Грузы);
		НоменклатураГруза = Грузы.ВыгрузитьКолонку(КолонкаНоменклатура);
	ИначеЕсли ЭтоСсылка(ОбъектСсылка) Тогда
		ОбъектДок = ОбъектСсылка.ПолучитьОбъект();
	Иначе // Значит пришел объект в переменной "ОбъектСсылка"
		ОбъектДок = ОбъектСсылка;
	КонецЕсли;
	
	Если НеГруппироватьГруз(ОбъектДок, НоменклатураГруза, СтруктураПараметров, РезультатФункции) Тогда
		Возврат РезультатФункции;
	КонецЕсли;
	
	Если ЭтоСсылка(ОбъектСсылка) Тогда
		Грузы = ОбъектДок.Грузы.Выгрузить();
		Грузы.Колонки.Добавить(КолонкаНоменклатура, Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		
		Для Каждого КлючЗначение Из НоменклатураГруза Цикл
			Грузы[КлючЗначение.Ключ][КолонкаНоменклатура] = КлючЗначение.Значение;
		КонецЦикла;
	Иначе
		Если ТипЗнч(ОбъектСсылка) <> Тип("Структура") Тогда // Значит пришел объект в переменной "ОбъектСсылка"
			Грузы = ОбъектДок.Грузы.Выгрузить();
			Грузы.Колонки.Добавить(КолонкаНоменклатура, Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
			
			Для Каждого КлючЗначение Из НоменклатураГруза Цикл
				Грузы[КлючЗначение.Ключ][КолонкаНоменклатура] = КлючЗначение.Значение;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	ГрузыСвернуто = СвернутаяТаблицаГрузов(Грузы, СтруктураПараметров);
	ЗаполнитьГрузыОбъектаДокумент(ОбъектДок, ГрузыСвернуто);
	
	Если ТипЗнч(ОбъектСсылка) = Тип("Структура") Тогда
		РезультатФункции.Ссылка = ОбъектДок;
	Иначе
		ОбъектДок.Записать();
	КонецЕсли;

	Возврат РезультатФункции;
	
КонецФункции    

Функция СвернутаяТаблицаГрузов(Грузы, СтруктураПараметров)
	
    СуммируемыеКолонки = Новый Массив;
	СуммируемыеКолонки.Добавить("Высота");
	СуммируемыеКолонки.Добавить("Длина");
	СуммируемыеКолонки.Добавить("Количество");
	СуммируемыеКолонки.Добавить("КоличествоПаллет");
	СуммируемыеКолонки.Добавить("МассаБрутто");
	СуммируемыеКолонки.Добавить("МассаНетто");
	СуммируемыеКолонки.Добавить("Объем");
	СуммируемыеКолонки.Добавить("Стоимость");
	СуммируемыеКолонки.Добавить("Ширина");

	ЗапросДанных     = ЗапросПоГруппировкеГруза(Грузы, СтруктураПараметров, СуммируемыеКолонки);
	РезультатЗапроса = ЗапросДанных.Выполнить();
	
	Грузы.Очистить();
		
	Погрузка_КоличествоМест = 0;
	Погрузка_Масса          = 0;
	
	СуммируемыеКолонки = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрСоединитьЭПД(СуммируемыеКолонки, ",");
	
	ВыборкаПоКритериюГруппировки = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);	
	Пока ВыборкаПоКритериюГруппировки.Следующий() Цикл
		
		СтрокаГруза = Грузы.Добавить();
		
		ВыборкаДанных = ВыборкаПоКритериюГруппировки.Выбрать();
		Если ВыборкаДанных.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(СтрокаГруза, ВыборкаДанных);
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаГруза, ВыборкаПоКритериюГруппировки, СуммируемыеКолонки);
		
		ЗаполнитьНаименованиеСгруппированногоГруза(
			СтрокаГруза, СтруктураПараметров, ВыборкаПоКритериюГруппировки.КритерийГруппировки);
		
		Погрузка_КоличествоМест = Погрузка_КоличествоМест + ВыборкаПоКритериюГруппировки.Количество;
		Погрузка_Масса          = Погрузка_Масса + ВыборкаПоКритериюГруппировки.МассаБрутто;
		
	КонецЦикла;
		
	Результат = Новый Структура;
	Результат.Вставить("Таблица",                 Грузы);
	Результат.Вставить("Погрузка_КоличествоМест", Погрузка_КоличествоМест);
	Результат.Вставить("Погрузка_Масса",          Формат(Погрузка_Масса, "ЧГ="));
	
	Возврат Результат;
	
КонецФункции

Функция ЗапросПоГруппировкеГруза(Грузы, СтруктураПараметров, СуммируемыеКолонки)
	
	МодульТНКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	
	КолонкиДляЗапроса = Новый Массив;
	Для Каждого Колонка Из Грузы.Колонки Цикл
		СтрокаЗапроса = "Грузы.%1 КАК %1";
		КолонкиДляЗапроса.Добавить(МодульТНКлиентСервер.СтрШаблонЭПД(СтрокаЗапроса, Колонка.Имя));
	КонецЦикла;
		
	ЗапросДанных = Новый Запрос;
	ЗапросДанных.УстановитьПараметр("Грузы", Грузы);
	
	ЗапросДанных.Текст =
	"ВЫБРАТЬ
	|	Выразить(Грузы.Наименование Как Строка(255)) КАК КритерийГруппировки,
	|	1 КАК Колонки
	|ПОМЕСТИТЬ ТаблицаГрузов
	|ИЗ
	|	&Грузы КАК Грузы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаГрузов.КритерийГруппировки КАК КритерийГруппировки,
	|	2 КАК Колонки
	|ИЗ
	|	ТаблицаГрузов КАК ТаблицаГрузов
	|ИТОГИ
	|	СУММА(Колонки)
	|ПО
	|	КритерийГруппировки";
	
	РазделительСтрок = ",
	|	";
	
	КолонкиПервойТаблицы = МодульТНКлиентСервер.СтрСоединитьЭПД(КолонкиДляЗапроса, РазделительСтрок);
	ЗапросДанных.Текст   = СтрЗаменить(ЗапросДанных.Текст, "1 КАК Колонки", КолонкиПервойТаблицы);
	
	КолонкиВторойТаблицы = СтрЗаменить(КолонкиПервойТаблицы, "Грузы.",        "ТаблицаГрузов.");
	ЗапросДанных.Текст   = СтрЗаменить(ЗапросДанных.Текст,   "2 КАК Колонки", КолонкиВторойТаблицы);
	
	КолонкиСуммыДляЗапроса = Новый Массив;
	Для Каждого ИмяКолонки Из СуммируемыеКолонки Цикл
		СтрокаЗапроса = "СУММА(%1)";
		КолонкиСуммыДляЗапроса.Добавить(МодульТНКлиентСервер.СтрШаблонЭПД(СтрокаЗапроса, ИмяКолонки));
	КонецЦикла;
	
	КолонкиСуммыДляЗапроса = МодульТНКлиентСервер.СтрСоединитьЭПД(КолонкиСуммыДляЗапроса, РазделительСтрок);
	
	ЗапросДанных.Текст = СтрЗаменить(ЗапросДанных.Текст, "СУММА(Колонки)", КолонкиСуммыДляЗапроса);
		
	ЗаполнитьКритерийГруппировки(СтруктураПараметров, ЗапросДанных, Грузы);
	
	Возврат ЗапросДанных;
	
КонецФункции

Процедура ЗаполнитьГрузыОбъектаДокумент(ОбъектДок, ГрузыСвернуто)

	Если ТипЗнч(ОбъектДок) = Тип("Структура") Тогда
		ЭтоЭТрН = ОбъектДок.ИмяМетаданных = ТранспортнаяНакладная();
		ОбъектДок.Грузы = ТаблицаЗначенийВМассивЭПД(ГрузыСвернуто.Таблица);		
	Иначе
		ОбъектДок.Грузы.Загрузить(ГрузыСвернуто.Таблица);
		ЭтоЭТрН = МодульКода("ESD_ТНОбщегоНазначенияСервер").ИмяМетаданныхДокумента(ОбъектДок.Ссылка) = ТранспортнаяНакладная();
	КонецЕсли;
	
	Если ЭтоЭТрН Тогда
		
		ОбъектДок.Погрузка_КоличествоМест = ГрузыСвернуто.Погрузка_КоличествоМест;
		ОбъектДок.Погрузка_Масса          = ГрузыСвернуто.Погрузка_Масса;
		
	КонецЕсли;
	
КонецПроцедуры

Функция НеГруппироватьГруз(ОбъектДок, НоменклатураГруза, СтруктураПараметров, РезультатФункции)
	
	// в ВО - сейчас нет настроек для группировки груза,
	// если нет параметров группировки - не группируем
	Если СтруктураПараметров = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;	
	
	Если ТипЗнч(ОбъектДок) = Тип("Структура") Тогда
		ИмяМетаданных = ОбъектДок.ИмяМетаданных;	
	Иначе
		ИмяМетаданных = МодульКода("ESD_ТНОбщегоНазначенияСервер").ИмяМетаданныхДокумента(ОбъектДок.Ссылка);
	КонецЕсли;
	
	ЭтоЭПЛ   = (ИмяМетаданных = ПутевойЛист());
	ЭтоЭТрН  = (ИмяМетаданных = ТранспортнаяНакладная());
	ЭтоЗаказ = (ИмяМетаданных = ЗаказНаПеревозку());
	
	ЭтоДокумент = Макс(ЭтоЭТрН, ЭтоЭПЛ, ЭтоЗаказ);		
	Если Не ЭтоДокумент Или ЭтоЭПЛ Тогда
		// у справочников и в ЭПЛ нет груза
		Возврат Истина;
	КонецЕсли;
	
	НеЗаполненаНоменклатураДляГруппировки = Ложь;
	
	ГруппировкаНовымРедактором = СтруктураПараметров.Свойство("ГруппировкаНовымРедактором");
	Если Не ГруппировкаНовымРедактором Тогда	
		
		НеЗаполненаНоменклатураДляГруппировки = СтруктураПараметров.ГруппироватьПоРеквизитуНоменклатуры
													И НоменклатураГруза.Количество() = 0;
			
		Если НеЗаполненаНоменклатураДляГруппировки Тогда
			РезультатФункции.ТекстЗаголовка = "Не выполнена группировка товаров";
			РезультатФункции.Вставить("ТекстСообщения", "Не заполнена номенклатура в файле настроек");
		КонецЕсли;

	КонецЕсли;
			
	ЕстьГруз = ОбъектДок.Грузы.Количество() 
				Или ГруппировкаНовымРедактором;  
	    
	НеГруппируем = Не СтруктураПараметров.ГруппироватьТоварыИзДокументовОснований
				   Или Не ЕстьГруз
				   Или НеЗаполненаНоменклатураДляГруппировки;
		
	Возврат НеГруппируем;
	
КонецФункции

Функция ПараметрыГруппировки()
	СтруктураПараметров = ESD_ЗагрузитьНастройкиОбъекта("ПараметрыГруппировкиПозицийОснований");
	Если СтруктураПараметров = Неопределено Тогда
		СтруктураПараметров = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ПараметрыГруппировкиПозицийОснований();
	КонецЕсли;
	
	Возврат СтруктураПараметров;
КонецФункции

Процедура ЗаполнитьКритерийГруппировки(СтруктураПараметров, ЗапросДанных, Грузы)
	
	ПодстрокаЗамены = "ТаблицаГрузов.КритерийГруппировки";
	
	Если СтруктураПараметров.ГруппироватьВОднуПозицию Тогда
		Если ЗначениеЗаполнено(СтруктураПараметров.НаименованиеОбщейПозиции) Тогда
			Наименование = СтруктураПараметров.НаименованиеОбщейПозиции;
		Иначе
			Наименование = Грузы[0].Наименование;
		КонецЕсли;
		НаименованиеОбщейПозиции = """%1""";
		НаименованиеОбщейПозиции = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрШаблонЭПД(
			НаименованиеОбщейПозиции, Наименование);
		ЗапросДанных.Текст = СтрЗаменить(ЗапросДанных.Текст, ПодстрокаЗамены, НаименованиеОбщейПозиции);
	ИначеЕсли СтруктураПараметров.ГруппироватьПоРеквизитуНоменклатуры Тогда
		ЗапросДанных.Текст = СтрЗаменить(
			ЗапросДанных.Текст,
			ПодстрокаЗамены,
			"ТаблицаГрузов.Номенклатура." + СтруктураПараметров.РеквизитНоменклатуры);
	Иначе
		ЗапросДанных.Текст = СтрЗаменить(ЗапросДанных.Текст, ПодстрокаЗамены, "Выразить(ТаблицаГрузов.Наименование Как Строка(255))");
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьНаименованиеСгруппированногоГруза(СтрокаГруза, СтруктураПараметров, КритерийГруппировки)
	
	Если СтруктураПараметров.ГруппироватьВОднуПозицию И ЗначениеЗаполнено(СтруктураПараметров.НаименованиеОбщейПозиции) Тогда
		СтрокаГруза.Наименование = СтруктураПараметров.НаименованиеОбщейПозиции;
	КонецЕсли;
	
	Если СтруктураПараметров.ГруппироватьПоРеквизитуНоменклатуры Тогда
		СтрокаГруза.Наименование = Строка(КритерийГруппировки);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти // ЗаполнениеНаОснованииINI

#Область ПолучениеРеквизитовОбъектов

Процедура СформироватьСтруктуруРеквизитов(Реквизиты, СтруктураПолей)
	
	// Разбор реквизитов, если второй параметр Строка.
	Если ТипЗнч(Реквизиты) = Тип("Строка") Тогда
		Реквизиты = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрРазделитьЭПД(Реквизиты, ",", Ложь);
		Для Индекс = 0 По Реквизиты.ВГраница() Цикл
			Реквизиты[Индекс] = СокрЛП(Реквизиты[Индекс]);
		КонецЦикла;
	КонецЕсли;
	
	// Приведение реквизитов к единому формату.
	Если ТипЗнч(Реквизиты) = Тип("Структура")
		Или ТипЗнч(Реквизиты) = Тип("ФиксированнаяСтруктура") Тогда
		
		Для Каждого КлючИЗначение Из Реквизиты Цикл
			СтруктураПолей.Вставить(КлючИЗначение.Ключ, СокрЛП(КлючИЗначение.Значение));
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Реквизиты) = Тип("Массив")
		Или ТипЗнч(Реквизиты) = Тип("ФиксированныйМассив") Тогда
		
		Для Каждого Реквизит Из Реквизиты Цикл
			Реквизит = СокрЛП(Реквизит);
			ПсевдонимПоля = СтрЗаменить(Реквизит, ".", "");
			СтруктураПолей.Вставить(ПсевдонимПоля, Реквизит);
		КонецЦикла;
	Иначе
		ШаблонИсключения = НСтр("ru = 'Неверный тип второго параметра %1 в функции %2: %3.';
			|en = 'Invalid type of parameter %1 in function %2: %3.'");
		ВызватьИсключение МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрШаблонЭПД(
			ШаблонИсключения,
			"Реквизиты",
			"ESD_ТНОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта",
			Строка(ТипЗнч(Реквизиты)));
	КонецЕсли;
	
КонецПроцедуры

Процедура РеквизитыВМассив(Реквизиты, СтруктураПолей)
	
	Если Тип("Структура") = ТипЗнч(Реквизиты)
		Или Тип("ФиксированнаяСтруктура") = ТипЗнч(Реквизиты) Тогда
		Реквизиты = Новый Массив;
		Для Каждого КлючИЗначение Из СтруктураПолей Цикл
			ИмяПоля = ?(ЗначениеЗаполнено(КлючИЗначение.Значение),
						КлючИЗначение.Значение,
						КлючИЗначение.Ключ);
			Реквизиты.Добавить(ИмяПоля);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьРезультат(Ссылка, Реквизиты, ВыбратьРазрешенные, КодЯзыка, Результат, СтруктураПолей)
	
	Если ЗначениеЗаполнено(Реквизиты) Тогда
		
		МассивСсылок = Новый Массив;
	    МассивСсылок.Добавить(Ссылка);
		
		ЗначенияРеквизитовОбъекта = ЗначенияРеквизитовОбъектов(
			МассивСсылок, Реквизиты, ВыбратьРазрешенные, КодЯзыка)[Ссылка];
		Если ЗначенияРеквизитовОбъекта <> Неопределено Тогда
			Для Каждого КлючИЗначение Из СтруктураПолей Цикл
				ИмяПоля = ?(ЗначениеЗаполнено(КлючИЗначение.Значение),
							КлючИЗначение.Значение,
							КлючИЗначение.Ключ);
				Если Найти(ИмяПоля, ".") = 0 И ЗначенияРеквизитовОбъекта.Свойство(ИмяПоля) Тогда
					Результат[КлючИЗначение.Ключ] = ЗначенияРеквизитовОбъекта[ИмяПоля];
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьТекстыЗапросов(СсылкиПоТипам, ТекстыЗапросов, ПараметрыЗапроса, ВыбратьРазрешенные, РеквизитыТекстЗапроса)
	
	ИменаОбъектовМетаданных = Новый Массив;
	
	Для Каждого СсылкиПоТипу Из СсылкиПоТипам Цикл
		Тип = СсылкиПоТипу.Ключ;
		ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
		Если ОбъектМетаданных = Неопределено Тогда
			ВызватьИсключение МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрШаблонЭПД(
				НСтр("ru = 'Неверный первый параметр %1 в функции %2: 
					|Значения массива должны быть ссылками.';
					|en = 'Invalid value of the %1 parameter, function %2:
					|The array values must be of the Ref type.'"), "Ссылки", "ESD_ТНОбщегоНазначенияСервер.ЗначенияРеквизитовОбъектов");
		КонецЕсли;
		
		ПолноеИмяОбъектаМетаданных = ОбъектМетаданных.ПолноеИмя();
		ИменаОбъектовМетаданных.Добавить(ПолноеИмяОбъектаМетаданных);
		
		ТекстЗапроса =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Ссылка КАК Ссылка,
			|	&Реквизиты КАК Реквизиты
			|ИЗ
			|	&ПолноеИмяОбъектаМетаданных КАК ПсевдонимЗаданнойТаблицы
			|ГДЕ
			|	ПсевдонимЗаданнойТаблицы.Ссылка В (&Ссылки)";
		Если Не ВыбратьРазрешенные Или ТекстыЗапросов.Количество() > 0 Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РАЗРЕШЕННЫЕ", "");
		КонецЕсли;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Реквизиты КАК Реквизиты", РеквизитыТекстЗапроса);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолноеИмяОбъектаМетаданных", ПолноеИмяОбъектаМетаданных);
		ИмяПараметра = "Ссылки" + СтрЗаменить(ПолноеИмяОбъектаМетаданных, ".", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Ссылки", "&" + ИмяПараметра);
		ПараметрыЗапроса.Вставить(ИмяПараметра, СсылкиПоТипу.Значение);
		
		ТекстыЗапросов.Добавить(ТекстЗапроса);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти // ПолучениеРеквизитовОбъектов

Функция СформироватьИмяМетаданных(Тип, Имя)
	
	Если Тип = "Документы" Тогда 
		ТипМетаданных = "ДокументСсылка";
	ИначеЕсли Тип = "Справочники" Тогда
		ТипМетаданных = "СправочникСсылка";
	ИначеЕсли Тип = "Перечисления" Тогда
		ТипМетаданных = "ПеречислениеСсылка";
	Иначе
		ТипМетаданных = "";
	КонецЕсли;	
	
	ИмяТипа = ТипМетаданных + "." + Имя;
	
	Возврат ИмяТипа;
	
КонецФункции

