// Возвращает число - код состояния ДО.
//
// Параметры:
//  СсылкаНаДокумент - ДокументСсылка - Ссылка на документ основной конфигурации или документа расширения
//  ТипДокумента - Строка - тип документа расширения
//
// Возвращаемое значение:
//   Число - Код состояния документа расширения, если нет, то 0
//
Функция КодСостоянияДокументаРасширения(СсылкаНаДокумент, ТипДокумента = Неопределено) Экспорт
	ДанныеСостояния = ДанныеСостоянияОбъекта(СсылкаНаДокумент, ТипДокумента, Ложь);
	Если ДанныеСостояния = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	КодСостоянияДокументРасширение = 0;
	
	КодСостоянияДокументРасширение = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ЗначениеИзКоллекции(ДанныеСостояния, "Состояние.ИдентификаторСБИС");
	Если ТипЗнч(КодСостоянияДокументРасширение) <> Тип("Число") Тогда
		КодСостоянияДокументРасширение = 0;
	КонецЕсли;
	
	Возврат КодСостоянияДокументРасширение;
КонецФункции

// Получение из регистра состояний активного этапа
//
// Параметры:
// 	СсылкаНаДокумент - ДокументСсылка - ссылка на документ для поиска
//
// Возвращаемое значение:
//  Строка - активный этап строкой
//
Функция АктивныйЭтапСтрокой(Знач СсылкаНаДокумент) Экспорт
	
	РезультатФункции = "";
	
	ДанныеСостояния = ДанныеСостоянияОбъекта(СсылкаНаДокумент);
	Если ДанныеСостояния <> Неопределено Тогда
		РезультатФункции = ДанныеСостояния.АктивныйЭтап;
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

// Очищает отметки и связанные с ними таблицы документа.
//
// Параметры:
//  ОбъектДок - ДокументОбъект.Saby_ТранспортнаяНакладная - объект документа для зачистки отметок.
//  Титул - ПеречислениеСсылка.Saby_ТипТитулаЭтрН - тип титула для зачистки отметок.
//  ЗначениеРоли - ПеречислениеСсылка.Saby_РолиКонтрагентов - роль контрагента для зачистки отметок.
//
Процедура ЗачисткаОтметокШтрафовАктов(ОбъектДок, Титул, ЗначениеРоли) Экспорт
	
	Если ТипЗнч(ОбъектДок) <> Тип("Структура")
		И МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ЕстьРеквизитИлиСвойство(ОбъектДок, "Ссылка")
		И Не ЗначениеЗаполнено(ОбъектДок.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	КлючиОтметокДляУдаления = Новый Соответствие;
	
	ИндексСтроки = 0;
	Пока ИндексСтроки < ОбъектДок.Отметки.Количество() Цикл
		СтрокаОтметки = ОбъектДок.Отметки[ИндексСтроки];
		
		Если СтрокаОтметки.Этап = Титул И СтрокаОтметки.Роль = ЗначениеРоли Тогда
			КлючиОтметокДляУдаления.Вставить(СтрокаОтметки.КлючСтроки, Истина);
			ОбъектДок.Отметки.Удалить(ИндексСтроки);
		Иначе
			ИндексСтроки = ИндексСтроки + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	ЗачиститьШтрафы(ОбъектДок, КлючиОтметокДляУдаления);
	
	ЗачиститьАкты(ОбъектДок, КлючиОтметокДляУдаления);
	
КонецПроцедуры

#Область ДатаВремя

// Преобразовывает дату, полученную с онлайна, в тип дата.
//
// Параметры:
//  ДатаВходящая - Строка - дата в виде строки, полученная с онлайна.
//
// Возвращаемое значение:
//   Дата - значение даты
//
Функция ПреобразоватьСтрокуВДатуЭПД(ДатаВходящая) Экспорт
	
	Если ТипЗнч(ДатаВходящая) = Тип("Дата") Тогда
		Возврат ДатаВходящая;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаВходящая) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	
	// ранее 24.01.2023 12.00.00
	// 15.03.2022T00:00:00+01:00
	// 15.03.2022T00:00:00-01:00
	// 2023-02-02 07:33:30
	// 2023-02-02
	// 2023.01.03
	ФорматБезСмещения = Ложь;
		
	ЕстьВремя = (Найти(ДатаВходящая, "T") > 0);
	
	ЧислоДвоеточийВДате = 2;
	
	// часть дат может приходить в старом формате
	Если Не ЕстьВремя Тогда
		
		ЧислоТочекВДате = 4;
		
		Если СтрЧислоВхождений(ДатаВходящая, ".") = ЧислоТочекВДате
			Или СтрЧислоВхождений(ДатаВходящая, ":") = ЧислоДвоеточийВДате Тогда
			ЕстьВремя = Истина;
			ФорматБезСмещения = Истина;
		КонецЕсли;
	КонецЕсли;	
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	
	Если ЕстьВремя Тогда
		
		Если ФорматБезСмещения Тогда 
			Разделитель = " ";
		Иначе 
			Разделитель = "T";			
		КонецЕсли;
		
		МассивЧастейДаты = МодульТНОбщегоНазначенияКлиентСервер.СтрРазделитьЭПД(ДатаВходящая, Разделитель);
		ЧастьДата  = МассивЧастейДаты[0];
		ЧастьВремя = МассивЧастейДаты[1];
		
	Иначе
		
		ЧастьДата = ДатаБезВремениВСтандартномФормате(ДатаВходящая);		
		
	КонецЕсли;
				
	МассивДат = МодульТНОбщегоНазначенияКлиентСервер.СтрРазделитьЭПД(ЧастьДата, ".", Ложь);
	
	МассивИтог = Новый Массив;
	МассивИтог.Добавить(МассивДат[2]); 
	МассивИтог.Добавить(МассивДат[1]);
	МассивИтог.Добавить(МассивДат[0]); 		
	
	СмещениеВСекундах = Неопределено;
	
	ДобавитьВремяВМассивДаты(МассивИтог, ЧастьВремя, ЕстьВремя, ФорматБезСмещения, СмещениеВСекундах);
	
	ДатаСтрокой = МодульТНОбщегоНазначенияКлиентСервер.СтрСоединитьЭПД(МассивИтог, "");
	
	Возврат ?(ЗначениеЗаполнено(СмещениеВСекундах), Дата(ДатаСтрокой) - СмещениеВСекундах, Дата(ДатаСтрокой)); 
	
КонецФункции	

// Преобразовывает дату, полученную с онлайна, в тип дата.
//
// Параметры:
//  ВремяВходящее - Строка - дата в виде строки, полученная с онлайна.
//
// Возвращаемое значение:
//   Время - значение времени
//
Функция ПреобразоватьСтрокуВоВремя(ВремяВходящее) Экспорт
	
	Если ТипЗнч(ВремяВходящее) = Тип("Дата") Тогда
		Возврат ВремяВходящее;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВремяВходящее) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	
	// 00:00:00+01:00
	// 00:00:00-01:00
	// может быть +/-
	Если Найти(ВремяВходящее, "+") > 0 Тогда
		РазделительСмещение = "+";
	Иначе
		РазделительСмещение = "-";
	КонецЕсли;
	
	МассивВремени = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрРазделитьЭПД(ВремяВходящее, РазделительСмещение);
	Время         = МассивВремени[0];
	
	ПервыйМесяц = "01";
	ПервоеЧисло = "01";
	
	МассивИтог = Новый Массив;
	МассивИтог.Добавить("0001");
	МассивИтог.Добавить(ПервыйМесяц);
	МассивИтог.Добавить(ПервоеЧисло);
		
	ДобавитьВремяВМассивДаты(МассивИтог, Время, Истина, Истина, 0);
	
	ДатаСтрокой = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрСоединитьЭПД(МассивИтог, "");
	
	Возврат Дата(ДатаСтрокой); 

КонецФункции
	
#КонецОбласти // ДатаВремя

// Возвращает структуру адреса в формате обмена со СБИС
// Параметры:
//  Выгрузка - Белево - признак того что адрес будет использован для выгрузки в онлайн
//
// Возвращаемое значение:
