	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	
	МассивДанныхВидовУпаковки = Новый Массив;
	
	ДанныеГрузов = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(РезультатРасчетаПолей, "Грузы", Новый Массив);
	Для Каждого ДанныеГруза Из ДанныеГрузов Цикл
		Путь = Новый Массив;
		Путь.Добавить("Грузы.ВидТары");
		ДанныеВидаУпаковки = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(
			ДанныеГруза, Путь, Новый Соответствие);
		МассивДанныхВидовУпаковки.Добавить(ДанныеВидаУпаковки);
	КонецЦикла;
	
	МодульКода("Справочники.ESD_ВидыУпаковки").ЗаполнитьСсылкиВидовУпаковкиНовыйРедактор(МассивДанныхВидовУпаковки);
	
КонецПроцедуры

Процедура ЗаполнитьСсылкиОпасныхГрузов(РезультатРасчетаПолей) Экспорт
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	
	МассивДанныхОпасныхГрузов = Новый Массив;
	
	ДанныеГрузов = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(РезультатРасчетаПолей, "Грузы", Новый Массив);
	Для Каждого ДанныеГруза Из ДанныеГрузов Цикл
		Путь = Новый Массив;
		Путь.Добавить("Грузы.ОпасныйГруз");
		ДанныеОпасныйГруз = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(ДанныеГруза, Путь, Новый Соответствие);
		МассивДанныхОпасныхГрузов.Добавить(ДанныеОпасныйГруз);
		
		Путь = Новый Массив;
		Путь.Добавить("Грузы.ОпасныеГрузы");
		ДанныеОпасныхГрузов = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(ДанныеГруза, Путь, Новый Массив);
		Для Каждого ДанныеОпасногоГруза Из ДанныеОпасныхГрузов Цикл
			Путь = Новый Массив;
