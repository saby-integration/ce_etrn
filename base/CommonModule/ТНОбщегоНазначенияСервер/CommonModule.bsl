//
Функция ИмяСобытияЖурналаРегистрации_ВыгрузкаВSaby() Экспорт
	Возврат "Выгрузка данных в Saby"
КонецФункции

Процедура ДобавитьРеквизитыИзБД(СтруктураДанных, СсылкаНаДокумент, ПсевдонимыРеквизитов, ТекстЗапросаРеквизитов) Экспорт
		
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапросаРеквизитов);
	
	НужныеКолонки = Новый Соответствие;
	Для Каждого ПсевдонимРеквизита Из ПсевдонимыРеквизитов Цикл
		НужныеКолонки.Вставить(ПсевдонимРеквизита, Истина);
	КонецЦикла;
	
	Колонки = СхемаЗапроса.ПакетЗапросов[0].Колонки;
	
	ИндексКолонки = 0;
	Пока ИндексКолонки < Колонки.Количество() Цикл
		
		Псевдоним = Колонки[ИндексКолонки].Псевдоним;
		
		Если НужныеКолонки[Псевдоним] = Неопределено Тогда
			Колонки.Удалить(ИндексКолонки);
		Иначе
			ИндексКолонки = ИндексКолонки + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	ЗапросДанных = Новый Запрос;
	ЗапросДанных.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	ЗапросДанных.УстановитьПараметр("Ссылка", СсылкаНаДокумент);
	
	МассивДанных = МодульКода("ESD_ТНОбщегоНазначенияСервер").ТаблицаЗначенийВМассивЭПД(ЗапросДанных.Выполнить().Выгрузить());
	
	Для Каждого КлючЗначение Из МассивДанных[0] Цикл
		СтруктураДанных.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьТаблицыИзБД(СтруктураДанных, СсылкаНаДокумент, Таблицы,
		ШаблонЗапросаТаблиц, НестандартныеЗапросыТаблиц
) Экспорт
    МодульESD_ОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");

    УникальныеТаблицы_ = Новый Массив;
	МодульESD_ОбщегоНазначенияКлиентСервер.ДополнитьМассив(УникальныеТаблицы_, Таблицы, Истина);

	МассивЗапросов = Новый Массив;
	ЗапросДанных = Новый Запрос;
	
	СоответствиеПакетныхЗапросов = Новый Соответствие;
	Для Каждого ИмяТаблицы Из УникальныеТаблицы_ Цикл
		ТекстЗапроса = НестандартныеЗапросыТаблиц.Получить(ИмяТаблицы);
		Если ТекстЗапроса = Неопределено Тогда
			ТекстЗапроса = МодульESD_ОбщегоНазначенияКлиентСервер.СтрШаблонЭПД(ШаблонЗапросаТаблиц, ИмяТаблицы);
		КонецЕсли;
		
		Пакеты = СтрЧислоВхождений(ТекстЗапроса, ";");
		Если Пакеты > 0 Тогда
			СоответствиеПакетныхЗапросов.Вставить(ИмяТаблицы, Пакеты);
		КонецЕсли;	
			
		МассивЗапросов.Добавить(ТекстЗапроса);
	КонецЦикла;
	
	РазделительЗапросов = "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
	ЗапросДанных.Текст = МодульESD_ОбщегоНазначенияКлиентСервер.СтрСоединитьЭПД(МассивЗапросов, РазделительЗапросов);
	ЗапросДанных.УстановитьПараметр("Ссылка", СсылкаНаДокумент);
	
	Результат = ЗапросДанных.ВыполнитьПакет();
	
	Индекс = 0;
	Для Каждого ИмяТаблицы Из УникальныеТаблицы_ Цикл
				
		ПакетыЗапроса = СоответствиеПакетныхЗапросов[ИмяТаблицы];
		Сдвиг = ?(ЗначениеЗаполнено(ПакетыЗапроса), ПакетыЗапроса, 0);
		
		НомерТаблицыВЗапросе = Индекс + Сдвиг;
		
		СтруктураДанных.Вставить(ИмяТаблицы, Результат[НомерТаблицыВЗапросе].Выгрузить());
		Индекс = НомерТаблицыВЗапросе + 1;
		
	КонецЦикла;
	
КонецПроцедуры

Функция РеквизитыДокументовСбис(МассивДокументов) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивСсылок", МассивДокументов);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДокументыЭПД.Наименование КАК Наименование,
	|	ДокументыЭПД.Номер КАК Номер,
	|	ДокументыЭПД.Дата КАК Дата,
	|	ДокументыЭПД.Дата КАК ДатаВремя,
	|	ДокументыЭПД.ДопСведения КАК ДополнительныеСведения,
	|	ДокументыЭПД.Ссылка КАК Ссылка,
	|	ДокументыЭПД.Тип КАК Тип
	|ИЗ
	|	Справочник.ESD_ДокументыЭПД КАК ДокументыЭПД
	|ГДЕ
	|	ДокументыЭПД.Ссылка В(&МассивСсылок)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументыЭПДДанныеЮрЛиц.Ссылка КАК Ссылка,
	|	ДокументыЭПДДанныеЮрЛиц.НаименованиеОрганизации КАК НаименованиеОрганизации,
	|	ДокументыЭПДДанныеЮрЛиц.ИНН КАК ИНН,
	|	ДокументыЭПДДанныеЮрЛиц.КПП КАК КПП,
	|	ДокументыЭПДДанныеЮрЛиц.СтранаРегистрации КАК СтранаРегистрации,
	|	ДокументыЭПДДанныеЮрЛиц.ОГРН КАК ОГРН,
	|	ДокументыЭПДДанныеЮрЛиц.ЮрФизЛицо КАК ЮрФизЛицо
	|ИЗ
	|	Справочник.ESD_ДокументыЭПД.ДанныеЮрЛиц КАК ДокументыЭПДДанныеЮрЛиц
	|ГДЕ
	|	ДокументыЭПДДанныеЮрЛиц.Ссылка В(&МассивСсылок)";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ESD_ДокументыЭПД", ДокументыЭПД());
	
	Если ЭтоДоступнаяКонфигурация().Имя = "УАТ" Тогда
		
		Запрос.Текст = СтрЗаменить(
			Запрос.Текст,
			"ДокументыЭПДСтороны.Сторона.РегистрационныйНомер",
			"&ПустаяСтрока");
			
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ПустаяСтрока", "");
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаДокументов = РезультатЗапроса[0].Выбрать();
	РеквизитыСторон   = РезультатЗапроса[1].Выгрузить();
	
	Соответствие = Новый Соответствие;
	
	КолонкиИсключения = Новый Массив;
	КолонкиИсключения.Добавить("Ссылка");
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		ПараметрыСтроки = СтрокаТаблицыЗначенийВСтруктуруЭПД(
			ВыборкаДокументов, КолонкиИсключения);
		ПараметрыСтроки.Дата = МодульКода("ESD_ТНВыгрузкаСервер").ЗначениеДатыВремяДляВыгрузки(ПараметрыСтроки.Дата, Истина);
		
		// добавим стороны документа
		Отбор = Новый Структура;
		Отбор.Вставить("Ссылка", ВыборкаДокументов.Ссылка);
		НайденныеСтроки = РеквизитыСторон.НайтиСтроки(Отбор);
		
		МассивСторон = ПараметрыСторонДокумента(НайденныеСтроки);
		
		ПараметрыСтроки.Вставить("Стороны", МассивСторон);
		
		Соответствие.Вставить(ВыборкаДокументов.Ссылка, ПараметрыСтроки);
		
	КонецЦикла;
	
	Возврат Соответствие;
	
КонецФункции

Функция РеквизитыДокументаСбисИзСтрокиТаблицы(СтрокаДокумента) Экспорт
	
	КолонкиИсключения = Новый Массив;
	КолонкиИсключения.Добавить("Путь");
	
	ПараметрыСтроки = СтрокаТаблицыЗначенийВСтруктуруЭПД(СтрокаДокумента, КолонкиИсключения);
	
	ПараметрыСтроки.Дата = МодульКода("ESD_ТНВыгрузкаСервер").ЗначениеДатыВремяДляВыгрузки(ПараметрыСтроки.Дата, Истина);
		
	МассивСторон = ПараметрыСторонДокумента(СтрокаДокумента.ДанныеЮрЛиц);
		
	ПараметрыСтроки.Вставить("Стороны", МассивСторон);
	
	Возврат ПараметрыСтроки;
	
КонецФункции

Процедура ДозаполнитьНовыеЭлементыДаннымиСОнлайна(ТекстЗапроса, МенеджерСправочника) Экспорт
	
	ЗапросДанных = Новый Запрос;
	ЗапросДанных.Текст = ТекстЗапроса;
	
	ЗапросДанных.УстановитьПараметр("Идентификатор", МенеджерСправочника.ИдентификаторДозаполнения());
	
	МассивНаименований = Новый Массив;
	
	ВыборкаДанных = ЗапросДанных.Выполнить().Выбрать();
	Пока ВыборкаДанных.Следующий() Цикл
		Наименование = МенеджерСправочника.ПреобразоватьНаименование(ВыборкаДанных.Наименование);
		МассивНаименований.Добавить(Наименование);
	КонецЦикла;
	
	Если МассивНаименований.Количество() > 0 Тогда
		
		МенеджерСправочника.ЗагрузитьСОнлайна(МассивНаименований);
		
		ВыборкаДанных = ЗапросДанных.Выполнить().Выбрать();
		Пока ВыборкаДанных.Следующий() Цикл
			ОбъектСправочника = ВыборкаДанных.Ссылка.ПолучитьОбъект();
			ОбъектСправочника.Идентификатор = "";
			ОбъектСправочника.Записать();
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция СтруктураПредставленияТитула(ТипТитула, КодТитула, ИмяПодстановки = "") Экспорт
	
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("КодТитула",      КодТитула);
	РезультатФункции.Вставить("ИмяПодстановки", ИмяПодстановки);
	РезультатФункции.Вставить("ТипТитула",      ТипТитула);
	
	Имя           = "";
	Представление = "";
	Если Не ТипТитула.Пустая() Тогда
		МетаданныеПеречисления = ТипТитула.Метаданные();
		ИндексТипа = Перечисления[МетаданныеПеречисления.Имя].Индекс(ТипТитула);
		МетаданныеПеречисления = МетаданныеПеречисления.ЗначенияПеречисления[ИндексТипа];
		Имя           = МетаданныеПеречисления.Имя;
		Представление = МетаданныеПеречисления.Синоним;
	КонецЕсли;
	
	РезультатФункции.Вставить("Имя",           Имя);
	РезультатФункции.Вставить("Представление", Представление);
	
	Возврат РезультатФункции;
	
КонецФункции

Функция АвторизованныйАккаунтСтрокой() Экспорт
	Аккаунт = "";
	
	ПараметрыСессии = ESD_ПараметрыАвторизацииПользователя().Сессия;
	Если Не ESD_АвторизацияПройдена(ПараметрыСессии) Тогда
		Возврат Аккаунт;
	КонецЕсли;
	
	Возврат ПараметрыСессии["AccountId"];
КонецФункции

// Возвращает структуру, содержащую значения реквизитов, прочитанные из информационной базы по ссылке на объект.
// Рекомендуется использовать вместо обращения к реквизитам объекта через точку от ссылки на объект
// для быстрого чтения отдельных реквизитов объекта из базы данных.
//
// Если необходимо зачитать реквизит независимо от прав текущего пользователя,
// то следует использовать предварительный переход в привилегированный режим.
//
// Параметры:
//  Ссылка    - ЛюбаяСсылка - объект, значения реквизитов которого необходимо получить.
//            - Строка      - полное имя предопределенного элемента, значения реквизитов которого необходимо получить.
//  Реквизиты - Строка - имена реквизитов, перечисленные через запятую, в формате
//                       требований к свойствам структуры.
//                       Например, "Код, Наименование, Родитель".
//            - Структура
//            - ФиксированнаяСтруктура - в качестве ключа передается
//                       псевдоним поля для возвращаемой структуры с результатом, а в качестве
//                       значения (опционально) фактическое имя поля в таблице.
//                       Если ключ задан, а значение не определено, то имя поля берется из ключа.
//                       Допускается указание имени поля через точку, но при этом параметр КодЯзыка для такого поля
//                       учитываться не будет.
//            - Массив из Строка
//            - ФиксированныйМассив из Строка - имена реквизитов в формате требований к свойствам структуры.
//  ВыбратьРазрешенные - Булево - если Истина, то запрос к объекту выполняется с учетом прав пользователя;
//                                если есть ограничение на уровне записей, то все реквизиты вернутся со 
//                                значением Неопределено; если нет прав для работы с таблицей, то возникнет исключение;
//                                если Ложь, то возникнет исключение при отсутствии прав на таблицу 
//                                или любой из реквизитов.
//  КодЯзыка - Строка - код языка для мультиязычного реквизита. Значение по умолчанию - основной язык конфигурации.
//
// Возвращаемое значение:
//  Структура - содержит имена (ключи) и значения затребованных реквизитов.
//              Если в параметр Реквизиты передана пустая строка, то возвращается пустая структура.
//              Если в параметр Ссылка передана пустая ссылка, то возвращается структура, 
//              соответствующая именам реквизитов со значениями Неопределено.
//              Если в параметр Ссылка передана ссылка несуществующего объекта (битая ссылка), 
//              то все реквизиты вернутся со значением Неопределено.
//
Функция ЗначенияРеквизитовОбъекта(Ссылка, Знач Реквизиты, ВыбратьРазрешенные = Ложь, Знач КодЯзыка = Неопределено) Экспорт
	
	Попытка
		ПолноеИмяОбъектаМетаданных = Ссылка.Метаданные().ПолноеИмя(); 
	Исключение
		ВызватьИсключение МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрШаблонЭПД(
			НСтр("ru = 'Неверный первый параметр %1 в функции %2: 
				|Значение должно быть ссылкой или именем предопределенного элемента.';
				|en = 'Invalid value of the %1 parameter, function %2:
				|The value must contain predefined item name or reference.'"),
			"Ссылка", "ESD_ТНОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта");
	КонецПопытки;
	
	СтруктураПолей = Новый Структура;
	МультиязычныеРеквизиты = Новый Соответствие;
	СуффиксЯзыка = "";
	
	СформироватьСтруктуруРеквизитов(Реквизиты, СтруктураПолей);
	
	// Подготовка результата (после выполнения запроса переопределится).
	Результат = Новый Структура;
	
	// Формирование текста запроса к выбираемым полям.
	ТекстЗапросаПолей = "";
	Для каждого КлючИЗначение Из СтруктураПолей Цикл
		
		ИмяПоля = ?(ЗначениеЗаполнено(КлючИЗначение.Значение),
						КлючИЗначение.Значение,
						КлючИЗначение.Ключ);
		ПсевдонимПоля = КлючИЗначение.Ключ;
		
		Если МультиязычныеРеквизиты[ИмяПоля] <> Неопределено Тогда
			ИмяПоля = ИмяПоля + СуффиксЯзыка;
		КонецЕсли;
		
		ТекстЗапросаПолей = 
			ТекстЗапросаПолей + ?(ПустаяСтрока(ТекстЗапросаПолей), "", ",") + "
			|	" + ИмяПоля + " КАК " + ПсевдонимПоля;
		
		// Предварительное добавление поля по псевдониму в возвращаемый результат.
		Результат.Вставить(ПсевдонимПоля);
		
	КонецЦикла;
	
	// Если предопределенного нет в ИБ.
	// - приведение результата к отсутствию объекта в ИБ или передаче пустой ссылки.
	Если Ссылка = Неопределено Тогда 
		Возврат Результат;
	КонецЕсли;
	
	РеквизитыВМассив(Реквизиты, СтруктураПолей);
	
	РеквизитыЧерезТочку = Новый Массив;
	Для Индекс = -Реквизиты.ВГраница() По 0 Цикл
		ИмяПоля = Реквизиты[ -Индекс];
		Если Найти(ИмяПоля, ".") Тогда
			РеквизитыЧерезТочку.Добавить(ИмяПоля);
			Реквизиты.Удалить(-Индекс);
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьРезультат(Ссылка, Реквизиты, ВыбратьРазрешенные, КодЯзыка, Результат, СтруктураПолей);
	
	Если Не ЗначениеЗаполнено(РеквизитыЧерезТочку) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Реквизиты = РеквизитыЧерезТочку;
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|&ТекстЗапросаПолей КАК ТекстЗапросаПолей
		|ИЗ
		|	&ПолноеИмяОбъектаМетаданных КАК ПсевдонимЗаданнойТаблицы
		|ГДЕ
		|	ПсевдонимЗаданнойТаблицы.Ссылка = &Ссылка";
	
	Если Не ВыбратьРазрешенные Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РАЗРЕШЕННЫЕ", "");
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаПолей КАК ТекстЗапросаПолей", ТекстЗапросаПолей);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолноеИмяОбъектаМетаданных", ПолноеИмяОбъектаМетаданных);
	
	// Выполнение запроса.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст = ТекстЗапроса;
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	// Заполнение реквизитов.
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает значения реквизита, прочитанного из информационной базы по ссылке на объект.
// Рекомендуется использовать вместо обращения к реквизитам объекта через точку от ссылки на объект
// для быстрого чтения отдельных реквизитов объекта из базы данных.
//
// Если необходимо зачитать реквизит независимо от прав текущего пользователя,
// то следует использовать предварительный переход в привилегированный режим.
//
// Параметры:
//  Ссылка    - ЛюбаяСсылка - объект, значения реквизитов которого необходимо получить.
//            - Строка      - полное имя предопределенного элемента, значения реквизитов которого необходимо получить.
//  ИмяРеквизита       - Строка - имя получаемого реквизита.
//                                Допускается указание имени реквизита через точку, но при этом параметр КодЯзыка для
//                                такого реквизита учитываться не будет.
//  ВыбратьРазрешенные - Булево - если Истина, то запрос к объекту выполняется с учетом прав пользователя;
//                                если есть ограничение на уровне записей, то возвращается Неопределено;
//                                если нет прав для работы с таблицей, то возникнет исключение;
//                                если Ложь, то возникнет исключение при отсутствии прав на таблицу
//                                или любой из реквизитов.
//  КодЯзыка - Строка - код языка для мультиязычного реквизита. Значение по умолчанию - основной язык конфигурации.
//
// Возвращаемое значение:
//  Произвольный - если в параметр Ссылка передана пустая ссылка, то возвращается Неопределено.
//                 Если в параметр Ссылка передана ссылка несуществующего объекта (битая ссылка), 
//                 то возвращается Неопределено.
//
Функция ЗначениеРеквизитаОбъекта(Ссылка, ИмяРеквизита, ВыбратьРазрешенные = Ложь, Знач КодЯзыка = Неопределено) Экспорт
	
	Если ПустаяСтрока(ИмяРеквизита) Тогда 
		ВызватьИсключение МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрШаблонЭПД(
			НСтр("ru = 'Неверный второй параметр %1 в функции %2: 
				|Имя реквизита должно быть заполнено.';
				|en = 'Invalid value of the %1 parameter, function %2:
				|The attribute name cannot be empty.'"), "ИмяРеквизита", "ESD_ТНОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта");
	КонецЕсли;
	
	Результат = ЗначенияРеквизитовОбъекта(Ссылка, ИмяРеквизита, ВыбратьРазрешенные, КодЯзыка);
	Возврат Результат[СтрЗаменить(ИмяРеквизита, ".", "")];
	
КонецФункции 

// Возвращает значения реквизитов, прочитанные из информационной базы для нескольких объектов.
// Рекомендуется использовать вместо обращения к реквизитам объекта через точку от ссылки на объект
// для быстрого чтения отдельных реквизитов объекта из базы данных.
//
// Если необходимо зачитать реквизит независимо от прав текущего пользователя,
// то следует использовать предварительный переход в привилегированный режим.
//
// Параметры:
//  Ссылки - Массив из ЛюбаяСсылка
//         - ФиксированныйМассив из ЛюбаяСсылка - ссылки на объекты.
//           Если массив пуст, то результатом будет пустое соответствие.
//  Реквизиты - Строка - имена реквизитов перечисленные через запятую, в формате требований к свойствам
//                       структуры. Например, "Код, Наименование, Родитель".
//            - Массив из Строка
//            - ФиксированныйМассив из Строка - имена реквизитов в формате требований к свойствам структуры.
//  ВыбратьРазрешенные - Булево - если Истина, то запрос к объектам выполняется с учетом прав пользователя;
//                                если какой-либо объект будет исключен из выборки по правам, то этот объект
//                                будет исключен и из результата;
//                                если Ложь, то возникнет исключение при отсутствии прав на таблицу
//                                или любой из реквизитов.
//  КодЯзыка - Строка - код языка для мультиязычного реквизита. Значение по умолчанию - основной язык конфигурации.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - список объектов и значений их реквизитов:
//   * Ключ - ЛюбаяСсылка - ссылка на объект;
//   * Значение - Структура:
//    ** Ключ - Строка - имя реквизита;
//    ** Значение - Произвольный - значение реквизита.
// 
Функция ЗначенияРеквизитовОбъектов(Ссылки, Знач Реквизиты, ВыбратьРазрешенные = Ложь, Знач КодЯзыка = Неопределено) Экспорт
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	
	Если ТипЗнч(Реквизиты) = Тип("Массив") Или ТипЗнч(Реквизиты) = Тип("ФиксированныйМассив") Тогда
		Реквизиты = МодульТНОбщегоНазначенияКлиентСервер.СтрСоединитьЭПД(Реквизиты, ",");
	КонецЕсли;
	
	Если ПустаяСтрока(Реквизиты) Тогда 
		ВызватьИсключение МодульТНОбщегоНазначенияКлиентСервер.СтрШаблонЭПД(
			НСтр("ru = 'Неверный второй параметр %1 в функции %2: 
				|Поле объекта должно быть указано.';
				|en = 'Invalid value of the %1 parameter, function %2:
				|The object field must be specified.'"), "Реквизиты", "ESD_ТНОбщегоНазначенияСервер.ЗначенияРеквизитовОбъектов");
	КонецЕсли;
	
	Если Найти(Реквизиты, ".") <> 0 Тогда 
		ВызватьИсключение МодульТНОбщегоНазначенияКлиентСервер.СтрШаблонЭПД(
			НСтр("ru = 'Неверный второй параметр %1 в функции %2: 
				|Обращение через точку не поддерживается.';
				|en = 'Invalid value of the %1 parameter, function %2:
				|Dot syntax is not supported.'"), "Реквизиты", "ESD_ТНОбщегоНазначенияСервер.ЗначенияРеквизитовОбъектов");
	КонецЕсли;
	
	ЗначенияРеквизитов = Новый Соответствие;
	Если Ссылки.Количество() = 0 Тогда
		Возврат ЗначенияРеквизитов;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КодЯзыка) Тогда
		КодЯзыка = МодульТНОбщегоНазначенияКлиентСервер.СтрРазделитьЭПД(КодЯзыка, "_", Истина)[0];
	КонецЕсли;
	
	РеквизитыТекстЗапроса = Реквизиты;
	
	СсылкиПоТипам = Новый Соответствие;
	Для Каждого Ссылка Из Ссылки Цикл
		Тип = ТипЗнч(Ссылка);
		Если СсылкиПоТипам[Тип] = Неопределено Тогда
			СсылкиПоТипам[Тип] = Новый Массив;
		КонецЕсли;
		ЭлементПоТипу = СсылкиПоТипам[Тип]; // Массив
		ЭлементПоТипу.Добавить(Ссылка);
	КонецЦикла;
	
	ТекстыЗапросов = Новый Массив;
	ПараметрыЗапроса = Новый Структура;
	
	СформироватьТекстыЗапросов(СсылкиПоТипам, ТекстыЗапросов, ПараметрыЗапроса, ВыбратьРазрешенные, РеквизитыТекстЗапроса);
	
	ТекстЗапроса = МодульТНОбщегоНазначенияКлиентСервер.СтрСоединитьЭПД(
		ТекстыЗапросов, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("КодЯзыка", КодЯзыка);
	Для Каждого Параметр Из ПараметрыЗапроса Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Результат = Новый Структура(Реквизиты);
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
		ЗначенияРеквизитов[Выборка.Ссылка] = Результат;
		
	КонецЦикла;
	
	Возврат ЗначенияРеквизитов;
	
КонецФункции

// Преобразует таблицу значений в массив структур.
// Может использоваться для передачи на клиент данных в том случае, если таблица
// значений содержит только такие значения, которые могут
// быть переданы с сервера на клиент.
//
// Полученный массив содержит структуры, каждая из которых повторяет
// структуру колонок таблицы значений.
//
// Не рекомендуется использовать для преобразования таблиц значений
// с большим количеством строк.
//
// Параметры:
//  ТаблицаЗначений - ТаблицаЗначений - исходная таблица значений.
//
// Возвращаемое значение:
//  Массив - коллекция строк таблицы в виде структур.
//
Функция ТаблицаЗначенийВМассивЭПД(ТаблицаЗначений) Экспорт
	
	Массив = Новый Массив();
	Для Каждого Строка Из ТаблицаЗначений Цикл
		НоваяСтрока = Новый Структура;
		Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
			ЗначениеКолонки = Строка[Колонка.Имя];
			Если ТипЗнч(ЗначениеКолонки) = Тип("ТаблицаЗначений") Тогда
				ЗначениеКолонки = ТаблицаЗначенийВМассивЭПД(ЗначениеКолонки);
			КонецЕсли;
			НоваяСтрока.Вставить(Колонка.Имя, ЗначениеКолонки);
		КонецЦикла;
		Массив.Добавить(НоваяСтрока);
	КонецЦикла;
	
	Возврат Массив;

КонецФункции

// Единая точка входа для всего функционала описанного в модулях перечислений
//
// Параметры:
//  ИмяМетаданных - Строка - имя метаданных документа
//  ИмяФункции - Строка - имя функции описанной в данном модуле
//  Параметр1 - Произвольный - первый параметр вызываемой функции
//  Параметр2 - Произвольный - второй параметр вызываемой функции
//  Параметр3 - Произвольный - третий параметр вызываемой функции
//
// Возвращаемое значение:
//   Произвольный - зависит от конкретной вызванной функции
//
Функция РезультатФункцииТитулов(ИмяМетаданных, ИмяФункции,
		Параметр1 = Неопределено, Параметр2 = Неопределено, Параметр3 = Неопределено) Экспорт
		
	Если ИмяМетаданных = ТранспортнаяНакладная() Тогда
		Возврат МодульКода("Перечисления.ESD_ТипТитулаЭтрН").РезультатФункцииТитуловЭТрН(ИмяФункции, Параметр1, Параметр2, Параметр3);
	ИначеЕсли ИмяМетаданных = ПутевойЛист() Тогда
		Возврат МодульКода("Перечисления.ESD_ТипТитулаЭПЛ").РезультатФункцииТитуловЭПЛ(ИмяФункции, Параметр1, Параметр2, Параметр3);
	ИначеЕсли ИмяМетаданных = ЗаказНаПеревозку() Тогда
		Возврат МодульКода("Перечисления.ESD_ТипТитулаЗнП").РезультатФункцииТитуловЗнП(ИмяФункции, Параметр1, Параметр2, Параметр3);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ПрочитатьПоОбъекту(ОбъектИС, Сервис = "", Аккаунт = "") Экспорт
	
	Возврат Новый Структура("Объект,Сервис,Аккаунт,АктивныйЭтап,Состояние,UID,SbisId");
	
КонецФункции

#Область Пользователи

////////////////////////////////////////////////////////////////////////////////
// Процедуры и функции работы с пользователями.

// Только для внутреннего использования.
//
// Возвращаемое значение:
//  СправочникСсылка.Пользователи
//  СправочникСсылка.ВнешниеПользователи
//
Функция ТекущийПользователь() Экспорт
	
	Если ТипЗнч(ПараметрыСеанса) = Тип("Структура") Тогда
		ТекущийВнешнийПользователь = Неопределено;
		ПараметрыСеанса.Свойство("ТекущийВнешнийПользователь", ТекущийВнешнийПользователь);
		ТекущийПользователь = Неопределено;
		ПараметрыСеанса.Свойство("ТекущийПользователь", ТекущийПользователь);
	ИначеЕсли ТипЗнч(ПараметрыСеанса) = Тип("Соответствие") Тогда
		ТекущийВнешнийПользователь = ПараметрыСеанса["ТекущийВнешнийПользователь"];
		ТекущийПользователь = ПараметрыСеанса["ТекущийПользователь"];
	Иначе
		ТекущийВнешнийПользователь = Неопределено;
		ТекущийПользователь = Неопределено;
	КонецЕсли;
	
	РезультатФункции = ТекущийВнешнийПользователь;
	Если Не ЗначениеЗаполнено(РезультатФункции) Тогда
		РезультатФункции = ТекущийПользователь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(РезультатФункции) Тогда
		РезультатФункции = ПользовательПоПользователюИнформационнойБазы();
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ПользовательПоПользователюИнформационнойБазы() Экспорт
	
	РезультатФункции = Неопределено;
	СправочникПользователи = Метаданные.Справочники.Найти("Пользователи");
	Если СправочникПользователи = Неопределено 
		Или СправочникПользователи.Реквизиты.Найти("ИдентификаторПользователяИБ") = Неопределено Тогда
		Возврат РезультатФункции;
	КонецЕсли;
	
	ПользовательИнформационнойБазы = ПользователиИнформационнойБазы.ТекущийПользователь();
	
	ЗапросДанных = Новый Запрос;
	ЗапросДанных.Текст =
	"ВЫБРАТЬ
	|	Пользователи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.ИдентификаторПользователяИБ = &ИдентификаторПользователяИБ";
	
	ЗапросДанных.УстановитьПараметр("ИдентификаторПользователяИБ", ПользовательИнформационнойБазы.УникальныйИдентификатор);
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	ВыборкаДанных = ЗапросДанных.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ВыборкаДанных.Следующий() Тогда
		РезультатФункции = ВыборкаДанных.Ссылка;
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

#КонецОбласти // Пользователи

#Область include_etrn_base_CommonModule_ТНОбщегоНазначенияСервер_ПараметрыДаты
#КонецОбласти // include_etrn_base_CommonModule_ТНОбщегоНазначенияСервер_ПараметрыДаты

#Область ЗаполнениеНаОснованииИспользуяНастройкиСопоставления

Функция СтруктураЗаполненияНаОснованииНовогоРедактора(МассивОснований) Экспорт
	
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("НовыйРедактор",   Истина);
	РезультатФункции.Вставить("МассивОснований", МассивОснований);
	РезультатФункции.Вставить("ТипТитула",       Неопределено);
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ЗаполнениеНаОснованииПоНовомуРедактору(Форма, СсылкаНаОснование) Экспорт
	
	МассивОснованийДляЗаполнения = ДанныеОснованийДляЗаполненияНаОснованииINI(СсылкаНаОснование);
	МассивОснований = Новый Массив;
	Для Каждого СтруктураОснования Из МассивОснованийДляЗаполнения Цикл
		МассивОснований.Добавить(СтруктураОснования.Основание);
	КонецЦикла;
	
	ОбъектЗаполнения = Форма.РеквизитФормыВЗначение("Объект");
	
	СтруктураЗаполнения = СтруктураЗаполненияНаОснованииНовогоРедактора(МассивОснований);
	ОбъектЗаполнения.Заполнить(СтруктураЗаполнения);
	
	НеобходимоЗаполнитьСсылкуНаОснование = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ЕстьРеквизитИлиСвойство(
		ОбъектЗаполнения, "ДокументОснование_ОбъектМетаданных");
		
	Если НеобходимоЗаполнитьСсылкуНаОснование Тогда
		ОбъектЗаполнения.ДокументОснование_ОбъектМетаданных = СсылкаНаОснование.Метаданные().Имя;
		ОбъектЗаполнения.ДокументОснование_Идентификатор    = СсылкаНаОснование.УникальныйИдентификатор();
	КонецЕсли;
	
	Форма.ЗначениеВРеквизитФормы(ОбъектЗаполнения, "Объект");
	
	Форма.ПриЧтенииСозданииПослеЗаписиНаСервере();
	
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("ОК",        Истина);
	РезультатФункции.Вставить("Ошибка",    "");
	РезультатФункции.Вставить("Ссылка",    Неопределено);
	РезультатФункции.Вставить("Основание", Неопределено);
	
	Если ОбъектЗаполнения.ДополнительныеСвойства.Свойство("ОшибкаСопоставления") Тогда
		
		РезультатФункции.ОК = Ложь;
		РезультатФункции.Ошибка    = ОбъектЗаполнения.ДополнительныеСвойства.ОшибкаСопоставления.Текст;
		РезультатФункции.Ссылка    = ОбъектЗаполнения.ДополнительныеСвойства.ОшибкаСопоставления.Ссылка;
		РезультатФункции.Основание = ОбъектЗаполнения.ДополнительныеСвойства.ОшибкаСопоставления.Основание;
		
	КонецЕсли;
		
	Возврат РезультатФункции;
	
КонецФункции

Процедура ЗаполнитьНаОснованииИспользуяНастройкиСопоставления(ОбъектЗаполнения, ДанныеЗаполнения) Экспорт
	
	ДоступныеПоля = ОбъектЗаполнения.ДоступныеПоляПоЭтапу(ДанныеЗаполнения.ТипТитула);
	
	МассивРассчитанныхОснований = Новый Массив;
	Для Каждого СсылкаНаОснование Из ДанныеЗаполнения.МассивОснований Цикл
		
		МетаданныеОбъекта = ОбъектЗаполнения.Метаданные();
		Источник = СсылкаНаОснование.Метаданные().ПолноеИмя();
		Приемник = МетаданныеОбъекта.ПолноеИмя();
		
		ОбъектНастроекСопоставлений = МодульКода("Справочники.ESD_НастройкиСопоставлений").СсылкаПоИсточникуПриемнику(
			Источник, Приемник);
		Если Не ЗначениеЗаполнено(ОбъектНастроекСопоставлений) Тогда
			ОбъектНастроекСопоставлений = МодульКода("Справочники.ESD_НастройкиСопоставлений").СсылкаПоИсточникуПриемнику(
				"", Приемник);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ОбъектНастроекСопоставлений) Тогда
			СообщитьПользователюСервер("Нет настроек сопоставления для объекта: " + Источник);
			Продолжить;
		КонецЕсли;
		
		ОбъектНастроекСопоставлений = ОбъектНастроекСопоставлений.ПолучитьОбъект();
		ОбъектНастроекСопоставлений.Источник = Источник;
		РезультатРасчетаПолей = ОбъектНастроекСопоставлений.РезультатРасчетаПолей(СсылкаНаОснование);
		
		ОшибкиРасчета = РезультатРасчетаПолей["Ошибки"];
		Если ЗначениеЗаполнено(ОшибкиРасчета) Тогда
			
			ТекстОшибки = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрСоединитьЭПД(ОшибкиРасчета, "; ");
			
			ОшибкаСопоставления = Новый Структура;
			ОшибкаСопоставления.Вставить("Текст",     ТекстОшибки);
			ОшибкаСопоставления.Вставить("Ссылка",    ОбъектНастроекСопоставлений.Ссылка);
			ОшибкаСопоставления.Вставить("Основание", СсылкаНаОснование);
			ОбъектЗаполнения.ДополнительныеСвойства.Вставить("ОшибкаСопоставления", ОшибкаСопоставления);
			
		КонецЕсли;
		
		ОставитьТолькоДоступныеПоляПоЭтапу(РезультатРасчетаПолей, ДоступныеПоля);
		
		МассивРассчитанныхОснований.Добавить(РезультатРасчетаПолей);
		
	КонецЦикла;
	
	ПередЗаполнением(ОбъектЗаполнения, ДанныеЗаполнения, ДоступныеПоля);
	
	ПервоеОснование = Истина;
	Для Каждого РезультатРасчетаПолей Из МассивРассчитанныхОснований Цикл
		ОбъектЗаполнения.ЗаполнитьНаОснованииРасчетаСопоставлений(РезультатРасчетаПолей, ДанныеЗаполнения.ТипТитула, ПервоеОснование);
		ПервоеОснование = Ложь;
	КонецЦикла;
	
	// Место группировки грузов
	СгрупироватьГрузПоОснованиям(ОбъектЗаполнения, МассивРассчитанныхОснований);
	
КонецПроцедуры

Процедура ПередЗаполнением(ОбъектЗаполнения, ДанныеЗаполнения, ДоступныеПоля) Экспорт
	
	МетаданныеОбъекта = ОбъектЗаполнения.Метаданные();
	
	ЭтоПервыйТитул = РезультатФункцииТитулов(МетаданныеОбъекта.Имя, "ЭтоПервыйТитул", ДанныеЗаполнения.ТипТитула);
	Если ЭтоПервыйТитул = Неопределено Тогда
		ЭтоПервыйТитул = Истина;
	КонецЕсли;
	
	Если Не ЭтоПервыйТитул Тогда
		Возврат;
	КонецЕсли;
	
	НеобходимыеРеквизиты = Новый Соответствие;
	НеобходимыеРеквизиты.Вставить("Код",          Истина);
	НеобходимыеРеквизиты.Вставить("Наименование", Истина);
	
	Для Каждого СтандартныйРеквизит Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
		Если НеобходимыеРеквизиты.Получить(СтандартныйРеквизит.Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОчиститьЕслиДоступно(ОбъектЗаполнения, СтандартныйРеквизит.Имя, ДоступныеПоля);
	КонецЦикла;
	
	РеквизитыИсключения = Новый Соответствие;
	РеквизитыИсключения.Вставить("ПЛПредыдущий", Истина);
	РеквизитыИсключения.Вставить("ПЛСледующий",  Истина);
	Для Каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
		Если РеквизитыИсключения[Реквизит.Имя] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОчиститьЕслиДоступно(ОбъектЗаполнения, Реквизит.Имя, ДоступныеПоля);
	КонецЦикла;
	
	ТЧИсключения = Новый Соответствие;
	ТЧИсключения.Вставить("ДанныеЮрЛиц", Истина);
	Для Каждого ТабличнаяЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
		Если ТЧИсключения[ТабличнаяЧасть.Имя] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОчиститьЕслиДоступно(ОбъектЗаполнения, ТабличнаяЧасть.Имя, ДоступныеПоля, Истина);
	КонецЦикла;
	
КонецПроцедуры

Процедура ОчиститьЕслиДоступно(ОбъектЗаполнения, ИмяРеквизита, ДоступныеПоля, ЭтоТабличнаяЧасть = Ложь) Экспорт
	
	РеквизитДоступен = ДоступныеПоля.Количество() = 0;
	Если ЭтоТабличнаяЧасть И РеквизитДоступен Тогда
		ОбъектЗаполнения[ИмяРеквизита].Очистить();
	КонецЕсли;
	
	РеквизитДоступен = РеквизитДоступен Или ДоступныеПоля[ИмяРеквизита] <> Неопределено;
	Если Не ЭтоТабличнаяЧасть И РеквизитДоступен Тогда
		ОбъектЗаполнения[ИмяРеквизита] = "";
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыОбъекта(ОбъектЗаполнения, РезультатРасчетаПолей, Очищать) Экспорт
	
	МетаданныеОбъекта = ОбъектЗаполнения.Метаданные();
	
	Для Каждого КлючЗначение Из РезультатРасчетаПолей Цикл
		Если МетаданныеОбъекта.Реквизиты.Найти(КлючЗначение.Ключ) <> Неопределено
			Или ЕстьВСтандартныхРеквизитах(МетаданныеОбъекта.СтандартныеРеквизиты, КлючЗначение.Ключ) Тогда
			Значение = КлючЗначение.Значение;
			Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
				Значение = Значение["Ссылка"];
			КонецЕсли;
			ОбъектЗаполнения[КлючЗначение.Ключ] = Значение;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ЕстьВСтандартныхРеквизитах(СтандартныеРеквизиты, Реквизит) Экспорт
	
	РезультатФункции = Ложь;
	
	Для Каждого СтандартныйРеквизит Из СтандартныеРеквизиты Цикл
		РезультатФункции = РезультатФункции Или СтандартныйРеквизит.Имя = Реквизит;
	КонецЦикла;
	
	Возврат РезультатФункции;
	
КонецФункции

Процедура ЗаполнитьДанныеЮрЛиц(ОбъектЗаполнения, РезультатРасчетаПолей, МассивЮрЛиц) Экспорт
	
	Для Каждого ИмяЮрЛица Из МассивЮрЛиц Цикл
		
		ДанныеЮрЛица = РезультатРасчетаПолей[ИмяЮрЛица];
		Если ДанныеЮрЛица = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ОчиститьДанныеЮрЛиц(ОбъектЗаполнения, ИмяЮрЛица);
		
		ЗаполнитьДанныеЮрЛица(ОбъектЗаполнения, ДанныеЮрЛица, ИмяЮрЛица);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ЗаполнитьДанныеЮрЛица(ОбъектЗаполнения, ДанныеЮрЛица, ИмяЮрЛица) Экспорт
	
	Если Не ЗначениеЗаполнено(ДанныеЮрЛица) Тогда
		Возврат 0;
	КонецЕсли;
	
	КлючСтроки = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").НовыйКлючОсновнойСтроки(ОбъектЗаполнения, "ДанныеЮрЛиц");
		
	СтрокаЮрЛица = ОбъектЗаполнения.ДанныеЮрЛиц.Добавить();
	ЗаполнитьЗначенияИзСоответствия(СтрокаЮрЛица, ДанныеЮрЛица);
	СтрокаЮрЛица.НаименованиеОрганизации = ДанныеЮрЛица["Наименование"];
	СтрокаЮрЛица.КлючСтроки = КлючСтроки;
	СтрокаЮрЛица.Роль = МодульКода("Перечисления.ESD_РолиКонтрагентов").РольПоИмени(ИмяЮрЛица);
	
	СтруктураФИО = МодульКода("ESD_ТНЗагрузкаСервер").СтруктураФИО(ДанныеЮрЛица);
	СтрокаЮрЛица.СтруктураФИО = ЗначениеВСтрокуВнутр(СтруктураФИО);
	
	КлючКонтактныеДанные = "КонтактныеДанные";
	Если ДанныеЮрЛица[КлючКонтактныеДанные] <> Неопределено Тогда
		Для Каждого СтруктураКонтактныхДанных Из ДанныеЮрЛица[КлючКонтактныеДанные] Цикл
			СтрокаКонтактныхДанных = ОбъектЗаполнения.КонтактныеДанные.Добавить();
			ЗаполнитьЗначенияИзСоответствия(СтрокаКонтактныхДанных, СтруктураКонтактныхДанных);
			СтрокаКонтактныхДанных.Роль = СтрокаЮрЛица.Роль;
			СтрокаКонтактныхДанных.КлючСтроки_ДанныеЮрЛиц = СтрокаЮрЛица.КлючСтроки;
		КонецЦикла;
	КонецЕсли;
	
	Возврат СтрокаЮрЛица.КлючСтроки;
	
КонецФункции

Процедура ОчиститьДанныеЮрЛиц(ОбъектЗаполнения, ИмяЮрЛица) Экспорт
	
	ОтборДанныеЮрЛиц = Новый Структура;
	ОтборДанныеЮрЛиц.Вставить("Роль", МодульКода("Перечисления.ESD_РолиКонтрагентов").РольПоИмени(ИмяЮрЛица));
	
	ОтборКонтактныхДанных = Новый Структура;
	ОтборКонтактныхДанных.Вставить("КлючСтроки_ДанныеЮрЛиц", "");
	
	СтрокиДанныеЮрЛиц = ОбъектЗаполнения.ДанныеЮрЛиц.НайтиСтроки(ОтборДанныеЮрЛиц);
	Для Каждого СтрокаДанныеЮрЛиц Из СтрокиДанныеЮрЛиц Цикл
		
		ОтборКонтактныхДанных.КлючСтроки_ДанныеЮрЛиц = СтрокаДанныеЮрЛиц.КлючСтроки;
		СтрокиКонтактныеДанные = ОбъектЗаполнения.КонтактныеДанные.НайтиСтроки(ОтборКонтактныхДанных);
		Для Каждого СтрокаКонтактныеДанные Из СтрокиКонтактныеДанные Цикл
			ОбъектЗаполнения.КонтактныеДанные.Удалить(СтрокаКонтактныеДанные);
		КонецЦикла;
		
		ОбъектЗаполнения.ДанныеЮрЛиц.Удалить(СтрокаДанныеЮрЛиц);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТранспортныеСредства(ОбъектЗаполнения, РезультатРасчетаПолей) Экспорт
	
	ТранспортноеСредство = РезультатРасчетаПолей["ТранспортноеСредство"];
	Если ТранспортноеСредство <> Неопределено Тогда
		ВидАвтомобиль = ЗначениеМетаданных("ESD_ВидыТС.Автомобиль");
		РегистрационныйНомер = ТранспортноеСредство["Наименование"];
		Если ЗначениеЗаполнено(РегистрационныйНомер) Тогда
			ОчиститьТранспортноеСредство(ОбъектЗаполнения, ВидАвтомобиль);
			СтрокаТранспортногоСредства = ОбъектЗаполнения.ТранспортныеСредства.Добавить();
			СтрокаТранспортногоСредства.Вид = ВидАвтомобиль;
			ЗаполнитьЗначенияИзСоответствия(СтрокаТранспортногоСредства, ТранспортноеСредство);
			СтрокаТранспортногоСредства.РегистрационныйНомер = РегистрационныйНомер;
			ЗаполнитьДокументыВладения(СтрокаТранспортногоСредства, ТранспортноеСредство);
		КонецЕсли;
	КонецЕсли;
	
	Прицепы = РезультатРасчетаПолей["Прицепы"];
	Если Прицепы <> Неопределено Тогда
		ВидПрицеп = ЗначениеМетаданных("ESD_ВидыТС.Прицеп");
		ОчиститьТранспортноеСредство(ОбъектЗаполнения, ВидПрицеп);
		Для Каждого Прицеп Из Прицепы Цикл
			Путь = Новый Массив;
			Путь.Добавить("Прицепы.Прицеп");
			Прицеп = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ЗначениеИзКоллекции(
				Прицеп, Путь, Новый Соответствие);
			СтрокаТранспортногоСредства = ОбъектЗаполнения.ТранспортныеСредства.Добавить();
			СтрокаТранспортногоСредства.Вид = ВидПрицеп;
			ЗаполнитьЗначенияИзСоответствия(СтрокаТранспортногоСредства, Прицеп);
			СтрокаТранспортногоСредства.РегистрационныйНомер = Прицеп["Наименование"];
			ЗаполнитьДокументыВладения(СтрокаТранспортногоСредства, Прицеп);
			Если Не ЗначениеЗаполнено(СтрокаТранспортногоСредства.РегистрационныйНомер) Тогда
				ОбъектЗаполнения.ТранспортныеСредства.Удалить(ОбъектЗаполнения.ТранспортныеСредства.Количество() - 1);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОчиститьТранспортноеСредство(ОбъектЗаполнения, Вид) Экспорт
	
	ОтборТранспорта = Новый Структура;
	ОтборТранспорта.Вставить("Вид", Вид);
	
	СтрокиТранспорта = ОбъектЗаполнения.ТранспортныеСредства.НайтиСтроки(ОтборТранспорта);
	Для Каждого СтрокаТранспорта Из СтрокиТранспорта Цикл
		ОбъектЗаполнения.ТранспортныеСредства.Удалить(СтрокаТранспорта);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДокументыВладения(СтрокаТранспортногоСредства, ТранспортноеСредство) Экспорт
	
	ДокументыВладения = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ЗначениеИзКоллекции(
		ТранспортноеСредство, "ДокументыВладения", Новый Массив);
	
	ОснованияВладения = Новый Массив;
	Для Каждого ДокументВладения Из ДокументыВладения Цикл
		Путь = Новый Массив;
		Путь.Добавить("ДокументыВладения.ДокументВладения");
		ДокументВладения = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ЗначениеИзКоллекции(
			ДокументВладения, Путь, Новый Соответствие);
		Если ЗначениеЗаполнено(ДокументВладения["Ссылка"]) Тогда
			ОснованияВладения.Добавить(ДокументВладения["Ссылка"]);
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ОснованияВладения) Тогда
		СтрокаТранспортногоСредства.ОснованияВладения = ЗначениеВСтрокуВнутр(ОснованияВладения);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьВодителей(ОбъектЗаполнения, РезультатРасчетаПолей) Экспорт
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	
	Водители = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(РезультатРасчетаПолей, "Водители", Новый Массив);
	
	РольВодитель = ЗначениеМетаданных("ESD_РолиОтветственных.Водитель");
	
	Если Водители.Количество() > 0 Тогда
		// Если в нескольких документах есть водитель, то берем водителя из последнего документа
		ОчиститьОтветственных(ОбъектЗаполнения, "Водитель");
	КонецЕсли;
	
	Для Каждого Водитель Из Водители Цикл
		Водитель = Водитель["Водители.Водитель"];
		КлючСтроки = МодульТНОбщегоНазначенияКлиентСервер.НовыйКлючОсновнойСтроки(ОбъектЗаполнения, "ОтветственныеЛица");
		СтрокаОтветственного = ОбъектЗаполнения.ОтветственныеЛица.Добавить();
		ЗаполнитьЗначенияИзСоответствия(СтрокаОтветственного, Водитель);
		ФИОЗаполнено = ЗначениеЗаполнено(СтрокаОтветственного.Фамилия)
			Или ЗначениеЗаполнено(СтрокаОтветственного.Имя)
			Или ЗначениеЗаполнено(СтрокаОтветственного.Отчество);
		Если Не ФИОЗаполнено Тогда
			ОбъектЗаполнения.ОтветственныеЛица.Удалить(ОбъектЗаполнения.ОтветственныеЛица.Количество() - 1);
			Продолжить;
		КонецЕсли;
		СтрокаОтветственного.Телефоны   = "";
		СтрокаОтветственного.КлючСтроки = КлючСтроки;
		СтрокаОтветственного.Роль       = РольВодитель;
		СтрокаОтветственного.Серия      = Водитель["СерияВУ"];
		СтрокаОтветственного.Номер      = Водитель["НомерВУ"];
		СтрокаОтветственного.ДатаВыдачи = Водитель["ДатаВыдачиВУ"];
		
		ЗаполнитьТелефоныОтветственногоЛица(СтрокаОтветственного, Водитель);
		
		Путь = Новый Массив;
		Путь.Добавить("Водители.ПутевыеЛисты");
		ПутевыеЛисты = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(Водитель, Путь, Новый Массив);
		Для Каждого ПутевойЛист Из ПутевыеЛисты Цикл
			ПутевойЛист = ПутевойЛист["Водители.ПутевыеЛисты.Документ"];
			СтрокаПутевогоЛиста = ОбъектЗаполнения.ПутевыеЛисты.Добавить();
			СтрокаПутевогоЛиста.Документ = ПутевойЛист["Ссылка"];
			СтрокаПутевогоЛиста.КлючСтроки_ОтветственныеЛица = КлючСтроки;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьГрузы(ОбъектЗаполнения, РезультатРасчетаПолей) Экспорт
	
	ПолеГрузы = РезультатРасчетаПолей["Грузы"];
	Если ПолеГрузы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Груз Из ПолеГрузы Цикл
		
		КлючСтрокиЮрЛица = 0;
		ДанныеЗаказчика = Груз["Грузы.Заказчик"];
		Если ДанныеЗаказчика <> Неопределено Тогда
			КлючСтрокиЮрЛица = ЗаполнитьДанныеЮрЛица(ОбъектЗаполнения, ДанныеЗаказчика, "Заказчик");
		КонецЕсли;
		
		СтрокаГруза = ОбъектЗаполнения.Грузы.Добавить();
		ЗаполнитьЗначенияИзСоответствия(СтрокаГруза, Груз);
		СтрокаГруза.КлючСтроки = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").НовыйКлючОсновнойСтроки(ОбъектЗаполнения, "Грузы");
		СтрокаГруза.КлючСтроки_ДанныеЮрЛиц = КлючСтрокиЮрЛица;
		
		ЗаполнитьПодчиненныеГрузуТаблицы(ОбъектЗаполнения, Груз, СтрокаГруза.КлючСтроки);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПодчиненныеГрузуТаблицы(ОбъектЗаполнения, Груз, КлючСтроки_Грузы) Экспорт
	
	ПодчиненныеТаблицы = Новый Массив;
	ПодчиненныеТаблицы.Добавить("Маркировки");
	ПодчиненныеТаблицы.Добавить("Контейнеры");
	ПодчиненныеТаблицы.Добавить("ОпасныеГрузы");
	ПодчиненныеТаблицы.Добавить("СведенияГосСистем");
	
	Для Каждого ИмяПодчиненнойТаблицы Из ПодчиненныеТаблицы Цикл
		ДанныеПодчиненнойТаблицы = Груз["Грузы." + ИмяПодчиненнойТаблицы];
		Если ДанныеПодчиненнойТаблицы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтруктураДанныхПодчиненнойТаблицы Из ДанныеПодчиненнойТаблицы Цикл
			СтрокаПодчиненнойТаблицы = ОбъектЗаполнения[ИмяПодчиненнойТаблицы].Добавить();
			ЗаполнитьЗначенияИзСоответствия(СтрокаПодчиненнойТаблицы, СтруктураДанныхПодчиненнойТаблицы);
			СтрокаПодчиненнойТаблицы.КлючСтроки_Грузы = КлючСтроки_Грузы;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьОтветственных(ОбъектЗаполнения, РезультатРасчетаПолей, МассивОтветственных) Экспорт
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	
	Для Каждого ИмяОтветственного Из МассивОтветственных Цикл
		Ответственный = РезультатРасчетаПолей[ИмяОтветственного];
		Если Ответственный = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Роль = МодульТНОбщегоНазначенияКлиентСервер.СтрРазделитьЭПД(ИмяОтветственного, "_");
		Роль = Роль[Роль.ВГраница()];
		
		ОчиститьОтветственных(ОбъектЗаполнения, Роль);
		
		СтрокаОтветственногоЛица = ОбъектЗаполнения.ОтветственныеЛица.Добавить();
		ЗаполнитьЗначенияИзСоответствия(СтрокаОтветственногоЛица, Ответственный);
		СтрокаОтветственногоЛица.КлючСтроки = МодульТНОбщегоНазначенияКлиентСервер.НовыйКлючОсновнойСтроки(
			ОбъектЗаполнения, "ОтветственныеЛица");
		СтрокаОтветственногоЛица.Роль = ЗначениеМетаданных("ESD_РолиОтветственных." + Роль);
		СтрокаОтветственногоЛица.Серия      = Ответственный["ЛицензияСерия"];
		СтрокаОтветственногоЛица.Номер      = Ответственный["ЛицензияНомер"];
		СтрокаОтветственногоЛица.ДатаВыдачи = Ответственный["ЛицензияДатаС"];
		Если МодульТНОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойство(СтрокаОтветственногоЛица, "ДатаОкончанияДействия") Тогда
			СтрокаОтветственногоЛица.ДатаОкончанияДействия = Ответственный["ЛицензияДатаПо"];
		КонецЕсли;
		
		СтрокаОтветственногоЛица.Телефоны = "";
		ЗаполнитьТелефоныОтветственногоЛица(СтрокаОтветственногоЛица, Ответственный);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОчиститьОтветственных(ОбъектЗаполнения, ИмяОтветственного) Экспорт
	
	ОтборОтветственного = Новый Структура;
	ОтборОтветственного.Вставить("Роль", ЗначениеМетаданных("ESD_РолиОтветственных." + ИмяОтветственного));
	
	ОтборПутевыхЛистов = Новый Структура;
	ОтборПутевыхЛистов.Вставить("КлючСтроки_ОтветственныеЛица", "");
	
	СтрокиОтветственных = ОбъектЗаполнения.ОтветственныеЛица.НайтиСтроки(ОтборОтветственного);
	Для Каждого СтрокаОтветственного Из СтрокиОтветственных Цикл
		ОтборПутевыхЛистов.КлючСтроки_ОтветственныеЛица = СтрокаОтветственного.КлючСтроки;
		Если МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ЕстьРеквизитИлиСвойство(ОбъектЗаполнения, "ПутевыеЛисты") Тогда
			СтрокиПутевыхЛистов = ОбъектЗаполнения.ПутевыеЛисты.НайтиСтроки(ОтборПутевыхЛистов);
			Для Каждого СтрокаПутевогоЛиста Из СтрокиПутевыхЛистов Цикл
				ОбъектЗаполнения.ПутевыеЛисты.Удалить(СтрокаПутевогоЛиста);
			КонецЦикла;
		КонецЕсли;
		ОбъектЗаполнения.ОтветственныеЛица.Удалить(СтрокаОтветственного);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТелефоныОтветственногоЛица(СтрокаОтветственного, ДанныеОтветственного) Экспорт
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	
	Телефоны = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(ДанныеОтветственного, "Телефоны", Новый Массив);
	МассивТелефонов = Новый Массив;
	Для Каждого ДанныеТелефона Из Телефоны Цикл
		Путь = Новый Массив;
		Путь.Добавить("Телефоны.Телефон");
		ЗначениеТелефона = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(ДанныеТелефона, Путь);
		Если ЗначениеЗаполнено(ЗначениеТелефона) Тогда
			МассивТелефонов.Добавить(ЗначениеТелефона);
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(МассивТелефонов) Тогда
		СтрокаОтветственного.Телефоны = ЗначениеВСтрокуВнутр(МассивТелефонов);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьЗначенияИзСоответствия(Приемник, Источник) Экспорт
	
	Если ТипЗнч(Источник) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;
	
	ПрефиксМножественногоПоля = "";
	Для Каждого КлючЗначение Из Источник Цикл
		Ключ = КлючЗначение.Ключ;
		
		ПозицияТочки = Найти(Ключ, ".");
		Пока ПозицияТочки > 0 Цикл
			ПрефиксМножественногоПоля = ПрефиксМножественногоПоля + Лев(Ключ, ПозицияТочки);
			Ключ = Прав(Ключ, СтрДлина(Ключ) - ПозицияТочки);
			ПозицияТочки = Найти(Ключ, ".");
		КонецЦикла;
		
		Прервать;
	КонецЦикла;
	
	СтруктураДляЗаполнения = Новый Структура;
	Для Каждого КлючЗначение Из Источник Цикл
		Ключ = СтрЗаменить(КлючЗначение.Ключ, ПрефиксМножественногоПоля, "");
		Значение = КлючЗначение.Значение;
		Если ТипЗнч(Значение) = Тип("Соответствие") И ЗначениеЗаполнено(Значение["Ссылка"]) Тогда
			Значение = Значение["Ссылка"];
		КонецЕсли;
		СтруктураДляЗаполнения.Вставить(Ключ, Значение);
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(Приемник, СтруктураДляЗаполнения);
	
КонецПроцедуры

#Область ЗаполнениеСсылок

Процедура ЗаполнитьСсылкиНаОбъекты(РезультатРасчетаПолей) Экспорт
	
	ЗаполнитьСсылкиДокументовЭПД(РезультатРасчетаПолей);
	
	ЗаполнитьСсылкиВидовУпаковки(РезультатРасчетаПолей);
	
	ЗаполнитьСсылкиОпасныхГрузов(РезультатРасчетаПолей);
	
КонецПроцедуры

Процедура ЗаполнитьСсылкиДокументовЭПД(РезультатРасчетаПолей) Экспорт
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	МодульСправочникДокументыЭПД         = МодульКода("Справочники.ESD_ДокументыЭПД");
	
	ЗначениеДоговорПеревозки = ЗначениеМетаданных("ESD_ТипыДокумента.ДоговорПеревозки");

	МассивДанныхДокументовЭПД = Новый Массив;
	
	МодульСправочникДокументыЭПД.ДобавитьДанныеДокументаЭПД(
		МассивДанныхДокументовЭПД,
		РезультатРасчетаПолей["Заказчик_Договор"],
		ЗначениеДоговорПеревозки);
		
	МодульСправочникДокументыЭПД.ДобавитьДанныеДокументаЭПД(
		МассивДанныхДокументовЭПД,
		РезультатРасчетаПолей["Договор"],
		ЗначениеДоговорПеревозки);
		
	МодульСправочникДокументыЭПД.ДобавитьДанныеДокументаЭПД(
		МассивДанныхДокументовЭПД,
		РезультатРасчетаПолей["ИнициаторПереадресацииПодтверждение"],
		ЗначениеМетаданных("ESD_ТипыДокумента.ПравоПереадресации"));
		
	МодульСправочникДокументыЭПД.ДобавитьДанныеДокументаЭПД(
		МассивДанныхДокументовЭПД,
		РезультатРасчетаПолей["Отгрузка_НаОснованииДокумент"],
		ЗначениеМетаданных("ESD_ТипыДокумента.ПередачиЦенностей"));
		
	МодульСправочникДокументыЭПД.ДобавитьДанныеДокументаЭПД(
		МассивДанныхДокументовЭПД,
		РезультатРасчетаПолей["Отгрузка_ОтветственныйНаОсновании"],
		ЗначениеМетаданных("ESD_ТипыДокумента.ОтветственныйНаОсновании"));
		
	МодульСправочникДокументыЭПД.ДобавитьДанныеДокументаЭПД(
		МассивДанныхДокументовЭПД,
		РезультатРасчетаПолей["Отправитель_СопроводительнаяВедомость"],
		ЗначениеМетаданных("ESD_ТипыДокумента.СопроводительнаяВедомость"));
		
	МодульСправочникДокументыЭПД.ДобавитьДанныеДокументаЭПД(
		МассивДанныхДокументовЭПД,
		РезультатРасчетаПолей["Составитель_НаОснованииДокумент"],
		ЗначениеМетаданных("ESD_ТипыДокумента.СоставительНаОсновании"));
		
	МодульСправочникДокументыЭПД.ДобавитьДанныеДокументаЭПД(
		МассивДанныхДокументовЭПД,
		РезультатРасчетаПолей["ПредставительЗаказчика_Основание"],
		ЗначениеМетаданных("ESD_ТипыДокумента.СоставительНаОсновании"));
	
	ДокументыВладенияТС = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(
		РезультатРасчетаПолей, "ТранспортноеСредство.ДокументыВладения", Новый Массив);
	Для Каждого ДокументВладенияТС Из ДокументыВладенияТС Цикл
		МодульСправочникДокументыЭПД.ДобавитьДанныеДокументаЭПД(
			МассивДанныхДокументовЭПД,
			ДокументВладенияТС["ДокументыВладения.ДокументВладения"],
			ЗначениеМетаданных("ESD_ТипыДокумента.ПодтверждениеВладения"));
	КонецЦикла;
	
	Водители = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(РезультатРасчетаПолей, "Водители", Новый Массив);
	Для Каждого Водитель Из Водители Цикл
		ДанныеПутевыхЛистов = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(Водитель, "ПутевыеЛисты", Новый Массив);
		Для Каждого ПутевойЛист Из ДанныеПутевыхЛистов Цикл
			МодульСправочникДокументыЭПД.ДобавитьДанныеДокументаЭПД(
				МассивДанныхДокументовЭПД,
				ПутевойЛист["Водители.ПутевыеЛисты.Документ"],
				ЗначениеМетаданных("ESD_ТипыДокумента.ПутевойЛист"));
		КонецЦикла;
	КонецЦикла;
	
	ДанныеОтметок = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(РезультатРасчетаПолей, "Отметки", Новый Массив);
	Для Каждого Отметка Из ДанныеОтметок Цикл
		ДанныеАктов = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(Отметка, "Акты", Новый Массив);
		Для Каждого Акт Из ДанныеАктов Цикл
			МодульСправочникДокументыЭПД.ДобавитьДанныеДокументаЭПД(МассивДанныхДокументовЭПД, Акт["Отметки.Акты.Документ"]);
		КонецЦикла;
	КонецЦикла;
	
	ДанныеСопроводительныхДокументов = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(
		РезультатРасчетаПолей, "СопроводительныеДокументы", Новый Массив);
	Для Каждого СопроводительныйДокумент Из ДанныеСопроводительныхДокументов Цикл
		МодульСправочникДокументыЭПД.ДобавитьДанныеДокументаЭПД(
			МассивДанныхДокументовЭПД,
			СопроводительныйДокумент["СопроводительныеДокументы.СопроводительныйДокумент"]);
	КонецЦикла;
	
	Прицепы = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(РезультатРасчетаПолей, "Прицепы", Новый Массив);
	Для Каждого Прицеп Из Прицепы Цикл
		Путь = Новый Массив;
		Путь.Добавить("Прицепы.Прицеп");
		Путь.Добавить("ДокументыВладения");
		ДокументыВладенияПрицепа = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(Прицеп, Путь, Новый Массив);
		Для Каждого ДокументВладенияПрицепа Из ДокументыВладенияПрицепа Цикл
			МодульСправочникДокументыЭПД.ДобавитьДанныеДокументаЭПД(
				МассивДанныхДокументовЭПД,
				ДокументВладенияПрицепа["ДокументыВладения.ДокументВладения"],
				ЗначениеМетаданных("ESD_ТипыДокумента.ПодтверждениеВладения"));
		КонецЦикла;
	КонецЦикла;
	
	Грузы = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(РезультатРасчетаПолей, "Грузы", Новый Массив);
	Для Каждого Груз Из Грузы Цикл
		МодульСправочникДокументыЭПД.ДобавитьДанныеДокументаЭПД(
			МассивДанныхДокументовЭПД, Груз["Грузы.Договор"], ЗначениеДоговорПеревозки);
	КонецЦикла;
		
	УполномоченныеЛицаЗаказчика = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(
		РезультатРасчетаПолей, "УполномоченныеЛицаЗаказчика", Новый Массив);
	Для Каждого УполномоченноеЛицоЗаказчика Из УполномоченныеЛицаЗаказчика Цикл
		МодульСправочникДокументыЭПД.ДобавитьДанныеДокументаЭПД(
			МассивДанныхДокументовЭПД,
			УполномоченноеЛицоЗаказчика["УполномоченныеЛицаЗаказчика.Основание"],
			ЗначениеМетаданных("ESD_ТипыДокумента.УполномоченныйНаОсновании"));
	КонецЦикла;
	
	МодульСправочникДокументыЭПД.ЗаполнитьСсылкиДокументовЭПД(МассивДанныхДокументовЭПД);
	
КонецПроцедуры

