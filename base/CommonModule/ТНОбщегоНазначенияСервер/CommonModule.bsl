Процедура ЗагруженныеДанныеПечатнойФормыДляОткрытия(ПараметрыЗагрузки, РезультатФункции, ДополнительныеПараметры)
	
	МодульТНЗагрузкаСервер = МодульКода("ESD_ТНЗагрузкаСервер");
			
	АдресДвоичныхДанныхФайла = МодульТНЗагрузкаСервер.АдресДвоичныхДанныхФайла(ПараметрыЗагрузки, ДополнительныеПараметры);
	Если ПараметрыЗагрузки.ЗагрузкаТребуется И Не ЗначениеЗаполнено(АдресДвоичныхДанныхФайла) Тогда
		Если ДополнительныеПараметры.ВыгрузкаАрхива Тогда
			РезультатФункции.ОписаниеОшибки = "Не удалось получить архив документа из Saby.";
		Иначе 	
			РезультатФункции.ОписаниеОшибки = "Не удалось получить печатную форму из Saby.";
		КонецЕсли;
	Иначе
		РезультатФункции.АдресДвоичныхДанных = АдресДвоичныхДанныхФайла;
	КонецЕсли;
			
КонецПроцедуры

Функция ПрисоединенныйФайлПоВладельцуИОписанию(ВладелецФайла, Описание) Экспорт
	
	РезультатФункции = Неопределено;
	ИмяСправочника = МодульКода("ESD_РаботаСФайлами").ИмяСправочникаХраненияФайлов(ВладелецФайла, "", "", "");
	
	Запрос = Новый Запрос;
	Запрос.Текст = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрШаблонЭПД(
		"ВЫБРАТЬ
		|	Справочник.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.%1 КАК Справочник
		|ГДЕ
		|	Справочник.ВладелецФайла = &ВладелецФайла
		|	И Не Справочник.ПометкаУдаления
		|	И Подстрока(Справочник.Описание,1,100) = &Описание", ИмяСправочника);
	
	Запрос.УстановитьПараметр("ВладелецФайла", ВладелецФайла);
	Запрос.УстановитьПараметр("Описание", Описание);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		РезультатФункции = Выборка.Ссылка;
	КонецЦикла;
	
	Возврат РезультатФункции;
	
КонецФункции

#Область ФормированиеПечатнойФормыQR

Процедура СформироватьПечатнуюФормуQR(Результат, ДополнительныеПараметры)
	
	Если Не ЗначениеЗаполнено(Результат.АдресДвоичныхДанных) Тогда
		Возврат;
	КонецЕсли;
	
	QRКодыДляВывода = QRКодыДляВывода(Результат);
	
	Результат.ПечатнаяФормаQR = Новый ТабличныйДокумент;
	
	ШиринаШтрихкода = 20;
	ШиринаЗаголовка = 80;
	РазмерШрифтаЗаголовка = 14;
	
	Результат.ПечатнаяФормаQR.Область(1, , 1).СоздатьФорматСтрок();
	ОбластьЗаголовка = Результат.ПечатнаяФормаQR.Область(1, 1, 1, 1);
	ОбластьЗаголовка.ШиринаКолонки = ШиринаЗаголовка;
	// BSLLS:StyleElementConstructors-off
	ОбластьЗаголовка.Шрифт = Новый Шрифт(ОбластьЗаголовка.Шрифт, , РазмерШрифтаЗаголовка, Истина);
	// BSLLS:StyleElementConstructors-on
	ОбластьЗаголовка.Текст = ДополнительныеПараметры.Заголовок;
	
	СтрокаДокумента = 2;
	Результат.ПечатнаяФормаQR.Область(СтрокаДокумента, , СтрокаДокумента).СоздатьФорматСтрок();
	НомерКартинки = 1;
	Для Каждого КартинкаКода Из QRКодыДляВывода Цикл
		ОбластьШтрихкода = Результат.ПечатнаяФормаQR.Область(СтрокаДокумента, НомерКартинки, СтрокаДокумента, НомерКартинки);
		ОбластьШтрихкода.ШиринаКолонки = ШиринаШтрихкода;
		ОбластьШтрихкода.Картинка = КартинкаКода;
		НомерКартинки = НомерКартинки + 1;
	КонецЦикла;
	
КонецПроцедуры

Функция QRКодыДляВывода(Результат)
	
	РезультатФункции = Новый Массив;
	
	МассивДвоичныхДанных = ПолучитьИзВременногоХранилища(Результат.АдресДвоичныхДанных);
	УдалитьИзВременногоХранилища(Результат.АдресДвоичныхДанных);
	
	Для Каждого ДвоичныеДанныеКартинки Из МассивДвоичныхДанных Цикл
		КартинкаКода = Новый Картинка(ДвоичныеДанныеКартинки);
		РезультатФункции.Добавить(КартинкаКода);
	КонецЦикла;
	
	Возврат РезультатФункции;
	
КонецФункции

