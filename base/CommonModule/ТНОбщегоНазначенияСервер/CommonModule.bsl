#Область ЮрЛица

Процедура ПолучитьДанныеЮрЛицИзБазы(МассивЮрЛиц, МенеджерВременныхТаблиц)
		
	ЗапросДанных = Новый Запрос;
	ЗапросДанных.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	ЭтаКонфигурация = ЭтоДоступнаяКонфигурация();
	
	Если ЭтаКонфигурация.Имя = "ERP" Тогда
		
		ЗапросДанных.Текст =
		"ВЫБРАТЬ
		|	ДополнительныеСведения.Объект КАК Ссылка,
		|	ДополнительныеСведения.Значение КАК Значение
		|ПОМЕСТИТЬ ДопСведения
		|ИЗ
		|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
		|ГДЕ
		|	ДополнительныеСведения.Объект В(&МассивЮрЛиц)
		|	И ДополнительныеСведения.Свойство.Наименование = &ИмяСвойстваКодФилиала
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка,
		|	Контрагенты.Наименование КАК Наименование,
		|	Контрагенты.ИНН КАК ИНН,
		|	Контрагенты.КПП КАК КПП,
		|	Контрагенты.СтранаРегистрации.Наименование КАК СтранаРегистрации,
		|	Контрагенты.РегистрационныйНомер КАК ОГРН,
		|	ВЫБОР
		|		КОГДА Контрагенты.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
		|			ТОГДА ""ЮрЛицо""
		|		КОГДА Контрагенты.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
		|			ТОГДА ""ИндивидуальныйПредприниматель""
		|		КОГДА Контрагенты.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицоНеРезидент)
		|			ТОГДА ""ЮрЛицоНеРезидент""
		|		КОГДА Контрагенты.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ИндивидуальныйПредприниматель)
		|			ТОГДА ""ИндивидуальныйПредприниматель""
		|	КОНЕЦ КАК ЮрФизЛицо,
		|	ЕСТЬNULL(ДопСведения.Значение, """") КАК КодФилиала
		|ПОМЕСТИТЬ ДанныеЮрЛицИзБазы
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|		ЛЕВОЕ СОЕДИНЕНИЕ ДопСведения КАК ДопСведения
		|		ПО Контрагенты.Ссылка = ДопСведения.Ссылка
		|ГДЕ
		|	Контрагенты.Ссылка В(&МассивЮрЛиц)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Организации.Ссылка,
		|	Организации.Наименование,
		|	Организации.ИНН,
		|	Организации.КПП,
		|	Организации.СтранаРегистрации.Наименование,
		|	Организации.ОГРН,
		|	ВЫБОР
		|		КОГДА Организации.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
		|			ТОГДА ""ЮрЛицо""
		|		КОГДА Организации.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
		|			ТОГДА ""ИндивидуальныйПредприниматель""
		|		КОГДА Организации.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицоНеРезидент)
		|			ТОГДА ""ЮрЛицоНеРезидент""
		|		КОГДА Организации.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ИндивидуальныйПредприниматель)
		|			ТОГДА ""ИндивидуальныйПредприниматель""
		|	КОНЕЦ КАК ЮрФизЛицо,
		|	ЕСТЬNULL(ДопСведения.Значение, """")
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ЛЕВОЕ СОЕДИНЕНИЕ ДопСведения КАК ДопСведения
		|		ПО Организации.Ссылка = ДопСведения.Ссылка
		|ГДЕ
		|	Организации.Ссылка В(&МассивЮрЛиц)";
		
	Иначе
		
		ЗапросДанных.Текст =
		"ВЫБРАТЬ
		|	ДополнительныеСведения.Объект КАК Ссылка,
		|	ДополнительныеСведения.Значение КАК Значение
		|ПОМЕСТИТЬ ДопСведения
		|ИЗ
		|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
		|ГДЕ
		|	ДополнительныеСведения.Объект В(&МассивЮрЛиц)
		|	И ДополнительныеСведения.Свойство.Наименование = &ИмяСвойстваКодФилиала
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка,
		|	Контрагенты.Наименование КАК Наименование,
		|	Контрагенты.ИНН КАК ИНН,
		|	Контрагенты.КПП КАК КПП,
		|	Контрагенты.СтранаРегистрации.Наименование КАК СтранаРегистрации,
		|	Контрагенты.РегистрационныйНомер КАК ОГРН,
		|	ВЫБОР
		|		КОГДА Контрагенты.ЮридическоеФизическоеЛицо = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ЮридическоеЛицо)
		|			ТОГДА ""ЮрЛицо""
		|		КОГДА Контрагенты.ЮридическоеФизическоеЛицо = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ФизическоеЛицо)
		|			ТОГДА ""ИндивидуальныйПредприниматель""
		|	КОНЕЦ КАК ЮрФизЛицо,
		|	ЕСТЬNULL(ДопСведения.Значение, """") КАК КодФилиала
		|ПОМЕСТИТЬ ДанныеЮрЛицИзБазы
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|		ЛЕВОЕ СОЕДИНЕНИЕ ДопСведения КАК ДопСведения
		|		ПО Контрагенты.Ссылка = ДопСведения.Ссылка
		|ГДЕ
		|	Контрагенты.Ссылка В(&МассивЮрЛиц)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Организации.Ссылка,
		|	Организации.Наименование,
		|	Организации.ИНН,
		|	Организации.КПП,
		|	Организации.СтранаРегистрации.Наименование,
		|	Организации.ОГРН,
		|	ВЫБОР
		|		КОГДА Организации.ЮридическоеФизическоеЛицо = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ЮридическоеЛицо)
		|			ТОГДА ""ЮрЛицо""
		|		КОГДА Организации.ЮридическоеФизическоеЛицо = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ФизическоеЛицо)
		|			ТОГДА ""ИндивидуальныйПредприниматель""
		|	КОНЕЦ,
		|	ЕСТЬNULL(ДопСведения.Значение, """")
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ЛЕВОЕ СОЕДИНЕНИЕ ДопСведения КАК ДопСведения
		|		ПО Организации.Ссылка = ДопСведения.Ссылка
		|ГДЕ
		|	Организации.Ссылка В(&МассивЮрЛиц)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ДопСведения";
		
		Если ЭтаКонфигурация.Имя = "УАТ" Тогда
			ЗапросДанных.Текст = СтрЗаменить(ЗапросДанных.Текст, "Контрагенты.РегистрационныйНомер", "&ПустаяСтрока");
		КонецЕсли;
		
		Если ЭтаКонфигурация.Имя = "Бух3" Тогда
			
			ЗапросДанных.Текст = СтрЗаменить(
				ЗапросДанных.Текст,
				"	ВЫБОР
				|		КОГДА Организации.ЮридическоеФизическоеЛицо = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ЮридическоеЛицо)
				|			ТОГДА ""ЮрЛицо""
				|		КОГДА Организации.ЮридическоеФизическоеЛицо = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ФизическоеЛицо)
				|			ТОГДА ""ФизЛицо""
				|	КОНЕЦ",
				"	ВЫБОР
				|		КОГДА Организации.ЮридическоеФизическоеЛицо = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ЮридическоеЛицо)
				|			ТОГДА ""ЮрЛицо""
				|			ИНАЧЕ ""ИндивидуальныйПредприниматель""
				|	КОНЕЦ");
				
			ЗапросДанных.Текст = СтрЗаменить(
				ЗапросДанных.Текст,
				"	ВЫБОР
				|		КОГДА Контрагенты.ЮридическоеФизическоеЛицо = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ЮридическоеЛицо)
				|			ТОГДА ""ЮрЛицо""
				|		КОГДА Контрагенты.ЮридическоеФизическоеЛицо = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ФизическоеЛицо)
				|			ТОГДА ""ИндивидуальныйПредприниматель""
				|	КОНЕЦ",
				"	ВЫБОР
				|		КОГДА Контрагенты.ЮридическоеФизическоеЛицо = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ЮридическоеЛицо)
				|			ТОГДА ""ЮрЛицо""
				|			ИНАЧЕ ""ИндивидуальныйПредприниматель""
				|	КОНЕЦ");
				
		КонецЕсли;
		
	КонецЕсли;
	
	ЗапросДанных.УстановитьПараметр("ПустаяСтрока", "");
	ЗапросДанных.УстановитьПараметр("МассивЮрЛиц",  МассивЮрЛиц);
	
	ЗапросДанных.УстановитьПараметр(
		"ИмяСвойстваКодФилиала",
		МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ИмяСвойстваКодФилиала());
		
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	ЗапросДанных.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ПараметрыСторонДокумента(Стороны)
	
	МассивСторон = Новый Массив;
	Для Каждого Сторона Из Стороны Цикл
		
		ПараметрыСтороны = Новый Структура;
		ПараметрыСтороны.Вставить("Наименование", Сторона.НаименованиеОрганизации);
		
		// наименование органа исполнительной власти выдавшего документ
		// пока не храним это значение
		Если Сторона.ЮрФизЛицо = ЗначениеМетаданных("ESD_ЮрФизЛицо.ЮрЛицо")
			Или Сторона.ЮрФизЛицо = ЗначениеЮрФизЛицаКонфигурации("ЮрЛицо") Тогда
			
			ПараметрыСтороны.Вставить("ЮЛ", Новый Структура);
			ПараметрыСтороны.ЮЛ.Вставить("ИНН", Сторона.ИНН);
			
		ИначеЕсли Сторона.ЮрФизЛицо = ЗначениеМетаданных("ESD_ЮрФизЛицо.ЮрЛицоНеРезидент")
			Или Сторона.ЮрФизЛицо = ЗначениеЮрФизЛицаКонфигурации("ЮрЛицоНеРезидент") Тогда 
			
			СтруктураИнЛица = МодульКода("ESD_ТНВыгрузкаСервер").ШаблонИностранногоЛица();
			
			// Поиск будет только по наименованию
			СтруктураИнЛица.Страна       = СокрЛП(Сторона.СтранаРегистрации);
			СтруктураИнЛица.Наименование = Сторона.НаименованиеОрганизации;
			
			ПараметрыСтороны.Вставить("ИностранноеЛицо", СтруктураИнЛица);
			
		Иначе  
			
			// Физ или ИП
			ПараметрыСтороны.Вставить("ФЛ", Новый Структура);
			ПараметрыСтороны.ФЛ.Вставить("ИНН", Сторона.ИНН);
			
		КонецЕсли;
		
		МассивСторон.Добавить(ПараметрыСтороны);
		
	КонецЦикла;
	
	Возврат МассивСторон;
	
КонецФункции

Процедура ЗапросПоОрганизации(МассивЗапросов, КПП, Наименование)
	
	Если Метаданные.Справочники.Найти("Организации") = Неопределено Тогда
		Возврат;
	КонецЕсли;
				
	ТекстЗапросаОрганизации =
		"ВЫБРАТЬ
		|	Организации.Ссылка КАК Ссылка,
		|	1 КАК Порядок,
		|	ИСТИНА КАК ЭтоОрганизация
		|ПОМЕСТИТЬ НайденныеЮрЛица
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.ИНН = &ИНН
		|	И 1 = 1";
	
	ЕстьИНН = Метаданные.Справочники["Организации"].Реквизиты.Найти("ИНН");
	ЕстьКПП = Метаданные.Справочники["Организации"].Реквизиты.Найти("КПП");
	
	НетИННиКПП = (ЕстьИНН = Неопределено) И (ЕстьКПП = Неопределено);
	
	Если ЕстьКПП <> Неопределено И ЗначениеЗаполнено(КПП) Тогда
		
		УсловиеКПП = "Организации.КПП = &КПП";
		ТекстЗапросаОрганизации = СтрЗаменить(ТекстЗапросаОрганизации, "1 = 1", УсловиеКПП);
		
	КонецЕсли;
	
	Если Не НетИННиКПП Тогда
		
		МассивЗапросов.Добавить(ТекстЗапросаОрганизации);
		
	ИначеЕсли ЗначениеЗаполнено(Наименование) Тогда
		
		ПоискОрганизацииПоНаименованию = 
			"ВЫБРАТЬ
			|	Организации.Ссылка КАК Ссылка,
			|	3 КАК Порядок,
			|	ИСТИНА КАК ЭтоОрганизация
			|ПОМЕСТИТЬ НайденныеЮрЛица
			|ИЗ
			|	Справочник.Организации КАК Организации
			|ГДЕ
			|	Организации.Наименование = &Наименование";
		
		МассивЗапросов.Добавить(ПоискОрганизацииПоНаименованию);
		
	Иначе
		
		ТекстЗапросаОрганизации =
			"ВЫБРАТЬ
			|	Неопределено КАК Ссылка,
			|	99 КАК Порядок,
			|	ИСТИНА КАК ЭтоОрганизация
			|ПОМЕСТИТЬ НайденныеЮрЛица
			|ГДЕ
			|	ЛОЖЬ";
		
		МассивЗапросов.Добавить(ТекстЗапросаОрганизации);
		
	КонецЕсли;
			
КонецПроцедуры	

Процедура ЗапросПоКонтрагенту(МассивЗапросов, КПП, Наименование)

	Если Метаданные.Справочники.Найти("Контрагенты") = Неопределено Тогда
		Возврат;
	КонецЕсли;
			
	ТекстЗапросаКонтрагенты = 
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка,
		|	2 КАК Порядок,
		|	ЛОЖЬ КАК ЭтоОрганизация
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ИНН = &ИНН
		|   И 1 = 1";
	
	ЕстьИНН = Метаданные.Справочники["Контрагенты"].Реквизиты.Найти("ИНН");
	ЕстьКПП = Метаданные.Справочники["Контрагенты"].Реквизиты.Найти("КПП");
	
	НетИННиКПП = (ЕстьИНН = Неопределено) И (ЕстьКПП = Неопределено);
	
	Если ЕстьКПП <> Неопределено И ЗначениеЗаполнено(КПП) Тогда
		
		УсловиеКПП = "Контрагенты.КПП = &КПП";
		ТекстЗапросаКонтрагенты = СтрЗаменить(ТекстЗапросаКонтрагенты, "1 = 1", УсловиеКПП);
		
	КонецЕсли;
	
	Если Не НетИННиКПП Тогда
		
		МассивЗапросов.Добавить(ТекстЗапросаКонтрагенты);
		
	ИначеЕсли ЗначениеЗаполнено(Наименование) Тогда
	
		ПоискКонтрагентаПоНаименованию = 
			"ВЫБРАТЬ
			|	Контрагенты.Ссылка КАК Ссылка,
			|	4 КАК Порядок,
			|	ЛОЖЬ КАК ЭтоОрганизация
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	Контрагенты.Наименование = &Наименование";
		
	    МассивЗапросов.Добавить(ПоискКонтрагентаПоНаименованию);
		
	Иначе		
		Возврат;		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

Процедура ЗачиститьШтрафы(ОбъектДок, КлючиОтметокДляУдаления)
	
	Если Не МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ЕстьРеквизитИлиСвойство(ОбъектДок, "Штрафы") Тогда
		Возврат;
	КонецЕсли;
	
	ИндексШтрафы = ОбъектДок.Штрафы.Количество() - 1;
	Пока ИндексШтрафы >= 0 Цикл
				
		СтрокаШтраф = ОбъектДок.Штрафы[ИндексШтрафы];
			
		ЕстьСтрока = КлючиОтметокДляУдаления.Получить(СтрокаШтраф.КлючСтроки_Отметки);
		Если ЕстьСтрока <> Неопределено Тогда
			ОбъектДок.Штрафы.Удалить(ИндексШтрафы);
		КонецЕсли;
		
		ИндексШтрафы = ИндексШтрафы - 1;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗачиститьАкты(ОбъектДок, КлючиОтметокДляУдаления)
	
	Если Не МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ЕстьРеквизитИлиСвойство(ОбъектДок, "Акты") Тогда
		Возврат;
	КонецЕсли;
	
	ИндексАкты = ОбъектДок.Акты.Количество() - 1;
	Пока ИндексАкты >= 0 Цикл
				
		СтрокаАкт = ОбъектДок.Акты[ИндексАкты];
			
		ЕстьСтрока = КлючиОтметокДляУдаления.Получить(СтрокаАкт.КлючСтроки_Отметки);
		Если ЕстьСтрока <> Неопределено  Тогда
			ОбъектДок.Акты.Удалить(ИндексАкты);
		КонецЕсли;
		
		ИндексАкты = ИндексАкты - 1;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьВремяВМассивДаты(МассивИтог, ЧастьВремя, ЕстьВремя, ФорматБезСмещения, СмещениеВСекундах)
	
	Если Не ЕстьВремя Тогда
		Возврат;
	КонецЕсли;
	
	ЧислоДвоеточийВДате = 2;
	
	Если ФорматБезСмещения Тогда 
		
		Время = ЧастьВремя;    
		Если СтрЧислоВхождений(ЧастьВремя, ":") = ЧислоДвоеточийВДате Тогда
			РазделительВремя = ":";
		Иначе
			РазделительВремя = ".";
		КонецЕсли;
		
	Иначе 
		
		// может быть +/-
		Если Найти(ЧастьВремя, "+") > 0 Тогда
			РазделительСмещение = "+";  
		Иначе 
			РазделительСмещение = "-";
		КонецЕсли;
				
		МассивВремени = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрРазделитьЭПД(ЧастьВремя, РазделительСмещение);
		Время         = МассивВремени[0];
		Смещение      = МассивВремени[1];
		
		РазделительВремя = ":";
		
		СмещениеВходящее = Дата("00010101" + СтрЗаменить(Смещение, РазделительВремя, ""));
		СмещениеСеанса   = Дата("00010101") + СмещениеСтандартногоВремени(ЧасовойПоясСеанса());
		
		СмещениеВСекундах = СмещениеВходящее - СмещениеСеанса;
		
	КонецЕсли;
	
	ЧастиВремени = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрРазделитьЭПД(Время, РазделительВремя);
	МассивИтог.Добавить(ЧастиВремени[0]);
	МассивИтог.Добавить(ЧастиВремени[1]);
	МассивИтог.Добавить(ЧастиВремени[2]);
	
КонецПроцедуры

Функция ДатаБезВремениВСтандартномФормате(ДатаВходящая)
	
	// старый формат
	// 2023-02-02
	// 2023.01.03
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	
	Если Найти(ДатаВходящая, "-") <> 0 Тогда
		МассивЧастейДаты = МодульТНОбщегоНазначенияКлиентСервер.СтрРазделитьЭПД(ДатаВходящая, "-");
	Иначе
		МассивЧастейДаты = МодульТНОбщегоНазначенияКлиентСервер.СтрРазделитьЭПД(ДатаВходящая, ".");
	КонецЕсли;
	
	// формат может быть перевернут 03.01.2023
	КоличествоСимволовГод = 4;
	ФорматПеревернут = СтрДлина(МассивЧастейДаты[0]) = КоличествоСимволовГод;
	
	Если ФорматПеревернут Тогда
		КоличествоУдалить = МассивЧастейДаты.Количество();
		МассивЧастейДаты.Добавить(МассивЧастейДаты[2]);
		МассивЧастейДаты.Добавить(МассивЧастейДаты[1]);
		МассивЧастейДаты.Добавить(МассивЧастейДаты[0]);
		Пока КоличествоУдалить <> 0 Цикл
			МассивЧастейДаты.Удалить(0);
			КоличествоУдалить = КоличествоУдалить - 1;
		КонецЦикла;
	КонецЕсли;
	
	Возврат МодульТНОбщегоНазначенияКлиентСервер.СтрСоединитьЭПД(МассивЧастейДаты, ".");
	
КонецФункции

#Область ПолучениеДанныхПоСсылкеИзБазы

Функция ДанныеТранспортныхСредствИзКонфигурацииУАТ(МассивСсылокТС, МенеджерВременныхТаблицПереданный)
	
	МенеджерВременныхТаблиц = МенеджерВременныхТаблицПереданный;
	
	РезультатФункции = Новый Соответствие;
	Если МассивСсылокТС = Неопределено И МенеджерВременныхТаблиц = Неопределено Тогда
		Возврат РезультатФункции;
	КонецЕсли;
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	
	ОчиститьМенеджерВременныхТаблиц = Ложь;
	Если МенеджерВременныхТаблиц = Неопределено Тогда
		ОчиститьМенеджерВременныхТаблиц = Истина;
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		ЗапросДанных = Новый Запрос;
		ЗапросДанных.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		ЗапросДанных.Текст = 
		"ВЫБРАТЬ
		|	уатТС.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ТаблицаТранспортныхСредств
		|ИЗ
		|	Справочник.уатТС КАК уатТС
		|ГДЕ
		|	уатТС.Ссылка В(&МассивСсылокТС)";
		ЗапросДанных.УстановитьПараметр("МассивСсылокТС", МассивСсылокТС);
		// BSLLS:SetPrivilegedMode-off
		УстановитьПривилегированныйРежим(Истина);
		// BSLLS:SetPrivilegedMode-on
		ЗапросДанных.Выполнить();
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	ЗапросДанных = Новый Запрос;
	ЗапросДанных.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	ЗапросДанных.Текст =
	"ВЫБРАТЬ
	|	ТранспортныеСредства.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА ТранспортныеСредства.Ссылка.ВидМоделиТС = ЗНАЧЕНИЕ(Перечисление.уатВидыМоделейТС.Автотранспорт) ТОГДА ЗНАЧЕНИЕ(Перечисление.ESD_ВидыТС.Автомобиль)
	|		КОГДА ТранспортныеСредства.Ссылка.ВидМоделиТС = ЗНАЧЕНИЕ(Перечисление.уатВидыМоделейТС.Прицеп) ТОГДА ЗНАЧЕНИЕ(Перечисление.ESD_ВидыТС.Прицеп)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ESD_ВидыТС.ПустаяСсылка)
	|	КОНЕЦ КАК Вид,
	|	ТранспортныеСредства.Ссылка.ГосударственныйНомер КАК РегистрационныйНомер,
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(ТранспортныеСредства.Ссылка.ТипТС) КАК Тип,
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(ТранспортныеСредства.Ссылка.Марка) КАК Марка,
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(ТранспортныеСредства.Ссылка.Модель) КАК Модель,
	|	ТранспортныеСредства.Ссылка.VIN КАК ВИН,
	|	ЕСТЬNULL(РегистрСведенийуатДокументыТС.Серия, """") + ЕСТЬNULL(РегистрСведенийуатДокументыТС.Номер, """") КАК НомерСТС,
	|	ТранспортныеСредства.Ссылка.Грузоподъемность КАК Грузоподъемность,
	|	ТранспортныеСредства.Ссылка.ПолезныйРазмерВысота / 1000 * ТранспортныеСредства.Ссылка.ПолезныйРазмерДлина / 1000 * ТранспортныеСредства.Ссылка.ПолезныйРазмерШирина / 1000 КАК Вместимость,
	|	ВЫБОР
	|		КОГДА ТранспортныеСредства.Ссылка.ТипВладенияТС = ЗНАЧЕНИЕ(Перечисление.уатТипыВладенияТС.Собственность) ТОГДА ЗНАЧЕНИЕ(Перечисление.ESD_ТипыВладенияТС.Собственность)
	|		КОГДА ТранспортныеСредства.Ссылка.ТипВладенияТС = ЗНАЧЕНИЕ(Перечисление.уатТипыВладенияТС.СовместнаяСобственностьСупругов) ТОГДА ЗНАЧЕНИЕ(Перечисление.ESD_ТипыВладенияТС.СовместнаяСобственностьСупругов)
	|		КОГДА ТранспортныеСредства.Ссылка.ТипВладенияТС = ЗНАЧЕНИЕ(Перечисление.уатТипыВладенияТС.Аренда) ТОГДА ЗНАЧЕНИЕ(Перечисление.ESD_ТипыВладенияТС.Аренда)
	|		КОГДА ТранспортныеСредства.Ссылка.ТипВладенияТС = ЗНАЧЕНИЕ(Перечисление.уатТипыВладенияТС.Лизинг) ТОГДА ЗНАЧЕНИЕ(Перечисление.ESD_ТипыВладенияТС.Лизинг)
	|		КОГДА ТранспортныеСредства.Ссылка.ТипВладенияТС = ЗНАЧЕНИЕ(Перечисление.уатТипыВладенияТС.БезвозмездноеПользование) ТОГДА ЗНАЧЕНИЕ(Перечисление.ESD_ТипыВладенияТС.БезвозмездноеПользование)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ESD_ТипыВладенияТС.ПустаяСсылка)
	|	КОНЕЦ КАК ТипВладения
	|ИЗ
	|	ТаблицаТранспортныхСредств КАК ТранспортныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.уатРегистрационныеДокументы КАК РегистрСведенийуатДокументыТС
	|		ПО ТранспортныеСредства.Ссылка = РегистрСведенийуатДокументыТС.ВладелецДокументов
	|			И РегистрСведенийуатДокументыТС.ДатаОкончания <> ДАТАВРЕМЯ(1, 1, 1)
	|			И РегистрСведенийуатДокументыТС.ДатаОкончания <= &ТекущаяДата
	|			И ВидДокумента = ЗНАЧЕНИЕ(Справочник.уатВидыДокументов.СТС)";
	
	ЗапросДанных.Текст = СтрЗаменить(ЗапросДанных.Текст, "ESD_ВидыТС", ВидыТС());
	ЗапросДанных.Текст = СтрЗаменить(ЗапросДанных.Текст, "ESD_ТипыВладенияТС", ТипыВладенияТС());
		
	ЕстьГрузоподъемность = МодульТНОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойство(
		Справочники["уатТС"].ПустаяСсылка(), "Грузоподъемность");
		
	Если Не ЕстьГрузоподъемность Тогда
		
		ЗапросДанных.Текст = СтрЗаменить(
			ЗапросДанных.Текст,
			"ТранспортныеСредства.Ссылка.Грузоподъемность",
			"0");
		
	КонецЕсли;	
	
	ЗапросДанных.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	ВыборкаДанных = ЗапросДанных.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Пока ВыборкаДанных.Следующий() Цикл
		СтруктураТС = МодульТНОбщегоНазначенияКлиентСервер.СтруктураТранспортногоСредства();
		ЗаполнитьЗначенияСвойств(СтруктураТС, ВыборкаДанных);
		РезультатФункции.Вставить(ВыборкаДанных.Ссылка, СтруктураТС);
	КонецЦикла;
	
	Если ОчиститьМенеджерВременныхТаблиц Тогда
		МенеджерВременныхТаблиц.Закрыть();
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ДанныеТранспортныхСредствИзДругихКонфигураций(МассивСсылокТС, МенеджерВременныхТаблицПереданный = Неопределено)
	
	МенеджерВременныхТаблиц = МенеджерВременныхТаблицПереданный;
	
	ЕстьСправочникТранспортныхСредств = Метаданные.Справочники.Найти("ТранспортныеСредства") <> Неопределено;
	Если Не ЕстьСправочникТранспортныхСредств Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "В конфигурации не найден справочник транспортных средств";
		Сообщение.Сообщить();
	КонецЕсли;
	
	РезультатФункции = Новый Соответствие;
	Если Не ЕстьСправочникТранспортныхСредств Или (МассивСсылокТС = Неопределено И МенеджерВременныхТаблиц = Неопределено) Тогда
		Возврат РезультатФункции;
	КонецЕсли;
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");

	ЕстьВид = МодульТНОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойство(
		Справочники.ТранспортныеСредства.ПустаяСсылка(), "Вид");
	
	Если Не ЕстьВид Тогда
		Возврат ДанныеТранспортныхСредствИзДругихКонфигурацийБезРасширения(МассивСсылокТС);
	КонецЕсли;
	
	ОчиститьМенеджерВременныхТаблиц = Ложь;
	Если МенеджерВременныхТаблиц = Неопределено Тогда
		ОчиститьМенеджерВременныхТаблиц = Истина;
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		ЗапросДанных = Новый Запрос;
		ЗапросДанных.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		ЗапросДанных.Текст = 
		"ВЫБРАТЬ
		|	ТранспортныеСредства.Ссылка КАК Ссылка,
		|	ТранспортныеСредства.Вид КАК Вид
		|ПОМЕСТИТЬ ТаблицаТранспортныхСредств
		|ИЗ
		|	Справочник.ТранспортныеСредства КАК ТранспортныеСредства
		|ГДЕ
		|	ТранспортныеСредства.Ссылка В(&МассивСсылокТС)";
		ЗапросДанных.УстановитьПараметр("МассивСсылокТС", МассивСсылокТС);
		// BSLLS:SetPrivilegedMode-off
		УстановитьПривилегированныйРежим(Истина);
		// BSLLS:SetPrivilegedMode-on
		ЗапросДанных.Выполнить();
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	ЗапросДанных = Новый Запрос;
	ЗапросДанных.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	ЗапросДанных.Текст =
	"ВЫБРАТЬ
	|	ТранспортныеСредства.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА ТранспортныеСредства.Ссылка.Вид = ЗНАЧЕНИЕ(Перечисление.ESD_ВидыТС.ПустаяСсылка)
	|		ТОГДА ТранспортныеСредства.Вид
	|		ИНАЧЕ ТранспортныеСредства.Ссылка.Вид
	|	КОНЕЦ КАК Вид,
	|	ТранспортныеСредства.Ссылка.Код КАК РегистрационныйНомер,
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(ТранспортныеСредства.Ссылка.Тип) КАК Тип,
	|	ТранспортныеСредства.Ссылка.Марка КАК Марка,
	|	ТранспортныеСредства.Ссылка.VIN КАК ВИН,
	|	ТранспортныеСредства.Ссылка.НомерСТС КАК НомерСТС,
	|	ТранспортныеСредства.Ссылка.ГрузоподъемностьВТоннах КАК Грузоподъемность,
	|	ТранспортныеСредства.Ссылка.ВместимостьВКубическихМетрах КАК Вместимость,
	|	ТранспортныеСредства.Ссылка.ТипВладения КАК ТипВладения,
	|	ТранспортныеСредства.Ссылка.ДокументыПодтверждающиеВладение.(
	|		ДокументВладения КАК ДокументВладения
	|	) КАК ОснованияВладения
	|ИЗ
	|	ТаблицаТранспортныхСредств КАК ТранспортныеСредства";
	
	ЗапросДанных.Текст = СтрЗаменить(ЗапросДанных.Текст, "ESD_ВидыТС", ВидыТС());
	
	ЕстьРегистрационныйЗнак = МодульТНОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойство(
		Справочники.ТранспортныеСредства.ПустаяСсылка(), "РегистрационныйЗнак");
	
	Если ЕстьРегистрационныйЗнак Тогда
		ЗапросДанных.Текст = СтрЗаменить(
			ЗапросДанных.Текст,
			"ТранспортныеСредства.Ссылка.Код",
			"ТранспортныеСредства.Ссылка.РегистрационныйЗнак");
	КонецЕсли;
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	ВыборкаДанных = ЗапросДанных.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Пока ВыборкаДанных.Следующий() Цикл
		СтруктураТС = МодульТНОбщегоНазначенияКлиентСервер.СтруктураТранспортногоСредства();
		ЗаполнитьЗначенияСвойств(СтруктураТС, ВыборкаДанных, , "ОснованияВладения");
		ВыборкаОснованийВладения = ВыборкаДанных.ОснованияВладения.Выбрать();
		МассивОснований = Новый Массив;
		Пока ВыборкаОснованийВладения.Следующий() Цикл
			МассивОснований.Добавить(ВыборкаОснованийВладения.ДокументВладения);
		КонецЦикла;
		Если МассивОснований.Количество() > 0 Тогда
			СтруктураТС.ОснованияВладения = ЗначениеВСтрокуВнутр(МассивОснований);
		КонецЕсли;
		РезультатФункции.Вставить(ВыборкаДанных.Ссылка, СтруктураТС);
	КонецЦикла;
	
	Если ОчиститьМенеджерВременныхТаблиц Тогда
		МенеджерВременныхТаблиц.Закрыть();
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ДанныеТранспортныхСредствИзДругихКонфигурацийБезРасширения(МассивСсылокТС)
	
	РезультатФункции = Новый Соответствие;
	
	ЗапросДанных = Новый Запрос;
	ЗапросДанных.УстановитьПараметр("МассивСсылокТС", МассивСсылокТС);
	
	ЗапросДанных.Текст = 
	"ВЫБРАТЬ *
	|ИЗ
	|	Справочник.ТранспортныеСредства КАК ТранспортныеСредства
	|ГДЕ
	|	ТранспортныеСредства.Ссылка В(&МассивСсылокТС)";
	
	ПустаяСсылка = Справочники.ТранспортныеСредства.ПустаяСсылка();
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");

	ЕстьРегистрационныйЗнак = МодульТНОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойство(
		ПустаяСсылка, "РегистрационныйЗнак");
			
	ЕстьГрузоподъемность = МодульТНОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойство(
		ПустаяСсылка, "ГрузоподъемностьВТоннах");
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	ВыборкаДанных = ЗапросДанных.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Пока ВыборкаДанных.Следующий() Цикл
		
		СтруктураТС = МодульТНОбщегоНазначенияКлиентСервер.СтруктураТранспортногоСредства();
		ЗаполнитьЗначенияСвойств(СтруктураТС, ВыборкаДанных);
		
		Если ЗначениеЗаполнено(СтруктураТС.Тип) Тогда
			СтруктураТС.Тип = СокрЛП(СтруктураТС.Тип);
		КонецЕсли;	
		
		Если ЕстьГрузоподъемность Тогда 
			СтруктураТС.Грузоподъемность = ВыборкаДанных.ГрузоподъемностьВТоннах; 
			СтруктураТС.Вместимость      = ВыборкаДанных.ВместимостьВКубическихМетрах;
		КонецЕсли;	
		
		Если ЕстьРегистрационныйЗнак Тогда
			СтруктураТС.РегистрационныйНомер = ВыборкаДанных.РегистрационныйЗнак;
		Иначе 
			СтруктураТС.РегистрационныйНомер = ВыборкаДанных.Код;
		КонецЕсли;
				
		РезультатФункции.Вставить(ВыборкаДанных.Ссылка, СтруктураТС);
		
	КонецЦикла;
		
	Возврат РезультатФункции;
	
КонецФункции

Функция ОписаниеРеквизитовПоСсылке(МетаданныеСсылки)
	СписокРеквизитов = Новый Массив;
	Реквизиты = МетаданныеСсылки.Реквизиты;
	Для Каждого Реквизит Из Реквизиты Цикл
		СписокРеквизитов.Добавить(Реквизит.Имя);
	КонецЦикла;
	
	СписокТабличныхЧастей = Новый Соответствие;
	ТабличныеЧасти = МетаданныеСсылки.ТабличныеЧасти;
	Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
		РеквизитыТЧ = Новый Массив;
		Для Каждого РеквизитТЧ Из ТабличнаяЧасть.Реквизиты Цикл 
			РеквизитыТЧ.Добавить(РеквизитТЧ.Имя);	
		КонецЦикла;
		СписокТабличныхЧастей.Вставить(ТабличнаяЧасть.Имя, РеквизитыТЧ);	
	КонецЦикла;
	
	Возврат Новый Структура("Реквизиты,ТабличныеЧасти", СписокРеквизитов, СписокТабличныхЧастей);
КонецФункции

Функция РезультатЗапросаДанныхИзБД(Выборка, ОписаниеРеквизитов)
	ДанныеСсылки = Новый Структура;
	
	Реквизиты = Новый Структура;
	Для Каждого ИмяРеквизита Из ОписаниеРеквизитов.Реквизиты Цикл
		Реквизиты.Вставить(ИмяРеквизита, Выборка[ИмяРеквизита]);				
	КонецЦикла;
	ДанныеСсылки.Вставить("Реквизиты", Реквизиты);
	
	ТабличныеЧасти = Новый Структура;
	Для Каждого ОписаниеТабличнаяЧасть Из ОписаниеРеквизитов.ТабличныеЧасти Цикл
		ИмяТЧ = ОписаниеТабличнаяЧасть.Ключ;
		РеквизитыТЧ = ОписаниеТабличнаяЧасть.Значение;
		
		ДанныеТЧ = Новый Массив;
		ВыборкаПоТЧ = Выборка[ИмяТЧ].Выбрать();
		Пока ВыборкаПоТЧ.Следующий() Цикл
			ДанныеСтрокиТЧ = Новый Структура;
			Для Каждого РеквизитТЧ Из РеквизитыТЧ Цикл
				ДанныеСтрокиТЧ.Вставить(РеквизитТЧ, ВыборкаПоТЧ[РеквизитТЧ]);	
			КонецЦикла;
			ДанныеТЧ.Добавить(ДанныеСтрокиТЧ);
		КонецЦикла;
		
		ТабличныеЧасти.Вставить(ИмяТЧ, ДанныеТЧ);
	КонецЦикла;
	ДанныеСсылки.Вставить("ТабличныеЧасти", ТабличныеЧасти);
		
	Возврат ДанныеСсылки;
КонецФункции

Функция ТекстЗапросаДанныхСсылокИзБД(ОписанияРеквизитов)
	СписокПодзапросов = Новый Массив;
	Для Каждого ОписаниеРеквизитов Из ОписанияРеквизитов Цикл
		ТекстПодзапроса = ТекстЗапросаДанныхСсылкиИзБД(ОписаниеРеквизитов.Значение);
		СписокПодзапросов.Добавить(ТекстПодзапроса);
	КонецЦикла;
	
	Возврат МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрСоединитьЭПД(СписокПодзапросов, "; ");
КонецФункции

Функция ТекстЗапросаДанныхСсылкиИзБД(ОписаниеРеквизитов)
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	
	ПолноеИмяМетаданных = ОписаниеРеквизитов.ПолноеИмяМетаданных;
	Реквизиты = ОписаниеРеквизитов.Реквизиты;
	ТабличныеЧасти = ОписаниеРеквизитов.ТабличныеЧасти;
	
	ТекстРеквизитов = МодульТНОбщегоНазначенияКлиентСервер.СтрСоединитьЭПД(Реквизиты, ", ");
	
	СписокРеквизитовТЧ = Новый Массив;
	Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
		ИмяТЧ = ТабличнаяЧасть.Ключ;
		РеквизитыТЧ = ТабличнаяЧасть.Значение;
		
		ТекстРеквизитовТЧ = ИмяТЧ + ".(" + МодульТНОбщегоНазначенияКлиентСервер.СтрСоединитьЭПД(РеквизитыТЧ, ", ") + ") КАК " + ИмяТЧ;
		СписокРеквизитовТЧ.Добавить(ТекстРеквизитовТЧ);
	КонецЦикла;
	
	Если СписокРеквизитовТЧ.Количество() Тогда
		ТекстРеквизитовТЧ = МодульТНОбщегоНазначенияКлиентСервер.СтрСоединитьЭПД(СписокРеквизитовТЧ, ", ");
		ТекстРеквизитов = ТекстРеквизитов + ", " + ТекстРеквизитовТЧ;	
	КонецЕсли;
	
	ТекстЗапроса = "
		|ВЫБРАТЬ
		|	Ссылка,
		|	" + ТекстРеквизитов + "
		|ИЗ
		|	" + ПолноеИмяМетаданных + " КАК ОбъектДанных
		|ГДЕ
		|	ОбъектДанных.Ссылка В(&СписокСсылок)";
	
	Возврат ТекстЗапроса;
КонецФункции

#КонецОбласти // ПолучениеДанныхПоСсылкеИзБазы

#Область ФЛК

// Проверяет заполненность реквизитов документа.
//
// Параметры:
//  ДанныеДокумента - Структура - структура реквизитов и табличных часте документа
//  ПараметрыПроверкиРеквизитов - Структура - структура параметров для проверки реквизитов на заполненность
//    Для реквизитов табличных частей реквизиты указываются через точку. Сначала имя табличной части а потом реквизит.
//  Ошибки - Массив - массив структур ошибок. Расхождения по реквизитам.
//
Процедура ПроверитьЗаполненНеЗаполнен(ДанныеДокумента, ПараметрыПроверкиРеквизитов, Ошибки)
	
	ТабличныеЧасти = Новый Структура;
	
	// Проверка реквизитов объекта и заполнение структуры по реквизитам табличных частей.
	Для Каждого Реквизит Из ПараметрыПроверкиРеквизитов.ПроверяемыеРеквизиты Цикл
		
		ПозицияТочки = Найти(Реквизит.РеквизитОбъекта, ".");
		
		Если ПозицияТочки > 0 Тогда 
			// В случае если указан реквизит табличной части
			ПроверкаРеквизитаТабличнойЧасти(Реквизит, ПозицияТочки, ТабличныеЧасти);
		Иначе 
			// В случае если указан реквизит объекта
			ПроверкаРеквизитаОбъекта(Реквизит, ДанныеДокумента, ПараметрыПроверкиРеквизитов, Ошибки);
		КонецЕсли;
		
	КонецЦикла;
	
	ПроверитьЗаполненНеЗаполненРеквизитТЧ(ДанныеДокумента, ПараметрыПроверкиРеквизитов, Ошибки, ТабличныеЧасти);
	
	ПараметрыПроверкиРеквизитов.ПроверяемыеРеквизиты.Очистить();
	
КонецПроцедуры

Процедура ПроверитьЗаполненНеЗаполненРеквизитТЧ(ДанныеДокумента, ПараметрыПроверкиРеквизитов, Ошибки, ТабличныеЧасти)
	
	// Проверка реквизитов в табличных частях
	Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
		
		ИмяТабличнойЧасти = ТабличнаяЧасть.Ключ;
		ТЧ = ДанныеДокумента[ИмяТабличнойЧасти];
		МассивРеквизитов = ТабличнаяЧасть.Значение;
		
		// Цикл по всем строкам табличной части.
		Для ИндексСтроки = 0 По ТЧ.Количество() - 1 Цикл
			
			ИмяТЧ = ПараметрыПроверкиРеквизитов.ДокументМенеджер.ИмяТЧДокумента(
				ИмяТабличнойЧасти, ТЧ[ИндексСтроки], ДанныеДокумента);
			
			// Цикл по всем проверяемым реквизитам для текущей табличной части.
			Для Каждого Реквизит Из МассивРеквизитов Цикл
				
				ИмяРеквизита = Реквизит.РеквизитОбъекта;
				
				РеквизитДляПроверки = ПараметрыПроверкиРеквизитов.ДокументМенеджер.ИзменитьРеквизитТЧ(
					ТЧ[ИндексСтроки], ИмяТЧ, Реквизит, ДанныеДокумента);
				
				ПроверятьРеквизитТЧДокумента = ПараметрыПроверкиРеквизитов.ДокументМенеджер.ПроверятьРеквизитТЧДокумента(
					ТЧ[ИндексСтроки], ИмяТЧ, РеквизитДляПроверки, ДанныеДокумента);
					
				ИсточникДанныхТЧ = ИсточникДанныхТЧ(ТЧ[ИндексСтроки], ИмяРеквизита, ДанныеДокумента, ИмяТабличнойЧасти);
					
				Если Не ПроверятьРеквизитТЧДокумента
					Или ЗначениеЗаполнено(ИсточникДанныхТЧ[ИмяРеквизита]) Тогда
					Продолжить;
				КонецЕсли;
				
				ПолеОшибки = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрШаблонЭПД(
					"Объект.%1",
				    ИмяТабличнойЧасти + "[" + Формат(ИндексСтроки, "ЧН=0; ЧГ=0") + "]." + РеквизитДляПроверки.РеквизитОбъекта);

				ДобавитьОшибкуПользователю(
					Ошибки,
					ПолеОшибки,
					РеквизитДляПроверки.Ошибка,
					ИмяТЧ + "." + РеквизитДляПроверки.РеквизитОбъекта,
					РеквизитДляПроверки.ЭлементФормы,
					ИндексСтроки);
					
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ИсточникДанныхТЧ(СтрокаТЧ, ИмяРеквизита, ДанныеДокумента, ИмяТабличнойЧасти)
	
	ИмяТелефон = "Телефон";
	
	ТаблицыОтветственныхЛиц = Новый Соответствие;
	ТаблицыОтветственныхЛиц.Вставить("ОтветственныеЛица", Истина);
	ТаблицыОтветственныхЛиц.Вставить("Водители", Истина);
	ТаблицыОтветственныхЛиц.Вставить("ОтветственныйМедосмотрВыезд", Истина);
	ТаблицыОтветственныхЛиц.Вставить("ОтветственныйМедосмотрЗаезд", Истина);
	ТаблицыОтветственныхЛиц.Вставить("ОтветственныйТехосмотр", Истина);
	ТаблицыОтветственныхЛиц.Вставить("ОтветственныйОдометрВыезд", Истина);
	ТаблицыОтветственныхЛиц.Вставить("ОтветственныйОдометрЗаезд", Истина);
	
	ЭтоРеквизитЮрЛица = ТаблицыОтветственныхЛиц[ИмяТабличнойЧасти] = Неопределено
		И (ИмяРеквизита = "Фамилия" Или ИмяРеквизита = "Имя" Или ИмяРеквизита = ИмяТелефон);
	
	Если Не ЭтоРеквизитЮрЛица Тогда
		Возврат СтрокаТЧ;
	КонецЕсли;
	
	РезультатФункции = Новый Соответствие;
	
	Если МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ЕстьРеквизитИлиСвойство(СтрокаТЧ, "СтруктураФИО")
		И ЗначениеЗаполнено(СтрокаТЧ.СтруктураФИО) Тогда
		СтруктураФИО = ЗначениеИзСтрокиВнутр(СтрокаТЧ.СтруктураФИО);
		Для Каждого КлючЗначение Из СтруктураФИО Цикл
			РезультатФункции.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Если ИмяРеквизита = ИмяТелефон Тогда
		ОтборТелефона = Новый Структура;
		ОтборТелефона.Вставить("КлючСтроки_ДанныеЮрЛиц", СтрокаТЧ.КлючСтроки);
		ОтборТелефона.Вставить("Тип",                    ЗначениеМетаданных(ТипыКонтактнойИнформации() + ".Телефон"));
		
		НайденныеСтроки = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").НайтиСтрокиУниверсально(
			ДанныеДокумента.КонтактныеДанные, ОтборТелефона);
		РезультатФункции.Вставить(ИмяТелефон, НайденныеСтроки);
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Процедура ПроверкаРеквизитаТабличнойЧасти(Реквизит, ПозицияТочки, ТабличныеЧасти)
	
	ДлинаСтроки       = СтрДлина(Реквизит.РеквизитОбъекта);
	ИмяТабличнойЧасти = Лев(Реквизит.РеквизитОбъекта, ПозицияТочки - 1);
	ИмяРеквизита      = Прав(Реквизит.РеквизитОбъекта, ДлинаСтроки - ПозицияТочки);
	
	Если ТабличныеЧасти.Свойство(ИмяТабличнойЧасти) Тогда
		ПроверяемыеРеквизитыТЧ = ТабличныеЧасти[ИмяТабличнойЧасти];
	Иначе
		ПроверяемыеРеквизитыТЧ = Новый Массив;
		ТабличныеЧасти.Вставить(ИмяТабличнойЧасти, ПроверяемыеРеквизитыТЧ);
	КонецЕсли;
	
	Реквизит.РеквизитОбъекта = ИмяРеквизита;
	
	ПроверяемыеРеквизитыТЧ.Добавить(Реквизит);
	
КонецПроцедуры

Процедура ПроверкаРеквизитаОбъекта(Реквизит, ДанныеДокумента, ПараметрыПроверкиРеквизитов, Ошибки)
	
	Если Не ПараметрыПроверкиРеквизитов.ДокументМенеджер.ПроверятьРеквизитДокумента(Реквизит.РеквизитОбъекта, ДанныеДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	ЗначениеРеквизитаЗаполнено = ЗначениеЗаполнено(ДанныеДокумента[Реквизит.РеквизитОбъекта]);
	
	Если Не ЗначениеРеквизитаЗаполнено Тогда
		
		ДобавитьОшибкуПользователю(
			Ошибки,
			МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрШаблонЭПД("Объект.%1", Реквизит),
			Реквизит.Ошибка,
			Реквизит.РеквизитОбъекта,
			Реквизит.ЭлементФормы);
		
	КонецЕсли;
		
КонецПроцедуры

Процедура ДобавитьОшибкуТипаВладения(СтрокаТС, Ошибки, СоответствиеРеквизитовОшибок)
	
	Если СтрокаТС.Вид = ЗначениеМетаданных("ESD_ВидыТС.Автомобиль") Тогда
		СтруктураДанныхОшибки = СоответствиеРеквизитовОшибок.Получить("ТранспортноеСредствоДокумент");
		ДобавитьОшибкуПользователю(
			Ошибки,
			"ТранспортноеСредствоСтрокой",
			СтруктураДанныхОшибки.Ошибка,
			СтруктураДанныхОшибки.РеквизитОбъекта,
			СтруктураДанныхОшибки.ЭлементФормы);
	Иначе
		СтруктураДанныхОшибки = СоответствиеРеквизитовОшибок.Получить("Прицепы.ПрицепДокумент");
		ДобавитьОшибкуПользователю(
			Ошибки,
			МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрШаблонЭПД("Объект.ТранспортныеСредства[%1]", СтрокаТС.НомерСтроки),
			СтруктураДанныхОшибки.Ошибка,
			СтруктураДанныхОшибки.РеквизитОбъекта,
			СтруктураДанныхОшибки.ЭлементФормы,
			СтрокаТС.НомерСтроки - 1);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьСОХ(СтрокаДокументаЭПД, ДанныеДокумента, Ошибки)
	
	Если Не ДанныеДокумента.Свойство("ДанныеЮрЛиц") Или Не СтрокаДокументаЭПД.ЭтоОформитель Тогда
		Возврат;
	КонецЕсли;
	
	ОтборОтправителя  = Новый Структура("Роль", ЗначениеМетаданных("ESD_РолиКонтрагентов.Отправитель"));
	СтрокиОтправителя = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").НайтиСтрокиУниверсально(
		ДанныеДокумента.ДанныеЮрЛиц, ОтборОтправителя);
	
	Для Каждого СтрокаОтправителя Из СтрокиОтправителя Цикл
		Если Не ЗначениеЗаполнено(СтрокаОтправителя.ИНН) Тогда
			Продолжить;
		КонецЕсли;
		
		ОтборПоИНН = Новый Структура("ИНН", СтрокаОтправителя.ИНН);
		СтрокиСторон = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").НайтиСтрокиУниверсально(
			СтрокаДокументаЭПД.ДанныеЮрЛиц, ОтборПоИНН);
			
		ИмяСтороны = "отправитель";
		Если ДанныеДокумента.ИмяМетаданных = ЗаказНаПеревозку() Тогда
			ИмяСтороны = "заказчик";
		КонецЕсли;
			
		Если СтрокиСторон.Количество() = 0 Тогда
			ДобавитьОшибкуПользователю(
				Ошибки,
				СтрокаДокументаЭПД.ЭлементФормы,
				"Одной из сторон документа должен быть " + ИмяСтороны,
				СтрокаДокументаЭПД.РеквизитОбъекта,
				СтрокаДокументаЭПД.ЭлементФормы);
		КонецЕсли;
			
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти // ФЛК

#Область Лента

Процедура ОбновитьДанныеЛенты(Форма)
	
	Форма.Лента.Очистить();
	
	ИмяМетаданных = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ИмяМетаданныхПоФорме(Форма);
	
	ФормаОбъект = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ФормаОбъект(Форма);

	ТекущиеЭтапыДокумента = МодульКода("Документы." + ИмяМетаданных).ТекущиеЭтапыДокумента(Форма);
	ДанныеДляЛенты = МодульКода("РегистрыСведений.ESD_ДанныеТитулов").ДанныеДляЛенты(
		ФормаОбъект, ИмяМетаданных, ТекущиеЭтапыДокумента);
	
	КоличествоВидимость = РазмерЛентыВТитулах();
	
	Для Каждого СтруктураДанных Из ДанныеДляЛенты Цикл
		
		СтрокаЛенты = Форма.Лента.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаЛенты, СтруктураДанных);
		
		ЗаполнитьПризнакТекущегоЭтапа(Форма, ИмяМетаданных, СтрокаЛенты);
		
		ЗаполнитьНаименованиеТитула(СтрокаЛенты, ИмяМетаданных);
		
		СтрокаЛенты.Видимость = КоличествоВидимость > 0;
		КоличествоВидимость   = КоличествоВидимость - 1;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьНаименованиеТитула(СтрокаСобытия, ИмяМетаданных)
	
	ПредставленияТитула = РезультатФункцииТитулов(ИмяМетаданных, "ПредставленияТитула", СтрокаСобытия.ТипТитула);	
	СтрокаСобытия.НаименованиеТитула = ПредставленияТитула.Имя;
	
КонецПроцедуры

Процедура СдвинутьНаСтроку(Лента, СтрокаЛенты)
	
	КоличествоВидимость = РазмерЛентыВТитулах();
	
	ИндексСтроки = Лента.Индекс(СтрокаЛенты);
	
	Индекс = Лента.Количество() - 1;
	Пока Индекс >= 0 Цикл
		СтрокаЛенты = Лента[Индекс];
		Если Индекс <= ИндексСтроки Тогда
			СтрокаЛенты.Видимость = КоличествоВидимость > 0;
			КоличествоВидимость   = КоличествоВидимость - 1;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
КонецПроцедуры

Процедура СдвинутьЛентуВправо(Лента)
	
	Если Лента.Количество() <= РазмерЛентыВТитулах() Или Лента[Лента.Количество() - 1].Видимость Тогда
		Возврат;
	КонецЕсли;
	
	Для ИндексНачала = 0 По Лента.Количество() - 1 Цикл
		Если Лента[ИндексНачала].Видимость Тогда
			Лента[ИндексНачала].Видимость = Ложь;
			ИндексНачала = ИндексНачала + 1;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ПоследнийИндекс = Мин(ИндексНачала + РазмерЛентыВТитулах() - 1, Лента.Количество() - 1);
	
	Для Индекс = ИндексНачала По ПоследнийИндекс Цикл
		Лента[Индекс].Видимость = Истина;
	КонецЦикла;
	
КонецПроцедуры

Процедура СдвинутьЛентуВлево(Лента)
	
	Если Лента.Количество() <= РазмерЛентыВТитулах() Или Лента[0].Видимость Тогда
		Возврат;
	КонецЕсли;
	
	Для ИндексНачала = 0 По Лента.Количество() - 1 Цикл
		Если Лента[ИндексНачала].Видимость Тогда
			ИндексНачала = ИндексНачала - 1;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ПоследнийИндекс = Мин(ИндексНачала + РазмерЛентыВТитулах() - 1, Лента.Количество() - 1);
	
	Для Индекс = ИндексНачала По Лента.Количество() - 1 Цикл
		Лента[Индекс].Видимость = Индекс <= ПоследнийИндекс;
	КонецЦикла;
	
КонецПроцедуры

Функция РазмерЛентыВТитулах()
	
	Возврат 6;
	
КонецФункции

Процедура ЗаполнитьПризнакТекущегоЭтапа(Форма, ИмяМетаданных, СтрокаЛенты)
	
	ДокументооборотЗавершен = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ДокументооборотЗавершен(Форма.ИндексКартинки);
	ТекущиеЭтапыДокумента   = МодульКода("Документы." + ИмяМетаданных).ТекущиеЭтапыДокумента(Форма);
	
	ЕстьТитулВТекущихЭтапах = Ложь;
	Если ТекущиеЭтапыДокумента.Количество() <> 0 Тогда
		ЕстьТитулВТекущихЭтапах = Не ЗначениеЗаполнено(СтрокаЛенты.ИдентификаторТитула)
			И ТекущиеЭтапыДокумента.Найти(СтрокаЛенты.ТипТитула) <> Неопределено;
	КонецЕсли;
	
	Если СтрокаЛенты.ТипТитула = ЗначениеМетаданных("ESD_ТипТитулаЭтрН.ИзменениеСтоимости")
		Или СтрокаЛенты.ТипТитула = ЗначениеМетаданных("ESD_ТипТитулаЭтрН.СогласованиеСтоимости") Тогда
		СтрокаЛенты.ТекущийТитул = ЕстьТитулВТекущихЭтапах;
	Иначе
		СтрокаЛенты.ТекущийТитул = Не ДокументооборотЗавершен И ЕстьТитулВТекущихЭтапах;
	КонецЕсли;
	
КонецПроцедуры

#Область Отрисовка

Процедура ОчиститьЛенту(Форма)
	
	Пока Форма.Элементы.ГруппаЛента.ПодчиненныеЭлементы.Количество() <> 0 Цикл
		Форма.Элементы.Удалить(Форма.Элементы.ГруппаЛента.ПодчиненныеЭлементы.Получить(0));
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьКнопку(Форма, ИмяКоманды)
	
	Если Форма.Лента.Количество() = 0 Или Форма.Лента.Количество() <= РазмерЛентыВТитулах() Тогда
		Возврат;
	КонецЕсли;
		
	КнопкаФормы = Форма.Элементы.Добавить("Кнопка" + ИмяКоманды, Тип("КнопкаФормы"), Форма.Элементы.ГруппаЛента);
	КнопкаФормы.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	КнопкаФормы.ИмяКоманды = ИмяКоманды;
	КнопкаФормы.Отображение = ОтображениеКнопки.Картинка;
	КнопкаФормы.ОтображениеФигуры = ОтображениеФигурыКнопки.ПриАктивности;
	КнопкаФормы.Высота = 4;
	
КонецПроцедуры

Процедура ДобавитьДекорациюЛинию(Форма, СтрокаЛенты = Неопределено, Ширина = 3, ИмяДекорации = "ДекорацияЛиния")
	
	Серая   = Истина;
	Красная = Ложь;
	
	ПолноеИмяДекорации = ИмяДекорации;
	ИдентификаторСтроки = "";
	Если СтрокаЛенты <> Неопределено Тогда
		ИдентификаторСтроки = Формат(СтрокаЛенты.ПолучитьИдентификатор(), "ЧДЦ=0; ЧГ=");
		ПолноеИмяДекорации = ПолноеИмяДекорации + ИдентификаторСтроки;
		Серая   = Не ЗначениеЗаполнено(СтрокаЛенты.Период) И Не СтрокаЛенты.ТекущийТитул;
		Красная = Форма.ТитулОтрицательноЗавершен(СтрокаЛенты);
	КонецЕсли;
	
	ГруппаЛинии = Форма.Элементы.Добавить(
		"ГруппаЛинии_" + ИдентификаторСтроки,
		Тип("ГруппаФормы"),
		Форма.Элементы.ГруппаЛента);
		
	ГруппаЛинии.Вид                                = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаЛинии.Отображение                        = ОтображениеОбычнойГруппы.Нет;
	ГруппаЛинии.ОтображатьЗаголовок                = Ложь;
	ГруппаЛинии.Группировка                        = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаЛинии.ГоризонтальноеПоложениеПодчиненных = ГоризонтальноеПоложениеЭлемента.Центр;
	ГруппаЛинии.РастягиватьПоГоризонтали           = Ложь;
	ГруппаЛинии.Ширина                             = Ширина;
	
	ДекорацияФормы = Форма.Элементы.Добавить("Отступ" + ПолноеИмяДекорации, Тип("ДекорацияФормы"), ГруппаЛинии);
	ДекорацияФормы.Вид = ВидДекорацииФормы.Надпись;
	ДекорацияФормы.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Центр;
	ДекорацияФормы.РастягиватьПоГоризонтали = Ложь;
	ДекорацияФормы.Ширина = Ширина;
	
	ДекорацияФормы = Форма.Элементы.Добавить(ПолноеИмяДекорации, Тип("ДекорацияФормы"), ГруппаЛинии);
	ДекорацияФормы.Вид = ВидДекорацииФормы.Надпись;
	ДекорацияФормы.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Центр;
	ДекорацияФормы.РастягиватьПоГоризонтали = Ложь;
	ДекорацияФормы.Ширина = Ширина;
	ДекорацияФормы.Рамка = Форма.Элементы.Стили.Рамка;
	
	Если Красная Тогда
		ДекорацияФормы.ЦветРамки = ЦветаСтиля.ЦветОсобогоТекста;
	ИначеЕсли Серая Тогда
		ДекорацияФормы.ЦветРамки = ЦветаСтиля.ЦветРамкиКнопки;
	Иначе
		ДекорацияФормы.ЦветРамки = WebЦвета.ЖелтоЗеленый;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьДекорациюТитул(Форма, СтрокаЛенты)
	
	ИдентификаторСтроки = Формат(СтрокаЛенты.ПолучитьИдентификатор(), "ЧДЦ=0; ЧН=0; ЧГ=");
	
	ГруппаТитул = Форма.Элементы.Добавить(
		"Группа_" + ИдентификаторСтроки,
		Тип("ГруппаФормы"),
		Форма.Элементы.ГруппаЛента);
		
	ГруппаТитул.Вид                                = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаТитул.Отображение                        = ОтображениеОбычнойГруппы.Нет;
	ГруппаТитул.ОтображатьЗаголовок                = Ложь;
	ГруппаТитул.Группировка                        = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаТитул.ГоризонтальноеПоложениеПодчиненных = ГоризонтальноеПоложениеЭлемента.Центр;
	ГруппаТитул.ВертикальныйИнтервал               = ИнтервалМеждуЭлементамиФормы.Нет;
	ГруппаТитул.РастягиватьПоГоризонтали           = Ложь;
	ГруппаТитул.РастягиватьПоВертикали             = Ложь;
	ГруппаТитул.Ширина                             = ШиринаПоТитулу(СтрокаЛенты.ТипТитула);
	
	ДекорацияФормы = Форма.Элементы.Добавить(
		"Титул_" + ИдентификаторСтроки,
		Тип("ДекорацияФормы"),
		Форма.Элементы[ГруппаТитул.Имя]);
		
	ДекорацияФормы.Вид = ВидДекорацииФормы.Картинка;
	ДекорацияФормы.Гиперссылка = Истина;
	ДекорацияФормы.РастягиватьПоГоризонтали = Истина;
	ДекорацияФормы.Высота = 2;
		
	МассивДанныхПодсказки = Новый Массив;
	Если ЗначениеЗаполнено(СтрокаЛенты.Период) Тогда
		ПериодСтрокой = Формат(СтрокаЛенты.Период, "ДФ='dd.MM.yyyy ЧЧ:мм'");
	Иначе
		ПериодСтрокой = "";
	КонецЕсли;		
	
	Если Форма.ТитулОтрицательноЗавершен(СтрокаЛенты) Тогда
		ЦветТитула = ЦветаСтиля.ЦветОсобогоТекста;
		МассивДанныхПодсказки.Добавить("Красный");
	Иначе
		ЦветТитула = WebЦвета.ТемноЗеленый;
		МассивДанныхПодсказки.Добавить("Зеленый");
	КонецЕсли;
	
	Если СтрокаЛенты.ТекущийТитул Тогда
		Картинка = КартинкаИнтерфейсаСервер(Форма, "ESD_ТекущийТитул");
		МассивДанныхПодсказки.Добавить("ESD_ТекущийТитул");
	ИначеЕсли ЗначениеЗаполнено(СтрокаЛенты.ИдентификаторТитула) Тогда
		Картинка = КартинкаИнтерфейсаСервер(Форма, "ESD_АктивныйТитул");
		МассивДанныхПодсказки.Добавить("ESD_АктивныйТитул");
	Иначе
		Картинка = КартинкаИнтерфейсаСервер(Форма, "ESD_НеактивныйТитул");
		ЦветТитула = ЦветаСтиля.ЦветРамкиКнопки;
		МассивДанныхПодсказки[0] = "Серый";
		МассивДанныхПодсказки.Добавить("ESD_НеактивныйТитул");
	КонецЕсли;
	
	ДекорацияФормы.Картинка = Картинка;
	
	ФорматированнаяСтрока = Новый ФорматированнаяСтрока(
		Новый ФорматированнаяСтрока(СтрокаЛенты.Представление, ШрифтыСтиля.ОбычныйШрифтТекста, ЦветТитула),
		Символы.ПС,
		Новый ФорматированнаяСтрока(ПериодСтрокой, ШрифтыСтиля.МелкийШрифтТекста, WebЦвета.Серый));
		
	МассивДанныхПодсказки.Добавить(СтрокаЛенты.Представление);
	Если ЗначениеЗаполнено(ПериодСтрокой) Тогда
		МассивДанныхПодсказки.Добавить(ПериодСтрокой);
	КонецЕсли;
		
	ДекорацияФормы.ОтображениеПодсказки = ОтображениеПодсказки.Нет;
	ДекорацияФормы.Подсказка            = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрСоединитьЭПД(
		МассивДанныхПодсказки, "/");
	
	ДекорацияФормы.УстановитьДействие("Нажатие", "ДекорацияТитулОбработкаНавигационнойСсылки");
	
	ДекорацияФормыТекст = Форма.Элементы.Добавить(
		"НадписьТитула_" + ИдентификаторСтроки,
		Тип("ДекорацияФормы"),
		Форма.Элементы[ГруппаТитул.Имя]);
		
	ДекорацияФормыТекст.Вид                     = ВидДекорацииФормы.Надпись;
	ДекорацияФормыТекст.Заголовок               = ФорматированнаяСтрока;
	ДекорацияФормыТекст.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Центр;
	ДекорацияФормыТекст.Ширина                  = ШиринаПоТитулу(СтрокаЛенты.ТипТитула);
	ДекорацияФормыТекст.Высота                  = ВысотаПоТитулу(СтрокаЛенты.Представление);
	
КонецПроцедуры

Функция ШиринаПоТитулу(ТипТитула) Экспорт
	
	РезультатФункции = 10;
	
	Если ТипТитула = ЗначениеМетаданных("ESD_ТипТитулаЭтрН.Переадресовка") Тогда		
		РезультатФункции = 12;		
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ВысотаПоТитулу(ПредставлениеТитула)
	
	Высота = 2;
	
	НесколькоСлов = Найти(ПредставлениеТитула, " ") > 0;
	Если НесколькоСлов Тогда
		Высота = Высота + 1;
	КонецЕсли;  
	
	Возврат Высота;
	
КонецФункции

Процедура ДобавитьПодсказку(Форма)
	
	ДекорацияФормы = Форма.Элементы.Добавить("ПодсказкаЛенты", Тип("ДекорацияФормы"), Форма.Элементы.ГруппаЛента);
	ДекорацияФормы.ОтображениеПодсказки = ОтображениеПодсказки.Кнопка;
	ДекорацияФормы.Подсказка = "При нажатии на картинку, происходит переход к данным выбранного титула";
	
КонецПроцедуры

