// Выполняет выгрузку документов Эпд в регламентном задании.
//
// Параметры:
//  context_params - Структура - параметры подключения к онлайн 
//  ТипДокумента - Строка - тип документа подсистемы ЭПД
//  МассивДокументов - Массив - массив из ДокументСсылка<ДокументЭПД>
//
Процедура ВыгрузитьПоРегламенту(context_params, ТипДокумента, МассивДокументов = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(context_params) Тогда
		Возврат;
	КонецЕсли;
		
	ЗапросДанных = Новый Запрос;
	ЗапросДанных.Текст = 
	"ВЫБРАТЬ
	|	ДокументЭПД.Ссылка КАК Ссылка
	|ИЗ
	|	Документ_СсылкаНаНужныйДокумент КАК ДокументЭПД
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ESD_Состояние КАК ESD_Состояние
	|		ПО ДокументЭПД.Ссылка = ESD_Состояние.Объект
	|ГДЕ
	|	ДокументЭПД.Направление = &НаправлениеИсходящий
	|	И НЕ ДокументЭПД.ПометкаУдаления
	|	И ЕСТЬNULL(ESD_Состояние.UID, """") = """"
	|	И ДокументЭПД.Ссылка В(&МассивДокументов)";
	
	РегистрСостояний = РегистрСостояний();
	ЗапросДанных.Текст = СтрЗаменить(ЗапросДанных.Текст, "ESD_Состояние", РегистрСостояний);
	
	Если РегистрСостояний = "ESD_СостоянияОбъектовИнтеграции" Тогда
		ЗапросДанных.Текст = СтрЗаменить(
			ЗапросДанных.Текст, "ESD_СостоянияОбъектовИнтеграции.Объект", "ESD_СостоянияОбъектовИнтеграции.ОбъектРасширения");
		ЗапросДанных.Текст = СтрЗаменить(
			ЗапросДанных.Текст, "ESD_СостоянияОбъектовИнтеграции.UID", "ESD_СостоянияОбъектовИнтеграции.Идентификатор");
	КонецЕсли;
	
	ЗапросДанных.УстановитьПараметр("НаправлениеИсходящий", ЗначениеМетаданных("ESD_Направление.Исходящий"));
	
	ЗапросДанных.Текст = СтрЗаменить(ЗапросДанных.Текст, "_СсылкаНаНужныйДокумент", "." + ТипДокумента);
	
	Если МассивДокументов <> Неопределено Тогда
		ЗапросДанных.УстановитьПараметр("МассивДокументов", МассивДокументов);
	Иначе
		ЗапросДанных.Текст = СтрЗаменить(
			ЗапросДанных.Текст,
			"И ДокументЭПД.Ссылка В(&МассивДокументов)",
			"");
	КонецЕсли;
		
	РезультатЗапроса = ЗапросДанных.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаДанных = РезультатЗапроса.Выбрать();
	
	ДанныеДляВыгрузки = Новый Массив;
	Пока ВыборкаДанных.Следующий() Цикл
		ПараметрыКоманды = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ПараметрыВыгрузки(ВыборкаДанных.Ссылка);
		ДанныеДляВыгрузки.Добавить(ПараметрыКоманды);
	КонецЦикла;
	
	ДополнительныеПараметры = Новый Структура;
	
	МодульКода("ESD_ТНВыгрузкаСервер").РезультатВыгрузкиДокументов(ДанныеДляВыгрузки, context_params, ДополнительныеПараметры);
	
КонецПроцедуры 

Процедура ОтправитьСтатистикуПоРегламенту(context_params)
	
	Результат = Новый Структура;
	Результат.Вставить("ИспользованиеСистемыПрав", 0);
	
	МассивПИБ = ПользователиИнформационнойБазы.ПолучитьПользователей(); 
	Для Каждого ПользовательИБ Из МассивПИБ Цикл 
		Если Не (ПользовательИБ.АутентификацияОС Или ПользовательИБ.АутентификацияСтандартная) Тогда
			Продолжить;
		КонецЕсли;
		
		ФлагСтатистика = ПользовательИБ.Роли.Содержит(Метаданные.Роли.ESD_ЗаказНаПеревозку_ДобавлениеИзменение) 
						Или ПользовательИБ.Роли.Содержит(Метаданные.Роли.ESD_СтандартныеПрава) 
						Или ПользовательИБ.Роли.Содержит(Метаданные.Роли.ESD_ПутевойЛист_ДобавлениеИзменение)
						Или ПользовательИБ.Роли.Содержит(Метаданные.Роли.ESD_ТранспортнаяНакладная_ДобавлениеИзменение)
		                Или ПользовательИБ.Роли.Содержит(Метаданные.Роли.ESD_ЭкспортныеКоманды);
		Если ФлагСтатистика Тогда
			Результат.ИспользованиеСистемыПрав = Результат.ИспользованиеСистемыПрав + 1;
		КонецЕсли;
	КонецЦикла;
	
	ESD_ТНЗагрузкаСервер_ = МодульКода("ESD_ТНЗагрузкаСервер");
	
	ОбщиеПараметры = ESD_ТНЗагрузкаСервер_.ОбщиеПараметрыЗагрузки(Неопределено);
	
	Для Каждого КлючЗначения Из Результат Цикл
		Если КлючЗначения.Значение = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка 
			ПараметрыМетода = ESD_ТНЗагрузкаСервер_.ПараметрыМетодаЗаписиСтатистики("", КлючЗначения.Ключ, , "Расширение 1С ESD",
																						ОбщиеПараметры.context);
			ПараметрыМетода.data.Вставить("count", КлючЗначения.Значение);
			ESD_ТНЗагрузкаСервер_.ЗаписатьСтатистикуВОблако(Неопределено, ПараметрыМетода, ОбщиеПараметры);
		Исключение
			Информация = ИнформацияОбОшибке();
			ВыполнитьНаСервере("ESD_ТНОбщегоНазначенияСервер.ЗаписатьОшибкуВЖурналРегистрации", Неопределено,
			"Ошибка записи статистики", Информация.Описание);
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры 

