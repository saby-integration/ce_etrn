
Функция Классификатор_СтраныМира_ИмяМакета() Экспорт
	Возврат "КлассификаторСтранМира";	
КонецФункции

Функция Классификатор_СтраныМира_Имя() Экспорт
	Возврат "ESD. Страны мира";
КонецФункции

Функция Классификатор_СтраныМира_ТекстСообщения_УспешноЗагружен(СтруктураРезультатаЗагрузки) Экспорт
	ИмяКлассификатора_ = Классификатор_СтраныМира_Имя();
	Возврат Классификатор_ТекстСообщения_УспешноЗагружен(ИмяКлассификатора_, СтруктураРезультатаЗагрузки);
КонецФункции

Функция Классификатор_СтраныМира_ТекстСообщения_ОшибкаЗагрузкиЭлемента(СтруктураРезультатаЗаписи) Экспорт
	ИмяКлассификатора_ = Классификатор_СтраныМира_Имя();
	Возврат Классификатор_ТекстСообщения_ОшибкаЗагрузкиЭлемента(ИмяКлассификатора_, СтруктураРезультатаЗаписи);	
КонецФункции

Функция Классификатор_СтраныМира_ТекстСообщения_ОшибкаЗагрузки(Причина = "") Экспорт
	ИмяКлассификатора_ = Классификатор_СтраныМира_Имя();
	Возврат Классификатор_ТекстСообщения_ОшибкаЗагрузки(ИмяКлассификатора_, Причина);
КонецФункции

Функция Классификатор_СтруктураРезультатаЗаписи(Успешно = Истина, Значение = Неопределено, Ссылка = Неопределено) Экспорт
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("Успешно", Успешно);
	РезультатФункции.Вставить("Ссылка", Ссылка);
	РезультатФункции.Вставить("Значение", Значение);
	РезультатФункции.Вставить("КраткоеОписание", "");
	РезультатФункции.Вставить("ПодробноеОписание", "");
	
	Возврат РезультатФункции;
КонецФункции

Функция Классификатор_СтруктураРезультатаЗагрузки() Экспорт
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("ВсегоОбработано", 0);
	РезультатФункции.Вставить("Успешные", Новый Массив);
	РезультатФункции.Вставить("Ошибочные", Новый Массив);
	
	Возврат РезультатФункции;
КонецФункции

// Возвращает общий текст ошибки загрузки значения классификатора
//
// Параметры:
//  ИмяКлассификатора - Строка - имя загружаемого классификатора
//  СтруктураРезультатаЗаписи - Структура - см. функцию "Классификатор_СтруктураРезультатаЗаписи()"
//
// Возвращаемое значение:
//  Строка - текст ошибки
//
Функция Классификатор_ТекстСообщения_ОшибкаЗагрузкиЭлемента(ИмяКлассификатора, СтруктураРезультатаЗаписи) Экспорт
	РезультатФункции = "Не удалось загрузить значение ""%1"" классификатора ""%2"" по причине:
		|%3";
	Возврат ESD_ТНОбщегоНазначенияКлиентСервер.СтрШаблонЭПД(РезультатФункции, 
		СтруктураРезультатаЗаписи.Значение, 
		ИмяКлассификатора,
		СтруктураРезультатаЗаписи.ПодробноеОписание);
КонецФункции

// Возвращает общий текст положительного результата загрузки классификатора
//
// Параметры:
//  ИмяКлассификатора - Строка - имя загружаемого классификатора
//  СтруктураРезультатаЗагрузки - Структура - см. функцию "Классификатор_СтруктураРезультатаЗагрузки()"
//
// Возвращаемое значение:
//  Строка - текст результата
//
Функция Классификатор_ТекстСообщения_УспешноЗагружен(ИмяКлассификатора, СтруктураРезультатаЗагрузки) Экспорт
	РезультатФункции = "Классификатор ""%1"" обновлен.
		|Загружено данных %2 из %3";
	Возврат ESD_ТНОбщегоНазначенияКлиентСервер.СтрШаблонЭПД(
		РезультатФункции, ИмяКлассификатора, 
		СтруктураРезультатаЗагрузки.Успешные.Количество(), 
		СтруктураРезультатаЗагрузки.ВсегоОбработано);
КонецФункции

// Возвращает общий текст отрицательного результата загрузки классификатора
//
// Параметры:
//  ИмяКлассификатора - Строка - имя загружаемого классификатора
//	Причина - Строка - подробная причина ошибки загрузки
//
// Возвращаемое значение:
//  Строка - текст результата
//
Функция Классификатор_ТекстСообщения_ОшибкаЗагрузки(ИмяКлассификатора, Причина = "") Экспорт
	РезультатФункции = "Загрузка классификатора ""%1"" не выполнена!";
	Если Не ПустаяСтрока(Причина) Тогда
		РезультатФункции = РезультатФункции + "
			|" + Причина;
	КонецЕсли;
	
	Возврат ESD_ТНОбщегоНазначенияКлиентСервер.СтрШаблонЭПД(РезультатФункции, ИмяКлассификатора);
КонецФункции

// Возвращает общий текст актуальности классификатора
//
// Параметры:
//  ИмяКлассификатора - Строка - имя загружаемого классификатора
//
// Возвращаемое значение:
//  Строка - текст результата
//
Функция Классификатор_ТекстСообщения_ОтменаЗагрузки(ИмяКлассификатора) Экспорт
	РезультатФункции = "Данные объекта ""%1"" актуальны. Загрузка не требуется!";
	Возврат ESD_ТНОбщегоНазначенияКлиентСервер.СтрШаблонЭПД(РезультатФункции, ИмяКлассификатора);
КонецФункции

