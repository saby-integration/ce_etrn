
Функция НашаОрганизация_СтруктураОписания() Экспорт
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("ЭтоФизЛицо",   Ложь);
	РезультатФункции.Вставить("Наименование", "");
	РезультатФункции.Вставить("ИНН",          "");
	РезультатФункции.Вставить("КПП",          "");
	РезультатФункции.Вставить("КодСтраны",    "");
	РезультатФункции.Вставить("КодФилиала",   "");
	РезультатФункции.Вставить("Фамилия",      "");
	РезультатФункции.Вставить("Имя",          "");
	РезультатФункции.Вставить("Отчество",     "");
	РезультатФункции.Вставить("ЧастноеЛицо",  "");

	Возврат РезультатФункции;
КонецФункции

Функция НашаОрганизация_ОписаниеПоРеквизитамВыгрузки(РеквизитыВыгрузки) Экспорт
	// РеквизитыВыгрузки - структура с ключом "СвЮЛ" или "СвФЛ", значение ключа "НашаОрганизация" вложения,
	// см. ESD_ТНВыгрузкаСервер.РеквизитыНашейОрганизации
	МодульКлиентСервер_ = ESD_ТНОбщегоНазначенияКлиентСервер;

	РезультатФункции = НашаОрганизация_СтруктураОписания();

	ДанныеЛица_ = МодульКлиентСервер_.ЗначениеИзКоллекции(РеквизитыВыгрузки, "СвЮЛ");
	РезультатФункции.ЭтоФизЛицо = Не ЗначениеЗаполнено(ДанныеЛица_);
	Если РезультатФункции.ЭтоФизЛицо Тогда
		ДанныеЛица_ = МодульКлиентСервер_.ЗначениеИзКоллекции(РеквизитыВыгрузки, "СвФЛ");
	КонецЕсли;

	ИменаПолей_ = Новый Структура("ИНН, КПП, КодСтраны, КодФилиала, Фамилия, Имя, Отчество, ЧастноеЛицо");
	Для Каждого Поле_ Из ИменаПолей_ Цикл
		РезультатФункции[Поле_.Ключ] = МодульКлиентСервер_.ЗначениеИзКоллекции(ДанныеЛица_, Поле_.Ключ, "");
	КонецЦикла;

	Если РезультатФункции.ЭтоФизЛицо Тогда
		РезультатФункции.Наименование = СокрЛП(РезультатФункции.Фамилия + " " + РезультатФункции.Имя
			+ " " + РезультатФункции.Отчество);
	Иначе
		РезультатФункции.Наименование = МодульКлиентСервер_.ЗначениеИзКоллекции(ДанныеЛица_, "Название", "");
	КонецЕсли;

	Возврат РезультатФункции;
КонецФункции

Функция НашаОрганизация_РеквизитыВыгрузки(Описание) Экспорт
	Если Не ЗначениеЗаполнено(Описание) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Состав полей - как в стандартной отправке, см. ESD_ТНВыгрузкаСервер.РеквизитыНашейОрганизации
	Если Описание.ЭтоФизЛицо Тогда
		ИмяУзла_ = "СвФЛ";
		ДанныеЛица_ = Новый Структура("ИНН, КодСтраны, Фамилия, Имя, Отчество, ЧастноеЛицо");
	Иначе
		ИмяУзла_ = "СвЮЛ";
		ДанныеЛица_ = Новый Структура("ИНН, КодСтраны, КПП");
		ДанныеЛица_.Вставить("Название", Описание.Наименование);
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ДанныеЛица_, Описание);

	Если ЗначениеЗаполнено(Описание.КодФилиала) Тогда
		ДанныеЛица_.Вставить("КодФилиала", Описание.КодФилиала);
	КонецЕсли;

	Возврат Новый Структура(ИмяУзла_, ДанныеЛица_);
КонецФункции

Функция НашаОрганизация_Представление(Описание) Экспорт
	Если Описание = Неопределено Или Не ЗначениеЗаполнено(Описание.ИНН) Тогда
		Возврат "";
	КонецЕсли;

	ИННКПП_ = "ИНН " + Описание.ИНН;
	Если ЗначениеЗаполнено(Описание.КПП) Тогда
		ИННКПП_ = ИННКПП_ + ", КПП " + Описание.КПП;
	КонецЕсли;

	Возврат Описание.Наименование + " (" + ИННКПП_ + ")";
КонецФункции

