Функция СоздатьНаОсновании_ДополнительныеПараметры_СтруктураДанныхSaby(ИмяМетаданных = "") Экспорт
	РезультатФункции = ESD_ТНЗагрузкаСервер.ДопПараметрыЗагрузкиВложения();
	РезультатФункции.ЗагрузкаСОнлайна = Ложь;
	РезультатФункции.ИмяМетаданных = ИмяМетаданных;
	
	Возврат РезультатФункции;
КонецФункции

