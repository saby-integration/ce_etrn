
Функция СоздатьНаОсновании_ПараметрыЗаполнения(Вид = "",
	Данные = Неопределено,
	ДополнительныеПараметры = Неопределено
) Экспорт
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("Вид", Вид);
	РезультатФункции.Вставить("Данные", Данные);
	РезультатФункции.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
	
	// Служебный параметр, заполняющийся "извне"
	РезультатФункции.Вставить("Данные_АдресВременногоХранилища", "");
	
	Возврат РезультатФункции;
КонецФункции

Функция СоздатьНаОсновании_ПараметрыЗаполнения_СтруктураДанныхSaby(
	Данные = Неопределено, 
	ДополнительныеПараметры = Неопределено
) Экспорт
	РезультатФункции = СоздатьНаОсновании_ПараметрыЗаполнения();
	РезультатФункции.Вид = СоздатьНаОсновании_ВидПараметров_СтруктураДанныхSaby();
	РезультатФункции.Данные = Данные;
	РезультатФункции.ДополнительныеПараметры = ДополнительныеПараметры;
	
	Возврат РезультатФункции;
КонецФункции

Функция СоздатьНаОсновании_ПараметрыОткрытияФормы(
	Владелец = Неопределено, 
	ОповещениеПриЗакрытии = Неопределено,
	Знач РежимОткрытияОкна = Неопределено
) Экспорт
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("Владелец", Владелец);
	РезультатФункции.Вставить("ОповещениеПриЗакрытии", ОповещениеПриЗакрытии);
	
	#Если Клиент ИЛИ ТолстыйКлиентОбычноеПриложение ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
	Если РежимОткрытияОкна = Неопределено Тогда
		РежимОткрытияОкна = РежимОткрытияОкнаФормы.Независимый;
	КонецЕсли;
	#КонецЕсли
	РезультатФункции.Вставить("РежимОткрытияОкна", РежимОткрытияОкна);
	
	Возврат РезультатФункции;
КонецФункции

