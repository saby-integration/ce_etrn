// Возвращает структуру описания параметров отбора "Основание" для динамического списка документов.
//
// Возвращаемое значение:
//  Структура - описание параметров отбора.
//
Функция ДинСписокДокументов_Отбор_ДокументОснование_Параметры_СтруктураОписания() Экспорт
	РезультатФункции = Новый Структура();
	РезультатФункции.Вставить("ОснованиеМетаданные",	 "");
	РезультатФункции.Вставить("ОснованиеИдентификатор",	 "");
	Возврат РезультатФункции;
КонецФункции

// Возвращает структуру параметров отбора "Основание" для динамического списка документов.
//
// Параметры:
//  Значение - ЛюбаяСсылка - ссылка на документ основание отбора.
//
// Возвращаемое значение:
//  Структура - параметры отбора
//   (см. ДинСписокДокументов_Отбор_ДокументОснование_Параметры_СтруктураОписания).
//
Функция ДинСписокДокументов_Отбор_ДокументОснование_Параметры(Значение) Экспорт
	РезультатФункции = Неопределено;
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат РезультатФункции;
	КонецЕсли;
	РезультатФункции						 = ДинСписокДокументов_Отбор_ДокументОснование_Параметры_СтруктураОписания();
	РезультатФункции.ОснованиеМетаданные	 = ESD_ТНОбщегоНазначенияСервер.ПолноеИмяМетаданныхПоЗначению(Значение);
	РезультатФункции.ОснованиеИдентификатор	 = Строка(Значение.УникальныйИдентификатор());
	Возврат РезультатФункции;
КонецФункции

