&НаКлиенте
Процедура ПослеИзмененияИныхПолучателей(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер");

	ФормаОбъект = МодульТНОбщегоНазначенияКлиентСервер.ФормаОбъект(ДополнительныеПараметры.Форма);
	МодульТНОбщегоНазначенияКлиентСервер.ПерезаполнитьИныхПолучателей(ФормаОбъект, Результат.ИныеПолучатели);
	МодульТНОбщегоНазначенияКлиентСервер.ОбновитьЭлементыИныхПолучателей(
		ДополнительныеПараметры.Форма, Результат.ИныеПолучатели.Количество());
	
	Если Не ДополнительныеПараметры.Форма.ЭтоВО Тогда
		ДополнительныеПараметры.Форма.Модифицированность = Истина;
		Если ДополнительныеПараметры.ЗаписыватьФорму Тогда
			ДополнительныеПараметры.Форма.Записать();
		КонецЕсли;		
	КонецЕсли;
	
КонецПроцедуры

#Область ФормированиеПечатныхФорм

&НаКлиенте
Функция ОснованиеПечатнойФормы(Форма, ДополнительныеПараметры)
	Если ДополнительныеПараметры.ЭтоФормаСписка Тогда
		СсылкаНаДокумент = Форма.Элементы.Список.ТекущаяСтрока;
	Иначе
		ФормаОбъект = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер").ФормаОбъект(Форма);
		СсылкаНаДокумент = ФормаОбъект.Ссылка;
		
		Если Форма.ЭтоВО Тогда
			context_params = ВыполнитьНаСервере("ESD_ТНОбщегоНазначенияСервер.ПроверитьНаличиеПараметровПодключенияЭПД");
			ВыгрузитьЧерновикНаКлиенте(СсылкаНаДокумент, Форма, context_params);                                                      
			ДополнительныеПараметры.Вставить("context_params", context_params);
		КонецЕсли;
	КонецЕсли;
	
	Возврат СсылкаНаДокумент;	
КонецФункции

&НаКлиенте
Процедура ПередОткрытиемПечатнойФормы(Результат, ДополнительныеПараметры) Экспорт
	Форма = ДополнительныеПараметры.Форма;
	Если Не ДополнительныеПараметры.ЭтоФормаСписка Тогда
		Форма.ЗаполнитьСтруктуруДокумента();
	КонецЕсли;
	
	СсылкаНаДокумент = ОснованиеПечатнойФормы(Форма, ДополнительныеПараметры);
	Если Не ЗначениеЗаполнено(СсылкаНаДокумент) Тогда
		Возврат;
	КонецЕсли;
	ДополнительныеПараметры.Вставить("СсылкаНаДокумент", СсылкаНаДокумент);
	
	Если ДополнительныеПараметры.ЭтоПечатьQRКода Тогда
		ОткрытьПечатнуюФорму(Неопределено, ДополнительныеПараметры);
		Возврат;
	КонецЕсли;
	
	ВыборПечатнойФормы = ДополнительныеПараметры.ВыборПечатнойФормы;
	ДополнительныеПараметры.Удалить("ВыборПечатнойФормы");
	Если ВыборПечатнойФормы Тогда
		ОткрытьФормуВыбораПечатнойФормы(ДополнительныеПараметры);
	Иначе
		ОткрытьПечатнуюФорму(Неопределено, ДополнительныеПараметры);	
	КонецЕсли;
КонецПроцедуры 

&НаКлиенте
Процедура ОткрытьФормуВыбораПечатнойФормы(Параметры) Экспорт
	// Определение параметров формы
	ПараметрыФормы = Новый Структура("Основание, ЭтоВО"
		,Параметры.СсылкаНаДокумент
		,Параметры.Форма.ЭтоВО
	);
	
	// Определения оповещения
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораПечатнойФормы"
		,МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиент")
		,Параметры);
		
	// Открытие формы
	ОткрытьФорму("ОбщаяФорма." + ВыборПечатнойФормыКлиент()
		,ПараметрыФормы
		,Параметры.Форма
		,,,
		,ОписаниеОповещения
		,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	 
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПечатнойФормы(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат.Id) Тогда
		ДополнительныеПараметры.Вставить("УстановитьПечатнуюФорму", Результат.Id);
	КонецЕсли;
	
	ОткрытьПечатнуюФорму(Неопределено, ДополнительныеПараметры);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПечатнуюФорму(Результат, ДополнительныеПараметры) Экспорт
	Форма = ДополнительныеПараметры.Форма;	
	СсылкаНаДокумент = ДополнительныеПараметры.СсылкаНаДокумент;
	
	ДополнительныеПараметры.Удалить("Форма");
	ДополнительныеПараметры.Удалить("СсылкаНаДокумент");
	
	Если ДополнительныеПараметры.ЭтоФормаСписка Тогда		
		СтруктураФормы = Новый Структура("ЭтоВО, УникальныйИдентификатор", Ложь, Форма.УникальныйИдентификатор);		
	Иначе
		СтруктураФормы = Форма;	
	КонецЕсли;
	
	Результат = СоздатьПечатнуюФорму(СсылкаНаДокумент, СтруктураФормы, ДополнительныеПараметры);
	
	ОтобразитьПечатнуюФорму(Результат, Форма, ДополнительныеПараметры);
	
	ОбновитьФормуВО = Не ДополнительныеПараметры.ЭтоФормаСписка
						И Форма.ЭтоВО 
						И Форма.КоличествоОшибок = 0;
		
	Если ОбновитьФормуВО Тогда	
		Форма.Ссылка = СсылкаНаДокумент;
		Форма.Прочитать();	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция СоздатьПечатнуюФорму(СсылкаНаДокумент, Форма, ДополнительныеПараметры) Экспорт
	Если Форма.ЭтоВО Тогда
		Результат = ВыполнитьНаСервере("ESD_ТНОбщегоНазначенияСервер.ДанныеПечатнойФормыДляОткрытия",
			СсылкаНаДокумент, Ложь, ДополнительныеПараметры);
		Если ЗначениеЗаполнено(Результат.ОписаниеОшибки) Тогда	
			Возврат Результат;	
		КонецЕсли;
			
		ТранспортВО = ТранспортВО(Форма);
		
		Результат.ПараметрыЗагрузки.ЗагрузкаТребуется = Истина;
		Результат.ПараметрыЗагрузки.ОбъектОбработки = ТранспортВО.ТранспортИнтеграции;
		Результат.АдресДвоичныхДанных = МодульКодаКлиент("ESD_ТНЗагрузкаСервер")
			.АдресДвоичныхДанныхФайла(Результат.ПараметрыЗагрузки, ДополнительныеПараметры);
	Иначе
		#Если ТолстыйКлиентОбычноеПриложение Или ТолстыйКлиентУправляемоеПриложение Тогда
		ДополнительныеПараметры.Вставить("ЭтоТолстыйКлиент", Истина);
		#КонецЕсли

		Результат = ВыполнитьНаСервере("ESD_ТНОбщегоНазначенияСервер.ДанныеПечатнойФормыДляОткрытия",
			СсылкаНаДокумент, Истина, ДополнительныеПараметры);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

&НаКлиенте
Процедура ОтобразитьПечатнуюФорму(Результат, Форма, ДополнительныеПараметры) Экспорт
	Если ДополнительныеПараметры.ЭтоПечатьQRКода Тогда
		ОткрытьQRКод(Результат);
	Иначе
		ОткрытьФайлPDF(Форма, Результат);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФайлPDF(Форма, Результат)
	
	// ToDo: В последствии убрать все что не ESD	
    ИспользоватьМодульESD = Найти(СокрЛП(Результат.СсылкаНаДокумент), "ESD") > 0; 
	Если ИспользоватьМодульESD Тогда
		ОткрытьФайлВESD(Форма, Результат);
		Возврат;		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат.АдресДвоичныхДанных) Тогда
				
		МодульКодаКлиент("ФайловаяСистемаКлиент").ОткрытьФайл(Результат.АдресДвоичныхДанных, , "ЭПД.pdf");
		
	ИначеЕсли ЗначениеЗаполнено(Результат.СсылкаНаПрисоединенныйФайл) Тогда
		
		ДанныеФайла = МодульКодаКлиент("РаботаСФайламиСлужебныйВызовСервера").ДанныеФайлаДляОткрытия(
			Результат.СсылкаНаПрисоединенныйФайл,
			Неопределено,
			Форма.УникальныйИдентификатор);
		
		МодульКодаКлиент("РаботаСФайламиКлиент").ОткрытьФайл(ДанныеФайла);
		
	Иначе
		ОткрытьФайлИзСпискаДокументов(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьQRКод(Результат)
	
	ПечатнаяФормаQR = Неопределено;
	Если Результат.ПечатнаяФормаQR <> Неопределено Тогда
		
		#Если ТолстыйКлиентОбычноеПриложение Или ТолстыйКлиентУправляемоеПриложение Тогда
			// Табличный документ в толстом клиенте не передается с сервера на клиент, поэтому заворачиваем в строку внутр.
			ПечатнаяФормаQR = ЗначениеИзСтрокиВнутр(Результат.ПечатнаяФормаQR);
		#Иначе
			ПечатнаяФормаQR = Результат.ПечатнаяФормаQR;
		#КонецЕсли
		
	КонецЕсли;
	
	Если ПечатнаяФормаQR <> Неопределено Тогда
		ПечатнаяФормаQR.Показать();
	Иначе
		
		Если Результат.СписокДокументов = Неопределено Тогда
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = Результат.ОписаниеОшибки;
			Сообщение.Сообщить();
			
		Иначе
			
			ОткрытьПервыйДокументИзСоответствия(Результат.СписокДокументов);
			
			ПараметрыФормы = Новый Структура();
			ПараметрыФормы.Вставить("СписокДокументов",     Результат.СписокДокументов);
			ПараметрыФормы.Вставить("ЭтоДинамическийТитул", Ложь);
			
			Оповестить("Saby_СписокДокументов", ПараметрыФормы);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФайлИзСпискаДокументов(Результат) 
		
	Если Результат.СписокДокументов = Неопределено Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Результат.ОписаниеОшибки;
		Сообщение.Сообщить();
		
	Иначе
		
		ОткрытьПервыйДокументИзСоответствия(Результат.СписокДокументов);
		
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("СписокДокументов",     Результат.СписокДокументов);
		ПараметрыФормы.Вставить("ЭтоДинамическийТитул", Ложь);
		
		Оповестить("Saby_СписокДокументов", ПараметрыФормы);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФайлВESD(Форма, Результат)
	
	ДанныеФайла = Неопределено;
	
	Если ЗначениеЗаполнено(Результат.АдресДвоичныхДанных) Тогда
				
		ДанныеФайла = Новый Структура("Расширение, СсылкаНаДвоичныеДанныеФайла");			
		ДанныеФайла.Расширение                  = "pdf";
		ДанныеФайла.СсылкаНаДвоичныеДанныеФайла = Результат.АдресДвоичныхДанных;
		
	ИначеЕсли ЗначениеЗаполнено(Результат.СсылкаНаПрисоединенныйФайл) Тогда
		
		ДанныеФайла = МодульКодаКлиент("ESD_РаботаСФайлами").ДанныеФайла(
						Результат.СсылкаНаПрисоединенныйФайл, Неопределено, Форма.УникальныйИдентификатор);
						
    Иначе		
		ОткрытьФайлИзСпискаДокументов(Результат);		
	КонецЕсли;	
	
	Если ДанныеФайла <> Неопределено Тогда
		МодульКодаКлиент("ESD_РаботаСФайламиКлиент").ОткрытьФайлЧерезПриложение(ДанныеФайла);		
     КонецЕсли;
	
КонецПроцедуры		
		
#КонецОбласти // ФормированиеПечатныхФорм

#Область ЗагрузкаАрхива

&НаКлиенте
Процедура ПередВыгрузкойАрхива(Результат, ДополнительныеПараметры) Экспорт
	Форма = ДополнительныеПараметры.Форма;
	Если ДополнительныеПараметры.ЭтоФормаСписка Тогда
		МассивСсылокНаДокумент = Форма.Элементы.Список.ВыделенныеСтроки;
		Для Каждого СсылкаНаДокумент Из МассивСсылокНаДокумент Цикл
			ДополнительныеПараметры.Вставить("СсылкаНаДокумент", СсылкаНаДокумент);
			ЗагрузитьАрхив(ДополнительныеПараметры);
		КонецЦикла;
	Иначе
		СсылкаНаДокумент = ОснованиеПечатнойФормы(Форма, ДополнительныеПараметры);
		Если НЕ ЗначениеЗаполнено(СсылкаНаДокумент) Тогда
			Возврат;
		КонецЕсли;
		ДополнительныеПараметры.Вставить("СсылкаНаДокумент", СсылкаНаДокумент);
		ЗагрузитьАрхив(ДополнительныеПараметры);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьАрхив(Параметры)
	Результат = ВыполнитьНаСервере("ESD_ТНЗагрузкаСервер.ЗагрузитьАрхивВложениеВоВложенныеФайлы", Параметры.СсылкаНаДокумент);
	Если ЗначениеЗаполнено(Результат) И Результат.Свойство("ОписаниеОшибки") Тогда
		Параметры.Вставить("ОшибкаЗагрузкиАрхива", Истина);
		СообщитьПользователю(Результат.ОписаниеОшибки);
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область НастройкаФункционалаESD

&НаКлиенте
Процедура ПриАвторизацииПользователя(Кеш)
	Если Не Кеш["ПройденаАвторизацияSaby"] Тогда
		Возврат;
	КонецЕсли;
	
	Если Кеш["ЕстьДоступКЯдру"] Тогда
		// BSLLS:GetFormMethod-off
		ФормаТранспорта = ПолучитьФорму(ФормыЯдраКлиент() + "Transport");
		// BSLLS:GetFormMethod-on
		ФормаТранспорта.УстановитьВариантВебИнтерфейса();
	КонецЕсли;	
КонецПроцедуры

