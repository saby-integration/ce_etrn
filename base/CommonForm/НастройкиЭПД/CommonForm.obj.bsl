КонецПроцедуры

&НаКлиенте
Процедура ЭПЛ_ПечатнаяФормаПриИзменении(Элемент)
	СохранитьНастройкиОбъекта("ESD_ПутевойЛист", Новый Структура("ПечатнаяФорма", ПечатнаяФормаЭПЛ));
КонецПроцедуры

#КонецОбласти // ОбработчикиКомандФормы

#Область СлужебныеПроцедурыИФункции

#Область НастройкаИнтерфейсаФормы

&НаСервере
Процедура ОбновитьВидимостьИДоступностьЭлементов()
	Если ЭтоESD Тогда	
		ВыполненПервыйВход = ПройденаПервичнаяИнициализация();
		
		Элементы.ВыполнитьПервыйВход.Видимость = Не ВыполненПервыйВход;	
		Если Не ВыполненПервыйВход Тогда 
			НастройкаИнтерфейсаДляПервогоВхода();
			Возврат;
		КонецЕсли;				
	КонецЕсли;	
				
	НастроитьФункционалРегламентныхЗаданийНаСервере();
	
	ОбновитьВидимостьДоступностьЭлементовГруппировки(Истина);
	
	ОбновитьВидимостьПоФункциональнымОпциям();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИнтерфейсНастроек()
	ЗагрузитьПараметрыГруппировки();
	
	НастройкиВыгружатьАрхивВложений();
	
	ЗагрузитьИспользоватьСНИЛС();
	
	ЗагрузитьИспользоватьТабельныйНомер();
	
	ЗаполнитьПользователейФоновыхЗаданий();
	
	ЗаполнитьНастройкиСопоставлений();
	
	ВывестиТекущуюВерсию();
	
	ИспользуемыйФункционал();
	
	ЗагрузитьХранитьСтатусыВДопСведениях();
КонецПроцедуры

&НаСервере
Процедура НастройкаИнтерфейсаДляПервогоВхода(ВходВыполнен = Ложь)
		
	МассивЭлементов = Новый Массив;
	
	МассивЭлементов.Добавить("ГруппаВходВыход");
	МассивЭлементов.Добавить("ГруппаВерсия");
	МассивЭлементов.Добавить("ГруппаРедакторИНИ");
	МассивЭлементов.Добавить("ГруппаИспользуемыйФункционал");
	
	МассивЭлементов.Добавить("ГруппаНачальноеЗаполнение");		
	МассивЭлементов.Добавить("ГруппаНастройкаДокументовОснований");
	МассивЭлементов.Добавить("ГруппаНастройкаГруппировки");
	МассивЭлементов.Добавить("ГруппаРегламентныеЗадания");
	МассивЭлементов.Добавить("ГруппаНастройкаСопоставлений");
	МассивЭлементов.Добавить("ГруппаИспользоватьСНИЛС");
	МассивЭлементов.Добавить("ГруппаИспользоватьТабельныйНомер");
	МассивЭлементов.Добавить("ГруппаХранениеСтатусов");
	МассивЭлементов.Добавить("ГруппаНастройкиВложенийИПечатныхФорм");
	
	МассивЭлементов.Добавить("ДекорацияПользователь");
	МассивЭлементов.Добавить("ДекорацияСервис");
	МассивЭлементов.Добавить("ГруппаАккаунт");
	
	МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ИзменитьСвойствоЭлементовФормы(
		ЭтаФорма, "Видимость", ВходВыполнен, МассивЭлементов);
	
КонецПроцедуры

#КонецОбласти // НастройкаИнтерфейсаФормы

#Область РегламентныеЗадания

&НаСервере
Процедура НастроитьФункционалРегламентныхЗаданийНаСервере()
	// Прерываем настройку, если ранее видимость была отключена
	Если Не Элементы.ГруппаРегламентныеЗадания.Видимость Тогда
		Возврат;
	КонецЕсли;
	
	Если СтандартныеРегламентныеЗаданияДоступны() Тогда
		УстановитьДанныеРегламентныхЗаданий();
		
		Элементы.НастроитьРасписаниеРегЗаданияЗагрузки.Видимость = ЗначениеЗаполнено(ЭтаФорма.ИдентификаторРегламентЗагрузки);
		Элементы.НастроитьРасписаниеРегЗаданияВыгрузки.Видимость = ЗначениеЗаполнено(ЭтаФорма.ИдентификаторРегламентВыгрузки);
		
		ОбновитьКнопкиИспользованияРегламентныхЗаданий();
		
		Элементы.ГруппаРегламентныеЗадания.Видимость = Истина;
	Иначе
		Элементы.ГруппаРегламентныеЗадания.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ИзменитьАктивностьРегЗаданияНаСервере(Знач ИмяИндикатора, Знач Идентификатор)
	ТекущееЗначение = ЭтаФорма[ИмяИндикатора]; 
	
	НовоеЗначение = Не ТекущееЗначение;
	ПараметрыИзменения = Новый Структура("Использование", НовоеЗначение);
	
	Если Не ИзменитьРегламентноеЗаданиеНаСервере(Идентификатор, ПараметрыИзменения) Тогда
		Возврат;
	КонецЕсли;
	
	ЭтаФорма[ИмяИндикатора] = НовоеЗначение;
	ОбновитьКнопкиИспользованияРегламентныхЗаданий();
КонецПроцедуры

&НаКлиенте
Процедура НастроитьРасписаниеРегламентногоЗадания(Идентификатор)
	Расписание = РасписаниеРегламентногоЗаданияНаСервере(Идентификатор);
	Если Расписание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Идентификатор", Идентификатор);
	
	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(Расписание);
	Диалог.Показать(Новый ОписаниеОповещения("ПослеНастройкиРасписанияРегЗадания", ЭтаФорма, ДопПараметры));
КонецПроцедуры

&НаКлиенте
Процедура ПослеНастройкиРасписанияРегЗадания(НовоеРасписание, ДопПараметры) Экспорт
	Если НовоеРасписание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыИзменения = Новый Структура("Расписание", НовоеРасписание);
	ИзменитьРегламентноеЗаданиеНаСервере(ДопПараметры.Идентификатор, ПараметрыИзменения);
КонецПроцедуры

&НаСервере
Процедура УстановитьДанныеРегламентныхЗаданий()
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	РегламентныеЗаданияESD = МодульКода("ESD_РегламентныеЗаданияСервер").КоллекцияРегламентныхЗаданий();
	
	ЗаданиеЗагрузка = РегламентныеЗаданияESD["ЗагрузкаЭПД"];
	Если ЗаданиеЗагрузка <> Неопределено Тогда	
		ЭтаФорма.ИдентификаторРегламентЗагрузки  = ЗаданиеЗагрузка.УникальныйИдентификатор;
		ЭтаФорма.ИспользуетсяРегламентЗагрузки   = ЗаданиеЗагрузка.Использование;	
	КонецЕсли;
	
	ЗаданиеВыгрузка = РегламентныеЗаданияESD["ВыгрузкаЭПД"];
	Если ЗаданиеВыгрузка <> Неопределено Тогда	
		ЭтаФорма.ИдентификаторРегламентВыгрузки  = ЗаданиеВыгрузка.УникальныйИдентификатор;
		ЭтаФорма.ИспользуетсяРегламентВыгрузки   = ЗаданиеВыгрузка.Использование;	
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура СообщитьОбОкончанииРучногоВыполненияРегламентногоЗадания()
	
	ОповещенияОбОкончанииВыполнения = ОповещенияОбОкончанииВыполненияРегламентныхЗаданий();
	
	Для каждого Оповещение Из ОповещенияОбОкончанииВыполнения Цикл
		
		Текст = НСтр("ru = 'Выполнена процедура регламентного задания';
			|en = 'Scheduled job procedure completed'");
		
		СтрокаДляПояснения = НСтр("ru = '%1.
			|Процедура завершена в фоновом задании %2';
			|en = '%1.
			|The scheduled job has been completed in the background job ""%2"".'");
		
		ТекстПояснения = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер").СтрШаблонЭПД(
			СтрокаДляПояснения,
			Оповещение.ПредставлениеРегламентногоЗадания,
			Строка(Оповещение.МоментОкончания));
		
		ПоказатьОповещениеПользователя(
			Текст,
			,
			ТекстПояснения,
			БиблиотекаКартинок.ВыполнитьРегламентноеЗаданиеВручную);
		
	КонецЦикла;
	
	Если ИдентификаторыФоновыхЗаданийПриРучномВыполнении.Количество() > 0 Тогда
		
		ПодключитьОбработчикОжидания("СообщитьОбОкончанииРучногоВыполненияРегламентногоЗадания", 2, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ОповещенияОбОкончанииВыполненияРегламентныхЗаданий()
	
	ОповещенияОбОкончанииВыполнения = Новый Массив;
	
	Если ИдентификаторыФоновыхЗаданийПриРучномВыполнении.Количество() > 0 Тогда
		Индекс = ИдентификаторыФоновыхЗаданийПриРучномВыполнении.Количество() - 1;
		
		УстановитьПривилегированныйРежим(Истина);
		Пока Индекс >= 0 Цикл
			
			НовыйУникальныйИдентификатор = Новый УникальныйИдентификатор(
				ИдентификаторыФоновыхЗаданийПриРучномВыполнении[Индекс].Значение);
			Отбор = Новый Структура;
			Отбор.Вставить("УникальныйИдентификатор", НовыйУникальныйИдентификатор);
			
			МассивФоновыхЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
			
			Если МассивФоновыхЗаданий.Количество() = 1 Тогда
				МоментОкончания = МассивФоновыхЗаданий[0].Конец;
				
				Если ЗначениеЗаполнено(МоментОкончания) Тогда
					
					ОповещениеОкончания = Новый Структура;
					ОповещениеОкончания.Вставить("ПредставлениеРегламентногоЗадания",
						ИдентификаторыФоновыхЗаданийПриРучномВыполнении[Индекс].Представление);
					
					ОповещениеОкончания.Вставить("МоментОкончания", МоментОкончания);
					
					ОповещенияОбОкончанииВыполнения.Добавить(ОповещениеОкончания);
					
					ИдентификаторыФоновыхЗаданийПриРучномВыполнении.Удалить(Индекс);
				КонецЕсли;
			Иначе
				ИдентификаторыФоновыхЗаданийПриРучномВыполнении.Удалить(Индекс);
			КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат ОповещенияОбОкончанииВыполнения;
	
КонецФункции

&НаСервере
Процедура ОбновитьКнопкиИспользованияРегламентныхЗаданий()
	НеИспользуется = Новый Картинка;
	Используется   = КартинкаИнтерфейса(ЭтаФорма, "ESD_Успешно32");
	
	Если ЗначениеЗаполнено(ЭтаФорма.ИдентификаторРегламентЗагрузки)
		И ЭтаФорма.ИспользуетсяРегламентЗагрузки 
	Тогда
		Элементы.ИзменитьАктивностьРегЗаданияЗагрузки.Картинка = Используется;
	Иначе
		Элементы.ИзменитьАктивностьРегЗаданияЗагрузки.Картинка = НеИспользуется;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ЭтаФорма.ИдентификаторРегламентВыгрузки)
		И ЭтаФорма.ИспользуетсяРегламентВыгрузки 
	Тогда
		Элементы.ИзменитьАктивностьРегЗаданияВыгрузки.Картинка = Используется;
	Иначе
		Элементы.ИзменитьАктивностьРегЗаданияВыгрузки.Картинка = НеИспользуется;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьРегламентноеЗаданиеВручную(Идентификатор, Наименование)
	ПараметрыВыполнения = ВыполнитьРегламентноеЗаданиеВручнуюНаСервере(Идентификатор);
	
	МассивСообщенийОбОшибках = Новый Массив;
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер");
	
	Если ПараметрыВыполнения.ЗапускВыполнен Тогда	
		Текст = НСтр("ru = 'Запущена процедура регламентного задания';
			|en = 'Scheduled job started'");
		
		ПояснениеТекст = НСтр("ru = '%1.
			|Процедура запущена в фоновом задании %2';
			|en = '%1.
			|The scheduled job has been started in the background job ""%2"".'");
		
		Пояснение = МодульТНОбщегоНазначенияКлиентСервер.СтрШаблонЭПД(
			ПояснениеТекст,
			Наименование,
			Строка(ПараметрыВыполнения.МоментЗапуска));
		
		ПоказатьОповещениеПользователя(
			Текст, ,
			Пояснение,
			БиблиотекаКартинок.ВыполнитьРегламентноеЗаданиеВручную);
		
		ЭтаФорма.ИдентификаторыФоновыхЗаданийПриРучномВыполнении.Добавить(
			ПараметрыВыполнения.ИдентификаторФоновогоЗадания,
			Наименование);
		
		ПодключитьОбработчикОжидания(
			"СообщитьОбОкончанииРучногоВыполненияРегламентногоЗадания", 0.1, Истина);	
	ИначеЕсли ПараметрыВыполнения.ПроцедураУжеВыполняется Тогда	
		Текст = НСтр("ru = 'Процедура регламентного задания ""%1""
			|  уже выполняется в фоновом задании ""%2"", начатом %3.';
			|en = 'The scheduled job ""%1"" is running in
			|the background job ""%2""  started on %3.'");
		
		Сообщение = МодульТНОбщегоНазначенияКлиентСервер.СтрШаблонЭПД(
			Текст,
			Наименование,
			ПараметрыВыполнения.ПредставлениеФоновогоЗадания,
			Строка(ПараметрыВыполнения.МоментЗапуска));
		
		МассивСообщенийОбОшибках.Добавить(Сообщение);	
	Иначе
		Возврат;
	КонецЕсли;
	
	КоличествоОшибок = МассивСообщенийОбОшибках.Количество();
	Если КоличествоОшибок > 0 Тогда	
		Текст = НСтр("ru = 'Задания не выполнены (%1 из %2)';
			|en = 'The jobs are not completed (%1 out of %2)'");
		
		ЗаголовокТекстаПроОшибки = МодульТНОбщегоНазначенияКлиентСервер.СтрШаблонЭПД(
			Текст,
			Формат(КоличествоОшибок, "ЧГ="),
			"1");
		
		ТекстВсехОшибок = Новый ТекстовыйДокумент;
		ТекстВсехОшибок.ДобавитьСтроку(ЗаголовокТекстаПроОшибки + ":");
		
		Для Каждого ТекстЭтойОшибки Из МассивСообщенийОбОшибках Цикл
			ТекстВсехОшибок.ДобавитьСтроку("");
			ТекстВсехОшибок.ДобавитьСтроку(ТекстЭтойОшибки);
		КонецЦикла;	
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ИзменитьПользователяРегламентныхЗаданийНаСервере()
	Если Не ЗначениеЗаполнено(ЭтаФорма.ПользовательФоновыхЗаданий) Тогда
		ИмяПользователяИБ = ИмяТекущегоПользователяИБ();
	Иначе
		ИмяПользователяИБ = ЭтаФорма.ПользовательФоновыхЗаданий;
	КонецЕсли;
	
	ПараметрыЗадания = Новый Структура("ИмяПользователя", ИмяПользователяИБ);
	
	ИзменитьРегламентноеЗаданиеНаСервере(ЭтаФорма.ИдентификаторРегламентВыгрузки, ПараметрыЗадания);
	ИзменитьРегламентноеЗаданиеНаСервере(ЭтаФорма.ИдентификаторРегламентЗагрузки, ПараметрыЗадания);
	
	СохранитьПараметрыГруппировки();
КонецПроцедуры

