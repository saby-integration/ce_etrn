КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокАвторизации()
	ФИОАвторизации = "";
	ИмяСервиса     = "";	
	ИмяАккаунта    = "";
	
	Модуль_Core = МодульКода("ESD_Core");
	
	ПараметрыАвторизации = Модуль_Core.НастройкиПодключенияПрочитать();
	СтруктураСессии      = Модуль_Core.СтруктураСессии(ПараметрыАвторизации);
	
	АвторизацияВыполнена = ТипЗнч(СтруктураСессии) = Тип("Структура")
		И ЗначениеЗаполнено(СтруктураСессии);
				
	Если АвторизацияВыполнена Тогда
		Элементы.ДекорацияАвторизация.Заголовок = "Выйти";
		Элементы.ДекорацияАвторизация.Подсказка = "Закрыть сессию";
		
		Если СтруктураСессии.Свойство("user_fio") Тогда
			ФИОАвторизации = СтруктураСессии.user_fio;
			ИмяСервиса = ПараметрыАвторизации.api_url;	
		КонецЕсли;
		
		СтруктураСессии.Свойство("AccountTitle", ИмяАккаунта);
		Элементы.ГруппаАккаунт.Видимость = Истина;
	Иначе
		Элементы.ДекорацияАвторизация.Заголовок = "Войти";
		Элементы.ДекорацияАвторизация.Подсказка = "Открыть сессию";
		Элементы.ГруппаАккаунт.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.ДекорацияПользователь.Заголовок = ФИОАвторизации;
	Элементы.ДекорацияСервис.Заголовок	     = ИмяСервиса;
	Элементы.ДекорацияАккаунт.Заголовок      = ИмяАккаунта;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаРезультатаЗакрытияФормыАвторизации(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда 
		Возврат;
	Иначе 	
		ПослеАвторизации();
		МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиент").ESD_ПриАвторизации();
		ОбновитьАктуальныйСтатусВерсии();
	КонецЕсли;
		
КонецПроцедуры 

&НаКлиенте
Процедура ОбновитьАктуальныйСтатусВерсии()
	Если Не ЭтаФорма.ИспользоватьСсылкаНаОбновление Тогда
		Возврат;
	КонецЕсли;
		
	Элементы.ГруппаОбновление.Видимость = Истина;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ДвоичныеДанныеОбработки", Неопределено);
	ДополнительныеПараметры.Вставить("НаКлиенте",               Ложь);
	ДополнительныеПараметры.Вставить("ОтветНаКлиенте",          Неопределено);
	
	МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиент").ВыполнитьКомандуСбис(
		ЭтаФорма, "АктуальныйСтатусВерсии", Неопределено, ДополнительныеПараметры);	
КонецПроцедуры

&НаСервере
Процедура ПослеАвторизации()
	Если ЭтоESD И Не ПройденаПервичнаяИнициализация() Тогда		
		ИзменитьЗначениеКонстанты("ESD_ПройденаПервичнаяИнициализация", Истина);
		МодульКода("ESD_ТНОбщегоНазначенияСервер").ПослеПрохожденияПервичнойИнициализации();
		НастройкаИнтерфейсаДляПервогоВхода(Истина);
		ЗаполнитьИнтерфейсНастроек();
		ОбновитьВидимостьИДоступностьЭлементов();
	КонецЕсли;	
	
	ЗагрузитьСопоставленияДанных();
	АвторизацияРасширенияНаСервере();
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиОбъекта(Знач ИмяМетаданных, Знач Настройки)
