&НаКлиенте
Процедура НастройкаВсехДокументовОснований(ИмяКоманды)
	
	ПараметрыФормы = ПараметрыДляНастройкиОснований(ИмяКоманды);
	
	ОткрытьФорму("ОбщаяФорма." + ВыборТиповЭПДКлиент(), ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Функция ПараметрыДляНастройкиОснований(Знач ИмяКоманды)
	
	Если ИмяКоманды = "НастройкиДокументовОснованийЭПЛ" Тогда
		Ссылка = Документы[ПутевойЛист()].ПустаяСсылка();
	ИначеЕсли ИмяКоманды = "НастройкиДокументовОснованийЗнП" Тогда
		Ссылка = Документы[ЗаказНаПеревозку()].ПустаяСсылка();
	Иначе 	
		Ссылка = Документы[ТранспортнаяНакладная()].ПустаяСсылка();
	КонецЕсли;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Ссылка", Ссылка);
	
	Возврат ДопПараметры;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьРезультатЗагрузкиСправочника(РезультатЗагрузки)
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = РезультатЗагрузки.Текст;
	Сообщение.Сообщить();
	
	Если ЗначениеЗаполнено(РезультатЗагрузки.ОписаниеОшибок) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = РезультатЗагрузки.ОписаниеОшибок;
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция РезультатЗагрузкиСправочника(Знач НаименованиеСправочника)
	
	ОбщиеПараметрыЗагрузки = МодульКода("ESD_ТНОбщегоНазначенияСервер").ОбщиеПараметрыВыгрузкиЗагрузки();
	
	Если НаименованиеСправочника = "ESD_ВидыУпаковки" Тогда
		Результат = МодульКода("Справочники.ESD_ВидыУпаковки").ЗагрузитьВидыУпаковкиСОнлайна(ОбщиеПараметрыЗагрузки);
	Иначе
		Результат = МодульКода("Справочники.ESD_ОпасныеГрузы").ЗагрузитьОпасныеГрузыСОнлайна(ОбщиеПараметрыЗагрузки);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

