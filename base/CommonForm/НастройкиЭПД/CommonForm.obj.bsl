&НаСервере
Функция ПройденаПервичнаяИнициализация()
	
	Если Не ЭтоESD Тогда
		Результат = Истина;
	Иначе
		Результат = Константы.ESD_ПройденаПервичнаяИнициализация.Получить();		
	КонецЕсли;

	Возврат Результат;
		
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуАвторизации()
	
	ПроверкаДанныхАутентификации = Новый ОписаниеОповещения("ОбработкаРезультатаЗакрытияФормыАвторизации",
		ЭтаФорма);
	
	ОткрытьФорму("Обработка.ESD_SABY.Форма.Вход", , ЭтаФорма, , , , ПроверкаДанныхАутентификации);
	
КонецПроцедуры

&НаСервере
Процедура ПослеИзмененияАвторизацииНаСервере()
	УстановитьЗаголовокАвторизации();	
	НастроитьФункционалПечати();	
КонецПроцедуры

#Область ПоддерживаемыеКонфигурации

&НаСервере
Процедура ЗаполнитьПоддерживаемыеКонфигурации()
	
	Если Не ЭтаФорма.ЭтоESD Тогда
		Возврат;
	КонецЕсли;	
	
	// заполним список выбора
	Список = МодульКода("ESD_ТНОбщегоНазначенияСервер").ПоддержанныеКонфигурации();
	Для Каждого Строка Из Список Цикл
		
		НоваяСтрока = Элементы.ЭтаКонфигурация.СписокВыбора.Добавить();
		НоваяСтрока.Значение      = Строка.Ключ;
		НоваяСтрока.Представление = Строка.Значение.Представление;
		
	КонецЦикла;
	
	// Пустая
	НоваяСтрока = Элементы.ЭтаКонфигурация.СписокВыбора.Добавить();
	НоваяСтрока.Значение      = "";
	НоваяСтрока.Представление = "Своя конфигурация";
	
	// установим текущую конфигурацию
	КонфигурацияНастроек = КонфигурацияНастроекСопоставлений();	
	Если ЗначениеЗаполнено(КонфигурацияНастроек) Тогда
		ЭтаФорма.ЭтаКонфигурация = КонфигурацияНастроек;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция КонфигурацияНастроекСопоставлений()
	
	ТекущаяКонфигурация = Константы["ESD_КонфигурацияДляСопоставлений"].Получить();
	
	Если Не ЗначениеЗаполнено(ТекущаяКонфигурация) Тогда
				
		ДоступнаяКонфигурация = МодульКода("ESD_ТНОбщегоНазначенияСервер").ЭтоДоступнаяКонфигурация();
		ТекущаяКонфигурация = ДоступнаяКонфигурация.Имя;
		
	КонецЕсли;
	
	Возврат ТекущаяКонфигурация;
	
КонецФункции

&НаКлиенте
Процедура ПроверкаВозможностиЗагрузкиНастроек()

    ЗагрузкаДоступна = ЗначениеЗаполнено(ЭтаФорма.ЭтаКонфигурация);
	
	Элементы.ЗагрузитьНастройкиСопоставлений.Доступность = ЗагрузкаДоступна;
	Элементы.Декорация_КонфигурацияОшибка.Видимость      = Не ЗагрузкаДоступна;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаООчисткеНастроек(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.ЭтаКонфигурация = "";
	
	ЭтаКонфигурацияОчисткаСервер();
	
	ПроверкаВозможностиЗагрузкиНастроек();
КонецПроцедуры

&НаСервере
Процедура ЭтаКонфигурацияОчисткаСервер()

	// сбросим значение константы
	ИзменитьЗначениеКонстанты("ESD_КонфигурацияДляСопоставлений", ЭтаФорма.ЭтаКонфигурация);
	
	// сбросим настройки сопоставлений
	УдалитьТекущиеСопоставленияДанных();
КонецПроцедуры

#КонецОбласти // ПоддерживаемыеКонфигурации

&НаСервере
Процедура ИзменитьЗначениеКонстанты(Знач Имя, Знач Значение)
	
	МодульКода("ESD_ТНОбщегоНазначенияСервер").УстановитьЗначениеКонстанты(
		Имя, Значение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеИзмененияИспользованияНовогоРедактора(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		ЭтаФорма.ИспользоватьНовыйРедактор = Не ЭтаФорма.ИспользоватьНовыйРедактор;
		Возврат;
	КонецЕсли;
	
	ИзменитьЗначениеКонстанты("ESD_ИспользоватьНовыйРедактор", ЭтаФорма.ИспользоватьНовыйРедактор);
	
	ИспользоватьНовыйРедакторПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ИспользоватьНовыйРедакторПриИзмененииНаСервере()
	
	ОбновитьСопоставленияДанных();
	
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ПрименитьДополнительныеПрава(Результат) Экспорт
	
	ЭтаФорма.ИспользоватьСсылкаНаОбновление = Результат.СкачиваниеОбновления;
	ЭтаФорма.Элементы.ГруппаОбновление.Видимость = Результат.СкачиваниеОбновления;
	
	Для Каждого Настройка Из Результат Цикл
		Если Лев(Настройка.Ключ, 10) = "Настройки_" Тогда
			Если Настройка.Ключ = "Настройки_Дополнительно" Тогда
				ЭтаФорма.Элементы["ГруппаИспользоватьСНИЛС"].Видимость = Настройка.Значение И ЭтаФорма.ИспользоватьПутевойЛист;
				ЭтаФорма.Элементы["ГруппаИспользоватьТабельныйНомер"].Видимость = Настройка.Значение;
				ЭтаФорма.Элементы["ГруппаХранениеСтатусов"].Видимость = Настройка.Значение И ЭтоESD;
			ИначеЕсли Настройка.Ключ = "Настройки_РедакторИНИ" Тогда
				ЭтаФорма.Элементы["ГруппаРедакторИНИ"].Видимость = Настройка.Значение;
			ИначеЕсли Настройка.Ключ = "Настройки_ГруппаНастройкаГруппировки" Тогда
				ЭтаФорма.Элементы["ГруппаНастройкаГруппировки"].Видимость = Настройка.Значение И (ЭтаФорма.ИспользоватьТранспортнаяНакладная 
																								Или ЭтаФорма.ИспользоватьЗаказНаПеревозку);
			Иначе
				ЭтаФорма.Элементы[Сред(Настройка.Ключ, 11)].Видимость = Настройка.Значение;
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти // СлужебныеПроцедурыИФункции

