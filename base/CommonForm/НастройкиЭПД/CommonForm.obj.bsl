&НаКлиенте
Функция ПараметрыЗадания(Знач Идентификатор)
	
	ПараметрыЗадания = Новый Структура;
	
	Если Идентификатор = ЭтаФорма.ИдентификаторРегламентВыгрузки Тогда
		Использование = ЭтаФорма.ИспользуетсяРегламентВыгрузки;
	ИначеЕсли Идентификатор = ЭтаФорма.ИдентификаторРегламентЗагрузки Тогда
		Использование = ЭтаФорма.ИспользуетсяРегламентЗагрузки;
	Иначе
		Использование = Ложь;
	КонецЕсли;
	
	ПараметрыЗадания.Вставить("Использование", Использование);
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.ПользовательФоновыхЗаданий) Тогда
		ИмяПользователяИБ =  ИмяТекущегоПользователяИБ();
	Иначе
		ИмяПользователяИБ = ЭтаФорма.ПользовательФоновыхЗаданий;
	КонецЕсли;
	
	ПараметрыЗадания.Вставить("ИмяПользователя", ИмяПользователяИБ);
	
	Возврат ПараметрыЗадания;
	
КонецФункции

&НаСервереБезКонтекста
Функция ИмяТекущегоПользователяИБ()
	
	ТекущийПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	
	ИмяПользователя = "";
	Если ТекущийПользовательИБ <> Неопределено Тогда
		ИмяПользователя =  ТекущийПользовательИБ.Имя;
	КонецЕсли;
	
	Возврат ИмяПользователя;
	
КонецФункции

#Область Авторизация

&НаСервере
Процедура АвторизацияРасширения()
	
	Если Не ЭтоESD Тогда
		Возврат;		
	КонецЕсли;	
	
	УстановитьЗаголовокАвторизации();	
	
КонецПроцедуры

&НаСервере
Процедура ВыйтиНаСервере()
	
	МодульОбъектаОбработки = ОбъектОбработки();
	
	saby_param = МодульОбъектаОбработки.НастройкиПодключенияПрочитать();
	Если saby_param <> Неопределено Тогда	
		saby_param.Вставить("session", Неопределено);
		saby_param.Вставить("password", Неопределено);
		МодульОбъектаОбработки.НастройкиПодключенияЗаписать(saby_param);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокАвторизации(Знач Выйти = Ложь)
	
	Если Выйти Тогда
		ВыйтиНаСервере();
	КонецЕсли;	
	
	ОбъектОбработки = ОбъектОбработки();
	
	ПараметрыАвторизации = ОбъектОбработки.НастройкиПодключенияПрочитать();
	СтруктураСессии = ОбъектОбработки.СтруктураСессии(ПараметрыАвторизации);
	
	АвторизацияВыполнена =
	    ТипЗнч(СтруктураСессии) = Тип("Структура")
		И ЗначениеЗаполнено(СтруктураСессии);
		
	Если АвторизацияВыполнена Тогда
		Элементы.ДекорацияАвторизация.Заголовок = "Выйти";
		Элементы.ДекорацияАвторизация.Подсказка = "Закрыть сессию";
	Иначе
		Элементы.ДекорацияАвторизация.Заголовок = "Войти";
		Элементы.ДекорацияАвторизация.Подсказка = "Открыть сессию";
	КонецЕсли;
	
	ФИОАвторизации = "";
	ИмяСервиса     = "";	
	Если АвторизацияВыполнена
		И СтруктураСессии.Свойство("user_fio") Тогда
		
		ФИОАвторизации = СтруктураСессии.user_fio;
		ИмяСервиса = ПараметрыАвторизации.api_url;
		
	КонецЕсли;
	
	Элементы.ДекорацияПользователь.Заголовок = ФИОАвторизации;
	Элементы.ДекорацияСервис.Заголовок	     = ИмяСервиса;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаРезультатаЗакрытияФормыАвторизации(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда 
		Возврат;
	Иначе 
		УстановитьЗаголовокАвторизации();
		ПослеАвторизации();
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ПослеАвторизации()
	
	СоздатьСопоставленияПоУмолчанию();
	
	ОбновитьСопоставленныеДанные();
	
КонецПроцедуры

