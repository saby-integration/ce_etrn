	СтруктураПараметров = ХранилищеОбщихНастроек.Загрузить(
		"Saby", "ПараметрыГруппировкиПозицийОснований", , "ESD_ДляВсехПользователей");
	Если СтруктураПараметров <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма, СтруктураПараметров);
	КонецЕсли;
	
