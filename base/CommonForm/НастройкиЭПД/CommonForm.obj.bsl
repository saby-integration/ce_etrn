&НаСервере
Процедура ВывестиТекущуюВерсию()
	
	Если Найти(ЭтаФорма.ИмяФормы, "ESD") = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ШаблонВерсии = "Версия: %1";
	
	ИмяИВерсия = МодульКода("ESD_Core").ПолучитьИмяФайлаИНомерТекущейВерсии();
	Версия     = ИмяИВерсия[1];
	
	Элементы.ДекорацияВерсия.Заголовок = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрШаблонЭПД(ШаблонВерсии, Версия);
	
КонецПроцедуры

&НаСервере
Процедура ИспользуемыйФункционал()
	
	Если Не ЭтоESD Тогда
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.ИспользоватьТранспортнаяНакладная = Константы.ESD_ИспользоватьТранспортнаяНакладная.Получить();
	ЭтаФорма.ИспользоватьПутевойЛист           = Константы.ESD_ИспользоватьПутевойЛист.Получить();
	ЭтаФорма.ИспользоватьЗаказНаПеревозку      = Константы.ESD_ИспользоватьЗаказНаПеревозку.Получить();
	
	Если ОтключенВесьФункционал() Тогда
		
		// Первоначальная инициализация
		Константы.ESD_ИспользоватьТранспортнаяНакладная.Установить(Истина);
		Константы.ESD_ИспользоватьПутевойЛист.Установить(Истина);
		Константы.ESD_ИспользоватьЗаказНаПеревозку.Установить(Истина);
		
		// перечитаем настройки
		ИспользуемыйФункционал();
		
	КонецЕсли;
		
КонецПроцедуры

#Область ИспользуемыйФункционал

&НаКлиенте
Процедура ОбновитьЗначениеФункциональнойОпции(ИмяОпции)
	
	ОбновитьЗначениеФункциональнойОпцииСервер(ИмяОпции);
	ОбновитьИнтерфейс();
	
	ОбновитьРабочийСтолCF();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗначениеФункциональнойОпцииСервер(Знач ИмяОпции)
	
	Значение     = ЭтаФорма[ИмяОпции];
	ИмяКонстанты = "ESD_" + ИмяОпции;
		
	Если ОтключенВесьФункционал() Тогда
		
		ТекстСообщения = "Нельзя отключить весь функционал! Оставьте активным хотя бы один документ";
		МодульКода("ESD_ТНОбщегоНазначенияСервер").СообщитьПользователюСервер(ТекстСообщения, , "ГруппаИспользуемыйФункционал");
		
		// вернем флаг обратно
		ЭтаФорма[ИмяОпции] = Не ЭтаФорма[ИмяОпции];
		
	Иначе		
		Константы[ИмяКонстанты].Установить(Значение);		
	КонецЕсли;	
	
	ОбновитьВидимостьИДоступностьЭлементов();
	
КонецПроцедуры

&НаСервере
Функция ОтключенВесьФункционал()
	
	ВключенОдинДокумент = Макс(
		ЭтаФорма.ИспользоватьТранспортнаяНакладная, 
		ЭтаФорма.ИспользоватьПутевойЛист, 
		ЭтаФорма.ИспользоватьЗаказНаПеревозку);
		
	Возврат Не ВключенОдинДокумент;	
	
КонецФункции

&НаСервере
Процедура ОбновитьВидимостьПоФункциональнымОпциям()
	
	Если Не ЭтаФорма.ЭтоESD Тогда
		Возврат;
	КонецЕсли;
		
	// ЭТрН	
	Элементы.НастройкиДокументовОснованийЭТрН.Видимость = ЭтаФорма.ИспользоватьТранспортнаяНакладная; 
	Элементы.ГруппаESD_ТранспортнаяНакладная.Видимость  = ЭтаФорма.ИспользоватьТранспортнаяНакладная;
		
	// ЭПЛ		
	Элементы.НастройкиДокументовОснованийЭПЛ.Видимость  = ЭтаФорма.ИспользоватьПутевойЛист;
	Элементы.ГруппаESD_ПутевойЛист.Видимость            = ЭтаФорма.ИспользоватьПутевойЛист; 
	Элементы.ГруппаИспользоватьСНИЛС.Видимость          = ЭтаФорма.ИспользоватьПутевойЛист;
	
	// ЗнП
	Элементы.НастройкиДокументовОснованийЗнП.Видимость  = ЭтаФорма.ИспользоватьЗаказНаПеревозку;
	Элементы.ГруппаESD_ЗаказНаПеревозку.Видимость       = ЭтаФорма.ИспользоватьЗаказНаПеревозку;
	
	// Остальные	
	ЕстьЭтрНИлиЗаказ = ЭтаФорма.ИспользоватьТранспортнаяНакладная 
						Или ЭтаФорма.ИспользоватьЗаказНаПеревозку;
						
	Элементы.ГруппаНастройкаГруппировки.Видимость = ЕстьЭтрНИлиЗаказ;
		
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРабочийСтолCF()

	Если ЭтоCF() Тогда
		Оповестить("ESD_ОбновитьРабочийСтол");
	КонецЕсли;	
		
КонецПроцедуры

&НаСервере
Функция ЭтоCF()
	
	// Для старых конфигураций работающих на CF	
	ИмяОпции = "ESD_ИспользоватьТранспортнаяНакладная";	
	Возврат Метаданные.ФункциональныеОпции.Найти(ИмяОпции) = Неопределено;
	
КонецФункции

#КонецОбласти // ИспользуемыйФункционал

&НаКлиенте
Процедура ОткрытьРедакторФайловНастроекНажатие(Элемент)
		
	ESDКлиентСервер = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер");	
	context_params  = ВыполнитьНаСервере("ESD_ТНОбщегоНазначенияСервер.ПроверитьНаличиеПараметровПодключенияЭПД", Неопределено);
	
	Сессия   = ESDКлиентСервер.ДанныеСтруктуры(context_params, "session");
	АПИАдрес = ESDКлиентСервер.ДанныеСтруктуры(context_params, "api_url");
	
	Если Сессия <> Неопределено Тогда
		
		web_interface = ESDКлиентСервер.ДанныеСтруктуры(context_params, "public.web_interface");
		Если web_interface = "BrowserSabyPlugin" Тогда
			connector = "Lpp1C2";
		ИначеЕсли web_interface = "BrowserSaby" Тогда
			connector = "1c-lppbl";
		Иначе
			connector = "1C2";	
		КонецЕсли;
		
		АдресСтраницы = context_params.api_url
			+ "/blockly_editor_1c/page/?connection_id="
			+ context_params.ConnectionId
			+ "&connector="
			+ connector
			+ "&command="
			+ connector; 
			
	ИначеЕсли АПИАдрес <> Неопределено Тогда
		АдресСтраницы = context_params.api_url + "/auth/";
	Иначе
		АдресСтраницы = "https://ie-1c.saby.ru/auth/";	
	КонецЕсли;
	
	ПараметрыФормыРедактора = Новый Структура();
	ПараметрыФормыРедактора.Вставить("Заголовок", "Редактор файлов настроек");
	ПараметрыФормыРедактора.Вставить("АдресСтраницы", АдресСтраницы);
	ОткрытьФорму(ФормыЯдраКлиент() + "Browser", ПараметрыФормыРедактора, , "Редактор файлов настроек");
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьКэшНажатие(Элемент)
	СброситьКэшНаСервере();
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "Общие настройки ини очищены";
	Сообщение.Сообщить();
КонецПроцедуры

&НаСервере
Процедура СброситьКэшНаСервере()
	ОбъектОбработки = ОбъектОбработки();
	ОбъектОбработки.СброситьКэшНаСервере();
КонецПроцедуры

