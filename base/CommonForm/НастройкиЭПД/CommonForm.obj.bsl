#Область ФункционалПечатиЭПЛ

&НаСервере
Процедура НастройкиПечати_ЭПЛ()
	// Видимость и доступность элементов по умолчанию 
	Элементы.Декорация_ФункционалПечатиОшибка_ЭПЛ.Видимость = Ложь;
	Элементы.ПечатнаяФормаЭПЛ.ТолькоПросмотр = Ложь;
	Элементы.ПечатнаяФормаЭПЛ.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСнизу;
	Элементы.ПечатнаяФормаЭПЛ.СписокВыбора.Очистить();
	
	Попытка
		Если НЕ АвторизацияВыполнена Тогда
			ВызватьИсключение ФункционалПечатныхФорм_ОшибкаОтсутствуетАвторизация();	
		КонецЕсли;
		
		// Попытка получения и заполнения печатных форм
		ПечатнаяФормаЭПЛ_ЗаполнитьДанныеВыбора();
	Исключение
		ИнфоОшибки = ИнформацияОбОшибке();
		
		Элементы.Декорация_ФункционалПечатиОшибка_ЭПЛ.Видимость = Истина;
		Элементы.Декорация_ФункционалПечатиОшибка_ЭПЛ.Заголовок = КраткоеПредставлениеОшибки(ИнфоОшибки);
		Элементы.ПечатнаяФормаЭПЛ.ТолькоПросмотр = Истина;
		Элементы.ПечатнаяФормаЭПЛ.ОтображениеПодсказки = ОтображениеПодсказки.Нет;
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ПечатнаяФормаЭПЛ_ЗаполнитьДанныеВыбора()
	ИмяМетаданных = "ESD_ПутевойЛист";
	
	Попытка
		ПечатныеФормы = ЗагрузитьСписокВыбораПечатныхФорм(ИмяМетаданных);
	Исключение
		ВызватьИсключение ФункционалПечатныхФорм_ОшибкаПолученияПечатныхФорм();	
	КонецПопытки;
	
	// Заполнение списка выбора
	Для Каждого ДанныеПФ Из ПечатныеФормы Цикл
		ДанныеПечатнойФормы = ДанныеПФ["Values"];
		Элементы.ПечатнаяФормаЭПЛ.СписокВыбора.Добавить(ДанныеПечатнойФормы["Id"], ДанныеПечатнойФормы["Name"]);
	КонецЦикла;
	
	// Получение текущей печатной формы
	ЭтаФорма.ПечатнаяФормаЭПЛ = ВыбраннаяПечатнаяФорма(ИмяМетаданных);
КонецПроцедуры

