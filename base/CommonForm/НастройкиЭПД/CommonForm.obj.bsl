
#Область ПеременныеФормы

// BSLLS:UnusedLocalVariable-off
&НаКлиенте
Перем ТранспортИнтеграции;
// BSLLS:UnusedLocalVariable-on

#КонецОбласти

#Область ОбработчикиСобытийФормы  

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЭтаФорма.ЭтоESD = ЭтоУниверсальноеРасширение();
	
	// Установим значение прохождения первичной инициализации
	ЭтаФорма.ПройденаПервичнаяИнициализация = ПройденаПервичнаяИнициализация();
	// Обработаем прохождение первичной инициализации
	Если ЭтаФорма.ПройденаПервичнаяИнициализация Тогда
		ЗаполнитьИнтерфейсНастроек();
		ПослеИзмененияАвторизацииНаСервере();
	КонецЕсли;

	// Настроим видимость и доступность элементов относительно первичной инициализации
	ОбновитьВидимостьИДоступностьЭлементов();
	
	// Подключение модуля "длительных операций" на форму
	МодульКода("ESD_ДлительныеОперации").Подключаемый_ПриСозданииНаСервере(ЭтаФорма);
	// Подключение "общих настроек ЭПД" на форму
	ESD_ОбщийФункционалСервер.ОбщиеНастройкиЭПД_Инициализация(ЭтаФорма, Элементы.ГруппаОбщийФункционалЭПД);
КонецПроцедуры

#Область include_base_CommonForm_НастройкиЭПД_ОбновлениеВерсииОбработчикиСобытийФормы
#КонецОбласти // include_base_CommonForm_НастройкиЭПД_ОбновлениеВерсииОбработчикиСобытийФормы

#КонецОбласти // ОбработчикиСобытийФормы

#Область ОбработчикиСобытийЭлементовФормы  

&НаКлиенте
Процедура ВыгружатьАрхивВложенийПриИзменении(Элемент)
	
	ВыгружатьАрхивВложений();
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппироватьТоварыИзДокументовОснованийПриИзменении(Элемент)
	
	Если Не ЭтаФорма.ГруппироватьТоварыИзДокументовОснований Тогда
		ЭтаФорма.ГруппироватьВОднуПозицию            = Ложь;
		ЭтаФорма.ГруппироватьПоРеквизитуНоменклатуры = Ложь;
	КонецЕсли;
	
	СохранитьПараметрыГруппировки();
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппироватьПоРеквизитуНоменклатурыПриИзменении(Элемент)
	
	Если ЭтаФорма.ГруппироватьПоРеквизитуНоменклатуры Тогда
		ЭтаФорма.ГруппироватьВОднуПозицию = Ложь;
	КонецЕсли;
	
	СохранитьПараметрыГруппировки();
	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитНоменклатурыПриИзменении(Элемент)
	
	СохранитьПараметрыГруппировки();
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппироватьВОднуПозициюПриИзменении(Элемент)
	
	Если ЭтаФорма.ГруппироватьВОднуПозицию Тогда
		ЭтаФорма.ГруппироватьПоРеквизитуНоменклатуры = Ложь;
	КонецЕсли;
	
	СохранитьПараметрыГруппировки();
	
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеОбщейПозицииПриИзменении(Элемент)
	
	СохранитьПараметрыГруппировки();
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьСНИЛСПриИзменении(Элемент)
	
	СохранитьИспользованиеСНИЛС();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьАвторизацию(Элемент)
	
	Если Элементы.ДекорацияАвторизация.Заголовок = "Войти" Тогда
		ОткрытьФормуАвторизации();
	Иначе		
		ВыйтиНаСервере();
		ПослеВыхода();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СсылкаОбновлениеНажатие(Элемент)
    // BSLLS:UsingSynchronousCalls-off
    ЗапуститьПриложение(Элемент.Подсказка);
    // BSLLS:UsingSynchronousCalls-on
КонецПроцедуры 

&НаКлиенте
Процедура ИспользоватьТабельныйНомерПриИзменении(Элемент)
	
	СохранитьИспользованиеТабельногоНомера();
	
КонецПроцедуры

&НаКлиенте
Процедура ЭтаКонфигурацияПриИзменении(Элемент)
	ПроверкаВозможностиЗагрузкиНастроек();
КонецПроцедуры

&НаКлиенте
Процедура ЭтаКонфигурацияОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПроцедураПослеВопросаООчистке = Новый ОписаниеОповещения(
			"ПослеВопросаООчисткеНастроек", ЭтаФорма);
		
		ПоказатьВопрос(
			ПроцедураПослеВопросаООчистке,
			"Будут очищены все имеющиеся настройки сопоставлений, продолжить?",
			РежимДиалогаВопрос.ДаНет,
			120,
			КодВозвратаДиалога.Нет,
			"Очистить настройки сопоставлений?",
			КодВозвратаДиалога.Нет);
			
КонецПроцедуры

&НаКлиенте
Процедура ХранитьСтатусыВДопСведенияхПриИзменении(Элемент)
	МодульКодаКлиент("ESD_ТНОбщегоНазначенияСервер")
		.ХранитьСтатусыВДополнительныхСведениях_Записать(ЭтаФорма.ХранитьСтатусыВДопСведениях);
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияАккаунтНажатие(Элемент)
	ОповещениеПослеСменыАккаунта = Новый ОписаниеОповещения("ПослеСменыАккаунта", ЭтаФорма);
	СменитьАккаунтВВыпадающемСписке(Элемент, , ОповещениеПослеСменыАккаунта);
КонецПроцедуры

&НаКлиенте
Процедура СписокРегламентныхЗаданийПользовательПриИзменении(Элемент)
	МодульКодаКлиент("ESD_РегламентныеЗаданияКлиент").ИзменитьПользователяРегламентныхЗаданий(
		ЭтаФорма.Элементы.СписокРегламентныхЗаданий.ТекущиеДанные);
    РегламентныеЗадания_ПослеИзменения(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура СписокРегламентныхЗаданийИспользованиеПриИзменении(Элемент)
	МодульКодаКлиент("ESD_РегламентныеЗаданияКлиент").ИзменитьАктивностьРегламентныхЗаданий(
		ЭтаФорма.Элементы.СписокРегламентныхЗаданий.ТекущиеДанные);
	РегламентныеЗадания_ПослеИзменения(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура СписокРегламентныхЗаданийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ВыбранноеРегЗадание = Элемент.ТекущиеДанные;
	Если ВыбранноеРегЗадание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле = Элементы.СписокРегламентныхЗаданийРучнойЗапуск Тогда
		РегламентныеЗадания_ВыполнитьВручную(ВыбранноеРегЗадание.УникальныйИдентификатор, ВыбранноеРегЗадание.Наименование);
	ИначеЕсли Поле = Элементы.СписокРегламентныхЗаданийРасписание Тогда
		РегламентныеЗадания_ИзменитьРасписание(ВыбранноеРегЗадание.УникальныйИдентификатор);
	Иначе
		Возврат;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Декорация_ДополнительныеПоляНажатие(Элемент)
	ОткрытьФорму("Справочник.ESD_ДополнительныеПоля.ФормаСписка", , ЭтаФорма);
КонецПроцедуры

#КонецОбласти // ОбработчикиСобытийЭлементовФормы

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НастройкиДокументовОснований(Команда)
	
	ТекущаяКнопка = ЭтаФорма.ТекущийЭлемент;
	
	НастройкаВсехДокументовОснований(ТекущаяКнопка.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСправочникВидыУпаковки(Команда)
	
	РезультатЗагрузки = РезультатЗагрузкиСправочника("ESD_ВидыУпаковки");
	
	ПоказатьРезультатЗагрузкиСправочника(РезультатЗагрузки);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСправочникОпасныеГрузы(Команда)
	
	РезультатЗагрузки = РезультатЗагрузкиСправочника("ESD_ОпасныеГрузы");
	
	ПоказатьРезультатЗагрузкиСправочника(РезультатЗагрузки);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПервыйВход(Команда)
	
	ОткрытьФормуАвторизации();
		
КонецПроцедуры

&НаКлиенте
Процедура ЭПЛ_ПечатнаяФормаПриИзменении(Элемент)
	ФункционалПечатныхФорм_СохранитьНастройкиНаСервере("ESD_ПутевойЛист", ПечатнаяФормаЭПЛ);
КонецПроцедуры

#КонецОбласти // ОбработчикиКомандФормы

#Область СлужебныеПроцедурыИФункции 

#Область include_etrn_base_CommonForm_НастройкиЭПД_ОбработчикиОповещений_ОбработкаОповещенияВыходИзменитьАвторизацию
#КонецОбласти // include_etrn_base_CommonForm_НастройкиЭПД_ОбработчикиОповещений_ОбработкаОповещенияВыходИзменитьАвторизацию

#Область НастройкаИнтерфейсаФормы

&НаСервере
Процедура ОбновитьВидимостьИДоступностьЭлементов()
	Если ЭтоESD Тогда	
		Элементы.ВыполнитьПервыйВход.Видимость = Не ЭтаФорма.ПройденаПервичнаяИнициализация;	
		Если Не ПройденаПервичнаяИнициализация Тогда 
			НастройкаИнтерфейсаДляПервогоВхода();
			Возврат;
		КонецЕсли;				
	КонецЕсли;	
				
	ОбновитьВидимостьДоступностьЭлементовГруппировки(Истина);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИнтерфейсНастроек()
	// Применим параметры настроек прав расширения
	МодульКода("РегистрыСведений.ESD_НастройкаПравРасширения").НастроитьИнтерфейсФормы(ЭтаФорма);

	ЗагрузитьПараметрыГруппировки();
	ЗаполнитьНастройкиСопоставлений();
	ВывестиТекущуюВерсию();
	ЗагрузитьДополнительныеНастройки();
	РегламентныеЗадания_ПервичнаяНастройка();
КонецПроцедуры

&НаСервере
Процедура НастройкаИнтерфейсаДляПервогоВхода(ВходВыполнен = Ложь)
		
	МассивЭлементов = Новый Массив;
	
	МассивЭлементов.Добавить("ГруппаВходВыход");
	МассивЭлементов.Добавить("ГруппаВерсия");
	МассивЭлементов.Добавить("ГруппаНачальноеЗаполнение");
	МассивЭлементов.Добавить("ГруппаОбщийФункционалЭПД");		
	МассивЭлементов.Добавить("ГруппаНастройкаГруппировки");
	МассивЭлементов.Добавить("ГруппаРегламентныеЗадания");
	МассивЭлементов.Добавить("ГруппаНастройкаСопоставлений");
	МассивЭлементов.Добавить("ГруппаНастройкиВложенийИПечатныхФорм");
	МассивЭлементов.Добавить("Дополнительно");
	
	МассивЭлементов.Добавить("ДекорацияПользователь");
	МассивЭлементов.Добавить("ДекорацияСервис");
	МассивЭлементов.Добавить("ГруппаАккаунт");
	
	МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ИзменитьСвойствоЭлементовФормы(
		ЭтаФорма, "Видимость", ВходВыполнен, МассивЭлементов);
	
КонецПроцедуры

#КонецОбласти // НастройкаИнтерфейсаФормы

#Область РегламентныеЗадания

&НаСервере
Процедура РегламентныеЗадания_ПервичнаяНастройка()
	Если Не Элементы.ГруппаРегламентныеЗадания.Видимость Тогда
		Возврат;
	КонецЕсли;
	
	РегламентныеЗадания_ОбновитьСписок();
	РегламентныеЗадания_ЗаполнитьСписокВыбораПользователей();
	РегламентныеЗадания_НастроитьВизуальноеОформление();
КонецПроцедуры

&НаСервере
Процедура РегламентныеЗадания_ОбновитьСписок()
	СписокРегламентныхЗаданий.Очистить();
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	МассивРегЗаданий = ESD_РегламентныеЗаданияСлужебный.ПредопределенныеРегламентныеЗадания();
	Для Каждого ОписаниеРегламентное Из МассивРегЗаданий Цикл
		Если ОписаниеРегламентное.Значение.Служебный Тогда
			Продолжить;
		КонецЕсли;
		
		Задание = ESD_РегламентныеЗаданияСлужебный.НайтиРегламентноеЗаданиеПоКлючу(ОписаниеРегламентное.Значение.Ключ);
		Если Задание = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = СписокРегламентныхЗаданий.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Задание);
		ОписаниеРегламентное.Значение.Свойство("Подсказка", НоваяСтрока.Подсказка);
		НоваяСтрока.РучнойЗапуск = "Запустить вручную";
	КонецЦикла;
	
	Элементы.СписокРегламентныхЗаданий.ВысотаВСтрокахТаблицы = СписокРегламентныхЗаданий.Количество();
	
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

&НаСервере
Процедура РегламентныеЗадания_ЗаполнитьСписокВыбораПользователей()
	Элементы.СписокРегламентныхЗаданийПользователь.СписокВыбора.Очистить();
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	Попытка    
		МассивПользователей = ПользователиИнформационнойБазы.ПолучитьПользователей();
	Исключение       
		МассивПользователей = Новый Массив;
		МассивПользователей.Добавить(ПользователиИнформационнойБазы.ТекущийПользователь());
	КонецПопытки;
	
	Для Каждого Пользователь Из МассивПользователей Цикл
		Элементы.СписокРегламентныхЗаданийПользователь.СписокВыбора.Добавить(Пользователь.Имя);
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура РегламентныеЗадания_ВыполнитьВручную(УникальныйИдентификатор, Наименование)
	ПараметрыВыполнения = МодульКодаКлиент("ESD_РегламентныеЗаданияКлиент").ВыполнитьРегламентноеЗаданиеВручную(
		УникальныйИдентификатор, Наименование);
	Если ПараметрыВыполнения.ЗапускВыполнен Тогда
		Текст = НСтр("ru = 'Запущена процедура регламентного задания';
			|en = 'Scheduled job started'");
		
		ЭтаФорма.ИдентификаторыФоновыхЗаданийПриРучномВыполнении.Добавить(
			УникальныйИдентификатор,
			Наименование);
		
		ТаймаутПроверкиВыполненияРегЗадания = 0.1;	
		ПодключитьОбработчикОжидания("РегламентныеЗадания_СообщитьОбОкончанииРучногоВыполнения"
			, ТаймаутПроверкиВыполненияРегЗадания
			, Истина);
	Иначе
		Текст = НСтр("ru = 'Процедура регламентного задания не запущена';
			|en = 'Scheduled job not started'");		
	КонецЕсли;
	
	ПоказатьИнформативноеОповещениеПользователя(Текст,,
		ПараметрыВыполнения.Пояснение,
		БиблиотекаКартинок.ESD_Часы);	
КонецПроцедуры

&НаКлиенте
Процедура РегламентныеЗадания_ИзменитьРасписание(УникальныйИдентификатор)
	ОписаниеОповещения = Новый ОписаниеОповещения("РегламентныеЗадания_ПослеИзменения", ЭтаФорма);
	МодульКодаКлиент("ESD_РегламентныеЗаданияКлиент").ИзменитьРасписаниеРегламентныхЗаданий( 
		УникальныйИдентификатор,
		ОписаниеОповещения);
КонецПроцедуры

&НаКлиенте
Процедура РегламентныеЗадания_ПослеИзменения(Результат, ДополнительныеПараметры = Неопределено) Экспорт
    РегламентныеЗадания_ОбновитьСписок();
КонецПроцедуры

&НаКлиенте
Процедура РегламентныеЗадания_СообщитьОбОкончанииРучногоВыполнения()
	ОповещенияОбОкончанииВыполнения = РегламентныеЗадания_ОповещенияОбОкончанииВыполнения();
	Для каждого Оповещение Из ОповещенияОбОкончанииВыполнения Цикл	
		Текст = НСтр("ru = 'Выполнена процедура регламентного задания';
			|en = 'Scheduled job procedure completed'");
		
		СтрокаДляПояснения = НСтр("ru = '%1.
			|Процедура завершена в фоновом задании %2';
			|en = '%1.
			|The scheduled job has been completed in the background job ""%2"".'");
		
		ТекстПояснения = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер").СтрШаблонЭПД(
			СтрокаДляПояснения,
			Оповещение.ПредставлениеРегламентногоЗадания,
			Строка(Оповещение.МоментОкончания));
		
		ПоказатьИнформативноеОповещениеПользователя(Текст,,
			ТекстПояснения,
			БиблиотекаКартинок.ESD_Часы);	
	КонецЦикла;
	
	Если ИдентификаторыФоновыхЗаданийПриРучномВыполнении.Количество() > 0 Тогда	
		ПодключитьОбработчикОжидания("РегламентныеЗадания_СообщитьОбОкончанииРучногоВыполнения", 2, Истина);	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция РегламентныеЗадания_ОповещенияОбОкончанииВыполнения()
	
	ОповещенияОбОкончанииВыполнения = Новый Массив;
	
	Если ИдентификаторыФоновыхЗаданийПриРучномВыполнении.Количество() > 0 Тогда
		Индекс = ИдентификаторыФоновыхЗаданийПриРучномВыполнении.Количество() - 1;
		
		УстановитьПривилегированныйРежим(Истина);
		Пока Индекс >= 0 Цикл
			
			НовыйУникальныйИдентификатор = Новый УникальныйИдентификатор(
				ИдентификаторыФоновыхЗаданийПриРучномВыполнении[Индекс].Значение);
			Отбор = Новый Структура;
			Отбор.Вставить("УникальныйИдентификатор", НовыйУникальныйИдентификатор);
			
			МассивФоновыхЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
			
			Если МассивФоновыхЗаданий.Количество() = 1 Тогда
				МоментОкончания = МассивФоновыхЗаданий[0].Конец;
				
				Если ЗначениеЗаполнено(МоментОкончания) Тогда
					
					ОповещениеОкончания = Новый Структура;
					ОповещениеОкончания.Вставить("ПредставлениеРегламентногоЗадания",
						ИдентификаторыФоновыхЗаданийПриРучномВыполнении[Индекс].Представление);
					
					ОповещениеОкончания.Вставить("МоментОкончания", МоментОкончания);
					
					ОповещенияОбОкончанииВыполнения.Добавить(ОповещениеОкончания);
					
					ИдентификаторыФоновыхЗаданийПриРучномВыполнении.Удалить(Индекс);
				КонецЕсли;
			Иначе
				ИдентификаторыФоновыхЗаданийПриРучномВыполнении.Удалить(Индекс);
			КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат ОповещенияОбОкончанииВыполнения;
	
КонецФункции

