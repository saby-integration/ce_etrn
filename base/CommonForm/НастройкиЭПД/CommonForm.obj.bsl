&НаСервере
Процедура УстановитьЗаголовокАвторизации()
	ФИОАвторизации = "";
	ИмяСервиса     = "";	
	ИмяАккаунта    = "";
	
	МодульТНОбщегоНазначенияСервер = МодульКода("ESD_ТНОбщегоНазначенияСервер");
	ПараметрыАвторизации = МодульТНОбщегоНазначенияСервер.ESD_ПараметрыАвторизацииПользователя();
	АвторизацияВыполнена = МодульТНОбщегоНазначенияСервер.ESD_АвторизацияПройдена(ПараметрыАвторизации.Сессия);
				
	Если АвторизацияВыполнена Тогда
		Элементы.ДекорацияАвторизация.Заголовок = "Выйти";
		Элементы.ДекорацияАвторизация.Подсказка = "Закрыть сессию";
		
		Если ПараметрыАвторизации.Сессия.Свойство("UserFio") Тогда
			ФИОАвторизации = ПараметрыАвторизации.Сессия.UserFio;
			ИмяСервиса = ПараметрыАвторизации.Подключение.ApiUrl;	
		КонецЕсли;
		
		ПараметрыАвторизации.Сессия.Свойство("AccountTitle", ИмяАккаунта);
		Элементы.ГруппаАккаунт.Видимость = Истина;
	Иначе
		Элементы.ДекорацияАвторизация.Заголовок = "Войти";
		Элементы.ДекорацияАвторизация.Подсказка = "Открыть сессию";
		Элементы.ГруппаАккаунт.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.ДекорацияПользователь.Заголовок = ФИОАвторизации;
	Элементы.ДекорацияСервис.Заголовок	     = ИмяСервиса;
	Элементы.ДекорацияАккаунт.Заголовок      = ИмяАккаунта;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаРезультатаЗакрытияФормыАвторизации(Результат, Параметры) Экспорт
	Если Результат = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ПослеАвторизации();	
КонецПроцедуры 

&НаКлиенте
Процедура ОбновитьАктуальныйСтатусВерсии()
	Если Не (ЭтаФорма.ИспользоватьСсылкаНаОбновление И ЭтаФорма.АвторизацияВыполнена) Тогда
		Элементы.ГруппаОбновление.Видимость = Ложь;
		Возврат;
	КонецЕсли;
		
	Элементы.ГруппаОбновление.Видимость = Истина;
	
	МодульТНОбщегоНазначенияКлиент = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиент");
	ПараметрыКоманды = МодульТНОбщегоНазначенияКлиент.ВыполнитьКомандуСбис_ПараметрыКоманды();
	ПараметрыКоманды.Вставить("Подключаемый", Истина);
	МодульТНОбщегоНазначенияКлиент.ВыполнитьКомандуСбис(ЭтаФорма, "АктуальныйСтатусВерсии", Неопределено, 
		ПараметрыКоманды, 
		Новый УникальныйИдентификатор());	
КонецПроцедуры

&НаКлиенте
Процедура ПослеАвторизации()
	// Сохраним текущий признак прохождения первичной инициализации
	ТекущаяСостояниеПервичнойИнициализации = ЭтаФорма.ПройденаПервичнаяИнициализация;
	// Настроим функционал формы на сервере
	ПослеАвторизацииНаСервере();
	
	// При отличии текущего и нового признаков выполнить обработку
	Если ТекущаяСостояниеПервичнойИнициализации <> ЭтаФорма.ПройденаПервичнаяИнициализация Тогда
		ОбновитьРабочийСтол();	
	КонецЕсли;
	
	// После настройки формы выполним обработку общего функционала (не менять местами с "ПослеАвторизацииНаСервере")
	МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиент").ESD_ПослеАвторизацииПользователя();
	// Выполним обработку первичной инициализации после авторизации
	ПриПервичнойИнициализации();
КонецПроцедуры

&НаСервере
Процедура ПослеАвторизацииНаСервере()
	Если ЭтоESD Тогда
		Если Не ПройденаПервичнаяИнициализация() Тогда		
			// Выполним стандартную обработку прохождения первичной авторизации
			МодульКода("ESD_ТНОбщегоНазначенияСервер").ESD_ПослеПервичнойИнициализации();
			// Обновим состояние первичной инициализации
			ЭтаФорма.ПройденаПервичнаяИнициализация = Истина;
		КонецЕсли;
	КонецЕсли;
	
	НастройкаИнтерфейсаДляПервогоВхода(Истина);
	ЗаполнитьИнтерфейсНастроек();
	ОбновитьВидимостьИДоступностьЭлементов();
	ПослеИзмененияАвторизацииНаСервере();
КонецПроцедуры

#КонецОбласти // Авторизация

#Область Выход

&НаКлиенте
Процедура ПослеВыхода()
	// Сообщим об завершении сеанса
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "Сессия и пароль сброшены";
	Сообщение.Сообщить();
	
	// Загрузим актуальную версию
	ОбновитьАктуальныйСтатусВерсии();	
	
	Оповестить("Saby_ОбработкаВыхода");
КонецПроцедуры

&НаСервере
Процедура ВыйтиНаСервере()
	// Удалим параметры сессии из настроек подключения
	УдалитьПараметрыСессииНаСервере();
	// Обновим данные после выхода
	ПослеИзмененияАвторизацииНаСервере();
КонецПроцедуры

&НаСервере
Процедура УдалитьПараметрыСессииНаСервере()
	МодульОбъектаОбработки = ОбъектОбработки();
	
	saby_param = МодульОбъектаОбработки.НастройкиПодключенияПрочитать();
	Если saby_param <> Неопределено Тогда	
		saby_param.Вставить("session", Неопределено);
		saby_param.Вставить("password", Неопределено);
		МодульОбъектаОбработки.НастройкиПодключенияЗаписать(saby_param);
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ВывестиТекущуюВерсию()
	
	Если Найти(ЭтаФорма.ИмяФормы, "ESD") = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ШаблонВерсии = "Версия: %1 %2";
	
	ИмяИВерсия = МодульКода("ESD_Core").ПолучитьИмяФайлаИНомерТекущейВерсии();
	Версия     = ИмяИВерсия[1];
	
	Если ЭтоCF() Тогда
		Продукт = "CF";
	Иначе
		Продукт = "";
	КонецЕсли;	
	
	Элементы.ДекорацияВерсия.Заголовок = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрШаблонЭПД(
		ШаблонВерсии, 
		Версия,
		Продукт);
	
КонецПроцедуры

