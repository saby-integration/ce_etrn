&НаКлиенте
Процедура ОткрытьРедакторФайловНастроекНажатие(Элемент)
	АдресСтраницы = ПолучитьАдресСтраницыРедактора(); 
	
	ПараметрыФормыРедактора = Новый Структура();
	ПараметрыФормыРедактора.Вставить("Заголовок", "Редактор файлов настроек");
	ПараметрыФормыРедактора.Вставить("АдресСтраницы", АдресСтраницы);
	ОткрытьФорму(ФормыЯдраКлиент() + "Browser", ПараметрыФормыРедактора, , "Редактор файлов настроек");
КонецПроцедуры

&НаСервере
Функция ПолучитьАдресСтраницыРедактора()
	ESDКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");	
	
	context_params = ВыполнитьНаСервере("ESD_ТНОбщегоНазначенияСервер.ПроверитьНаличиеПараметровПодключенияЭПД");
	
	Если ESDКлиентСервер.ЗначениеИзКоллекции(context_params, "session") <> Неопределено Тогда
		web_interface = ESDКлиентСервер.ЗначениеИзКоллекции(context_params, "web_interface");
		Если web_interface = "BrowserSabyPlugin" Тогда
			connector = "Lpp1C2";
		ИначеЕсли web_interface = "BrowserSaby" Тогда
			connector = "1c-lppbl";
		Иначе
			connector = "1C2";	
		КонецЕсли;
		
		Возврат context_params.ApiUrl
			+ "/blockly_editor_1c/page/?connection_id="
			+ context_params.ConnectionId
			+ "&connector="
			+ connector
			+ "&command="
			+ connector; 
	КонецЕсли;
		
	Если ESDКлиентСервер.ЗначениеИзКоллекции(context_params, "ApiUrl") <> Неопределено Тогда
		Возврат context_params.ApiUrl + "/auth/";
	КонецЕсли;	
	
	Возврат "https://ie-1c.saby.ru/auth/";
КонецФункции

