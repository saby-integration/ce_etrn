
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	БыстроеЗаполнение_КолвоЧасов_ЗаполнитьСписокВыбораНаСервере();
	
	ЗаполнитьЗначенияПоУмолчаниюНаСервере();
КонецПроцедуры

#КонецОбласти // ОбработчикиСобытийФормы

#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура ДекорацияПоследнийЧасЗаполнитьНажатие(Элемент)
	// BSLLS:DeprecatedCurrentDate-off
	ЭтаФорма.ДатаВремяОкончания = ТекущаяДата();
	// BSLLS:DeprecatedCurrentDate-on
	ЭтаФорма.ДатаВремяНачала = ЭтаФорма.ДатаВремяОкончания - (ЭтаФорма.БыстроеЗаполнение_КолвоЧасов * 3600);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

&НаКлиенте
Процедура ДиалогПериод_ПослеИзменения(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.ДатаВремяНачала = Результат.ДатаНачала;
	ЭтаФорма.ДатаВремяОкончания = Результат.ДатаОкончания;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьПериод(Команда)
	
	Структура = Новый Структура;
	Структура.Вставить("Начало",    ДатаВремяНачала);
	Структура.Вставить("Окончание", ДатаВремяОкончания);
	
	Закрыть(Структура);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериод(Команда)
	ДиалогПериода = Новый ДиалогРедактированияСтандартногоПериода();
	ДиалогПериода.Период.ДатаНачала = ЭтаФорма.ДатаВремяНачала;
	ДиалогПериода.Период.ДатаОкончания = ЭтаФорма.ДатаВремяОкончания;
	
	#Если ТолстыйКлиентОбычноеПриложение Или ТолстыйКлиентУправляемоеПриложение Тогда
		Если ДиалогПериода.Редактировать() Тогда
			ДиалогПериод_ПослеИзменения(ДиалогПериода.Период);
		КонецЕсли;
	#Иначе
		Оповещение_ = Новый ОписаниеОповещения("ДиалогПериод_ПослеИзменения", ЭтаФорма);
		ДиалогПериода.Показать(Оповещение_);	
	#КонецЕсли
КонецПроцедуры

#КонецОбласти // ОбработчикиКомандФормы

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьЗначенияПоУмолчаниюНаСервере()
	ТекущийДень = ТекущаяДатаСеанса();
	ЭтаФорма.ДатаВремяНачала    = НачалоДня(ТекущийДень);
	ЭтаФорма.ДатаВремяОкончания = ТекущийДень;
	ЭтаФорма.БыстроеЗаполнение_КолвоЧасов = 1;
КонецПроцедуры

&НаСервере
Процедура БыстроеЗаполнение_КолвоЧасов_ЗаполнитьСписокВыбораНаСервере()
	Элементы.БыстроеЗаполнение_КолвоЧасов.СписокВыбора.Очистить();
	МинЗнач = 1;
	МаксЗнач = 12;
	
	Пока МинЗнач <= МаксЗнач Цикл
		Элементы.БыстроеЗаполнение_КолвоЧасов.СписокВыбора.Добавить(МинЗнач);
		МинЗнач = МинЗнач + 1;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти