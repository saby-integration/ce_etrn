
&НаКлиенте
Процедура Подключаемый_СтраныМира_НачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка) Экспорт
	СтандартнаяОбработка = Ложь;
	ESD_ОбщийФункционалКлиент.СтраныМира_ФормаВыбора_Открыть(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СтраныМира_ОбработкаВыбора(Элемент,
	ВыбранноеЗначение,
	ДополнительныеДанные,
	ВыборДобавлением,
	СтандартнаяОбработка
) Экспорт
	СтандартнаяОбработка = Ложь;
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение)
		Или Не ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ESD_СтраныМира")
	Тогда
		Возврат;
	КонецЕсли;
	ДанныеСтраны = МодульКодаКлиент("ESD_ТНОбщегоНазначенияСервер").
		ЗначенияРеквизитовОбъекта(ВыбранноеЗначение, "Наименование, Код");
	ЭтаФорма.СтранаРегистрации     = ДанныеСтраны.Наименование;
	ЭтаФорма.СтранаРегистрации_Код = ДанныеСтраны.Код;
КонецПроцедуры

