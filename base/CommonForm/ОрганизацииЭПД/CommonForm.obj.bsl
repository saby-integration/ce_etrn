КонецПроцедуры

&НаСервере
Процедура ЮрФизЛицо_ЗагрузитьДоступныеЗначенияНаСервере(Знач ДоступныеВидыЛиц)
	Если Не ЗначениеЗаполнено(ДоступныеВидыЛиц) Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ЮрФизЛицоСтрокой.СписокВыбора.Очистить();
	
	Если ТипЗнч(ДоступныеВидыЛиц) = Тип("Строка") Тогда
		ДоступныеВидыЛиц = Новый Структура(ДоступныеВидыЛиц);
	КонецЕсли;
	
	Для Каждого ЗначениеВыбора_ Из ЮрФизЛицо_ДоступныеЗначения() Цикл
		Если Не ДоступныеВидыЛиц.Свойство(ЗначениеВыбора_.Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		Элементы.ЮрФизЛицоСтрокой.СписокВыбора.Добавить(ЗначениеВыбора_.Значение, ЗначениеВыбора_.Представление);
	КонецЦикла;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЮрФизЛицо_ДоступныеЗначения()
	РезультатФункции = Новый СписокЗначений;
	РезультатФункции.Добавить("ЮрЛицо", 
		"Юридическое лицо");
	РезультатФункции.Добавить("ЮрЛицоНеРезидент", 
		"Юридическое лицо (не резидент)");
	РезультатФункции.Добавить("ФизЛицо", 
		"Физическое лицо");
	РезультатФункции.Добавить("ИндивидуальныйПредприниматель", 
		"Индивидуальный предприниматель");
	
	Возврат РезультатФункции;
КонецФункции

#КонецОбласти // ЮрФизЛицо

&НаКлиенте
Процедура ОбновитьВидимостьИДоступностьЭлементовНаКлиенте() Экспорт
	ОбновитьВидимостьИДоступностьЭлементов();
КонецПроцедуры

&НаСервереБезКонтекста
Функция ФИОСтрокой(Знач Фамилия, Знач Имя, Знач Отчество)
	
	СтруктураФИО = Новый Структура;
	СтруктураФИО.Вставить("Фамилия",  Фамилия);
	СтруктураФИО.Вставить("Имя",      Имя);
	СтруктураФИО.Вставить("Отчество", Отчество);
	
	Возврат ЗначениеВСтрокуВнутр(СтруктураФИО);
	
КонецФункции

&НаКлиенте
Функция КонтактныеДанные(ТаблицаКонтактныхДанных)
	
	РезультатФункции = Новый Массив;
	
	Для Каждого СтрокаКонтактныхДанных Из ТаблицаКонтактныхДанных Цикл
		
		СтруктураКонтактныхДанных = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер").СтруктураКонтактныхДанных();
		ЗаполнитьЗначенияСвойств(СтруктураКонтактныхДанных, СтрокаКонтактныхДанных);
		
		РезультатФункции.Добавить(СтруктураКонтактныхДанных);
		
	КонецЦикла;
	
	Возврат РезультатФункции;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьНовуюСтрокуКонтактнойИнформации(ИмяТЧ)
	
	Отбор = Новый Структура;
	Отбор.Вставить("РольСтрокой", "");
	
	НайденныеСтроки = КонтактныеДанные.НайтиСтроки(Отбор);
	Для Каждого Строка Из НайденныеСтроки Цикл
		Строка.РольСтрокой            = ЭтаФорма.РольСтрокой;
		Строка.КлючСтроки_ДанныеЮрЛиц = ЭтаФорма.КлючСтроки;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция УдалитьЗапись()
	
	Если ЭтаФорма.ЭтоИП Тогда
		Возврат Не ЗначениеЗаполнено(ЭтаФорма.Фамилия)
			И Не ЗначениеЗаполнено(ЭтаФорма.Имя)
			И Не ЗначениеЗаполнено(ЭтаФорма.Отчество)
			И Не ЗначениеЗаполнено(ЭтаФорма.ИНН);
	Иначе
		Возврат Не ЗначениеЗаполнено(ЭтаФорма.ИНН)
			И Не ЗначениеЗаполнено(ЭтаФорма.КПП)
			И Не ЗначениеЗаполнено(ЭтаФорма.НаименованиеОрганизации);
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ИзменитьАдрес(СтандартнаяОбработка)
	
	ПараметрыВыбораАдреса = Новый Структура;
	ПараметрыВыбораАдреса.Вставить("РольСтрокой",    ЭтаФорма.РольСтрокой);
	ПараметрыВыбораАдреса.Вставить("Значение",       ЭтаФорма.АдресСтруктура);
	ПараметрыВыбораАдреса.Вставить("Текст",          ЭтаФорма.Адрес);
	ПараметрыВыбораАдреса.Вставить("ТолькоПросмотр", ЭтаФорма.ТолькоПросмотрФормы);
	
	МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиент").АдресНачалоВыбора(ЭтаФорма, ПараметрыВыбораАдреса, СтандартнаяОбработка);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТипыРеквизитов()	
	УстановитьТипыКонтрагентовОрганизаций();
	УстановитьОграничениеТиповНаСервере();	
	
	Элементы.КонтактныеДанныеТип.СписокВыбора.Очистить();
	ТипКИ_Телефон = ЗначениеМетаданных(ТипыКонтактнойИнформации() + ".Телефон"); 
	Элементы.КонтактныеДанныеТип.СписокВыбора.Добавить(ТипКИ_Телефон, "Телефон");
	ТипКИ_Email = ЗначениеМетаданных(ТипыКонтактнойИнформации() + ".АдресЭлектроннойПочты");
	Элементы.КонтактныеДанныеТип.СписокВыбора.Добавить(ТипКИ_Email, "Адрес электронной почты");	
КонецПроцедуры     

Процедура УстановитьПараметрОтбора(ЭлементФормы, Имя, Значение)
	
	ПараметрВыбора = Новый ПараметрВыбора(Имя, Значение);
	МассивПараметровВыбора = Новый Массив;
	МассивПараметровВыбора.Добавить(ПараметрВыбора);
	ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметровВыбора);
	ЭлементФормы.ПараметрыВыбора = ПараметрыВыбора;
	
КонецПроцедуры

&НаКлиенте
Процедура АктивизироватьФормуОрганизации() Экспорт
	
	Если Не ЭтаФорма.ВводДоступен() Тогда
		ЭтаФорма.Активизировать();
	КонецЕсли;
	
КонецПроцедуры

#Область АбонентскиеЯщики

&НаКлиенте
Процедура ИдентификаторЭДО_ОбновитьДанные()
	Если ЗначениеЗаполнено(ЭтаФорма.ИдентификаторЭДО) 
		И Элементы.ИдентификаторЭДО_Представление.Видимость 
		И ИдентификаторыЭДО_ПроверитьПередВыбором().Успешно 
	Тогда
		ТаблицаЯщиковЭДО_Сформировать();
	КонецЕсли;
	ИдентификаторЭДО_ЗаполнитьПредставление();
КонецПроцедуры

&НаКлиенте
Процедура ИдентификаторЭДО_ЗаполнитьПредставление(Знач ДанныеЭДО = Неопределено)
	Перем Оператор_;
	
	Если ДанныеЭДО = Неопределено Тогда
		Если ЗначениеЗаполнено(ЭтаФорма.ИдентификаторЭДО) Тогда
			СтруктураОтбора = Новый Структура("Идентификатор", ЭтаФорма.ИдентификаторЭДО);
			ДанныеЭДО = ЭтаФорма.АбонентскиеЯщикиЭДО.НайтиСтроки(СтруктураОтбора);
			Если ДанныеЭДО.Количество() Тогда
				Оператор_ = ДанныеЭДО[0].Оператор;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Оператор_ = ДанныеЭДО.Оператор;
	КонецЕсли;
	
	Элементы.ИдентификаторЭДО_Представление.Подсказка = "";
	
	Если ЗначениеЗаполнено(ЭтаФорма.ИдентификаторЭДО) И ЗначениеЗаполнено(Оператор_) Тогда
		Попытка
			ЭтаФорма.ИдентификаторЭДО_Представление = Оператор_;
			Элементы.ИдентификаторЭДО_Представление.Подсказка = ЭтаФорма.ИдентификаторЭДО;
			Элементы.ИдентификаторЭДО_Представление.ОтображениеПодсказки 
				= Вычислить("ОтображениеПодсказки.Кнопка");
		Исключение
			ЭтаФорма.ИдентификаторЭДО_Представление = Оператор_ + " (" + ЭтаФорма.ИдентификаторЭДО + ")";
		КонецПопытки;
	Иначе
		ЭтаФорма.ИдентификаторЭДО_Представление = ЭтаФорма.ИдентификаторЭДО;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЯщиковЭДО_Сформировать(ВызыватьИсключение = Ложь)
	context_params = ВыполнитьНаСервере("ESD_ТНОбщегоНазначенияСервер.ПроверитьНаличиеПараметровПодключенияЭПД", ВызыватьИсключение);
	Если Не ВызыватьИсключение И context_params = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыМетода_ = ТаблицаЯщиковЭДО_Параметры();
	ПараметрыМетода_.Вставить("context_params", context_params);
	Результат = ТаблицаЯщиковЭДО_ВыполнитьЗапрос(ПараметрыМетода_);
	
	Если ТипЗнч(Результат) <> Тип("Строка") Тогда 
		ЗаполнитьЯщики(Результат);
	Иначе
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Результат;
		Сообщение.Сообщить();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ТаблицаЯщиковЭДО_ВыполнитьЗапрос(ПараметрыМетода)
	Если ЭтаФорма.ЭтоВО Тогда
		ТранспортВО = ТранспортВО(ЭтаФорма);
		ОбщиеПараметрыЗагрузки = Новый Структура;
		ОбщиеПараметрыЗагрузки.Вставить("context_params",  ПараметрыМетода.context_params);
		ОбщиеПараметрыЗагрузки.Вставить("ОбъектОбработки", ТранспортВО.ТранспортИнтеграции);
		ОбщиеПараметрыЗагрузки.Вставить("ТранспортБлокли", ТранспортВО.ТранспортБлокли);
		Результат = ЗагрузитьПочтовыеЯщикиКонтрагента(ПараметрыМетода, ОбщиеПараметрыЗагрузки);
	Иначе
		Результат = ВыполнитьНаСервере("ESD_ТНЗагрузкаСервер.ЗагрузитьПочтовыеЯщикиКонтрагента", ПараметрыМетода);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ТаблицаЯщиковЭДО_Параметры()
	ДопПоля = "СписокИдентификаторов";
	ДанныеУчастника_ = Новый Структура("ДопПоля", ДопПоля);
	
	Если ЭтаФорма.ЮрФизЛицоСтрокой = "ЮрЛицо" Тогда
		СвЮЛ = Новый Структура;
		СвЮЛ.Вставить("ИНН",      ЭтаФорма.ИНН);
		СвЮЛ.Вставить("КПП",      ЭтаФорма.КПП); 
		СвЮЛ.Вставить("Название", ЭтаФорма.НаименованиеОрганизации);
		ДанныеУчастника_.Вставить("СвЮЛ", СвЮЛ);
	Иначе
		СвФЛ = Новый Структура;
		Если ЭтаФорма.ЮрФизЛицоСтрокой = "ИндивидуальныйПредприниматель" Тогда
			ЧастноеЛицо = "Нет";
		Иначе
			ЧастноеЛицо = "Да";
		КонецЕсли;
		СвФЛ.Вставить("ЧастноеЛицо", ЧастноеЛицо);
		СвФЛ.Вставить("ИНН",         ЭтаФорма.ИНН);
		СвФЛ.Вставить("Фамилия",     ЭтаФорма.Фамилия);
		СвФЛ.Вставить("Имя",         ЭтаФорма.Имя);
		ДанныеУчастника_.Вставить("СвФЛ",    СвФЛ);
	КонецЕсли;
	
	РезультатФункции = Новый Структура("ОтветНаКлиенте", Неопределено);
	РезультатФункции.Вставить("Участник", ДанныеУчастника_);
		
	Возврат РезультатФункции;
КонецФункции
 
&НаКлиенте
Процедура ЗаполнитьЯщики(Результат)
	ЭтаФорма.АбонентскиеЯщикиЭДО.Очистить();
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	Идентификаторы = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер").ЗначениеИзКоллекции(
		Результат, "Идентификатор", Новый Массив);
		
	Если Не ЗначениеЗаполнено(Идентификаторы) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "У организации отсутствуют абонентские ящики для выбора.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;	
						
	Для Каждого Описание Из Идентификаторы Цикл	
		НоваяСтрока = ЭтаФорма.АбонентскиеЯщикиЭДО.Добавить();
		НоваяСтрока.Идентификатор = Описание["ИдентификаторУчастника"];
		НоваяСтрока.Оператор      = Описание["Оператор"]["Название"];
		НоваяСтрока.Роуминг       = Булево(Описание["Роуминг"]);
		НоваяСтрока.Основной      = Булево(Описание["Основной"]);
		НоваяСтрока.Комментарий   = ОписаниеКодаСостояния(Описание["СостояниеПодключения"]["Код"], Описание["Комментарий"]);	
	КонецЦикла;
КонецПроцедуры 

&НаКлиенте
Функция ОписаниеКодаСостояния(Код, ОписаниеАбонентскогоЯщика)

	Если Код = "1" Тогда
		Описание = "Контрагент отключен от ЭДО";
	ИначеЕсли Код = "2" Тогда
		Описание = "Нет подключения к ЭДО. При отправке будет отправлено приглашение";
	Иначе
		Описание = ОписаниеАбонентскогоЯщика;
	КонецЕсли;
	
	Возврат Описание;
КонецФункции

&НаКлиенте
Процедура УстановитьДанныеВыбранногоЯщика() 
	
	ТекущиеДанные = Элементы.АбонентскиеЯщикиЭДО.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ЭтаФорма.ИдентификаторЭДОИзменен = Истина;
		ЭтаФорма.ИдентификаторЭДО = ТекущиеДанные.Идентификатор;
		ИдентификаторЭДО_ЗаполнитьПредставление(ТекущиеДанные);
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаОсновная;
	Иначе
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не выбрана строка для установки абонентского ящика";
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

