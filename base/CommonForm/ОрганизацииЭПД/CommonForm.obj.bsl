&НаКлиенте
Процедура ОбновитьДанныеПоСсылке()
	Если Не ЗначениеЗаполнено(ЭтаФорма.КонтрагентОрганизация) Тогда
		Возврат;
	КонецЕсли;
	
	Результат = ОбновитьДанныеЮрЛиц();
	
	Если Результат.Ошибка Тогда
		МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиент").ОповеститьПользователяОРезультатах(
			ЭтаФорма, "ЗаполнитьИзINI", Результат);
	Иначе
		ИдентификаторЭДО_ОбновитьДанные();
	КонецЕсли;
КонецПроцедуры

