		Список.Добавить(ПолноеИмя, ОбъектМетаданных.Синоним + " (" + ПолноеИмя + ")");		
	КонецЦикла;	
КонецПроцедуры

Функция ОтменитьОбработкуОснования(Основание)
	Отказ = Ложь;
	// Исключим обработку объектов, измененных через механизмы обмена 
	Если Основание.ОбменДанными.Загрузка Тогда
		Отказ = Истина;
	КонецЕсли;
	
	// Для справочников исключим обработку групп
	Если Не Отказ И Метаданные.Справочники.Найти(Основание.Метаданные().Имя) <> Неопределено Тогда
		Если Основание.ЭтоГруппа Тогда
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	
	// Возможность отменить запуск АС при записи объектов внутри действий
	Если Не Отказ И Основание.ДополнительныеСвойства.Свойство("ИсключитьЗапускАвтоматическогоСценария") Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Возврат Отказ;
КонецФункции

