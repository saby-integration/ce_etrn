#Область ИнтерфейсПодписокНаСобытия

// Обработчик подписки на событие "ESD_АвтоматическиеСценарииПриЗаписи"
//
// Параметры:
//  Источник - ДокументОбъект, СправочникОбъект - Источник запуска подписки на событие
//  Отказ - Булево - Признак отказа в записи (транзакции)
//
Процедура ESD_АвтоматическиеСценарииПриЗаписи(Источник, Отказ) Экспорт
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЗапуститьАвтоматическиеСценарии(Источник, МодульКода("Перечисления.АвтоматическиеСценарииСобытия").ПриЗаписи);
КонецПроцедуры

// Обработчик подписки на событие "ESD_АвтоматическиеСценарииОбработкаПроведения"
//
// Параметры:
//  Источник - ДокументОбъект - Источник запуска подписки на событие
//  Отказ - Булево - Признак отказа в записи (транзакции)
//	РежимПроведения - РежимПроведенияДокумента - режим проведения документа
//
Процедура ESD_АвтоматическиеСценарииОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЗапуститьАвтоматическиеСценарии(Источник, МодульКода("Перечисления.АвтоматическиеСценарииСобытия").ОбработкаПроведения);
КонецПроцедуры

// Обработчик подписки на событие "ESD_АвтоматическиеСценарииОбработкаУдаленияПроведения"
//
// Параметры:
//  Источник - ДокументОбъект - Источник запуска подписки на событие
//  Отказ - Булево - Признак отказа в записи (транзакции)
//
Процедура ESD_АвтоматическиеСценарииОбработкаУдаленияПроведения(Источник, Отказ) Экспорт
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЗапуститьАвтоматическиеСценарии(Источник, МодульКода("Перечисления.АвтоматическиеСценарииСобытия").ОбработкаУдаленияПроведения);
КонецПроцедуры

#КонецОбласти

#Область ПрограмнныйИнтерфейс

// Запуск автоматических сценариев по отрабатываемому событию объекта
//
// Параметры:
//  Основание - ДокументОбъект, СправочникОбъект - основание запуска автоматического сценария
//  Событие - Перечисления.АвтоматическиеСценарииСобытия - отрабатываемое событие
//
Процедура ЗапуститьАвтоматическиеСценарии(Основание, Событие) Экспорт
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	// Проверим параметры основания и отменим запуск АС при необходимости
	Если ОтменитьОбработкуОснования(Основание) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураОтбора = Новый Структура("Активно", Истина);
	СтруктураОтбора.Вставить("ОснованиеМетаданные", Основание.Метаданные().ПолноеИмя());
	СтруктураОтбора.Вставить("Событие", Событие);
	
	АвтоматическиеСценарии = МодульКода("Справочники.АвтоматическиеСценарии").НайтиПоОтбору(СтруктураОтбора);
	Если Не ЗначениеЗаполнено(АвтоматическиеСценарии) Тогда
		Возврат;
	КонецЕсли;
	
	МодульESD_АвтоматическиеСценарииВызовСервера = МодульКода("АвтоматическиеСценарииВызовСервера");
	
	СинхронныеАС = Новый Массив;
	Для Каждого АвтоматическийСценарий Из АвтоматическиеСценарии Цикл
		Объект = АвтоматическийСценарий.Ссылка.ПолучитьОбъект();
		Объект.Основание = Основание.Ссылка;
		
		Попытка
			// Запустим на выполнение автоматический сценарий
			ИдентификаторАС = Объект.Запустить();
			Если ИдентификаторАС = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			// Зарегистрируем первые действия на выполнение
			МодульESD_АвтоматическиеСценарииВызовСервера.ПослеВыполненияДействия(АвтоматическийСценарий.Ссылка, ИдентификаторАС);
			// Проверим вариант выполнения
			Если Объект.ВариантВыполнения = МодульКода("Перечисления.АвтоматическиеСценарииВариантыВыполнения").Синхронно Тогда
				// Добавим "синхронные" запущенные АС в отдельный список
				СинхронныеАС.Добавить(Новый Структура("АвтоматическийСценарий, ID", 
					АвтоматическийСценарий.Ссылка, 
					ИдентификаторАС));
			КонецЕсли;
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			МодульКода("АвтоматическиеСценарииСерверСлужебный")
				.ЗаписатьВЖурналРегистрации(Объект, "Запуск", , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		КонецПопытки;
	КонецЦикла;
	
	// Отдельно обработаем сихнонные автоматические сценарии
	МодульESD_АвтоматическиеСценарииВызовСервера.ВыполнитьДействияЗапущенных(СинхронныеАС);
	
	Основание.Прочитать();
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Формирование списка доступных метаданных для работы автоматических сценариев
//
// Параметры:
//	Сгруппировать - Булево - признак группировки доступных видов метаданных
//
// Возвращаемое значение:
//  СписокЗначений - доступные метаданные для работы автоматических сценариев
//
Функция СписокДоступныхОбъектовМетаданных(Сгруппировать = Ложь) Экспорт
	Если Сгруппировать Тогда
		Результат = Новый Структура("Документы,Справочники", Новый СписокЗначений, Новый СписокЗначений);
		ДоступныеОснованияМетаданных_ДобавитьСправочники(Результат.Справочники);
		ДоступныеОснованияМетаданных_ДобавитьДокументы(Результат.Документы);
	Иначе
		Результат = Новый СписокЗначений;
		ДоступныеОснованияМетаданных_ДобавитьСправочники(Результат);
		ДоступныеОснованияМетаданных_ДобавитьДокументы(Результат);	
	КонецЕсли;
		
	Возврат Результат;	
КонецФункции

