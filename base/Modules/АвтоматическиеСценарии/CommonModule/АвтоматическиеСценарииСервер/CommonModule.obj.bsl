#КонецОбласти // include_etrn_base_Modules_АвтоматическиеСценарии_CommonModule_АвтоматическиеСценарииСервер_НастройкаРегламентныхЗаданий

#Область include_etrn_base_Modules_АвтоматическиеСценарии_CommonModule_АвтоматическиеСценарииСервер_ВыполнениеОбработчика 
#КонецОбласти // include_etrn_base_Modules_АвтоматическиеСценарии_CommonModule_АвтоматическиеСценарииСервер_ВыполнениеОбработчика

Процедура ЗапросОтбора_ПрименитьСтруктуруОтбора(Запрос, СтруктураОтбора, ИмяОсновнойТаблицы, ИмяОтбора) Экспорт
	УсловияОтбора = Новый Массив;
	ПорядковыйНомер = 1;
	Для Каждого КлючЗначение Из СтруктураОтбора Цикл
		ИмяПараметра = "Параметр" + Строка(ПорядковыйНомер);
		Если ТипЗнч(КлючЗначение.Значение) = Тип("Массив") Тогда
			СтрокаУсловия = КлючЗначение.Ключ + " В(&" + ИмяПараметра + ")";
		Иначе
			СтрокаУсловия = КлючЗначение.Ключ + " = &" + ИмяПараметра;
		КонецЕсли;
		УсловияОтбора.Добавить(ИмяОсновнойТаблицы + "." + СтрокаУсловия);
		Запрос.УстановитьПараметр(ИмяПараметра, КлючЗначение.Значение);
		
		ПорядковыйНомер = ПорядковыйНомер + 1;
	КонецЦикла;
	
	ОбщийТекстОтбора = МодульКода("АвтоматическиеСценарииКлиентСервер")
		.СтрСоединить82(УсловияОтбора, " И ");	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, ИмяОтбора, ОбщийТекстОтбора);	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДоступныеОснованияМетаданных_ДобавитьСправочники(Список)
	Для Каждого ОбъектМетаданных Из Метаданные.Справочники Цикл
		ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
		Список.Добавить(ПолноеИмя, ОбъектМетаданных.Синоним + " (" + ПолноеИмя + ")");		
	КонецЦикла;	
КонецПроцедуры

Процедура ДоступныеОснованияМетаданных_ДобавитьДокументы(Список)
	Для Каждого ОбъектМетаданных Из Метаданные.Документы Цикл
		ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
		Список.Добавить(ПолноеИмя, ОбъектМетаданных.Синоним + " (" + ПолноеИмя + ")");		
	КонецЦикла;	
КонецПроцедуры

Функция ОтменитьОбработкуОснования(Основание)
	Отказ = Ложь;
	// Исключим обработку объектов, измененных через механизмы обмена 
	Если Основание.ОбменДанными.Загрузка Тогда
		Отказ = Истина;
	КонецЕсли;
	
	// Для справочников исключим обработку групп
	Если Не Отказ И Метаданные.Справочники.Найти(Основание.Метаданные().Имя) <> Неопределено Тогда
		Если Основание.ЭтоГруппа Тогда
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	
	// Возможность отменить запуск АС при записи объектов внутри действий
	Если Не Отказ И Основание.ДополнительныеСвойства.Свойство("ИсключитьЗапускАвтоматическогоСценария") Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Возврат Отказ;
КонецФункции

#КонецОбласти

#Область include_etrn_base_Modules_АвтоматическиеСценарии_CommonModule_МодульКода
