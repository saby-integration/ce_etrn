#Область ПрограммныйИнтерфейс

// Получение имени значения перечисления для обращения к подчиненным элементам
//
// Параметры:
//	Значение - ПеречислениеСсылка.АвтоматическиеСценарииПредопределенныеДействия - ссылка на элемент перечисления
//
// Возвращаемое значение:
//	Строка - Имя значения
//
Функция ИмяЗначения(Значение) Экспорт
	Индекс = Перечисления[ИмяОбъекта()].Индекс(Значение);
	Возврат Метаданные.Перечисления[ИмяОбъекта()].ЗначенияПеречисления[Индекс].Имя;	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция Обработчики(Действие) Экспорт
	ИмяДействия = ИмяЗначения(Действие);
	ТекстовоеОписаниеОбработчиков = МодульКода("Перечисления.АвтоматическиеСценарииПредопределенныеДействия")
		.ПолучитьМакет(ИмяДействия)
		.ПолучитьТекст();
		
	СтруктураОписания = ЗначениеИзСтрокиВнутр(ТекстовоеОписаниеОбработчиков); 
	Возврат МодульКода("Справочники.АвтоматическиеСценарииДействия").ДекодироватьОписаниеОбработчиков(СтруктураОписания);
КонецФункции

Функция ЕстьФормаНастройки(Действие) Экспорт
	Возврат (Действие <> Saby_ОтправкаЧерновика);
КонецФункции

// Проверка необходимости авторизации в Saby у текущего пользователя перед выполнением действия
//
// Параметры:
//	Действие - ПеречислениеСсылка.ESD_АвтоматическиеСценарииПредопределенныеДействия - ссылка на элемент перечисления
//
// Возвращаемое значение:
//	Булево - признак необходимости
//
Функция ТребуетсяАвторизацияSaby(Действие) Экспорт
	МодульESD_ = МодульКода("Перечисления.АвтоматическиеСценарииПредопределенныеДействия");
	Возврат Действие = МодульESD_.Saby_ОтправкаЧерновика 
		Или Действие = МодульESD_.Saby_ЗакрытиеФазыДокумента;
КонецФункции

#КонецОбласти

