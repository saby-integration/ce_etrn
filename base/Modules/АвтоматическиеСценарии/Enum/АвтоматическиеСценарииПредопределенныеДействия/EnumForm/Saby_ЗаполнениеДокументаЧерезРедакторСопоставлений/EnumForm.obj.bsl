#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Не ЗначениеЗаполнено(Параметры.Основание) Тогда
		ВызватьИсключение "Не заполнено основание настройки действия";
	КонецЕсли;
	
	ОбъектESD_ЗаполнитьСписокВыбораНаСервере();
	Если Параметры.Свойство("ПараметрыДействия") Тогда
		ЗаполнитьПараметрыДействия(Параметры.ПараметрыДействия);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПакетСопоставлений_НастроитьЭлементыФормы();
КонецПроцедуры

#КонецОбласти

#Область СобытияКоманд

&НаКлиенте
Процедура Применить(Команда)
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПараметрыДействия = СформироватьПараметрыДействия();
	Закрыть(СтруктураПараметрыДействия);
КонецПроцедуры

&НаКлиенте
Процедура ОбъектESDПриИзменении(Элемент)
	ЭтаФорма.Сопоставление = Неопределено;
	ПакетСопоставлений_НастроитьЭлементыФормы();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьПараметрыДействия(ПараметрыДействия)
	Если Не ЗначениеЗаполнено(ПараметрыДействия) Тогда
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.ОбъектESD = ПараметрыДействия["ПриВыполнении"]["ОбъектESD"];
	ЭтаФорма.Сопоставление = ПараметрыДействия["ПриВыполнении"]["Сопоставление"];
КонецПроцедуры

&НаСервере
Процедура ОбъектESD_ЗаполнитьСписокВыбораНаСервере()
	Элементы.ОбъектESD.СписокВыбора.Очистить();
	Для Каждого ОписаниеОбъектаESD Из ДоступныеОбъектыESD() Цикл
		Элементы.ОбъектESD.СписокВыбора.Добавить(
			ОписаниеОбъектаESD.Значение,
			ОписаниеОбъектаESD.Представление);
	КонецЦикла;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ДоступныеОбъектыESD()
	Результат = Новый Массив;
	Результат.Добавить(ОписаниеОбъектаESD("Справочник.ESD_ДокументыЭПД", 
		"Справочник 'Документы ЭПД'"));
	Результат.Добавить(ОписаниеОбъектаESD("Справочник.ESD_Организации", 
		"Справочник 'Организации'"));
	Результат.Добавить(ОписаниеОбъектаESD("Справочник.ESD_ОтветственныеЛица", 
		"Справочник 'Ответственные лица'"));
	Результат.Добавить(ОписаниеОбъектаESD("Справочник.ESD_ТранспортныеСредства", 
		"Справочник 'Транспортные средства'")); 
	Результат.Добавить(ОписаниеОбъектаESD("Справочник.ESD_ВидыУпаковки", 
		"Справочник 'Виды упаковки'")); 
	Результат.Добавить(ОписаниеОбъектаESD("Справочник.ESD_ОпасныеГрузы", 
		"Справочник 'Опасные грузы'")); 
	Результат.Добавить(ОписаниеОбъектаESD("Документ.ESD_ТранспортнаяНакладная", 
		"Документ 'Транспортная накладная'"));
	Результат.Добавить(ОписаниеОбъектаESD("Документ.ESD_ПутевойЛист", 
		"Документ 'Путевой лист'"));
	Результат.Добавить(ОписаниеОбъектаESD("Документ.ESD_ЗаказНаПеревозку", 
		"Документ 'Заказ на перевозку'"));
	Результат.Добавить(ОписаниеОбъектаESD("Документ.ESD_ПоручениеЭкспедитору", 
		"Документ 'Поручение экспедитору'"));
	Результат.Добавить(ОписаниеОбъектаESD("Документ.ESD_ЭкспедиторскаяРасписка", 
		"Документ 'Экспедиторская расписка'"));
	Результат.Добавить(ОписаниеОбъектаESD("Документ.ESD_СкладскаяРасписка", 
		"Документ 'Складская расписка'"));
	
	Возврат Результат;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОписаниеОбъектаESD(Значение = "", Представление = "")
	Возврат Новый Структура("Значение,Представление", Значение, Представление);
КонецФункции

&НаКлиенте
Функция СформироватьПараметрыДействия()
	ПараметрыПриВыполнении = Новый Соответствие;
	ПараметрыПриВыполнении.Вставить("ОбъектESD", ЭтаФорма.ОбъектESD);
	Если ЗначениеЗаполнено(ЭтаФорма.Сопоставление) Тогда
		ПараметрыПриВыполнении.Вставить("Сопоставление", ЭтаФорма.Сопоставление);
	КонецЕсли;
	
	Возврат Новый Структура("ПередВыполнением,ПриВыполнении,ПослеВыполнения",
		Новый Структура,
		ПараметрыПриВыполнении,
		Новый Структура);
КонецФункции

&НаКлиенте
Процедура ПакетСопоставлений_НастроитьЭлементыФормы()
	Элементы.Сопоставление.Доступность = ЗначениеЗаполнено(ЭтаФорма.ОбъектESD);	
КонецПроцедуры

#КонецОбласти
