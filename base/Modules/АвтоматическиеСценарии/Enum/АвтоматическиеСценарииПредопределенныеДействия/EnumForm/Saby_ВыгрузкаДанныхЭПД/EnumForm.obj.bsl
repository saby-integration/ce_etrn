
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ВыгрузкаДанныхЭПД_ОбъектESD_ЗаполнитьСписокВыбораНаСервере();
	Если Параметры.Свойство("ПараметрыДействия") Тогда
		ВыгрузкаДанныхЭПД_ЗаполнитьПараметрыДействия(Параметры.ПараметрыДействия);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти // ОбработчикиСобытийФормы

#Область ОбработчикиСобытийЭлементыФормы

&НаКлиенте
Процедура ОбъектESDПриИзменении(Элемент)
	ОбъектESD_ПриИзмененииНаСервере();
КонецПроцедуры

#КонецОбласти // ОбработчикиСобытийЭлементовФормы

#Область ОбработчикиКоманд

&НаКлиенте
Процедура Применить(Команда)
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПараметрыДействия = ВыгрузкаДанныхЭПД_СформироватьПараметрыДействия();
	Закрыть(СтруктураПараметрыДействия);
КонецПроцедуры

#КонецОбласти // ОбработчикиКоманд

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбъектESD_ПриИзмененииНаСервере()
	ВыгрузкаДанныхЭПД_ЗаполнитьКомпоновщикНастроекНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВыгрузкаДанныхЭПД_ЗаполнитьПараметрыДействия(ПараметрыДействия)
	Если Не ЗначениеЗаполнено(ПараметрыДействия) Тогда
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.ОбъектESD = ПараметрыДействия["ПриВыполнении"]["ОбъектESD"];
	ВыгрузкаДанныхЭПД_ЗаполнитьКомпоновщикНастроекНаСервере(ПараметрыДействия["ПриВыполнении"]["НастройкиОтбора"]);
КонецПроцедуры
	
&НаСервере
Процедура ВыгрузкаДанныхЭПД_ЗаполнитьКомпоновщикНастроекНаСервере(ТекущиеНастройки = Неопределено)
	Если ТипЗнч(ТекущиеНастройки) = Тип("ХранилищеЗначения") Тогда
		ТекущиеНастройки = ТекущиеНастройки.Получить();
	КонецЕсли;
	
	СхемаКомпоновкиДанных = ESD_АвтоматическиеСценарииСерверСлужебный.СхемаКомпоновкиДанных(ЭтаФорма.ОбъектESD);
	
	АдресСхемыКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, УникальныйИдентификатор);
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыКомпоновкиДанных);
	
	ЭтаФорма.КомпоновщикНастроекКомпоновкиДанных.Инициализировать(ИсточникНастроек);
	Если ТекущиеНастройки <> Неопределено Тогда
		ЭтаФорма.КомпоновщикНастроекКомпоновкиДанных.ЗагрузитьНастройки(ТекущиеНастройки);	
	Иначе
		ЭтаФорма.КомпоновщикНастроекКомпоновкиДанных.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ВыгрузкаДанныхЭПД_ОбъектESD_ЗаполнитьСписокВыбораНаСервере()
	Элементы.ОбъектESD.СписокВыбора.Очистить();
	Для Каждого ОписаниеОбъектаESD Из ВыгрузкаДанныхЭПД_ДоступныеОбъектыESD() Цикл
		Элементы.ОбъектESD.СписокВыбора.Добавить(
			ОписаниеОбъектаESD.Значение, ОписаниеОбъектаESD.Представление);
	КонецЦикла;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ВыгрузкаДанныхЭПД_ДоступныеОбъектыESD()
	Результат = Новый Массив;
	ВыгрузкаДанныхЭПД_ОписаниеОбъекта = ВыгрузкаДанныхЭПД_ОписаниеОбъектаESD("Документ.ESD_ТранспортнаяНакладная", 
		"Документ 'Транспортная накладная'");
	Результат.Добавить(ВыгрузкаДанныхЭПД_ОписаниеОбъекта);
	ВыгрузкаДанныхЭПД_ОписаниеОбъекта = ВыгрузкаДанныхЭПД_ОписаниеОбъектаESD("Документ.ESD_ПутевойЛист", 
		"Документ 'Путевой лист'");
	Результат.Добавить(ВыгрузкаДанныхЭПД_ОписаниеОбъекта);
	ВыгрузкаДанныхЭПД_ОписаниеОбъекта = ВыгрузкаДанныхЭПД_ОписаниеОбъектаESD("Документ.ESD_ЗаказНаПеревозку", 
		"Документ 'Заказ на перевозку'");
	Результат.Добавить(ВыгрузкаДанныхЭПД_ОписаниеОбъекта);
	ВыгрузкаДанныхЭПД_ОписаниеОбъекта = ВыгрузкаДанныхЭПД_ОписаниеОбъектаESD("Документ.ESD_ПоручениеЭкспедитору", 
		"Документ 'Поручение экспедитору'");
	Результат.Добавить(ВыгрузкаДанныхЭПД_ОписаниеОбъекта);
	ВыгрузкаДанныхЭПД_ОписаниеОбъекта = ВыгрузкаДанныхЭПД_ОписаниеОбъектаESD("Документ.ESD_ЭкспедиторскаяРасписка", 
		"Документ 'Экспедиторская расписка'");
	Результат.Добавить(ВыгрузкаДанныхЭПД_ОписаниеОбъекта);
	ВыгрузкаДанныхЭПД_ОписаниеОбъекта = ВыгрузкаДанныхЭПД_ОписаниеОбъектаESD("Документ.ESD_СкладскаяРасписка", 
		"Документ 'Складская расписка'");
	Результат.Добавить(ВыгрузкаДанныхЭПД_ОписаниеОбъекта);
	
	Возврат Результат;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВыгрузкаДанныхЭПД_ОписаниеОбъектаESD(Значение = "", Представление = "")
	Возврат Новый Структура("Значение,Представление", Значение, Представление);
КонецФункции

&НаКлиенте
Функция ВыгрузкаДанныхЭПД_СформироватьПараметрыДействия()
	РезультатФункции = Новый Структура("ПередВыполнением,ПриВыполнении,ПослеВыполнения");
	РезультатФункции.ПриВыполнении = ВыгрузкаДанныхЭПД_СформироватьПараметрыДействия_ПриВыполнении();	
	РезультатФункции.ПередВыполнением = Новый Структура;
	РезультатФункции.ПослеВыполнения = Новый Структура;
	
	Возврат РезультатФункции;
КонецФункции

&НаСервере
Функция ВыгрузкаДанныхЭПД_СформироватьПараметрыДействия_ПриВыполнении()
	РезультатФункции = Новый Соответствие;
	РезультатФункции.Вставить("ОбъектESD", ЭтаФорма.ОбъектESD);
	
	НастройкиОтбора_ = ЭтаФорма.КомпоновщикНастроекКомпоновкиДанных.ПолучитьНастройки();
	НастройкиОтбора_ = Новый ХранилищеЗначения(НастройкиОтбора_);
	РезультатФункции.Вставить("НастройкиОтбора", НастройкиОтбора_);
	
	Возврат РезультатФункции;
КонецФункции

#КонецОбласти // СлужебныеПроцедурыИФункции
