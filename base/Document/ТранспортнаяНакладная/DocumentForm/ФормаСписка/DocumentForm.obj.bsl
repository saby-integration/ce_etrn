
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Переопределяемый_ПриСозданииНаСервере();
	НастройкаВидимостиЭлементовНаСервере();	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиент")
		.ОбработатьОповещенияДляФормы(ЭтаФорма, ИмяСобытия, Параметр, Источник);	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЗагрузитьАктуальныйСтатусВерсии();	
КонецПроцедуры

#КонецОбласти // ОбработчикиСобытийФормы

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ESD_ТНОбщегоНазначенияКлиент.ОткрытьДокументРасширенияЭПД(
		ВыбраннаяСтрока, 
		"ESD_ТранспортнаяНакладная");
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	МодульКода("ESD_ТНОбщегоНазначенияСервер").ДинСписокДокументов_ПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки);
КонецПроцедуры

&НаКлиенте
Процедура ТипПриИзменении(Элемент)
		
	МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").УстановитьЭлементОтбораДинамическогоСписка(
		Список,
		Тип,
		"Направление");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтказВПриемкеГруза(Команда)
		
	Подсказка    = "Укажите причину отказа от приемки груза"; 
	ДопПараметры = Новый Структура;  	
	Оповещение   = Новый ОписаниеОповещения("ПослеВводаПричиныОтказа", ЭтаФорма, ДопПараметры);
	
	ПоказатьВводСтроки(Оповещение, "", Подсказка, 0, Истина);
					
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВСбис(Команда)
	МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиент").ОбменДаннымиСБИСИзФормыСписка(
		ЭтаФорма,
		Команда.Имя + "ИзСписка",
		Новый Структура);
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьДокумент(Команда)
	МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиент")
		.ОбменДаннымиСБИСИзФормыСписка(ЭтаФорма, Команда.Имя);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВСбис(Команда)
	МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиент")
		.ОбменДаннымиСБИСИзФормыСписка(ЭтаФорма, Команда.Имя);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДокументИзСбис(Команда)			
	МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиент")
		.ОбновитьДокументыСБИС(ЭтаФорма, Команда.Имя, ТранспортнаяНакладная());		
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДокументИзСбисЗаПериод(Команда)
	МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиент")
		.ОбновитьДокументыЗаПериод(ЭтаФорма, "ОбновитьДокументИзСбис", Истина);

КонецПроцедуры

&НаКлиенте
Процедура Просмотрено(Команда)
	МассивДокументов = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиент")
		.ДокументыДляОбработки(ЭтаФорма);
	ВыполнитьНаСервере("ESD_ТНОбщегоНазначенияСервер.СбросСтатусаНеПросмотрено", МассивДокументов);
	ОповеститьОбИзменении(Тип("ДокументСсылка." + ТранспортнаяНакладная()));
КонецПроцедуры

&НаКлиенте
Процедура ОтборИзмененныхДокументов(Команда)
	
	УстановленОтборИзмененныхДокументов = Не УстановленОтборИзмененныхДокументов;
	Если УстановленОтборИзмененныхДокументов Тогда		
		Значение = Ложь;		
	Иначе		
		Значение = Неопределено;		
	КонецЕсли;
		
	МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").УстановитьЭлементОтбораДинамическогоСписка(
		Список,
		Значение,
		"Просмотрен");
	
КонецПроцедуры

&НаКлиенте
Процедура СсылкаОбновлениеНажатие(Элемент)
	// Совместимость со старыми платформами
	// BSLLS:UsingSynchronousCalls-off
    ЗапуститьПриложение(Элемент.Подсказка);
    // BSLLS:UsingSynchronousCalls-on
КонецПроцедуры 

&НаКлиенте
Процедура МассовоеСоздание(Команда)
	ПараметрыСоздания = ESD_ТНОбщегоНазначенияКлиент
		.ЗаполнениеНаОсновании_Параметры("Документ.ESD_ТранспортнаяНакладная", Истина);
	ESD_ТНОбщегоНазначенияКлиент.ЗаполнениеНаОсновании_ВыбратьТипОснования(ЭтаФорма, ПараметрыСоздания);
КонецПроцедуры

&НаКлиенте
Процедура ОтборДокументовСОшибками(Команда)
	
	УстановленОтборДокументовСОшибками = Не УстановленОтборДокументовСОшибками;
	Если УстановленОтборДокументовСОшибками Тогда		
		Значение = Истина;		
	Иначе		
		Значение = Неопределено;		
	КонецЕсли;
		
	МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").УстановитьЭлементОтбораДинамическогоСписка(
		Список,
		Значение,
		"ЕстьОшибки");
	
КонецПроцедуры

#КонецОбласти // ОбработчикиКомандФормы

#Область include_etrn_base_Document_ТранспортнаяНакладная_DocumentForm_ФормаСписка_ДополнительныеКомандыSaby
