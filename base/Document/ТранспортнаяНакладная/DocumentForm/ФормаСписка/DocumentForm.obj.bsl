#КонецОбласти // ОбработчикиСобытийФормы

#Область ОбработчикиСобытийЭлементовФормы

&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	Если Не Строки.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	СписокДокументов = Строки.ПолучитьКлючи();
	ДополнительныеПараметры = МодульКода("ESD_ТНОбщегоНазначенияСервер").ДинСписокДокументов_ДополнительныеПараметрыЗаполнения(СписокДокументов);
	
	Для Каждого Строка Из Строки Цикл
		Ссылка = Строка.Ключ;
		ДанныеСтроки = Строка.Значение.Данные;
		ЗаполнитьТекущийЭтапСтрокиДС(ДанныеСтроки, Ссылка, ДополнительныеПараметры);
	КонецЦикла;
КонецПроцедуры 

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ESD_ТНОбщегоНазначенияКлиент.ОткрытьДокументРасширенияЭПД(
				ВыбраннаяСтрока, "ESD_ТранспортнаяНакладная", Найти(Нрег(Элемент.ТекущиеДанные.Комментарий), "форматно-логический контроль")>0);
КонецПроцедуры

&НаКлиенте
Процедура ТипПриИзменении(Элемент)
		
	МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").УстановитьЭлементОтбораДинамическогоСписка(
		Список,
		Тип,
		"Направление");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

