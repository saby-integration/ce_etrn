//
Процедура ПослеВыгрузкиДокументаВСБИС(ПараметрыВыгрузки) Экспорт
	УстановитьСвязьДокументов(ПараметрыВыгрузки);
КонецПроцедуры

// Возвращает массив типов доступных для заполнения на основании.
//
// Параметры:
//  ЗначенияПоУмолчанию - Булево - признак получения типов по умолчанию
//
// Возвращаемое значение:
//   Массив - массив типов выбранных для заполнения на основании.
//
Функция ТипыДляЗаполненияНаОсновании(ЗначенияПоУмолчанию = Ложь) Экспорт
	
	Если Не ЗначенияПоУмолчанию Тогда
		РезультатФункции = ПользовательскиеТипыДляЗаполненияНаОсновании();
	Иначе
		РезультатФункции = Неопределено;
	КонецЕсли;
	
	Если РезультатФункции = Неопределено Тогда
		РезультатФункции = ТипыПоУмолчаниюДляЗаполненияНаОсновании();
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

// Сохраняет выбранные типы документов для заполнения на основании выбранные пользователем.
//
// Параметры:
//  МассивТипов - Массив - массив типов
//
Процедура СохранитьВыбранныеТипыДляЗаполненияНаОсновании(МассивТипов) Экспорт
	ESD_ТНОбщегоНазначенияСервер.ESD_СохранитьНастройкиОбъекта("ТипыДляЗаполненияНаОснованииДокументаЭПЛ", 
		МассивТипов, , "");
КонецПроцедуры

// Возвращает структуру реквизитов документа, относящиеся титулу
//
// Параметры:
//  СсылкаНаДокумент - ДокументСсылка.ESD_ПутевойЛист - ссылка на документ
//  ТипТитула - ПеречислениеСсылка.ESD_ТипТитулаЭПЛ - ссылка на тип титула
//
// Возвращаемое значение:
//   Структура - структура полученных данных документа
//
Функция ДанныеДокумента(СсылкаНаДокумент, ТипТитула) Экспорт
	
	ТипыТитулов = МодульКода("ESD_ТНОбщегоНазначенияСервер").ВсеЗначенияПеречисления(ТипТитулаЭПЛ());
	
	ЭтоПервыйТитул = МодульКода("ESD_ТНОбщегоНазначенияСервер").РезультатФункцииТитулов(
		ПутевойЛист(), "ЭтоПервыйТитул", ТипТитула);
		
	РезультатФункции = Новый Соответствие;
		
	Если ЭтоПервыйТитул Тогда
		
		РезультатФункции.Вставить(ТипТитула, ВыгрузкаДанныеВыпуск(СсылкаНаДокумент));
		РезультатФункции.Вставить(ТипыТитулов["ПредрейсовыйМедосмотр"], ВыгрузкаДанныеПредрейсовыйМедосмотр(СсылкаНаДокумент));
		РезультатФункции.Вставить(ТипыТитулов["ПредрейсовыйТехосмотр"], ВыгрузкаДанныеПредрейсовыйТехосмотр(СсылкаНаДокумент));
		РезультатФункции.Вставить(ТипыТитулов["Выпускающий"], ВыгрузкаДанныеВыпускающий(СсылкаНаДокумент));
		РезультатФункции.Вставить(ТипыТитулов["Принимающий"], ВыгрузкаДанныеПринимающий(СсылкаНаДокумент));
		РезультатФункции.Вставить(ТипыТитулов["ПослерейсовыйМедосмотр"], ВыгрузкаДанныеПослерейсовыйМедосмотр(СсылкаНаДокумент));
		
	ИначеЕсли ТипТитула = ТипыТитулов["ПредрейсовыйМедосмотр"] Тогда
		
		РезультатФункции.Вставить(ТипТитула, ВыгрузкаДанныеПредрейсовыйМедосмотр(СсылкаНаДокумент));
		
	ИначеЕсли ТипТитула = ТипыТитулов["ПредрейсовыйТехосмотр"] Тогда
		
		РезультатФункции.Вставить(ТипТитула, ВыгрузкаДанныеПредрейсовыйТехосмотр(СсылкаНаДокумент));
		
	ИначеЕсли ТипТитула = ТипыТитулов["Выпускающий"] Тогда
		
		РезультатФункции.Вставить(ТипТитула, ВыгрузкаДанныеВыпускающий(СсылкаНаДокумент));
		
	ИначеЕсли ТипТитула = ТипыТитулов["Принимающий"] Тогда
		
		РезультатФункции.Вставить(ТипТитула, ВыгрузкаДанныеПринимающий(СсылкаНаДокумент));
		
	ИначеЕсли ТипТитула = ТипыТитулов["ПослерейсовыйМедосмотр"] Тогда
		
		РезультатФункции.Вставить(ТипТитула, ВыгрузкаДанныеПослерейсовыйМедосмотр(СсылкаНаДокумент));
		
	Иначе
		
		РезультатФункции.Вставить(ТипТитула, Новый Структура);
		
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

// Добавляет данные титулов для выгрузки на онлайн
//
// Параметры:
//  ТекущийЭтап - ПеречислениеСсылка.ESD_ТипТитулаЭПЛ - тип текущего титула
//  ДанныеТитула - Структура - структура реквизитов и таблиц документа для выгрузки
//  ДополнительныеПараметры - Структура - структура дополнительных параметров формирования вложения
//
// Возвращаемое значение:
//   Структура - структура титула для отправки
//
Функция ВложениеНаВыгрузку(ТекущийЭтап, ДанныеТитула, ДополнительныеПараметры) Экспорт
	
	ТипыТитулов = МодульКода("ESD_ТНОбщегоНазначенияСервер").ВсеЗначенияПеречисления(ТипТитулаЭПЛ());
	
	ЭтоПервыйТитул = МодульКода("ESD_ТНОбщегоНазначенияСервер").РезультатФункцииТитулов(
		ПутевойЛист(), "ЭтоПервыйТитул", ТекущийЭтап);
	
	Если ЭтоПервыйТитул Тогда
		
		СтруктураТитула = ТитулВыпуск(ДанныеТитула[ТекущийЭтап]);
		СтруктураТитула = ТитулПредрейсовыйМедосмотр(ДанныеТитула[ТипыТитулов["ПредрейсовыйМедосмотр"]], СтруктураТитула);
		СтруктураТитула = ТитулПредрейсовыйТехосмотр(ДанныеТитула[ТипыТитулов["ПредрейсовыйТехосмотр"]], СтруктураТитула);
		СтруктураТитула = ТитулВыпускающий(ДанныеТитула[ТипыТитулов["Выпускающий"]], СтруктураТитула);
		СтруктураТитула = ТитулПринимающий(ДанныеТитула[ТипыТитулов["Принимающий"]], СтруктураТитула);
		СтруктураТитула = ТитулПослерейсовыйМедосмотр(ДанныеТитула[ТипыТитулов["ПослерейсовыйМедосмотр"]], СтруктураТитула);
		
	ИначеЕсли ТекущийЭтап = ТипыТитулов["ПредрейсовыйМедосмотр"] Тогда
		
		СтруктураТитула = ТитулПредрейсовыйМедосмотр(ДанныеТитула[ТекущийЭтап]);
		
		СтруктураТитула.Вставить("СторонняяОрганизация", Не СтруктураТитула.ШтатныйСотрудник);
		СтруктураТитула.Удалить("ШтатныйСотрудник");
		
	ИначеЕсли ТекущийЭтап = ТипыТитулов["ПредрейсовыйТехосмотр"] Тогда
		
		СтруктураТитула = ТитулПредрейсовыйТехосмотр(ДанныеТитула[ТекущийЭтап]);
		
	ИначеЕсли ТекущийЭтап = ТипыТитулов["Выпускающий"] Тогда
		
		СтруктураТитула = ТитулВыпускающий(ДанныеТитула[ТекущийЭтап]);
		
	ИначеЕсли ТекущийЭтап = ТипыТитулов["Принимающий"] Тогда
		
		СтруктураТитула = ТитулПринимающий(ДанныеТитула[ТекущийЭтап]);
		
	ИначеЕсли ТекущийЭтап = ЗначениеМетаданных("ESD_ТипТитулаЭПЛ.ПослерейсовыйМедосмотр") Тогда
		
		СтруктураТитула = ТитулПослерейсовыйМедосмотр(ДанныеТитула[ТекущийЭтап]);
		
		СтруктураТитула.Вставить("СторонняяОрганизация", Не СтруктураТитула.ШтатныйСотрудник);
		СтруктураТитула.Удалить("ШтатныйСотрудник");
		
	Иначе
		СтруктураТитула = Неопределено;
	КонецЕсли;
	
	Возврат СтруктураТитула;

КонецФункции

// Устанавливает связь между документами - предыдущим и следующим путевым листом
// Параметры:
//  ПараметрыВыгрузки - Структура - данные выгружаемого документа
// 
Процедура УстановитьСвязьДокументов(ПараметрыВыгрузки) Экспорт

	Если ПараметрыВыгрузки.ТипТитула = ЗначениеМетаданных("ESD_ТипТитулаЭПЛ.Выпуск") Тогда
		
		// проверим есть ли связь с другим документом
	    ПредыдущийИД = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ЗначениеИзКоллекции(
			ПараметрыВыгрузки, "СтруктураДокумента.Документ.ПредыдущийИдентификаторВИ");
			
		Если ЗначениеЗаполнено(ПредыдущийИД) Тогда
			
			// сохраним ИД
			СсылкаНаПутевойЛист = МодульКода("ESD_ТНОбщегоНазначенияСервер").ДокументПоИдентификаторуСбис(ПредыдущийИД);			
			ЗаписатьИдСледПутевогоЛиста(СсылкаНаПутевойЛист, ПараметрыВыгрузки.ИдентификаторСБИС);
			
		КонецЕсли;	
		
	КонецЕсли;	
	
КонецПроцедуры

