Функция ТитулВыпуск(ДанныеДокумента)
	
	СтруктураТитула = Новый Структура;
	
	// Отдельно вынесены общие данные документа
	Дата               = МодульКода("ESD_ТНВыгрузкаСервер").ЗначениеДатыВремяДляВыгрузки(ДанныеДокумента.Дата, Истина);
	ПризнакНачалаРейса = МодульКода("Перечисления.ESD_ПризнакНачалаРейса").КодПоЗначению(ДанныеДокумента.ПризнакНачалаРейса);
	ВидПеревозки       = МодульКода("Перечисления.ESD_ВидПеревозки").КодПоЗначению(ДанныеДокумента.ВидПеревозки);
	
	ПослерейсовыйМедосмотрТребуется = ?(ДанныеДокумента.ПослерейсовыйМедосмотрТребуется, "1", "2");
	
	ВидКоммерческойПеревозки = МодульКода("Перечисления.ESD_ВидКоммерческойПеревозки").КодПоЗначению(
		ДанныеДокумента.ВидКоммерческойПеревозки);
		
	ВидТранспортногоСообщения = МодульКода("Перечисления.ESD_ВидСообщенияЭПЛ").КодПоЗначению(
		ДанныеДокумента.ВидТранспортногоСообщения);
		
	// на данном этапе точно не знаем признак окончания рейса
	// но это нужно для корректной загрузки данных по одометру
	ПризнакОкончанияРейса = 1;
		
	СтруктураДокумента = Новый Структура;
	СтруктураДокумента.Вставить("Номер",                    ДанныеДокумента.НомерСбис);
	СтруктураДокумента.Вставить("Дата",                     Дата);
	СтруктураДокумента.Вставить("ПризнакНачалаРейса",       ПризнакНачалаРейса);
	СтруктураДокумента.Вставить("ПризнакОкончанияРейса",    ПризнакОкончанияРейса);
	СтруктураДокумента.Вставить("ПослерейсовыйМедосмотр",   ПослерейсовыйМедосмотрТребуется);
	СтруктураДокумента.Вставить("ВидПеревозки",             ВидПеревозки);
	СтруктураДокумента.Вставить("ВидКоммерческойПеревозки", ВидКоммерческойПеревозки);
	СтруктураДокумента.Вставить("ВидСообщения",             ВидТранспортногоСообщения);
	
	СтруктураДокумента.Вставить(
		"Оформитель",
		МодульКода("ESD_ТНВыгрузкаСервер").ДанныеЮрЛица("Оформитель", ДанныеДокумента, Истина));
	
	ДобавитьСрокПутевогоЛиста(СтруктураДокумента, ДанныеДокумента);
	
	СтруктураТитула.Вставить("Документ", СтруктураДокумента);
	
	СтруктураТитула.Вставить("Маршрут", ДанныеУзлаМаршрут(ДанныеДокумента));
	
	СтруктураТитула.Вставить(
		"ТранспортноеСредство",
		МодульКода("ESD_ТНВыгрузкаСервер").ПодстановкиТранспортногоСредства(ДанныеДокумента, , Истина));
		
	СтруктураТитула.ТранспортноеСредство.Вставить(
		"Прицеп", 
		МодульКода("ESD_ТНВыгрузкаСервер").ПодстановкиПрицепов(ДанныеДокумента, Истина));
	
	СтруктураТитула.Вставить(
		"Водители", 
		МодульКода("ESD_ТНВыгрузкаСервер").ПодстановкиВодителя(ДанныеДокумента.Водители, Новый Массив, , Истина));
	
	ДобавитьДанныеСотрудникаПоВодителям(СтруктураТитула, СтруктураДокумента.Оформитель);
	
	ДобавитьМедосмотрДляОнлайна(СтруктураТитула, ДанныеДокумента, Истина);
	
	ДобавитьТехосмотрДляОнлайна(СтруктураТитула, ДанныеДокумента);
	
	Если ДанныеДокумента.ПослерейсовыйМедосмотрТребуется Тогда
		ДобавитьМедосмотрДляОнлайна(СтруктураТитула, ДанныеДокумента, Ложь);
	КонецЕсли;
	
	ДобавитьЗаменуВодителя(СтруктураТитула, ДанныеДокумента.ПЛПредыдущий);
	
	Возврат СтруктураТитула;
	
КонецФункции

Функция ТитулПредрейсовыйМедосмотр(ДанныеДокумента, СтруктураТитула = Неопределено)
	
	РезультатФункции = СтруктураТитула;
	Если РезультатФункции = Неопределено Тогда
		РезультатФункции = Новый Структура;
	КонецЕсли;
	
	ДобавитьМедосмотрДляОнлайна(РезультатФункции, ДанныеДокумента, Истина);
	
	Возврат РезультатФункции;
		
КонецФункции

Функция ТитулПредрейсовыйТехосмотр(ДанныеДокумента, СтруктураТитула = Неопределено)
	
	РезультатФункции = СтруктураТитула;
	Если РезультатФункции = Неопределено Тогда
		РезультатФункции = Новый Структура;
	КонецЕсли;
	
	ДобавитьТехосмотрДляОнлайна(РезультатФункции, ДанныеДокумента);
	
	РезультатФункции.Вставить(
		"ТранспортноеСредство",
		МодульКода("ESD_ТНВыгрузкаСервер").ПодстановкиТранспортногоСредства(ДанныеДокумента, , Истина));
		
	РезультатФункции.ТранспортноеСредство.Вставить(
		"Прицеп", 
		МодульКода("ESD_ТНВыгрузкаСервер").ПодстановкиПрицепов(ДанныеДокумента, Истина));
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ТитулВыпускающий(ДанныеДокумента, СтруктураТитула = Неопределено)
	
	РезультатФункции = СтруктураТитула;
	Если РезультатФункции = Неопределено Тогда
		РезультатФункции = Новый Структура;
	КонецЕсли;
	
	Выпуск = Новый Структура;
	
	Организация = МодульКода("ESD_ТНВыгрузкаСервер").ДанныеЮрЛица("Оформитель", ДанныеДокумента, Истина);
	
	Если ДанныеДокумента.ОтветственныйОдометрВыезд.Количество() Тогда
		ДобавитьОтветственного(РезультатФункции, Выпуск, ДанныеДокумента.ОтветственныйОдометрВыезд[0], Организация);
	КонецЕсли;
	
	ПризнакНачалаРейса = ДанныеДокумента.ПризнакНачалаРейса;
	
	Выезд = Новый Структура;
	Выезд.Вставить("Одометр", Формат(ДанныеДокумента.Выезд_Одометр, "ЧЦ=7; ЧДЦ=0; ЧГ="));
	Выезд.Вставить("ДатаВремя",
		МодульКода("ESD_ТНВыгрузкаСервер").ЗначениеДатыВремяДляВыгрузки(ДанныеДокумента.Выезд_ДатаВремя));
		
	Если ПризнакНачалаРейса = ЗначениеМетаданных("ESD_ПризнакНачалаРейса.ВыездСПарковки") Тогда
		Выпуск.Вставить("Выезд", Выезд);
	Иначе
		Выпуск.Вставить("ПриемТС", Выезд);
	КонецЕсли;
	
	РезультатФункции.Вставить("Выпуск", Выпуск);
	
	Приемка = Новый Структура;
	
	Если ДанныеДокумента.ОтветственныйОдометрЗаезд.Количество() Тогда
		ДобавитьОтветственного(РезультатФункции, Приемка, ДанныеДокумента.ОтветственныйОдометрЗаезд[0], Организация);
	КонецЕсли;
	
	РезультатФункции.Вставить("Приемка", Приемка);
	
	Если Не РезультатФункции.Свойство("Документ") Тогда
		ПризнакНачалаРейса = МодульКода("Перечисления.ESD_ПризнакНачалаРейса").КодПоЗначению(ПризнакНачалаРейса);
		СтруктураДокумента = Новый Структура;
		СтруктураДокумента.Вставить("ПризнакНачалаРейса", ПризнакНачалаРейса);
		РезультатФункции.Вставить("Документ", СтруктураДокумента);
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ТитулПринимающий(ДанныеДокумента, СтруктураТитула = Неопределено)
	
	РезультатФункции = СтруктураТитула;
	Если РезультатФункции = Неопределено Тогда
		РезультатФункции = Новый Структура;
	КонецЕсли;
	
	Приемка = Новый Структура;
	
	ЗаездДатаВремя = МодульКода("ESD_ТНВыгрузкаСервер").ЗначениеДатыВремяДляВыгрузки(ДанныеДокумента.Заезд_ДатаВремя);
	
	Заезд = Новый Структура;
	Заезд.Вставить("Одометр", Формат(ДанныеДокумента.Заезд_Одометр, "ЧЦ=7; ЧДЦ=0; ЧГ="));
	Заезд.Вставить("ДатаВремя", ЗаездДатаВремя);
		
	Если ЗначениеЗаполнено(ДанныеДокумента.ПЛСледующий) Тогда
		Приемка.Вставить("СдачаТС", Заезд);
	Иначе
		Приемка.Вставить("Заезд", Заезд);
	КонецЕсли;
	
	Организация = МодульКода("ESD_ТНВыгрузкаСервер").ДанныеЮрЛица("Оформитель", ДанныеДокумента, Истина);
	
	Если ДанныеДокумента.ОтветственныйОдометрЗаезд.Количество() Тогда
		ДобавитьОтветственного(РезультатФункции, Приемка, ДанныеДокумента.ОтветственныйОдометрЗаезд[0], Организация);
	КонецЕсли;
	
	РезультатФункции.Вставить("Приемка", Приемка);
	
	Если Не РезультатФункции.Свойство("Документ") Тогда
		
		Если ЗначениеЗаполнено(ДанныеДокумента.ПЛСледующий) Тогда
			ПризнакОкончанияРейса = 2; // Сдача след. водителю
		Иначе	
			ПризнакОкончанияРейса = 1; // Заезд в гараж
		КонецЕсли;
		
		СтруктураДокумента = Новый Структура;
		СтруктураДокумента.Вставить("ПризнакОкончанияРейса", ПризнакОкончанияРейса);
		РезультатФункции.Вставить("Документ", СтруктураДокумента);
		
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ТитулПослерейсовыйМедосмотр(ДанныеДокумента, СтруктураТитула = Неопределено)
	РезультатФункции = СтруктураТитула;
	Если РезультатФункции = Неопределено Тогда
		РезультатФункции = Новый Структура;
	КонецЕсли;
	
	Если ДанныеДокумента["ПослерейсовыйМедосмотрТребуется"] Тогда
		ДобавитьМедосмотрДляОнлайна(РезультатФункции, ДанныеДокумента, Ложь);
	КонецЕсли;

	Возврат РезультатФункции;
КонецФункции

Функция ДанныеУзлаМаршрут(ДанныеДокумента)
	
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("Отправление", 	  АдресМаршрута(ДанныеДокумента.МестоОтправления, ,
																ДанныеДокумента.ИнформацияДляВодителя));
	РезультатФункции.Вставить("Пункт",            Новый Массив);
	РезультатФункции.Вставить("Грузоотправитель", Новый Массив);
	
	Для Каждого ДанныеАдресаМаршрута Из ДанныеДокумента.АдресаПунктовВыгрузки Цикл
		СтруктураАдреса = МодульКода("ESD_ТНОбщегоНазначенияСервер").ДесериализоватьЗначение(ДанныеАдресаМаршрута.Структура);
		Если ЗначениеЗаполнено(СтруктураАдреса) Тогда
			КодСтраны = СтруктураАдреса.КодСтраны;
		Иначе
			КодСтраны = Неопределено;
		КонецЕсли;
		АдресМаршрута = АдресМаршрута(ДанныеАдресаМаршрута.Значение, КодСтраны, ДанныеАдресаМаршрута.ИнформацияДляВодителя);
		
		РезультатФункции.Пункт.Добавить(АдресМаршрута);

	КонецЦикла;
	
	РольКонтрагента = ЗначениеМетаданных("ESD_РолиКонтрагентов.Отправитель");
	
	Для Каждого СтрокаДанныхЮрЛиц Из ДанныеДокумента.ДанныеЮрЛиц Цикл
		Если СтрокаДанныхЮрЛиц.Роль <> РольКонтрагента Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураДанных = МодульКода("ESD_ТНВыгрузкаСервер").ОбщийШаблонЮрЛица(ДанныеДокумента.ИмяМетаданных);
		ДопПараметры = МодульКода("ESD_ТНВыгрузкаСервер").ДопПараметрыЗаполненияОсновныхДанных(Ложь, Неопределено);
		МодульКода("ESD_ТНВыгрузкаСервер").ОсновныеДанныеЮрЛицаИзДокумента(СтрокаДанныхЮрЛиц, СтруктураДанных, ДопПараметры);
		
		РезультатФункции.Грузоотправитель.Добавить(СтруктураДанных);
		
	КонецЦикла;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция АдресМаршрута(АдресТекст, Знач КодСтраны = Неопределено, Комментарий = "")
	
	Если КодСтраны = Неопределено Тогда
		КодСтраны = "643";
	КонецЕсли;
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("КодСтраны",  КодСтраны);
	РезультатФункции.Вставить("АдресТекст", АдресТекст);
	РезультатФункции.Вставить("Комментарий",  Комментарий);
	
	Возврат РезультатФункции;
	
КонецФункции

Процедура ДобавитьСрокПутевогоЛиста(СтруктураДокумента, РеквизитыОбъекта)

	ВремяНачалаИсполнения = Формат(РеквизитыОбъекта.ДатаНачалаИсполнения, "ДФ=ЧЧ:мм");
	ВремяКонцаИсполнения = Формат(РеквизитыОбъекта.ДатаОкончанияИсполнения, "ДФ=ЧЧ:мм");	
	
	Если НачалоДня(РеквизитыОбъекта.ДатаНачалаИсполнения) = НачалоДня(РеквизитыОбъекта.ДатаОкончанияИсполнения) Тогда
		СтруктураДокумента.Вставить("Длительность", "1");
		СтруктураДокумента.Вставить(
			"ДатаИсполнения",
			МодульКода("ESD_ТНВыгрузкаСервер").ЗначениеДатыВремяДляВыгрузки(РеквизитыОбъекта.ДатаНачалаИсполнения, Истина));
			
		Если ВремяНачалаИсполнения <> "00:00" ИЛИ ВремяКонцаИсполнения <> "00:00" Тогда
			СтруктураДокумента.Вставить("ВремяНачалаИсполнения", ВремяНачалаИсполнения);
			СтруктураДокумента.Вставить("ВремяКонцаИсполнения", ВремяКонцаИсполнения);
		КонецЕсли;	
	Иначе
		СтруктураДокумента.Вставить("Длительность", "2");
		СтруктураДокумента.Вставить(
			"ДатаНачалаИсполнения",
			МодульКода("ESD_ТНВыгрузкаСервер").ЗначениеДатыВремяДляВыгрузки(РеквизитыОбъекта.ДатаНачалаИсполнения, Истина));
		СтруктураДокумента.Вставить(
			"ДатаКонцаИсполнения",
			МодульКода("ESD_ТНВыгрузкаСервер").ЗначениеДатыВремяДляВыгрузки(РеквизитыОбъекта.ДатаОкончанияИсполнения, Истина));
			
		СтруктураДокумента.Вставить("ВремяНачалаИсполнения", ВремяНачалаИсполнения);
		СтруктураДокумента.Вставить("ВремяКонцаИсполнения", ВремяКонцаИсполнения);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьМедосмотрДляОнлайна(СтруктураДанных, ДанныеДокумента, ЭтоПредрейсовыйМедосмотр)
	
	КлючДанныхЮрЛиц = "ДанныеЮрЛиц";
	
	Если ЭтоПредрейсовыйМедосмотр Тогда // до рейса
		
		РольЮрЛица               	= "МедосмотрВыезд";
		РеквизитМедОрганизация		= "ДоРейса_МедицинскаяОрганизация";
		ОтветственныйЗаМедосмотр 	= ДанныеДокумента.ОтветственныйМедосмотрВыезд;
		ИмяУзлаМедосмотра        	= "Медосмотр";
		ШтатныйСотрудник         	= Не ДанныеДокумента.ДоРейса_МедосмотрСторонняяОрганизация;
		
		Если Не ДанныеДокумента.Свойство(КлючДанныхЮрЛиц) Тогда
			ДанныеДокумента.Вставить(КлючДанныхЮрЛиц, ДанныеДокумента.ДанныеЮрЛицМедосмотрВыезд);
		КонецЕсли;
		
	Иначе       // после рейса
		
		РольЮрЛица               	= "МедосмотрЗаезд";
		РеквизитМедОрганизация		= "ПослеРейса_МедицинскаяОрганизация";
		ОтветственныйЗаМедосмотр 	= ДанныеДокумента.ОтветственныйМедосмотрЗаезд;
		ИмяУзлаМедосмотра        	= "ПостМедосмотр";
		ШтатныйСотрудник         	= Не ДанныеДокумента.ПослеРейса_МедосмотрСторонняяОрганизация;
		
		Если Не ДанныеДокумента.Свойство(КлючДанныхЮрЛиц) Тогда
			ДанныеДокумента.Вставить(КлючДанныхЮрЛиц, ДанныеДокумента.ДанныеЮрЛицМедосмотрЗаезд);
		КонецЕсли;
		
	КонецЕсли;
	
	ОтветственныйЗаполнен = Истина;
	Если ОтветственныйЗаМедосмотр.Количество() = 0 Тогда
		СтрокаОтветственногоЗаМедосмотр = ОтветственныйЗаМедосмотр.Добавить();
		СтрокаОтветственногоЗаМедосмотр.Серия          = "";
		СтрокаОтветственногоЗаМедосмотр.Номер          = "";
		СтрокаОтветственногоЗаМедосмотр.Фамилия        = "";
		СтрокаОтветственногоЗаМедосмотр.Имя            = "";
		СтрокаОтветственногоЗаМедосмотр.Отчество       = "";
		СтрокаОтветственногоЗаМедосмотр.Должность      = "";
		СтрокаОтветственногоЗаМедосмотр.ТабельныйНомер = "";
		ОтветственныйЗаполнен = Ложь;
	КонецЕсли;
	
	ОтветственныйЗаМедосмотр = ОтветственныйЗаМедосмотр[0];
	
	Медосмотр = Новый Соответствие;
	
	МодульТНВыгрузкаСервер = МодульКода("ESD_ТНВыгрузкаСервер");

	Лицензия = Новый Структура;
	Лицензия.Вставить("Серия", ОтветственныйЗаМедосмотр.Серия);
	Лицензия.Вставить("Номер", ОтветственныйЗаМедосмотр.Номер);
	Лицензия.Вставить(
		"ДатаВыдачи",
		МодульТНВыгрузкаСервер.ЗначениеДатыВремяДляВыгрузки(ОтветственныйЗаМедосмотр.ДатаВыдачи, Истина));
	Лицензия.Вставить(
		"Срок",
		МодульТНВыгрузкаСервер.ЗначениеДатыВремяДляВыгрузки(ОтветственныйЗаМедосмотр.ДатаОкончанияДействия, Истина));
		
	Ответственный = Новый Структура;
	Ответственный.Вставить("Фамилия",         ОтветственныйЗаМедосмотр.Фамилия);
	Ответственный.Вставить("Имя",             ОтветственныйЗаМедосмотр.Имя);
	Ответственный.Вставить("Отчество",        ОтветственныйЗаМедосмотр.Отчество);
	Ответственный.Вставить("Должность",       ОтветственныйЗаМедосмотр.Должность);
	Ответственный.Вставить("ИдентификаторИС", ИдентификаторИССотрудника(ОтветственныйЗаМедосмотр));
	Ответственный.Вставить("ТабельныйНомер",  ОтветственныйЗаМедосмотр.ТабельныйНомер);
	
	Если ШтатныйСотрудник И ДанныеДокумента.Направление = ЗначениеМетаданных("ESD_Направление.Исходящий") Тогда // Сотрудник
		
		Ответственный.Вставить("Лицензия", Лицензия);
		Медосмотр.Вставить("Ответственный", Ответственный);
		
		ОрганизацияМедработника = МодульТНВыгрузкаСервер.ДанныеЮрЛица("Оформитель", ДанныеДокумента, Истина);
		
	ИначеЕсли ЗначениеЗаполнено(ДанныеДокумента[РеквизитМедОрганизация]) Тогда  // ЭСМО
		
		ВнешняяСистема = Новый Структура;
		ВнешняяСистема.Вставить("Идентификатор", МодульКода("Перечисления.ESD_МедицинскиеОрганизации").ИдентификаторПоЗначению(ДанныеДокумента[РеквизитМедОрганизация]));
		
		Медосмотр.Вставить("ВнешняяСистема", ВнешняяСистема);  
		
	Иначе    // Организация 
		
		ОрганизацияМедработника = МодульТНВыгрузкаСервер.ДанныеЮрЛица(РольЮрЛица, ДанныеДокумента, Истина);
		Медосмотр.Вставить("Контрагент", МодульТНВыгрузкаСервер.РеквизитыНашейОрганизации(ОрганизацияМедработника));
		
		Организация = Новый Структура;
		Организация.Вставить("Лицензия",      Лицензия);
		Организация.Вставить("Ответственный", Ответственный);
		Организация.Вставить("Название",      ОрганизацияМедработника.Название.Полное);
		
		Медосмотр.Вставить("Организация", Организация);
		
	КонецЕсли;
	
	Если ОтветственныйЗаполнен Тогда
		ДобавитьДанныеСотрудников(СтруктураДанных, Ответственный, ОрганизацияМедработника);
	КонецЕсли;
	
	Если ДанныеДокумента.Свойство("ДоРейса_ДатаВремяМедосмотра") Тогда
		ДобавитьРезультатОсмотра(
			Медосмотр,
			ДанныеДокумента.ДоРейса_ДатаВремяМедосмотра,
			"");
	КонецЕсли;
	
	Если ДанныеДокумента.Свойство("ПослеРейса_ДатаВремяМедосмотра") Тогда
		ДобавитьРезультатОсмотра(
			Медосмотр,
			ДанныеДокумента.ПослеРейса_ДатаВремяМедосмотра,
			"");
	КонецЕсли;
	
	СтруктураДанных.Вставить(ИмяУзлаМедосмотра, Медосмотр);
	
	СтруктураДанных.Вставить("ШтатныйСотрудник", ШтатныйСотрудник);
	
КонецПроцедуры

Процедура ДобавитьТехосмотрДляОнлайна(СтруктураДанных, ДанныеДокумента)
	
	Если ДанныеДокумента.ОтветственныйТехосмотр.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОтветственныйЗаТехосмотр = ДанныеДокумента.ОтветственныйТехосмотр[0];
	
	Техосмотр = Новый Структура;
	
	Ответственный = Новый Структура;
	Ответственный.Вставить("Фамилия",         ОтветственныйЗаТехосмотр.Фамилия);
	Ответственный.Вставить("Имя",             ОтветственныйЗаТехосмотр.Имя);
	Ответственный.Вставить("Отчество",        ОтветственныйЗаТехосмотр.Отчество);
	Ответственный.Вставить("Должность",       ОтветственныйЗаТехосмотр.Должность);
	Ответственный.Вставить("ИдентификаторИС", ИдентификаторИССотрудника(ОтветственныйЗаТехосмотр));
	Ответственный.Вставить("ТабельныйНомер",  ОтветственныйЗаТехосмотр.ТабельныйНомер);
	Техосмотр.Вставить("Ответственный", Ответственный);
	
	Организация = МодульКода("ESD_ТНВыгрузкаСервер").ДанныеЮрЛица("Оформитель", ДанныеДокумента, Истина);
	
	ДобавитьДанныеСотрудников(СтруктураДанных, Ответственный, Организация);
	
	Если ДанныеДокумента.Свойство("ТО_ДатаВремя") Тогда
		ДобавитьРезультатОсмотра(
			Техосмотр,
			ДанныеДокумента.ТО_ДатаВремя,
			ДанныеДокумента.ТО_Комментарий);
	КонецЕсли;
		
	Если ДанныеДокумента.Свойство("ТО_НеРазрешенВыпускПосле") И Не ДанныеДокумента.ТО_НеРазрешенВыпускПосле Тогда
		
		Техосмотр.Вставить("ВыпускНаЛинию", Новый Структура);
		Техосмотр.ВыпускНаЛинию.Вставить(
			"ДатаВремя",
			МодульКода("ESD_ТНВыгрузкаСервер").ЗначениеДатыВремяДляВыгрузки(ДанныеДокумента.ТО_ДатаВремяВыпускаВРейс));
	КонецЕсли;
	
	СтруктураДанных.Вставить("Техосмотр", Техосмотр);
	
КонецПроцедуры

Процедура ДобавитьРезультатОсмотра(СтруктураДанных, ДатаВремя, Отметка)
	
	Если Не ЗначениеЗаполнено(ДатаВремя) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураРезультата = Новый Структура;
	СтруктураРезультата.Вставить("Отметка",   Отметка);
	СтруктураРезультата.Вставить("ДатаВремя", МодульКода("ESD_ТНВыгрузкаСервер").ЗначениеДатыВремяДляВыгрузки(ДатаВремя));
	
	СтруктураДанных.Вставить("Результат", СтруктураРезультата);
	
КонецПроцедуры

Процедура ДобавитьДанныеСотрудникаПоВодителям(СтруктураТитула, Организация)
	
	Для Каждого СтруктураВодителя Из СтруктураТитула.Водители.Водитель Цикл
		СтруктураВодителя.Вставить("ИдентификаторИС", ИдентификаторИССотрудника(СтруктураВодителя));
		ДобавитьДанныеСотрудников(СтруктураТитула, СтруктураВодителя, Организация);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьДанныеСотрудников(СтруктураТитула, СтруктураОтветственного, Организация)
	
	Если Не СтруктураТитула.Свойство("ДанныеСотрудников") Тогда
		СтруктураТитула.Вставить("ДанныеСотрудников", Новый Массив);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтруктураОтветственного.Фамилия) Или Не ЗначениеЗаполнено(СтруктураОтветственного.Имя) Тогда
		Возврат;
	КонецЕсли;
	
	Сотрудник = Новый Структура;
	Сотрудник.Вставить("Фамилия",         СтруктураОтветственного.Фамилия);
	Сотрудник.Вставить("Имя",             СтруктураОтветственного.Имя);
	Сотрудник.Вставить("Отчество",        СтруктураОтветственного.Отчество);
	Сотрудник.Вставить("ИдентификаторИС", ИдентификаторИССотрудника(СтруктураОтветственного));
	Сотрудник.Вставить("ТабельныйНомер",  СтруктураОтветственного.ТабельныйНомер);
	Сотрудник.Вставить("Подстановки",     Новый Массив);
	Сотрудник.Вставить("Организация",     МодульКода("ESD_ТНВыгрузкаСервер").РеквизитыНашейОрганизации(Организация));
	
	Для Каждого СтруктураСотрудника Из СтруктураТитула.ДанныеСотрудников Цикл
		СовпадаетТабельныйНомер = ЗначениеЗаполнено(Сотрудник.ТабельныйНомер)
			И СтруктураСотрудника.ТабельныйНомер = Сотрудник.ТабельныйНомер;
		Если СтруктураСотрудника.ИдентификаторИС = Сотрудник.ИдентификаторИС Или СовпадаетТабельныйНомер Тогда
			СтруктураСотрудника.Подстановки.Добавить(СтруктураОтветственного);
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	Сотрудник.Подстановки.Добавить(СтруктураОтветственного);
	СтруктураТитула.ДанныеСотрудников.Добавить(Сотрудник);
	
КонецПроцедуры

Функция ИдентификаторИССотрудника(СтруктураОтветственного)
	
	МассивФИО = Новый Массив;
	МассивФИО.Добавить(СокрЛП(СтруктураОтветственного.Фамилия));
	МассивФИО.Добавить(СокрЛП(СтруктураОтветственного.Имя));
	МассивФИО.Добавить(СокрЛП(СтруктураОтветственного.Отчество));
	
	Возврат МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрСоединитьЭПД(МассивФИО, "");
	
КонецФункции

Процедура ДобавитьОтветственного(СтруктураТитула, СтруктураДанных, СтрокаОтветственного, Организация)
	
	Ответственный = Новый Структура;
	Ответственный.Вставить("Фамилия",         СтрокаОтветственного.Фамилия);
	Ответственный.Вставить("Имя",             СтрокаОтветственного.Имя);
	Ответственный.Вставить("Отчество",        СтрокаОтветственного.Отчество);
	Ответственный.Вставить("Должность",       СтрокаОтветственного.Должность);
	Ответственный.Вставить("ИдентификаторИС", ИдентификаторИССотрудника(СтрокаОтветственного));
	Ответственный.Вставить("ТабельныйНомер",  СтрокаОтветственного.ТабельныйНомер);
	
	ДобавитьДанныеСотрудников(СтруктураТитула, Ответственный, Организация);
	
	СтруктураДанных.Вставить("Ответственный", Ответственный);
	
КонецПроцедуры

Процедура ДобавитьЗаменуВодителя(СтруктураТитула, ПЛПредыдущий)

	Если ПустаяСтрока(ПЛПредыдущий) Тогда 
		Возврат;
	КонецЕсли;	
		
	СтруктураТитула.Документ.Вставить("ПредыдущийИдентификаторВИ", ПЛПредыдущий);
	
КонецПроцедуры

#КонецОбласти // Выгрузка

#Область Загрузка

Процедура ЗагрузкаТитулаВыпуск(ОбъектДок, Вложения, Титул, ДопПараметры)
	
	Если Не Вложения.Количество() Тогда 
		Возврат;
	КонецЕсли;
	
	ДанныеВыпуск = ДанныеВыпуск(ОбъектДок, Вложения, Титул, ДопПараметры);
	
	ДанныеТитула = ДанныеВыпуск[ДанныеВыпуск.ВГраница()];
	
	Если Не ДопПараметры.ТолькоАктивныйЭтап Тогда
		
		ЗаполнитьЗначенияСвойств(ОбъектДок, ДанныеТитула.ДляДокумента);
		
		МодульКода("ESD_ТНЗагрузкаСервер").ЗаполнитьДанныеЮрЛицИКонтактнуюИнформацию(
			ОбъектДок, ДанныеТитула.ДляДокумента, ЗначениеМетаданных("ESD_РолиКонтрагентов.Оформитель"), ДопПараметры);
		
		МодульКода("ESD_ТНЗагрузкаСервер").ЗаполнитьДанныеТСИПрицеповДокумента(ОбъектДок, ДанныеТитула.ДляДокумента);
		
		МодульКода("ESD_ТНЗагрузкаСервер").ЗаполнитьОтветственныхЛиц(
			ОбъектДок, ДанныеТитула.ДляДокумента.ОтветственныеЛица, ЗначениеМетаданных("ESD_РолиОтветственных.Водитель"));
			
		ЗаполнитьАдресаПунктовВыгрузки(ОбъектДок, ДанныеТитула.ДляДокумента);
		
		МодульКода("ESD_ТНЗагрузкаСервер").ЗаполнитьОтветственныхЛиц(
			ОбъектДок, ДанныеТитула.ДляДокумента.ОтветственныеЗаМедосмотр, ЗначениеМетаданных("ESD_РолиОтветственных.МедосмотрВыезд"));
			
		МодульКода("ESD_ТНЗагрузкаСервер").ЗаполнитьДанныеЮрЛицИКонтактнуюИнформацию(
			ОбъектДок, ДанныеТитула.ДляДокумента, ЗначениеМетаданных("ESD_РолиКонтрагентов.МедосмотрВыезд"), ДопПараметры);
			
		МодульКода("ESD_ТНЗагрузкаСервер").ЗаполнитьОтветственныхЛиц(
			ОбъектДок, ДанныеТитула.ДляДокумента.ОтветственныеЗаТехосмотр, ЗначениеМетаданных("ESD_РолиОтветственных.Техосмотр"));
			
		МодульКода("ESD_ТНЗагрузкаСервер").ЗаполнитьОтветственныхЛиц(
			ОбъектДок,
			ДанныеТитула.ДляДокумента.ОтветственныеЗаМедосмотрЗаезд,
			ЗначениеМетаданных("ESD_РолиОтветственных.МедосмотрЗаезд"));
			
		МодульКода("ESD_ТНЗагрузкаСервер").ЗаполнитьДанныеЮрЛицИКонтактнуюИнформацию(
			ОбъектДок, ДанныеТитула.ДляДокумента, ЗначениеМетаданных("ESD_РолиКонтрагентов.МедосмотрЗаезд"), ДопПараметры);
			
	Иначе
		
		ЗаполнитьЗначенияСвойств(ОбъектДок, ДанныеТитула.ДляДокумента, "НомерСбис");
			
	КонецЕсли;
	
	Если ДопПараметры.ЗагрузкаСОнлайна Тогда
		МодульКода("РегистрыСведений.ESD_ДанныеТитулов").ЗаписатьДанные(ДанныеВыпуск, ОбъектДок, ДопПараметры.ИмяМетаданных);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузкаТитулаПредрейсовыйМедосмотр(ОбъектДок, Вложения, Титул, ДопПараметры)
	
	Если Не Вложения.Количество() Тогда 
		Возврат;
	КонецЕсли;
	
	ДанныеПредрейсовыйМедосмотр = ДанныеПредрейсовыйМедосмотр(ОбъектДок, Вложения, Титул, ДопПараметры);
	
	ДанныеТитула = ДанныеПредрейсовыйМедосмотр[ДанныеПредрейсовыйМедосмотр.ВГраница()];
	ЗаполнитьЗначенияСвойств(ОбъектДок, ДанныеТитула.ДляДокумента);
	
	Если Не ДопПараметры.ТолькоАктивныйЭтап Тогда
		
		МодульКода("ESD_ТНЗагрузкаСервер").ЗаполнитьДанныеЮрЛицИКонтактнуюИнформацию(
			ОбъектДок, ДанныеТитула.ДляДокумента, ЗначениеМетаданных("ESD_РолиКонтрагентов.МедосмотрВыезд"), ДопПараметры);
		
		МодульКода("ESD_ТНЗагрузкаСервер").ЗаполнитьОтветственныхЛиц(
			ОбъектДок, ДанныеТитула.ДляДокумента.ОтветственныеЗаМедосмотр, ЗначениеМетаданных("ESD_РолиОтветственных.МедосмотрВыезд"));
			
	КонецЕсли;
	
	Если ДопПараметры.ЗагрузкаСОнлайна Тогда
		МодульКода("РегистрыСведений.ESD_ДанныеТитулов").ЗаписатьДанные(
			ДанныеПредрейсовыйМедосмотр, ОбъектДок, ДопПараметры.ИмяМетаданных);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузкаТитулаПредрейсовыйТехосмотр(ОбъектДок, Вложения, Титул, ДопПараметры)
	
	Если Не Вложения.Количество() Тогда 
		Возврат;
	КонецЕсли;
	
	ДанныеПредрейсовыйТехосмотр = ДанныеПредрейсовыйТехосмотр(ОбъектДок, Вложения, Титул, ДопПараметры);
	
	ДанныеТитула = ДанныеПредрейсовыйТехосмотр[ДанныеПредрейсовыйТехосмотр.ВГраница()];
	
	Если Не ДопПараметры.ТолькоАктивныйЭтап Тогда
		МодульЗагрузкаСервер = МодульКода("ESD_ТНЗагрузкаСервер");
		ЗаполнитьЗначенияСвойств(ОбъектДок, ДанныеТитула.ДляДокумента);
		МодульЗагрузкаСервер.ЗаполнитьДанныеТСИПрицеповДокумента(ОбъектДок, ДанныеТитула.ДляДокумента);
		МодульЗагрузкаСервер.ЗаполнитьОтветственныхЛиц(
			ОбъектДок, ДанныеТитула.ДляДокумента.ОтветственныеЗаТехосмотр, ЗначениеМетаданных("ESD_РолиОтветственных.Техосмотр"));
	Иначе
		ЗаполнитьЗначенияСвойств(ОбъектДок, ДанныеТитула.ДляДокумента,
			"ТО_НеРазрешенВыпускПосле,ТО_ДатаВремя,ТО_ДатаВремяВыпускаВРейс");
	КонецЕсли;
	
	Если ДопПараметры.ЗагрузкаСОнлайна Тогда
		МодульКода("РегистрыСведений.ESD_ДанныеТитулов").ЗаписатьДанные(
			ДанныеПредрейсовыйТехосмотр, ОбъектДок, ДопПараметры.ИмяМетаданных);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузкаТитулаВыпускающий(ОбъектДок, Вложения, Титул, ДопПараметры)
	
	Если Не Вложения.Количество() Тогда 
		Возврат;
	КонецЕсли;
	
	ДанныеВыпускающий = ДанныеВыпускающий(ОбъектДок, Вложения, Титул, ДопПараметры);
	
	Если Не ДопПараметры.ТолькоАктивныйЭтап Тогда
		
		ДанныеТитула = ДанныеВыпускающий[ДанныеВыпускающий.ВГраница()];
		
		ЗаполнитьЗначенияСвойств(ОбъектДок, ДанныеТитула.ДляДокумента);
		
		МодульКода("ESD_ТНЗагрузкаСервер").ЗаполнитьОтветственныхЛиц(
			ОбъектДок, ДанныеТитула.ДляДокумента.ОтветственныеЗаВыпуск, ЗначениеМетаданных("ESD_РолиОтветственных.ОдометрВыезд"));
			
		МодульКода("ESD_ТНЗагрузкаСервер").ЗаполнитьОтветственныхЛиц(
			ОбъектДок, ДанныеТитула.ДляДокумента.ОтветственныеЗаПрием, ЗначениеМетаданных("ESD_РолиОтветственных.ОдометрЗаезд"));
			
	КонецЕсли;
	
	Если ДопПараметры.ЗагрузкаСОнлайна Тогда
		МодульКода("РегистрыСведений.ESD_ДанныеТитулов").ЗаписатьДанные(ДанныеВыпускающий, ОбъектДок, ДопПараметры.ИмяМетаданных);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузкаТитулаПринимающий(ОбъектДок, Вложения, Титул, ДопПараметры)
	
	Если Не Вложения.Количество() Тогда 
		Возврат;
	КонецЕсли;
	
	ДанныеПринимающий = ДанныеПринимающий(ОбъектДок, Вложения, Титул, ДопПараметры);
	
	Если Не ДопПараметры.ТолькоАктивныйЭтап Тогда
		
		ДанныеТитула = ДанныеПринимающий[ДанныеПринимающий.ВГраница()];
		
		ЗаполнитьЗначенияСвойств(ОбъектДок, ДанныеТитула.ДляДокумента);
		
		МодульКода("ESD_ТНЗагрузкаСервер").ЗаполнитьОтветственныхЛиц(
			ОбъектДок, ДанныеТитула.ДляДокумента.ОтветственныеЗаПрием, ЗначениеМетаданных("ESD_РолиОтветственных.ОдометрЗаезд"));
		
	КонецЕсли;
	
	Если ДопПараметры.ЗагрузкаСОнлайна Тогда
		МодульКода("РегистрыСведений.ESD_ДанныеТитулов").ЗаписатьДанные(ДанныеПринимающий, ОбъектДок, ДопПараметры.ИмяМетаданных);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузкаТитулаПослерейсовыйМедосмотр(ОбъектДок, Вложения, Титул, ДопПараметры)
	
	Если Не Вложения.Количество() Тогда 
		Возврат;
	КонецЕсли;
	
	ДанныеПослерейсовыйМедосмотр = ДанныеПослерейсовыйМедосмотр(ОбъектДок, Вложения, Титул, ДопПараметры);
	
