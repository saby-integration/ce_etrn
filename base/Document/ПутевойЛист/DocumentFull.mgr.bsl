Функция ДанныеВыпускающий(ОбъектДок, Вложения, Титул, ДопПараметры)
	РезультатФункции = Новый Массив;
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");

	ВложенияДляЗагрузки = МодульКода("РегистрыСведений.ESD_ДанныеТитулов").ВложенияДляЗагрузки(
		ОбъектДок, Титул, Вложения, ДопПараметры);
	Для Каждого Вложение Из ВложенияДляЗагрузки Цикл
		ДляДокумента = Новый Структура;
		
		ПризнакНачалаРейса = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(
			Вложение, "Документ.ПризнакНачалаРейса");
		ДляДокумента.Вставить(
			"ПризнакНачалаРейса",
			МодульКода("Перечисления.ESD_ПризнакНачалаРейса").ЗначениеПоКоду(ПризнакНачалаРейса));
		
		Если ДляДокумента.ПризнакНачалаРейса = ЗначениеМетаданных("ESD_ПризнакНачалаРейса.ВыездСПарковки") Тогда
			ПутьДатаВремя = "Выпуск.Выезд.ДатаВремя";
			ПутьОдометр = "Выпуск.Выезд.Одометр";
		Иначе
			ПутьДатаВремя = "Выпуск.ПриемТС.ДатаВремя";
			ПутьОдометр = "Выпуск.ПриемТС.Одометр";
		КонецЕсли;
		
		ДатаВремя = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(Вложение, ПутьДатаВремя);
		ДатаВремя = МодульКода("ESD_ТНОбщегоНазначенияСервер").ПреобразоватьСтрокуВДатуЭПД(ДатаВремя);
		
		Одометр = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(Вложение, ПутьОдометр);
		Одометр = ?(ЗначениеЗаполнено(Одометр), Число(Одометр), 0);
			
		ДляДокумента.Вставить("Выезд_ДатаВремя", ДатаВремя);
		ДляДокумента.Вставить("Выезд_Одометр",   Одометр);
		
		Ответственный = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(Вложение, "Выпуск.Ответственный");
		
		СтруктураВыпускающего = Новый Структура;
		МодульКода("ESD_ТНЗагрузкаСервер").ЗагрузитьОтветственного(СтруктураВыпускающего, Ответственный);
		СтруктураВыпускающего.Вставить("Роль", ЗначениеМетаданных("ESD_РолиОтветственных.ОдометрВыезд"));
		ОтветственныеЗаВыпуск = Новый Массив;
		ОтветственныеЗаВыпуск.Добавить(СтруктураВыпускающего);
		ДляДокумента.Вставить("ОтветственныеЗаВыпуск", ОтветственныеЗаВыпуск);
		
		ЗагрузитьСтороныВыпускающий(ДляДокумента, ДопПараметры.Стороны);
		
		ДляРегистра = СтруктураДанныхДляРегистра(ОбъектДок, Вложение, Титул, ДопПараметры.ИмяМетаданных);
		
		РезультатФункции.Добавить(МодульКода("ESD_ТНЗагрузкаСервер").СтруктураТитула(Титул, ДляДокумента, ДляРегистра));		
	КонецЦикла;
	
	Возврат РезультатФункции;
КонецФункции

Функция ДанныеПринимающий(ОбъектДок, Вложения, Титул, ДопПараметры)
