	ФЛК = ФЛК("ДанныеЮрЛицМедосмотрЗаезд.НаименованиеОрганизации",
		ПослеРейса_ОрганизацияСтрокой,
		"Не заполнено наименование организации медработника заезд");
	ПроверяемыеРеквизиты.Добавить(ФЛК);
	ПроверяемыеРеквизиты.Добавить(
		ФЛК("ДанныеЮрЛицМедосмотрЗаезд.Адрес", ПослеРейса_ОрганизацияСтрокой, "Не заполнен адрес юр. лица"));
	
КонецПроцедуры

Процедура ДопПроверкиФЛКВыпуск(ДанныеДокумента, ПараметрыВыгрузки, Ошибки)
	
	МодульТНОбщегоНазначенияСервер = МодульКода("ESD_ТНОбщегоНазначенияСервер");
	
	Если НачалоДня(ДанныеДокумента.ДатаОкончанияИсполнения) <> ДанныеДокумента.ДатаОкончанияИсполнения
		И ДанныеДокумента.ДатаНачалаИсполнения = ДанныеДокумента.ДатаОкончанияИсполнения Тогда
		ИмяДатаОкончанияИсполнения = "ДатаОкончанияИсполнения";
		СтруктураДанныхОшибки = ФЛК(
			ИмяДатаОкончанияИсполнения,
			ИмяДатаОкончанияИсполнения,
			"В длительности исполнения путевого листа не может быть указано одинаковое время");
		
		МодульКода("ESD_ТНОбщегоНазначенияСервер").ДобавитьОшибкуПользователю(
			Ошибки, 
			ИмяДатаОкончанияИсполнения, 
			СтруктураДанныхОшибки.Ошибка,
			СтруктураДанныхОшибки.РеквизитОбъекта,
			СтруктураДанныхОшибки.ЭлементФормы);
	КонецЕсли;
	
	СтруктураОшибки = ФЛК("ТранспортныеСредства", "ТранспортноеСредствоСтрокой", "Не заполнено транспортное средство");
	МодульТНОбщегоНазначенияСервер.ПроверитьЗаполнениеТранспортногоСредства(ДанныеДокумента, Ошибки, СтруктураОшибки);
	
	СтруктураОшибки = ФЛК("ОрганизацияСтрокой", "ОрганизацияСтрокой", "Не заполнен Телефон отправителя");
	МодульТНОбщегоНазначенияСервер.ПроверитьКонтактныеДанные(ДанныеДокумента, "Оформитель", "Телефон", Ошибки, СтруктураОшибки);
	
	
КонецПроцедуры

Процедура ДопПроверкиФЛКПредрейсовыйТехосмотр(ДанныеДокумента, ПараметрыВыгрузки, Ошибки)
	
	СтруктураОшибки = ФЛК("ТранспортныеСредства", "ТранспортноеСредствоСтрокой", "Не заполнено транспортное средство");
	МодульКода("ESD_ТНОбщегоНазначенияСервер").ПроверитьЗаполнениеТранспортногоСредства(ДанныеДокумента, Ошибки, СтруктураОшибки);
				
КонецПроцедуры

Процедура ДопПроверкиФЛКПринимающий(ДанныеДокумента, ПараметрыВыгрузки, Ошибки)
	
	ПроверитьОдометр(ДанныеДокумента, Ошибки);
	
КонецПроцедуры

Функция ПроверятьРеквизитТранспортногоСредства(СтрокаТЧ, ИмяТЧ, ИмяРеквизита)
	
	ЭтоАвтомобиль = СтрокаТЧ.Вид = ЗначениеМетаданных("ESD_ВидыТС.Автомобиль");
	
	Если ЭтоАвтомобиль Тогда
		
		Если ИмяРеквизита = "РегистрационныйНомер" Тогда
			Возврат Не ЗначениеЗаполнено(СтрокаТЧ.ИнвентарныйНомер);
		ИначеЕсли ИмяРеквизита = "ИнвентарныйНомер" Тогда
			Возврат Не ЗначениеЗаполнено(СтрокаТЧ.РегистрационныйНомер);
		Иначе
			Возврат Истина;
		КонецЕсли;
		
	Иначе
		
		Возврат ИмяРеквизита <> "Тип" И ИмяРеквизита <> "ИнвентарныйНомер";
		
	КонецЕсли;
	
КонецФункции

Функция ПроверятьРеквизитЮрЛиц(СтрокаТЧ, ИмяТЧ, ИмяРеквизита, ДанныеДокумента)
	
	МедосмотрПроводитСторонняяОрганизация = Ложь;
	
	Если ИмяТЧ = "ДанныеЮрЛицМедосмотрВыезд" Тогда
		МедосмотрПроводитСторонняяОрганизация = МедосмотрПроводитСторонняяОрганизация
			Или ДанныеДокумента.ДоРейса_МедосмотрСторонняяОрганизация;
	КонецЕсли;
		
	Если ИмяТЧ = "ДанныеЮрЛицМедосмотрЗаезд" Тогда
		МедосмотрПроводитСторонняяОрганизация = МедосмотрПроводитСторонняяОрганизация
			Или ДанныеДокумента.ПослеРейса_МедосмотрСторонняяОрганизация;
	КонецЕсли;
	
	ПроверятьРеквизиты = Истина;
	Если ИмяРеквизита <> Неопределено Тогда
		ПроверятьРеквизиты = ИмяРеквизита = "ИНН";
		Если СтрокаТЧ <> Неопределено
			И СтрокаТЧ.ЮрФизЛицо = ЗначениеМетаданных("ESD_ЮрФизЛицо.ИндивидуальныйПредприниматель") Тогда
			ПроверятьРеквизиты = ПроверятьРеквизиты Или ИмяРеквизита = "Имя" Или ИмяРеквизита = "Фамилия";
		КонецЕсли;
	КонецЕсли;
	
	Возврат МедосмотрПроводитСторонняяОрганизация И ПроверятьРеквизиты;
	
КонецФункции

Функция ПроверятьРеквизитОформителя(СтрокаТЧ, Реквизит)
	
	ЭтоОформитель = СтрокаТЧ.Роль = ЗначениеМетаданных("ESD_РолиКонтрагентов.Оформитель");
	
	ПроверятьРеквизиты = Реквизит.РеквизитОбъекта <> "Имя" И Реквизит.РеквизитОбъекта <> "Фамилия";
	Если Не ПроверятьРеквизиты Тогда
		ПроверятьРеквизиты = СтрокаТЧ.ЮрФизЛицо = ЗначениеМетаданных("ESD_ЮрФизЛицо.ИндивидуальныйПредприниматель");
	КонецЕсли;
	
	Возврат ЭтоОформитель И ПроверятьРеквизиты;
	
КонецФункции

Функция ПроверятьРеквизитВодителя(СтрокаТЧ, ИмяРеквизита)
	
	Если ИмяРеквизита = "Серия" Или ИмяРеквизита = "Номер" Или ИмяРеквизита = "ДатаВыдачи" Тогда
		Возврат ЗначениеЗаполнено(СтрокаТЧ.Серия)
			Или ЗначениеЗаполнено(СтрокаТЧ.Номер)
			Или ЗначениеЗаполнено(СтрокаТЧ.ДатаВыдачи);
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

Процедура ДополнитьПроверкуМедосмотра(ДанныеДокумента, ПроверяемыеРеквизиты)
		
	Если ДанныеДокумента.ДоРейса_МедосмотрСторонняяОрганизация Тогда
		Если Не ЗначениеЗаполнено(ДанныеДокумента.ДоРейса_МедицинскаяОрганизация) Тогда
			ДоРейса_ОрганизацияСтрокой = "ДоРейса_ОрганизацияСтрокой";
			ДанныеЮрЛицМедосмотрВыезд = ФЛК("ДанныеЮрЛицМедосмотрВыезд", ДоРейса_ОрганизацияСтрокой,
				"Не заполнена организация медработника выезд");
					
			ДанныеЮрЛицМедосмотрВыездНаименование = ФЛК("ДанныеЮрЛицМедосмотрВыезд.НаименованиеОрганизации",
				ДоРейса_ОрганизацияСтрокой, "Не заполнено наименование организации медработника выезд");
				
			ПроверяемыеРеквизиты.Добавить(
				ФЛК("ДанныеЮрЛицМедосмотрВыезд.ИНН", ДоРейса_ОрганизацияСтрокой, "Не заполнен ИНН организации медработника"));
			ПроверяемыеРеквизиты.Добавить(
				ФЛК("ДанныеЮрЛицМедосмотрВыезд.Имя", ДоРейса_ОрганизацияСтрокой, "Не заполнено Имя организации медработника"));
			ПроверяемыеРеквизиты.Добавить(
				ФЛК("ДанныеЮрЛицМедосмотрВыезд.Фамилия", ДоРейса_ОрганизацияСтрокой, "Не заполнена Фамилия организации медработника"));
				
			ПроверяемыеРеквизиты.Добавить(ДанныеЮрЛицМедосмотрВыезд);
			ПроверяемыеРеквизиты.Добавить(ДанныеЮрЛицМедосмотрВыездНаименование);
		КонецЕсли;
	Иначе
		
		МедосмотрВыездСтрокой = "МедосмотрВыездСтрокой";
		
		МедосмотрВыезд = ФЛК("ОтветственныйМедосмотрВыезд", МедосмотрВыездСтрокой,
			"Не заполнен медработник предрейсового медосмотра");
			
		МедосмотрВыездФамилия = ФЛК("ОтветственныйМедосмотрВыезд.Фамилия", МедосмотрВыездСтрокой,
			"Не заполнена фамилия медработника предрейсового медосмотра");
		
		МедосмотрВыездИмя = ФЛК("ОтветственныйМедосмотрВыезд.Имя", МедосмотрВыездСтрокой,
			"Не заполнено имя медработника предрейсового медосмотра");
			
		ПроверяемыеРеквизиты.Добавить(МедосмотрВыезд);
		ПроверяемыеРеквизиты.Добавить(МедосмотрВыездФамилия);
		ПроверяемыеРеквизиты.Добавить(МедосмотрВыездИмя);
			
	КонецЕсли;
	
	Если ДанныеДокумента.ПослерейсовыйМедосмотрТребуется Тогда
		Если ДанныеДокумента.ПослеРейса_МедосмотрСторонняяОрганизация Тогда
			Если Не ЗначениеЗаполнено(ДанныеДокумента.ПослеРейса_МедицинскаяОрганизация) Тогда
				ПослеРейса_ОрганизацияСтрокой = "ПослеРейса_ОрганизацияСтрокой";
				ДанныеЮрЛицМедосмотрЗаезд = ФЛК("ДанныеЮрЛицМедосмотрЗаезд", ПослеРейса_ОрганизацияСтрокой,
					"Не заполнена организация медработника заезд");
					
				ДанныеЮрЛицМедосмотрЗаездНаименование = ФЛК("ДанныеЮрЛицМедосмотрЗаезд.НаименованиеОрганизации",
					ПослеРейса_ОрганизацияСтрокой, "Не заполнено наименование организации медработника заезд");
					
				ПроверяемыеРеквизиты.Добавить(
					ФЛК("ДанныеЮрЛицМедосмотрЗаезд.ИНН", ПослеРейса_ОрганизацияСтрокой, "Не заполнен ИНН организации медработника"));
				ПроверяемыеРеквизиты.Добавить(
					ФЛК("ДанныеЮрЛицМедосмотрЗаезд.Имя", ПослеРейса_ОрганизацияСтрокой, "Не заполнено Имя организации медработника"));
				ПроверяемыеРеквизиты.Добавить(
					ФЛК("ДанныеЮрЛицМедосмотрЗаезд.Фамилия", ПослеРейса_ОрганизацияСтрокой, "Не заполнена Фамилия организации медработника"));
					
				ПроверяемыеРеквизиты.Добавить(ДанныеЮрЛицМедосмотрЗаезд);
				ПроверяемыеРеквизиты.Добавить(ДанныеЮрЛицМедосмотрЗаездНаименование);
			 КонецЕсли;
		Иначе
			
			МедосмотрЗаездСтрокой = "МедосмотрЗаездСтрокой";
			
			МедосмотрЗаезд = ФЛК("ОтветственныйМедосмотрЗаезд", МедосмотрЗаездСтрокой,
				"Не заполнен медработник послерейсового медосмотра");
				
			МедосмотрЗаездФамилия = ФЛК("ОтветственныйМедосмотрЗаезд.Фамилия", МедосмотрЗаездСтрокой,
				"Не заполнена фамилия медработника послерейсового медосмотра");
			
			МедосмотрЗаездИмя = ФЛК("ОтветственныйМедосмотрЗаезд.Имя", МедосмотрЗаездСтрокой,
				"Не заполнено имя медработника послерейсового медосмотра");
				
			ПроверяемыеРеквизиты.Добавить(МедосмотрЗаезд);	
			ПроверяемыеРеквизиты.Добавить(МедосмотрЗаездФамилия);
			ПроверяемыеРеквизиты.Добавить(МедосмотрЗаездИмя);
				
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьОдометр(ДанныеДокумента, Ошибки)
	Если ДанныеДокумента.Выезд_Одометр > ДанныеДокумента.Заезд_Одометр Тогда
		ТекстОшибки = "Значение одометра при заезде не может быть меньше значения одометра при выезде";
	Иначе
		Возврат;
	КонецЕсли;
	
	ИмяЗаездОдометр = "Заезд_Одометр";
	СтруктураДанныхОшибки = ФЛК(ИмяЗаездОдометр, ИмяЗаездОдометр, ТекстОшибки);
	МодульКода("ESD_ТНОбщегоНазначенияСервер").ДобавитьОшибкуПользователю(
		Ошибки, 
		ИмяЗаездОдометр, 
		СтруктураДанныхОшибки.Ошибка,
		СтруктураДанныхОшибки.РеквизитОбъекта,
		СтруктураДанныхОшибки.ЭлементФормы);
КонецПроцедуры

