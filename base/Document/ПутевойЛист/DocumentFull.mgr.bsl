	ПроверяемыеРеквизиты.Добавить(ФЛК("Водители.Имя", ВодителиФИО, "Не заполнена имя водителя"));
	
	МедосмотрВыездСтрокой = "МедосмотрВыездСтрокой";
	ДекорацияЗаполнитьЛицензияДоРейса = "ДекорацияЗаполнитьЛицензияДоРейса";
	
	ПроверяемыеРеквизиты.Добавить(
		ФЛК("ОтветственныйМедосмотрВыезд", МедосмотрВыездСтрокой, "Не заполнен медработник предрейсового медосмотра"));
	ПроверяемыеРеквизиты.Добавить(
		ФЛК("ОтветственныйМедосмотрВыезд.Серия", ДекорацияЗаполнитьЛицензияДоРейса, "Не заполнена серия документа"));
	ПроверяемыеРеквизиты.Добавить(
		ФЛК("ОтветственныйМедосмотрВыезд.Номер", ДекорацияЗаполнитьЛицензияДоРейса, "Не заполнен номер документа"));
	ПроверяемыеРеквизиты.Добавить(
		ФЛК("ОтветственныйМедосмотрВыезд.ДатаВыдачи", ДекорацияЗаполнитьЛицензияДоРейса, "Не заполнена дата выдачи документа"));
	ФЛК = ФЛК("ОтветственныйМедосмотрВыезд.ДатаОкончанияДействия",
		ДекорацияЗаполнитьЛицензияДоРейса,
		"Не заполнен срок действия документа");
	ПроверяемыеРеквизиты.Добавить(ФЛК);
	ФЛК = ФЛК("ОтветственныйМедосмотрВыезд.Фамилия",
		МедосмотрВыездСтрокой,
		"Не заполнена фамилия медработника предрейсового медосмотра");
	ПроверяемыеРеквизиты.Добавить(ФЛК);
	ПроверяемыеРеквизиты.Добавить(
		ФЛК("ОтветственныйМедосмотрВыезд.Имя", МедосмотрВыездСтрокой, "Не заполнено имя медработника предрейсового медосмотра"));
		
	ДоРейса_ОрганизацияСтрокой = "ДоРейса_ОрганизацияСтрокой";
	ПроверяемыеРеквизиты.Добавить(
		ФЛК("ДанныеЮрЛицМедосмотрВыезд", ДоРейса_ОрганизацияСтрокой, "Не заполнена организация медработника выезд"));
	ФЛК = ФЛК("ДанныеЮрЛицМедосмотрВыезд.НаименованиеОрганизации",
		ДоРейса_ОрганизацияСтрокой,
		"Не заполнено наименование организации медработника выезд");
	ПроверяемыеРеквизиты.Добавить(ФЛК);
	ПроверяемыеРеквизиты.Добавить(
		ФЛК("ДанныеЮрЛицМедосмотрВыезд.Адрес", ДоРейса_ОрганизацияСтрокой, "Не заполнен адрес юр. лица"));
	
КонецПроцедуры

