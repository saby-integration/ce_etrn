#Область СлужебныеПроцедурыИФункции

Функция ПользовательскиеТипыДляЗаполненияНаОсновании()
	РезультатФункции = МодульКода("ESD_ТНОбщегоНазначенияСервер")
		.ESD_ЗагрузитьНастройкиОбъекта("ТипыДляЗаполненияНаОснованииДокументаЭПЛ", , "");	
	Возврат РезультатФункции;
КонецФункции

Функция ТипыПоУмолчаниюДляЗаполненияНаОсновании()
	
	РезультатФункции = Новый Массив;
		
	ДоступнаяКонфигурация = МодульКода("ESD_ТНОбщегоНазначенияСервер").ЭтоДоступнаяКонфигурация();		
	Если Не ДоступнаяКонфигурация.Поддержана Тогда
		Возврат РезультатФункции;
	КонецЕсли;

	Если ДоступнаяКонфигурация.Имя = "УАТ" Тогда 
		
		РезультатФункции.Добавить("Документы.уатМаршрутныйЛист");
		РезультатФункции.Добавить("Документы.уатПутевойЛист");
				
	КонецЕсли;	
	
	РезультатФункции = МодульКода("ESD_ТНОбщегоНазначенияСервер").ДоступныеТипыМетаданных(РезультатФункции);
	
	Возврат РезультатФункции.Типы();
		
КонецФункции

Процедура ЗаписатьИдСледПутевогоЛиста(СсылкаНаПутевойЛист, ИдентификаторСБИС)
	
	Если Не ЗначениеЗаполнено(СсылкаНаПутевойЛист)
		Или Не ЗначениеЗаполнено(ИдентификаторСБИС) Тогда		
		Возврат;
	КонецЕсли;	
	
	ТекущееЗначение = МодульКода("ESD_ТНОбщегоНазначенияСервер").ЗначениеРеквизитаОбъекта(СсылкаНаПутевойЛист, "ПЛСледующий");
	Если ТекущееЗначение <> ИдентификаторСБИС Тогда
		
		ОбъектПЛ = СсылкаНаПутевойЛист.ПолучитьОбъект();
		ОбъектПЛ.ПЛСледующий = ИдентификаторСБИС;
		ОбъектПЛ.Записать();
		
	КонецЕсли;	
	
КонецПроцедуры

