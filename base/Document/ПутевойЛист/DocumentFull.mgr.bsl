Процедура ДобавитьТаблицыИзБД(СтруктураДанных, СсылкаНаДокумент, Таблицы)
	
	МассивЗапросов = Новый Массив;
	
	УниверсальныйШаблонЗапроса =
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	Документ.ESD_ПутевойЛист.%1 КАК ТЧПутевогоЛиста
	|ГДЕ
	|	ТЧПутевогоЛиста.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	УниверсальныйШаблонЗапроса = СтрЗаменить(УниверсальныйШаблонЗапроса, "ESD_ПутевойЛист", ПутевойЛист());
	
	ЗапросДанных = Новый Запрос;
	
	Для Каждого ИмяТаблицы Из Таблицы Цикл
		
		Если ДобавленаТаблицаОтветственных(МассивЗапросов, ИмяТаблицы, ЗапросДанных)
			Или ДобавленаТаблицаЮрЛиц(МассивЗапросов, ИмяТаблицы, ЗапросДанных) Тогда
			Продолжить;
		КонецЕсли;
			
		ТекстЗапроса = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрШаблонЭПД(УниверсальныйШаблонЗапроса, ИмяТаблицы);
		
		МассивЗапросов.Добавить(ТекстЗапроса);
		
	КонецЦикла;
	
	РазделительЗапросов = "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
	ЗапросДанных.Текст = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").СтрСоединитьЭПД(МассивЗапросов, РазделительЗапросов);
	ЗапросДанных.УстановитьПараметр("Ссылка", СсылкаНаДокумент);
	
	Результат = ЗапросДанных.ВыполнитьПакет();
	Индекс = 0;
	Пока Индекс < Таблицы.Количество() Цикл
		СтруктураДанных.Вставить(Таблицы[Индекс], Результат[Индекс].Выгрузить());
		Индекс = Индекс + 1;
	КонецЦикла;
	
КонецПроцедуры

Функция ДобавленаТаблицаОтветственных(МассивЗапросов, ИмяТаблицы, ЗапросДанных)
	
	РезультатФункции = Ложь;
	
	ШаблонЗапросаОтветственныхЛиц =
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	Документ.ESD_ПутевойЛист.ОтветственныеЛица КАК ESD_ПутевойЛистОтветственныеЛица
	|ГДЕ
	|	ESD_ПутевойЛистОтветственныеЛица.Ссылка = &Ссылка
	|	И ESD_ПутевойЛистОтветственныеЛица.Роль = &Роль
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	ШаблонЗапросаОтветственныхЛиц = СтрЗаменить(ШаблонЗапросаОтветственныхЛиц, "ESD_ПутевойЛист", ПутевойЛист());
	
	Если ИмяТаблицы = "Водители" Тогда
		ИмяПараметра = "РольВодитель";
		Роль = ЗначениеМетаданных("ESD_РолиОтветственных.Водитель");
	ИначеЕсли ИмяТаблицы = "ОтветственныйМедосмотрВыезд" Тогда
		ИмяПараметра = "РольМедосмотрВыезд";
		Роль = ЗначениеМетаданных("ESD_РолиОтветственных.МедосмотрВыезд");
	ИначеЕсли ИмяТаблицы = "ОтветственныйТехосмотр" Тогда
		ИмяПараметра = "РольТехосмотр";
		Роль = ЗначениеМетаданных("ESD_РолиОтветственных.Техосмотр");
	ИначеЕсли ИмяТаблицы = "ОтветственныйОдометрВыезд" Тогда
		ИмяПараметра = "РольОдометрВыезд";
		Роль = ЗначениеМетаданных("ESD_РолиОтветственных.ОдометрВыезд");
	ИначеЕсли ИмяТаблицы = "ОтветственныйОдометрЗаезд" Тогда
		ИмяПараметра = "РольОдометрЗаезд";
		Роль = ЗначениеМетаданных("ESD_РолиОтветственных.ОдометрЗаезд");
	ИначеЕсли ИмяТаблицы = "ОтветственныйМедосмотрЗаезд" Тогда
		ИмяПараметра = "РольМедосмотрЗаезд";
		Роль = ЗначениеМетаданных("ESD_РолиОтветственных.МедосмотрЗаезд");
	Иначе
		ИмяПараметра = "";
		Роль = Неопределено;
	КонецЕсли;
	
	Если Роль <> Неопределено Тогда
		
		ТекстЗапроса = СтрЗаменить(ШаблонЗапросаОтветственныхЛиц, "&Роль", "&" + ИмяПараметра);
		
		ЗапросДанных.УстановитьПараметр(ИмяПараметра, Роль);
		
		МассивЗапросов.Добавить(ТекстЗапроса);
		
		РезультатФункции = Истина;
		
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ДобавленаТаблицаЮрЛиц(МассивЗапросов, ИмяТаблицы, ЗапросДанных)
	
	РезультатФункции = Ложь;
	
	ШаблонЗапросаДанныхЮрЛиц =
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	Документ.ESD_ПутевойЛист.ДанныеЮрЛиц КАК ESD_ПутевойЛистДанныеЮрЛиц
	|ГДЕ
	|	ESD_ПутевойЛистДанныеЮрЛиц.Ссылка = &Ссылка
	|	И ESD_ПутевойЛистДанныеЮрЛиц.Роль = &Роль
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	ШаблонЗапросаДанныхЮрЛиц = СтрЗаменить(ШаблонЗапросаДанныхЮрЛиц, "ESD_ПутевойЛист", ПутевойЛист());
	
	Если ИмяТаблицы = "ДанныеЮрЛицМедосмотрВыезд" Тогда
		ИмяПараметра = "РольЮрМедосмотрВыезд";
		Роль = ЗначениеМетаданных("ESD_РолиКонтрагентов.МедосмотрВыезд");
	ИначеЕсли ИмяТаблицы = "ДанныеЮрЛицМедосмотрЗаезд" Тогда
		ИмяПараметра = "РольЮрМедосмотрЗаезд";
		Роль = ЗначениеМетаданных("ESD_РолиКонтрагентов.МедосмотрЗаезд");
	Иначе
		ИмяПараметра = "";
		Роль = Неопределено;
	КонецЕсли;
	
	Если Роль <> Неопределено Тогда
		
		ТекстЗапроса = СтрЗаменить(ШаблонЗапросаДанныхЮрЛиц, "&Роль", "&" + ИмяПараметра);
		
		ЗапросДанных.УстановитьПараметр(ИмяПараметра, Роль);
		
		МассивЗапросов.Добавить(ТекстЗапроса);
		
		РезультатФункции = Истина;
		
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

