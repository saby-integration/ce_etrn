Функция СтруктураДанныхДляРегистра(ОбъектДок, Вложение, Титул, ИмяМетаданных, СохранитьДанные = Ложь)
	
	Основной = Не МодульКода("ESD_ТНОбщегоНазначенияСервер").РезультатФункцииТитулов(
		ПутевойЛист(), "ЭтоДинамическийТитул", Титул);
	
	СтруктураДанныхДляРегистра = МодульКода("ESD_ТНЗагрузкаСервер").ШаблонСтруктурыДанныхДляРегистра(
		ОбъектДок.Ссылка, Титул, Основной);
	СтруктураДанныхДляРегистра.Просмотрено     = Истина;
	СтруктураДанныхДляРегистра.СохранитьДанные = СохранитьДанные;
	
	Вложение.Вставить("ЗагруженВРегистр", Вложение["ЗагруженВРегистр"] Или Вложение["ИдентификаторВложенияТитула"] = "");
	
	Возврат МодульКода("ESD_ТНЗагрузкаСервер").ДанныеДляРегистраТитулов(Вложение, ИмяМетаданных, СтруктураДанныхДляРегистра);
		
КонецФункции

Процедура ЗаполнитьДанныеОтрицательногоЗакрытия(Вложение, ДляДокумента, СобытияСОнлайна, Титул)
	
	СтруктураСобытия = Неопределено;
	
	Для Каждого СобытиеСоответствие Из СобытияСОнлайна Цикл
		
		НазваниеСобытия = СобытиеСоответствие["Название"];
		
		ТитулСобытия = МодульКода("ESD_ТНОбщегоНазначенияСервер").РезультатФункцииТитулов(
			ПутевойЛист(), "ЗначениеПоПредставлению", НазваниеСобытия);
		Если ТитулСобытия = Титул Или НазваниеСобытия = "Уведомление об уточнении" Тогда
			СтруктураСобытия = СобытиеСоответствие;
		КонецЕсли;
		
	КонецЦикла;
	
	Если СтруктураСобытия = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДатаВремя = МодульКода("ESD_ТНОбщегоНазначенияСервер").ПреобразоватьСтрокуВДатуЭПД(СтруктураСобытия["ДатаВремя"]);
	
	Вложение.Вставить("ДатаВложенияТитула",          ДатаВремя);
	Вложение.Вставить("ИдентификаторВложенияТитула", СтруктураСобытия["Идентификатор"]);
	
	ДляДокумента.Вставить("КомментарийУведомление", СтруктураСобытия["Комментарий"]);
	
КонецПроцедуры

#КонецОбласти // ДанныеТитуловДляЗагрузки

Процедура ЗаполнитьАдресаПунктовВыгрузки(ОбъектДок, ДляДокумента)
	
	Если Не ДляДокумента.Свойство("АдресаПунктовВыгрузки") Тогда
		Возврат;
	КонецЕсли;
	
	Если ДляДокумента.АдресаПунктовВыгрузки.Количество() > 0 Тогда
		ОбъектДок.АдресаПунктовВыгрузки.Очистить();
	КонецЕсли;
	
	Для Каждого СтрокаПункта Из ДляДокумента.АдресаПунктовВыгрузки Цикл
		НоваяСтрокаПункта = ОбъектДок.АдресаПунктовВыгрузки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаПункта, СтрокаПункта);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьДанныеДокумента(ДляДокумента, ДокументСОнлайна, ДопПараметры)
	
	Если Не ЗначениеЗаполнено(ДокументСОнлайна) Тогда
		Возврат;
	КонецЕсли;
		
	ДляДокумента.Вставить("НомерСБИС", ДокументСОнлайна["Номер"]);
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");

	ПризнакНачалаРейса = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(
		ДокументСОнлайна, "ПризнакНачалаРейса", "1");
	ДляДокумента.Вставить("ПризнакНачалаРейса", МодульКода("Перечисления.ESD_ПризнакНачалаРейса").ЗначениеПоКоду(ПризнакНачалаРейса));
		
	Если ДопПараметры.ЗагрузкаСОнлайна Или ДопПараметры.ЭтоПервоеОснование Тогда
		ДляДокумента.Вставить("ПослерейсовыйМедосмотрТребуется", ДокументСОнлайна["ПослерейсовыйМедосмотр"] = "1");
	КонецЕсли;
	
	ДляДокумента.Вставить(
	    "ВидПеревозки",
		МодульКода("Перечисления.ESD_ВидПеревозки").ЗначениеПоКоду(ДокументСОнлайна["ВидПеревозки"]));
	
	ДляДокумента.Вставить(
		"ВидКоммерческойПеревозки",
		МодульКода("Перечисления.ESD_ВидКоммерческойПеревозки").ЗначениеПоКоду(ДокументСОнлайна["ВидКоммерческойПеревозки"]));
		
	ДляДокумента.Вставить(
		"ВидТранспортногоСообщения",
		МодульКода("Перечисления.ESD_ВидСообщенияЭПЛ").ЗначениеПоКоду(ДокументСОнлайна["ВидСообщения"]));
	
	ЗагрузитьДанныеСроковПутевогоЛиста(ДляДокумента, ДокументСОнлайна);
	
	РольОформитель = ЗначениеМетаданных("ESD_РолиКонтрагентов.Оформитель");
	Если ЗначениеЗаполнено(ДопПараметры.СторонняяОрганизация) Тогда
		ПодстановкиЮрЛиц = МодульКода("ESD_ТНЗагрузкаСервер").НормализованныеДанныеЮрЛица(ДопПараметры.СторонняяОрганизация);
		КонтактыОформителя = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(
			ДокументСОнлайна, "Оформитель.Контакты");
		ПодстановкиЮрЛиц.Вставить("Контакты", КонтактыОформителя);
		АдресОформителя = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(ДокументСОнлайна, "Оформитель.Адрес");
		ПодстановкиЮрЛиц.Вставить("Адрес", АдресОформителя);
		МодульКода("ESD_ТНЗагрузкаСервер").ЗагрузитьДанныеЮрЛиц(ДляДокумента, ПодстановкиЮрЛиц, РольОформитель);
	Иначе
		МодульКода("ESD_ТНЗагрузкаСервер").ЗагрузитьДанныеЮрЛиц(ДляДокумента, ДокументСОнлайна["Оформитель"], РольОформитель);
	КонецЕсли;
	
	ЗагрузитьЗаменуВодителя(ДляДокумента, ДопПараметры);
		
	Если Не ДопПараметры.ЗагрузкаСОнлайна Тогда
		ДляДокумента = МодульКода("ESD_ТНОбщегоНазначенияСервер").СтруктураБезПустыхЗначений(ДляДокумента);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьДанныеСроковПутевогоЛиста(ДляДокумента, ДокументСОнлайна)
	
	МодульТНОбщегоНазначенияСервер = МодульКода("ESD_ТНОбщегоНазначенияСервер");

	Если ДокументСОнлайна["Длительность"] = "1" Тогда
		ДатаНачалаИсполнения = МодульТНОбщегоНазначенияСервер.ПреобразоватьСтрокуВДатуЭПД(
			ДокументСОнлайна["ДатаИсполнения"]);
		ДатаОкончанияИсполнения = ДатаНачалаИсполнения;
	Иначе
		ДатаНачалаИсполнения = МодульТНОбщегоНазначенияСервер.ПреобразоватьСтрокуВДатуЭПД(
			ДокументСОнлайна["ДатаНачалаИсполнения"]);
		ДатаОкончанияИсполнения = МодульТНОбщегоНазначенияСервер.ПреобразоватьСтрокуВДатуЭПД(
			ДокументСОнлайна["ДатаКонцаИсполнения"]);
	КонецЕсли;
		
	Если ДокументСОнлайна["ВремяНачалаИсполнения"] <> Неопределено Тогда
		ВремяНачалаИсполнения = ДокументСОнлайна["ВремяНачалаИсполнения"];
		ДатаНачалаИсполнения = Дата(Формат(ДатаНачалаИсполнения, "ДФ=dd.MM.yyyy") + " " + ВремяНачалаИсполнения + ":00");
	КонецЕсли;
	
	Если ДокументСОнлайна["ВремяКонцаИсполнения"] <> Неопределено Тогда
		ВремяКонцаИсполнения = ДокументСОнлайна["ВремяКонцаИсполнения"];
		ДатаОкончанияИсполнения = Дата(Формат(ДатаОкончанияИсполнения, "ДФ=dd.MM.yyyy") + " " + ВремяКонцаИсполнения + ":00");
	КонецЕсли;
																				
	ДляДокумента.Вставить("ДатаНачалаИсполнения",    ДатаНачалаИсполнения);
	ДляДокумента.Вставить("ДатаОкончанияИсполнения", ДатаОкончанияИсполнения);
	
КонецПроцедуры

Процедура ЗагрузитьДанныеМаршрутов(ДляДокумента, МаршрутСОнлайна)
	
	Если МаршрутСОнлайна = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДляДокумента.Вставить(
		"МестоОтправления",
		МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ЗначениеИзКоллекции(МаршрутСОнлайна, "Отправление.АдресТекст"));
		
	ДляДокумента.Вставить(
		"ИнформацияДляВодителя",
		МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ЗначениеИзКоллекции(МаршрутСОнлайна, "Отправление.Комментарий"));
	
	КлючСтроки = 1;
	АдресаПунктовВыгрузки = Новый Массив;
	Для Каждого Пункт Из МаршрутСОнлайна["Пункт"] Цикл
		
		СтруктураПункта = Новый Структура;
		СтруктураПункта.Вставить("Значение",   Пункт["АдресТекст"]);
		СтруктураПункта.Вставить("КлючСтроки", КлючСтроки);
		СтруктураПункта.Вставить("ИнформацияДляВодителя", Пункт["Комментарий"]); 
		
		АдресаПунктовВыгрузки.Добавить(СтруктураПункта);
		
		КлючСтроки = КлючСтроки + 1;
		
	КонецЦикла;
	ДляДокумента.Вставить("АдресаПунктовВыгрузки", АдресаПунктовВыгрузки);
	
	МодульКода("ESD_ТНЗагрузкаСервер").ЗагрузитьДанныеЮрЛиц(ДляДокумента, МаршрутСОнлайна["Грузоотправитель"], "Отправитель");
	
КонецПроцедуры

Процедура ЗагрузитьМедосмотр(ДляДокумента, МедосмотрСОнлайна, ЭтоПредрейсовыйМедосмотр, ДопПараметры)
	
	ИмяТаблицы = ?(ЭтоПредрейсовыйМедосмотр, "ОтветственныеЗаМедосмотр", "ОтветственныеЗаМедосмотрЗаезд");
	
	Если Не ДляДокумента.Свойство(ИмяТаблицы) Тогда
		ДляДокумента.Вставить(ИмяТаблицы, Новый Массив);
	КонецЕсли;
	
	ДляДокумента.Вставить("ДоРейса_НеДопущенПослеМедосмотра", Ложь);
	
	Если Не ЗначениеЗаполнено(МедосмотрСОнлайна) Тогда
		Возврат;
	КонецЕсли;
	
	ШтатныйСотрудник = ЭтоШтатныйМедик(МедосмотрСОнлайна, ДопПараметры);
	
	Ответственный = МедосмотрСОнлайна["Ответственный"];
	
	Если ЗначениеЗаполнено(МедосмотрСОнлайна["Организация"]) Тогда
		
		Если ЭтоПредрейсовыйМедосмотр Тогда
			Роль = ЗначениеМетаданных("ESD_РолиКонтрагентов.МедосмотрВыезд");
		Иначе
			Роль = ЗначениеМетаданных("ESD_РолиКонтрагентов.МедосмотрЗаезд");
		КонецЕсли;
		
		ПодстановкиЮрЛиц = МодульКода("ESD_ТНЗагрузкаСервер").НормализованныеДанныеЮрЛица(МедосмотрСОнлайна["Организация"]);
		МодульКода("ESD_ТНЗагрузкаСервер").ЗагрузитьДанныеЮрЛиц(ДляДокумента, ПодстановкиЮрЛиц, Роль);
		
	КонецЕсли;
	
	МодульТНОбщегоНазначенияСервер = МодульКода("ESD_ТНОбщегоНазначенияСервер");
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");

	СтруктураМедика = Новый Структура;
	МодульКода("ESD_ТНЗагрузкаСервер").ЗагрузитьОтветственного(СтруктураМедика, Ответственный);
	Если Не ПустаяСтрока(СтруктураМедика.Имя) Тогда
		Лицензия      = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(Ответственный, "Лицензия");
		ДатаВыдачи    = МодульТНОбщегоНазначенияСервер.ПреобразоватьСтрокуВДатуЭПД(Лицензия["ДатаВыдачи"]);
		Срок          = МодульТНОбщегоНазначенияСервер.ПреобразоватьСтрокуВДатуЭПД(Лицензия["Срок"]);
		РольМедосмотр = ?(ЭтоПредрейсовыйМедосмотр,
			ЗначениеМетаданных("ESD_РолиОтветственных.МедосмотрВыезд"),
			ЗначениеМетаданных("ESD_РолиОтветственных.МедосмотрЗаезд"));
		
		СтруктураМедика.Вставить("Серия",                 Лицензия["Серия"]);
		СтруктураМедика.Вставить("Номер",                 Лицензия["Номер"]);
		СтруктураМедика.Вставить("ДатаВыдачи",            ДатаВыдачи);
		СтруктураМедика.Вставить("ДатаОкончанияДействия", Срок);
		СтруктураМедика.Вставить("Роль",                  РольМедосмотр);
		
		ДляДокумента[ИмяТаблицы].Добавить(СтруктураМедика);
	КонецЕсли;
	
	ДатаВремя = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(МедосмотрСОнлайна, "Результат.ДатаВремя");
	ДатаВремя = МодульТНОбщегоНазначенияСервер.ПреобразоватьСтрокуВДатуЭПД(ДатаВремя);
	Отметка   = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(МедосмотрСОнлайна, "Результат.Отметка");
	Допущен   = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(МедосмотрСОнлайна, "Результат.Допуск");
	// Допущен = Неопределено так как в узле "Стороны" нет узла "Результат"
	Допущен   = Допущен = Неопределено Или Допущен = "1"; 
	
	// Сторонняя организация
	СторонняяОрганизацияИдентификатор =  МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(МедосмотрСОнлайна,
		"ВнешняяСистема.Идентификатор");
	СторонняяОрганизация = МодульКода("Перечисления.ESD_МедицинскиеОрганизации").ЗначениеПоИдентификатору(
		СторонняяОрганизацияИдентификатор);
	
	Если ЭтоПредрейсовыйМедосмотр Тогда
		ДляДокумента.Вставить("ДоРейса_МедосмотрСторонняяОрганизация", Не ШтатныйСотрудник);
		ДляДокумента.Вставить("ДоРейса_ДатаВремяМедосмотра",           ДатаВремя);
		ДляДокумента.Вставить("ДоРейса_КомментарииМедосмотра",         Отметка);
		ДляДокумента.Вставить("ДоРейса_НеДопущенПослеМедосмотра",      Не Допущен);
		ДляДокумента.Вставить("ДоРейса_МедицинскаяОрганизация",		   СторонняяОрганизация);
	Иначе
		ДляДокумента.Вставить("ПослеРейса_МедосмотрСторонняяОрганизация", Не ШтатныйСотрудник);
		ДляДокумента.Вставить("ПослеРейса_ДатаВремяМедосмотра",           ДатаВремя);
		ДляДокумента.Вставить("ПослеРейса_КомментарииМедосмотра",         Отметка);
		ДляДокумента.Вставить("ПослеРейса_МедицинскаяОрганизация",		  СторонняяОрганизация);
	КонецЕсли;
	
КонецПроцедуры

Функция ЭтоШтатныйМедик(МедосмотрСОнлайна, ДопПараметры)
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");

	Если Не ДопПараметры.ЗагрузкаСОнлайна Тогда
		Возврат МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(МедосмотрСОнлайна, "ШтатныйМедик", Ложь);
	КонецЕсли;
	
	ЮрЛица = Новый Структура;
	ЮрЛица.Вставить("ДанныеЮрЛиц",      Новый Массив);
	ЮрЛица.Вставить("КонтактныеДанные", Новый Массив);
	
	// Неважно какая роль, нужно просто получить структуру юр лица в стандартном плоском формате.
	ИскусственнаяРоль = ЗначениеМетаданных("ESD_РолиКонтрагентов.СторонаДокумента");
	
	ПодстановкиЮрЛиц = МодульКода("ESD_ТНЗагрузкаСервер").НормализованныеДанныеЮрЛица(МедосмотрСОнлайна["Организация"]);
	МодульКода("ESD_ТНЗагрузкаСервер").ЗагрузитьДанныеЮрЛиц(ЮрЛица, ПодстановкиЮрЛиц, ИскусственнаяРоль);
	
	Если ЮрЛица.ДанныеЮрЛиц.Количество() > 0 Тогда
		СтруктураЮрЛицаМедосмотр = ЮрЛица.ДанныеЮрЛиц[0];
	Иначе
		СтруктураЮрЛицаМедосмотр = МодульТНОбщегоНазначенияКлиентСервер.ШаблонДанныхЮрЛица();
	КонецЕсли;
	
	ЮрЛица.ДанныеЮрЛиц.Очистить();
	ЮрЛица.КонтактныеДанные.Очистить();
	
	// Если нет описания сторонней организации, то считаем сторонняя организация указана в данных медосмотра
	СтруктураЮрЛицаСторонняяОрганизация = СтруктураЮрЛицаМедосмотр;
	Если ЗначениеЗаполнено(ДопПараметры.СторонняяОрганизация) Тогда
		ПодстановкиЮрЛиц = МодульКода("ESD_ТНЗагрузкаСервер").НормализованныеДанныеЮрЛица(ДопПараметры.СторонняяОрганизация);
		МодульКода("ESD_ТНЗагрузкаСервер").ЗагрузитьДанныеЮрЛиц(ЮрЛица, ПодстановкиЮрЛиц, ИскусственнаяРоль);
		
		Если ЮрЛица.ДанныеЮрЛиц.Количество() > 0 Тогда
			СтруктураЮрЛицаСторонняяОрганизация = ЮрЛица.ДанныеЮрЛиц[0];
		КонецЕсли;
	КонецЕсли;
	
	ЮрЛица.ДанныеЮрЛиц.Очистить();
	ЮрЛица.КонтактныеДанные.Очистить();
	
	Если ЗначениеЗаполнено(ДопПараметры.НашаОрганизация) Тогда
		ПодстановкиЮрЛиц = МодульКода("ESD_ТНЗагрузкаСервер").НормализованныеДанныеЮрЛица(ДопПараметры.НашаОрганизация);
		МодульКода("ESD_ТНЗагрузкаСервер").ЗагрузитьДанныеЮрЛиц(ЮрЛица, ПодстановкиЮрЛиц, ИскусственнаяРоль);
		
		Если ЮрЛица.ДанныеЮрЛиц.Количество() > 0 Тогда
			СтруктураЮрЛицаНашаОрганизация = ЮрЛица.ДанныеЮрЛиц[0];
		КонецЕсли;
	КонецЕсли;
	
	ЭтоНашаОрганизация = МодульТНОбщегоНазначенияКлиентСервер.ЮрЛицаСовпадают(
		СтруктураЮрЛицаНашаОрганизация, СтруктураЮрЛицаСторонняяОрганизация);
	
	Если ЭтоНашаОрганизация Тогда
		СтруктураЮрЛицаСторонняяОрганизация = СтруктураЮрЛицаМедосмотр;
	КонецЕсли;
	
	// Сторонняя организация
	СторонняяОрганизацияИдентификатор =  МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(МедосмотрСОнлайна,
		"ВнешняяСистема.Идентификатор");
	
	ЮрЛицаСовпадают = МодульТНОбщегоНазначенияКлиентСервер.ЮрЛицаСовпадают(
		СтруктураЮрЛицаМедосмотр, СтруктураЮрЛицаСторонняяОрганизация);
	
	РезультатФункции = Не (СтруктураЮрЛицаМедосмотр.Заполнена 
				 	   И ЮрЛицаСовпадают 
					   Или ЗначениеЗаполнено(СторонняяОрганизацияИдентификатор));
	
	Возврат РезультатФункции;
	
КонецФункции

Процедура ЗагрузитьТехосмотр(ДляДокумента, ТехосмотрСОнлайна, ТолькоОтветственный = Ложь)
	ОтветственныеЗаТехосмотр = Новый Массив;
	ДляДокумента.Вставить("ОтветственныеЗаТехосмотр", ОтветственныеЗаТехосмотр);
	ДляДокумента.Вставить("ТО_НеРазрешенВыпускПосле", Ложь);
	
	Если Не ЗначениеЗаполнено(ТехосмотрСОнлайна) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураМеханика = Новый Структура;
	МодульКода("ESD_ТНЗагрузкаСервер").ЗагрузитьОтветственного(СтруктураМеханика, ТехосмотрСОнлайна["Ответственный"]);
	Если Не ПустаяСтрока(СтруктураМеханика.Имя) Тогда
		СтруктураМеханика.Вставить("Роль", ЗначениеМетаданных("ESD_РолиОтветственных.Техосмотр"));
		ОтветственныеЗаТехосмотр.Добавить(СтруктураМеханика);
	КонецЕсли;
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");

	Если Не ТолькоОтветственный Тогда
		
		ДатаВремя = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(ТехосмотрСОнлайна, "Результат.ДатаВремя");
		ДатаВремя = МодульКода("ESD_ТНОбщегоНазначенияСервер").ПреобразоватьСтрокуВДатуЭПД(ДатаВремя);
		Отметка   = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(ТехосмотрСОнлайна, "Результат.Отметка");
		
		ДляДокумента.Вставить("ТО_ДатаВремя",   ДатаВремя);
		ДляДокумента.Вставить("ТО_Комментарий", "");
		
		ДатаВыпускаВРейс = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(
			ТехосмотрСОнлайна, "ВыпускНаЛинию.ДатаВремя");
		ДатаВыпускаВРейс = МодульКода("ESD_ТНОбщегоНазначенияСервер").ПреобразоватьСтрокуВДатуЭПД(ДатаВыпускаВРейс);
		
		ДляДокумента.Вставить("ТО_НеРазрешенВыпускПосле", Отметка = "2");
		ДляДокумента.Вставить("ТО_ДатаВремяВыпускаВРейс", ДатаВыпускаВРейс);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьСтороныВыпуск(ДляДокумента, ДопПараметры)
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");

	Медосмотр = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(ДопПараметры.Стороны, "Медосмотр");
	ЗагрузитьМедосмотр(ДляДокумента, Медосмотр, Истина, ДопПараметры);
	
	ПостМедосмотр = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(ДопПараметры.Стороны, "ПостМедосмотр");
	ЗагрузитьМедосмотр(ДляДокумента, ПостМедосмотр, Ложь, ДопПараметры);
	
	Техосмотр = МодульТНОбщегоНазначенияКлиентСервер.ЗначениеИзКоллекции(ДопПараметры.Стороны, "Техосмотр");
	ЗагрузитьТехосмотр(ДляДокумента, Техосмотр, Истина);
	
КонецПроцедуры

Процедура ЗагрузитьСтороныВыпускающий(ДляДокумента, Стороны)
	ОтветственныеЗаПрием = Новый Массив;
	ДляДокумента.Вставить("ОтветственныеЗаПрием", ОтветственныеЗаПрием);
	
	Если Не ЗначениеЗаполнено(Стороны) Тогда
		Возврат;
	КонецЕсли;
	
	Ответственный = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ЗначениеИзКоллекции(Стороны, "Приемка.Ответственный");
	
	СтруктураПринимающего = Новый Структура;
	МодульКода("ESD_ТНЗагрузкаСервер").ЗагрузитьОтветственного(СтруктураПринимающего, Ответственный);
	СтруктураПринимающего.Вставить("Роль", ЗначениеМетаданных("ESD_РолиОтветственных.ОдометрЗаезд"));
	ОтветственныеЗаПрием.Добавить(СтруктураПринимающего);
КонецПроцедуры

Процедура ЗагрузитьЗаменуВодителя(ДляДокумента, ДопПараметры)
	Если Не ЗначениеЗаполнено(ДопПараметры.ЗаменаВодителя) Тогда
		Возврат;
	КонецЕсли;
		
	ПЛПредыдущий = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ЗначениеИзКоллекции(
		ДопПараметры.ЗаменаВодителя, "ПЛПредыдущий.Идентификатор");
		
	ПЛСледующий  = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ЗначениеИзКоллекции(
		ДопПараметры.ЗаменаВодителя, "ПЛСледующий.Идентификатор");
	
	ДляДокумента.Вставить("ПЛПредыдущий", ПЛПредыдущий);
	ДляДокумента.Вставить("ПЛСледующий",  ПЛСледующий);
КонецПроцедуры

Процедура ДобавитьТитулыПоАктивномуЭтапу(МассивТитуловДляЗагрузки, Этап, ТипыТитулов)
	
	// В регистре состояния нет данных о текущем этапе, при этом документооборот не завершен.
	Если Не ЗначениеЗаполнено(Этап) Тогда
		МассивТитуловДляЗагрузки.Добавить(ТипыТитулов["Выпуск"]);
	ИначеЕсли Этап = ТипыТитулов["ПредрейсовыйМедосмотр"] Или Этап = ТипыТитулов["ПредрейсовыйТехосмотр"] Тогда
		МассивТитуловДляЗагрузки.Добавить(ТипыТитулов["ПредрейсовыйМедосмотр"]);
		МассивТитуловДляЗагрузки.Добавить(ТипыТитулов["ПредрейсовыйТехосмотр"]);
	Иначе
		МассивТитуловДляЗагрузки.Добавить(Этап);
	КонецЕсли;
	
КонецПроцедуры

