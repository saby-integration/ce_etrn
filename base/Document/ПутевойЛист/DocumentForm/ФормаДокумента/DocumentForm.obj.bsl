Процедура ОбновитьВидимостьИДоступностьЭлементовНаКлиенте() Экспорт
	ОбновитьВидимостьИДоступностьЭлементов();
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьИДоступностьЭлементов()
	
	ЭтоКоммерческаяПеревозка = (Объект.ВидПеревозки = ЗначениеМетаданных("ESD_ВидПеревозки.КоммерческиеПеревозки"));
	
	Элементы.ВидКоммерческойПеревозки.Видимость           = ЭтоКоммерческаяПеревозка;
	Элементы.ДекорацияЗаполнитьМестоОтправления.Видимость = Не ЗначениеЗаполнено(Объект.МестоОтправления);
	Элементы.МестоОтправления.Видимость = ЗначениеЗаполнено(Объект.МестоОтправления);
	
	Признаки = ПризнакиДокумента();
	
	// Скрытие данных медработников
	ОбновитьВидимостьИДоступностьЭлементов_Медосмотр(Признаки);
	
	// Завершен ДО, блокируем все изменения
	Если Признаки.Этапы.ДОЗавершен Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	// СНИЛС
	Элементы.ВодителиСНИЛС.Видимость = ЭтаФорма.ИспользоватьСНИЛС; 
	
	// Техосмотр
	Если ЗначениеЗаполнено(Объект.ТО_ДатаВремя) И ЗначениеЗаполнено(Объект.ТО_ДатаВремяВыпускаВРейс) Тогда
		Элементы.ГруппаТехосмотр_Дата.ОтображениеПодсказки = ОтображениеПодсказки.Нет;
	Иначе
		Элементы.ГруппаТехосмотр_Дата.ОтображениеПодсказки = ОтображениеПодсказки.Кнопка;
	КонецЕсли;
	
	// Команды
	ОтборДоступных = Новый Структура("Доступен", Истина);
	НайденныеДоступныеЭтапы = ESD_ТНОбщегоНазначенияКлиентСервер.НайтиСтрокиУниверсально(Объект.ТекущиеЭтапы, ОтборДоступных);
	НесколькоЭтапов = НайденныеДоступныеЭтапы.Количество() > 1;
	
	Если ЭтоУниверсальноеРасширение() Тогда
		Элементы.ФормаВыгрузитьВСбис.Видимость       = Не НесколькоЭтапов И Не ЭтаФорма.ТолькоПросмотр;
		Элементы.ГруппаКнопок_ОтправитьКак.Видимость = НесколькоЭтапов И Не ЭтаФорма.ТолькоПросмотр;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьИДоступностьЭлементов_Медосмотр(Признаки = Неопределено)
	Если Признаки = Неопределено Тогда
		Признаки = ПризнакиДокумента();
	КонецЕсли;
	
	Элементы.ГруппаМедосмотрПослеРейса.Видимость         = Объект.ПослерейсовыйМедосмотрТребуется;
	Элементы.ДоРейса_МедицинскаяОрганизация.Видимость    = Объект.ДоРейса_МедосмотрСторонняяОрганизация;
	Элементы.ПослеРейса_МедицинскаяОрганизация.Видимость = Объект.ПослеРейса_МедосмотрСторонняяОрганизация;
	
	Элементы.ДоРейса_ОрганизацияСтрокой.Видимость    = Объект.ДоРейса_МедосмотрСторонняяОрганизация 
		И Не ЗначениеЗаполнено(Объект.ДоРейса_МедицинскаяОрганизация);
	Элементы.ПослеРейса_ОрганизацияСтрокой.Видимость = Объект.ПослеРейса_МедосмотрСторонняяОрганизация  
		И Не ЗначениеЗаполнено(Объект.ПослеРейса_МедицинскаяОрганизация);
		
	СкрытьМедРаботника_ДоРейса = 
		Объект.ДоРейса_МедосмотрСторонняяОрганизация И Признаки.Этапы.ВыпускДоступен 
		ИЛИ ЗначениеЗаполнено(Объект.ДоРейса_МедицинскаяОрганизация);
		
	СкрытьМедРаботника_ПослеРейса = 
		Объект.ПослеРейса_МедосмотрСторонняяОрганизация И Признаки.Этапы.ВыпускДоступен 
		ИЛИ ЗначениеЗаполнено(Объект.ПослеРейса_МедицинскаяОрганизация);
		
	Элементы.МедосмотрВыездСтрокой.Видимость     = Не СкрытьМедРаботника_ДоРейса; 
	Элементы.ГруппаДоРейса_Лицензия.Видимость    = Не СкрытьМедРаботника_ДоРейса;
	
	Элементы.МедосмотрЗаездСтрокой.Видимость     = Не СкрытьМедРаботника_ПослеРейса;
	Элементы.ГруппаПослеРейса_Лицензия.Видимость = Не СкрытьМедРаботника_ПослеРейса;
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьПоЭтапуИУчастнику()
	
	Признаки = ПризнакиДокумента();
	
	Элементы.ГруппаДокументОснование.Видимость = Признаки.Этапы.ВыпускДоступен
		Или ЗначениеЗаполнено(Объект.ДокументОснование_Идентификатор);
	Элементы.НастройкаДокументовОснований.Видимость = Ложь;
	Элементы.ГруппаКомандыДокументаОснования.Видимость = Признаки.Этапы.ВыпускДоступен И Не ЭтаФорма.ТолькоПросмотр;
	Элементы.ДекорацияДокументОснование.Доступность = ЗначениеЗаполнено(Объект.ДокументОснование_Идентификатор) 
															Или Не ЭтаФорма.ТолькоПросмотр;
		
	МассивЭлементов = Новый Массив;
	МассивЭлементов.Добавить("СтраницаОсновное");
	МассивЭлементов.Добавить("СтраницаМедосмотр");
	МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ИзменитьСвойствоЭлементовФормы(
		ЭтаФорма, "Видимость", Признаки.Этапы.Номер >= 1, МассивЭлементов);
		
	Элементы.СтраницаТехОсмотр.Видимость = Не Признаки.ЭтоЗаменаВодителя;
		
	МассивЭлементов.Очистить();
	МассивЭлементов.Добавить("СтраницаОсновное");
	МассивЭлементов.Добавить("ГруппаНомерДата");
	МассивЭлементов.Добавить("ВодителиСтрокой");
	МассивЭлементов.Добавить("ГруппаПрицепы");
	МассивЭлементов.Добавить("ПослерейсовыйМедосмотрТребуется");
	МассивЭлементов.Добавить("ГруппаМестоОтправления");
	МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ИзменитьСвойствоЭлементовФормы(
		ЭтаФорма, "ТолькоПросмотр", Не Признаки.Этапы.ВыпускДоступен Или ЭтаФорма.ТолькоПросмотр, МассивЭлементов);
		
	МассивЭлементов.Очистить();
	МассивЭлементов.Добавить("ДоРейса_МедосмотрСторонняяОрганизация");
	МассивЭлементов.Добавить("ПослеРейса_МедосмотрСторонняяОрганизация");
	МассивЭлементов.Добавить("ДоРейса_МедицинскаяОрганизация");
	МассивЭлементов.Добавить("ПослеРейса_МедицинскаяОрганизация");
	МассивЭлементов.Добавить("МестоОтправления");
	МассивЭлементов.Добавить("ДекорацияЗаполнитьМестоОтправления");
	МассивЭлементов.Добавить("ВодителиДобавитьВодителя");
	МассивЭлементов.Добавить("ПрицепыДобавить");
	МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ИзменитьСвойствоЭлементовФормы(
		ЭтаФорма, "Доступность", Признаки.Этапы.ВыпускДоступен И Не ЭтаФорма.ТолькоПросмотр, МассивЭлементов);

	ОбновитьВидимостьПолейПредрейсовогоМедосмотра(Признаки);
	
	ОбновитьВидимостьПолейПредрейсовогоТехосмотра(Признаки);
	
	ОбновитьВидимостьПолейПослерейсовогоМедосмотра(Признаки);
	
	Элементы.ГруппаВыезд.ТолькоПросмотр = Не Признаки.Этапы.ВыпускающийДоступен;
	Элементы.ГруппаЗаезд.ТолькоПросмотр = Не Признаки.Этапы.ПринимающийДоступен;
	
	ОбновитьДоступностьПолейЗаменыВодителя();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьПолейПредрейсовогоМедосмотра(Признаки)
	
	Элементы.ГруппаДоРейса.ТолькоПросмотр = Не (Признаки.Этапы.ПредрейсовыйМедосмотрДоступен
		Или Признаки.Этапы.ВыпускДоступен) Или ЭтаФорма.ТолькоПросмотр;
	
	Элементы.ДоРейса_ОрганизацияСтрокой.ТолькоПросмотр = Не Признаки.Этапы.ВыпускДоступен Или ЭтаФорма.ТолькоПросмотр;
		
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьПолейПредрейсовогоТехосмотра(Признаки)
	
	Элементы.СтраницаТехОсмотр.ТолькоПросмотр = Не (Признаки.Этапы.ПредрейсовыйТехосмотрДоступен
												Или Признаки.Этапы.ВыпускДоступен) Или ЭтаФорма.ТолькоПросмотр;
													
	Если Не Элементы.СтраницаТехОсмотр.ТолькоПросмотр Тогда
		
		МассивЭлементов = Новый Массив;
		МассивЭлементов.Добавить("ГруппаВыпуск_Дата");
		МассивЭлементов.Добавить("ТО_РазрешенВыпускПосле");
		МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ИзменитьСвойствоЭлементовФормы(
			ЭтаФорма, "ТолькоПросмотр", Не Признаки.Этапы.ПредрейсовыйТехосмотрДоступен, МассивЭлементов);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьПолейПослерейсовогоМедосмотра(Признаки)
	
	Элементы.ГруппаПослеРейса.ТолькоПросмотр = Не (Признаки.Этапы.ПослерейсовыйМедосмотрДоступен
		Или Признаки.Этапы.ВыпускДоступен) Или ЭтаФорма.ТолькоПросмотр;
												   
	Элементы.ПослеРейса_ОрганизацияСтрокой.ТолькоПросмотр = Не Признаки.Этапы.ВыпускДоступен Или ЭтаФорма.ТолькоПросмотр;											   										   
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДоступностьПолейЗаменыВодителя()
	ОбъектДокумента = РеквизитФормыВЗначение("Объект");
	РезультатПроверкиДоступностиЗаменыВодителя = ОбъектДокумента.РезультатПроверкиДоступностиЗаменыВодителя();
	ДоступнаЗаменаВодителя = РезультатПроверкиДоступностиЗаменыВодителя.ОК И Не ДокументЗаменыВодителяУжеЕсть();
	
	Если Элементы.Найти("ФормаДокументПутевойЛистСоздатьНаОсновании") <> Неопределено Тогда
		Элементы.ФормаДокументПутевойЛистСоздатьНаОсновании.Доступность = ДоступнаЗаменаВодителя;
    КонецЕсли;
		
	ОснованиеПутевойЛист = ЗначениеЗаполнено(Объект.ДокументОснование_Идентификатор)
		И Объект.ДокументОснование_ОбъектМетаданных = ПутевойЛист();
	
	ЭтоПутевойЛистЗаменыВодителя = ЗначениеЗаполнено(Объект.ПЛПредыдущий) Или ОснованиеПутевойЛист;
	
	Если ЭтоПутевойЛистЗаменыВодителя Тогда		
		ПодсказкаПризнакНачалаРейса = ОтображениеПодсказки.Кнопка;
	Иначе
		ПодсказкаПризнакНачалаРейса = ОтображениеПодсказки.Нет;
	КонецЕсли;
	
	Элементы.ПризнакНачалаРейса.ОтображениеПодсказки = ПодсказкаПризнакНачалаРейса;
	
	Если ЭтоПутевойЛистЗаменыВодителя Тогда
			
		МассивЭлементов = Новый Массив;
		МассивЭлементов.Добавить("ОрганизацияСтрокой");
		МассивЭлементов.Добавить("ТранспортноеСредствоСтрокой");
		МассивЭлементов.Добавить("ГруппаПрицепы");
		МассивЭлементов.Добавить("ПрицепыСтрокой");
		МассивЭлементов.Добавить("ГруппаДлительностьИсполнения");
		МассивЭлементов.Добавить("ВидПеревозки");
		МассивЭлементов.Добавить("ГруппаВидКоммерческойПеревозки");
		МассивЭлементов.Добавить("ВидТранспортногоСообщения");
		МассивЭлементов.Добавить("ГруппаМестоОтправления");
		МассивЭлементов.Добавить("ГруппаАдресаПогрузкиВыгрузки");
		
		МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ИзменитьСвойствоЭлементовФормы(
			ЭтаФорма, "ТолькоПросмотр", ЭтоПутевойЛистЗаменыВодителя, МассивЭлементов);
			
		Элементы.ПрицепыДобавить.Доступность = Ложь;
			
	КонецЕсли;	
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПараметрыДокумента

&НаСервере
Процедура ЗагрузитьСлужебныеПризнакиДокумента()
	ОбъектДокумента = РеквизитФормыВЗначение("Объект");
	ЭтаФорма.СлужебныеПризнаки = Новый ХранилищеЗначения(ОбъектДокумента.ПризнакиДокумента());
КонецПроцедуры

&НаСервере
Функция ПризнакиДокумента()
	Возврат ЭтаФорма.СлужебныеПризнаки.Получить();
КонецФункции

&НаСервере
Функция ДОЗавершен() Экспорт
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	ДОЗавершенОтрицательно = МодульТНОбщегоНазначенияКлиентСервер.ИндексКартинки_ДОЗавершенОтрицательно();
	ДОЗавершенПоложительно = МодульТНОбщегоНазначенияКлиентСервер.ИндексКартинки_ДОЗавершенПоложительно();
	
	Завершен = ИндексКартинки = ДОЗавершенОтрицательно
		Или ИндексКартинки = ДОЗавершенПоложительно;
	
	Возврат Завершен;
	
КонецФункции

#КонецОбласти

// Заполнение реквизитов формы при изменение, связанной информации
// или первоначальной инициализации формы
&НаСервере
Процедура ЗаполнитьРасчетныеРеквизиты()
	ЗагрузитьСлужебныеПризнакиДокумента();
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	
	// Документ основание
	Если ЗначениеЗаполнено(Объект.ДокументОснование_Идентификатор) Тогда 
		ДокументОснование = МодульКода("ESD_ТНОбщегоНазначенияСервер").СсылкаНаОбъектОснование(
			Объект.ДокументОснование_ОбъектМетаданных, Объект.ДокументОснование_Идентификатор);
		Элементы.ДекорацияДокументОснование.Заголовок = СокрЛП(ДокументОснование);
	КонецЕсли;
	
	// ТС
	МодульТНОбщегоНазначенияКлиентСервер.ОбновитьТранспортныеСредстваНаФорме(ЭтаФорма);
	
	// Водители
	МодульТНОбщегоНазначенияКлиентСервер.ОбновитьВодителейНаФорме(ЭтаФорма);
	
	ОбновитьВсеОтветственныеЛица();
	
	// Активный этап и индикация состояния
	МодульКода("ESD_ТНОбщегоНазначенияСервер").ОтобразитьНаФормеСбисЭтапИСостояние(ЭтаФорма);
	
	ОбновитьВсеОрганизации();
	
	// СНИЛС
	ЭтаФорма.ИспользоватьСНИЛС = ESD_ТНОбщегоНазначенияСервер
		.ESD_ЗагрузитьНастройкиОбъекта("ИспользоватьСНИЛС", , "");
	
	ЭтаФорма.ИспользоватьТабельныйНомер = ESD_ТНОбщегоНазначенияСервер
		.ESD_ЗагрузитьНастройкиОбъекта("ИспользоватьТабельныйНомер", , "");
КонецПроцедуры

&НаСервере
Процедура ОбновитьВсеОтветственныеЛица() Экспорт
	
	ОбновитьОтветственноеЛицо("МедосмотрВыезд");
	ОбновитьОтветственноеЛицо("МедосмотрЗаезд");
	ОбновитьОтветственноеЛицо("Техосмотр");
	ОбновитьОтветственноеЛицо("ОдометрВыезд");
	ОбновитьОтветственноеЛицо("ОдометрЗаезд");
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВсеОрганизации()
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	
	ЭтаФорма.ОрганизацияСтрокой = МодульТНОбщегоНазначенияКлиентСервер.ПредставлениеЮрЛицаПоРоли(
		Объект.ДанныеЮрЛиц, "Оформитель");
	ЭтаФорма.ДоРейса_ОрганизацияСтрокой = МодульТНОбщегоНазначенияКлиентСервер.ПредставлениеЮрЛицаПоРоли(
		Объект.ДанныеЮрЛиц, "МедосмотрВыезд");
	ЭтаФорма.ПослеРейса_ОрганизацияСтрокой = МодульТНОбщегоНазначенияКлиентСервер.ПредставлениеЮрЛицаПоРоли(
		Объект.ДанныеЮрЛиц, "МедосмотрЗаезд");
	
КонецПроцедуры

#Область ОбработкаОповещений

&НаКлиенте
Процедура ОбработатьОповещениеОбновитьДокумент(Параметр) Экспорт
	Подключаемый_ОбработкаОповещений_ОбновитьДокумент(Параметр);	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОповещениеВыполнитьПереходНаФорме(ПараметрыПерехода = Неопределено) Экспорт
	
	ОбменДаннымиЭПЛ("ОбновитьАктивныйЭтап");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОповещениеЗавершениеВыполнитьДействиеНаФорме(Параметр) Экспорт
	
	ОбменДаннымиЭПЛ("ОбновитьАктивныйЭтап");
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОбновленияДанныхТранспортныхСредств(Результат, ДополнительныеПараметры) Экспорт
		
	МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер").ОбновитьТранспортныеСредстваНаФорме(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаДанныхОтветственного(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗакрытия = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Роль", РезультатЗакрытия.Роль);
	
	НайденныеСтроки = Объект.ОтветственныеЛица.НайтиСтроки(Отбор);
	Если НайденныеСтроки.Количество() Тогда
		Строка = НайденныеСтроки[0];
	Иначе
		Строка = Объект.ОтветственныеЛица.Добавить();
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Строка, РезультатЗакрытия);
	
	Если Не ЗначениеЗаполнено(Строка.Фамилия) И Не ЗначениеЗаполнено(Строка.Имя) И Не ЗначениеЗаполнено(Строка.Отчество) Тогда
		Объект.ОтветственныеЛица.Удалить(Строка);
	КонецЕсли;
	
	ОбновитьОтветственноеЛицо(РезультатЗакрытия.Роль, , РезультатЗакрытия);
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти // ОбработкаОповещений

&НаКлиенте
Процедура ОбменДаннымиЭПЛ(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	ДополнительныеПараметрыОбмена = Новый Структура;
	ДополнительныеПараметрыОбмена.Вставить("ДвоичныеДанныеОбработки", Неопределено);
	
	ИмяКоманды      = Результат;
	ЭтапДляПерехода = Неопределено;
	Если ДополнительныеПараметры <> Неопределено Тогда 
		
		Если ДополнительныеПараметры.Свойство("ИмяКоманды") Тогда
			ИмяКоманды = ДополнительныеПараметры.ИмяКоманды;
		КонецЕсли;
		
		Если ДополнительныеПараметры.Свойство("ЭтапДляПерехода") Тогда
			ЭтапДляПерехода = ДополнительныеПараметры.ЭтапДляПерехода;
		КонецЕсли;
		
	КонецЕсли;
	
	ДополнительныеПараметрыОбмена.Вставить("ЭтапДляПерехода", ЭтапДляПерехода);
	
	МодульESD_КлиентСервер = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер");
	
	ДанныеДляОбработки = Новый Массив;
	Если ИмяКоманды = "ВыгрузитьВСбис" Тогда
		
		ПараметрыВыгрузки = МодульESD_КлиентСервер.ПараметрыВыгрузки(Объект.Ссылка);
		Если ЭтапДляПерехода <> Неопределено Тогда
			ПараметрыВыгрузки.Этап = ЭтапДляПерехода.Наименование;
		КонецЕсли;
		ДанныеДляОбработки.Добавить(ПараметрыВыгрузки);
		
	Иначе
		
		ПараметрыЗагрузки = МодульESD_КлиентСервер.ПараметрыЗагрузки(Объект.Ссылка);
		ПараметрыЗагрузки.ИзДокумента   = Истина;
		ПараметрыЗагрузки.ИмяМетаданных = ПутевойЛист();
		
		Если ИмяКоманды = "ОбновитьАктивныйЭтап" Тогда
			ПараметрыЗагрузки.ТекущийТитул = АктивныйЭтапСтрокой;
			ПараметрыЗагрузки.ТолькоАктивныйЭтап = Истина;
		КонецЕсли;
		
		ДанныеДляОбработки.Добавить(ПараметрыЗагрузки);
		
	КонецЕсли;
	
	МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиент").ВыполнитьКомандуСбис(
		ЭтаФорма,
		ИмяКоманды,
		ДанныеДляОбработки,
		ДополнительныеПараметрыОбмена);
		
КонецПроцедуры

