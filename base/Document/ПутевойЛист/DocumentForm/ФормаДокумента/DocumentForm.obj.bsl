&НаКлиенте
Функция ЭтапДляПерехода(Титул)
		
	Отбор = Новый Структура;
	Отбор.Вставить("Наименование", Титул);
	
	НайденныеСтроки = Объект.ТекущиеЭтапы.НайтиСтроки(Отбор);
	Если НайденныеСтроки.Количество() Тогда
		
		КолонкиИсключения = Новый Массив;
		КолонкиИсключения.Добавить("НомерСтроки");
		
		ЭтапПерехода = Новый Структура("Наименование, Идентификатор");
		ЗаполнитьЗначенияСвойств(ЭтапПерехода, НайденныеСтроки[0]);
		
	Иначе
		ЭтапПерехода = Неопределено;
	КонецЕсли;
	
	Возврат ЭтапПерехода;
	
КонецФункции

&НаКлиенте
Процедура ПечатьДокументаQrКода(Команда, ВыборПечатнойФормы = Ложь) Экспорт
	
	ФормаОбъект = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер").ФормаОбъект(ЭтаФорма);
	
	// BSLLS:DeprecatedCurrentDate-off
	ТекущаяДатаКлиента = ТекущаяДата();
	// BSLLS:DeprecatedCurrentDate-on
	
	Если Команда.Имя = "QRКод" И КонецДня(ФормаОбъект.ДатаОкончанияИсполнения) < ТекущаяДатаКлиента Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "QR-код не действителен после исполнения путевого листа.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	ЗаголовокПечатнойФормы = "Путевой лист №%1 от %2";
	ЗаголовокПечатнойФормы = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер").СтрШаблонЭПД(
		ЗаголовокПечатнойФормы, ФормаОбъект.Номер, Формат(ФормаОбъект.Дата, "ДФ=dd.MM.yyyy"));
	
	МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиент").ПечатьДокумента(ЭтаФорма, Команда.Имя, ЗаголовокПечатнойФормы,,ВыборПечатнойФормы);

КонецПроцедуры

