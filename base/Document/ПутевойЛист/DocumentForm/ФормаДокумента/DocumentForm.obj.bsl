&НаСервере
Функция ЗаполнениеНаОснованииINI() Экспорт
	
	ОбъектДокумента = РеквизитФормыВЗначение("Объект");
	
	Результат = МодульКода("ESD_ТНОбщегоНазначенияСервер").ЗаполнитьНаОснованииINI(
		ОбъектДокумента, ДокументОснование, ПутевойЛист());
	Если ЗначениеЗаполнено(Результат) Тогда
		ЭтаФорма.Прочитать();
	КонецЕсли;
	
