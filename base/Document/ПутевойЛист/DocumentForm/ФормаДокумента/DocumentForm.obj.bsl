&НаКлиенте
Процедура ПриИзмененииВидаМедицинскогоРаботника(РольСтрокой, ВидМедосмотра)
	МодульТНОбщегоНазначенияКлиентСервер = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер");
	
	// Удалим данные ответственного лица из ТЧ
	МодульТНОбщегоНазначенияКлиентСервер.УдалитьСтрокиПоРоли(Объект.ОтветственныеЛица, РольСтрокой, Истина);
	// Обновим ответственное лицо
	ОбновитьОтветственноеЛицо(РольСтрокой);
	
	// По умолчанию установим в организации "Другая организация"
	Объект[ВидМедосмотра + "_МедицинскаяОрганизация"] = Неопределено;
	// Обработаем изменение медицинской организации
	ПриИзмененииСтороннейОрганизации(РольСтрокой, ВидМедосмотра);	
КонецПроцедуры 

&НаКлиенте
Процедура ПриИзмененииСтороннейОрганизации(РольСтрокой, ВидМедосмотра) 
	МодульТНОбщегоНазначенияКлиентСервер = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер");
	// Удалим текущие данные организации из ТЧ по роли
	МодульТНОбщегоНазначенияКлиентСервер.УдалитьСтрокиПоРоли(Объект.ДанныеЮрЛиц, РольСтрокой);
	
	// Заполним строковое представление медицинской организации значением тумблера
	ТекущаяМедицинскаяОрганизация = Объект[ВидМедосмотра + "_МедицинскаяОрганизация"];
	Если Не ЗначениеЗаполнено(ТекущаяМедицинскаяОрганизация) Тогда
		ПредставлениеМедицинскойОрганизации = МодульТНОбщегоНазначенияКлиентСервер.ПредставлениеЮрЛицаПоРоли(
			Объект.ДанныеЮрЛиц, РольСтрокой);
	Иначе
		ПредставлениеМедицинскойОрганизации = ТекущаяМедицинскаяОрганизация;
	КонецЕсли;
	ЭтаФорма[ВидМедосмотра + "_ОрганизацияСтрокой"] = ПредставлениеМедицинскойОрганизации;
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииСозданииПослеЗаписиНаСервере() Экспорт
	ЗаполнитьРасчетныеРеквизиты();
	
	МодульТНОбщегоНазначенияСервер = МодульКода("ESD_ТНОбщегоНазначенияСервер");
	
	МодульТНОбщегоНазначенияСервер.ОбновитьЛенту(ЭтаФорма, Истина);
	
	МодульТНОбщегоНазначенияСервер.ОбновитьВнешнийВидЭлементовОшибок(ЭтаФорма);
	
	ОбновитьВидимостьИДоступностьЭлементов();
	
	ОбновитьВидимостьПоЭтапуИУчастнику();
	
	МодульТНОбщегоНазначенияСервер.УстановитьОтборТаблицыОтветственных(Элементы.Водители, "Водитель");
	
	Если ЭтоУниверсальноеРасширение() Тогда
		ЭтаФорма.АвтоЗаголовок = Не МодульТНОбщегоНазначенияСервер.ЭтоCF();
		Если Не ЭтаФорма.АвтоЗаголовок Тогда
			ЭтаФорма.Заголовок = МодульТНОбщегоНазначенияСервер.ПредставлениеДокумента(ЭтаФорма.Объект);
		КонецЕсли;
	КонецЕсли;
	
	ПриЧтенииСозданииПослеЗаписиНаСервереПереопределяемый();
КонецПроцедуры

