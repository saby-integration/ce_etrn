&НаКлиенте
Процедура НастройкаДокументовОснований(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ссылка",        Объект.Ссылка);
	ПараметрыФормы.Вставить("ТипМетаданных", "Документы");
	
	// ToDo: вынести в общие команды
	Префикс = "SABY";
	Если Найти(ЭтаФорма.ИмяФормы, "ESD") > 0 Тогда		
		Префикс = "ESD";
	КонецЕсли;
			
	ОткрытьФорму("ОбщаяФорма." + Префикс + "_ВыборТиповЭПД", ПараметрыФормы, ЭтаФорма);
		
КонецПроцедуры

