&НаКлиенте
Процедура ПослеРедактированияОтветственногоЛицаНаФорме(СтруктураОтветственногоЛица) Экспорт
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВодителя(Команда)
	
	РольВодитель = ЗначениеМетаданныхКлиент("ESD_РолиОтветственных.Водитель");
	
	Модуль_ТНКлиентСервер = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер");
	
	ОтборПоРоли  = Новый Структура;
	ОтборПоРоли.Вставить("Роль", РольВодитель);
	
	НайденныеСтроки             = Объект.ОтветственныеЛица.НайтиСтроки(ОтборПоРоли);
	КоличествоВодителей         = НайденныеСтроки.Количество();
	КоличествоВодителейМаксимум = 5;
	
	Если КоличествоВодителей = КоличествоВодителейМаксимум Тогда
		ТекстПредупреждения = Модуль_ТНКлиентСервер.СтрШаблонЭПД(
			"ru = 'Количество водителей в путевом листе не должно быть больше %1'", КоличествоВодителейМаксимум);
		ПоказатьПредупреждение(, Нстр(ТекстПредупреждения));
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = Объект.ОтветственныеЛица.Добавить();
	ИдентификаторСтроки = НоваяСтрока.ПолучитьИдентификатор();
	
	Элемент = Элементы.Водители;	
	Для Каждого СтруктураОтбора Из Элемент.ОтборСтрок Цикл
		НоваяСтрока[СтруктураОтбора.Ключ] = СтруктураОтбора.Значение;
	КонецЦикла;
	
	СтруктураОтветственного = Модуль_ТНКлиентСервер.СтруктураОтветственного(
		Объект.ОтветственныеЛица, "", ИдентификаторСтроки);
	
	ДобавитьДанныеОрганизации(СтруктураОтветственного);
	
	МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиент").НачатьРедактированиеОтветственногоЛица(
			ЭтаФорма, СтруктураОтветственного, "Водитель"); 
						
КонецПроцедуры

&НаКлиенте
Процедура ВодителиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	// временно оставляем для старого расширения ce_saby
	
	Если НоваяСтрока Тогда
		
		Для Каждого СтруктураОтбора Из Элемент.ОтборСтрок Цикл
			Элемент.ТекущиеДанные[СтруктураОтбора.Ключ] = СтруктураОтбора.Значение;
		КонецЦикла;
		
		СтруктураОтветственного = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер").СтруктураОтветственного(
			Объект.ОтветственныеЛица, "", Элемент.ТекущаяСтрока);
			
		ДобавитьДанныеОрганизации(СтруктураОтветственного);
			
		МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиент").НачатьРедактированиеОтветственногоЛица(
			ЭтаФорма, СтруктураОтветственного, "Водитель");
		
	КонецЕсли;
	
КонецПроцедуры

