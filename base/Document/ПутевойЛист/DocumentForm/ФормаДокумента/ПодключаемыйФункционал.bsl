&НаСервере
Функция Подключаемый_События_ДополнительныеПараметры()
	АльтернативныеНазвания_ = Новый Соответствие;
	Если Объект.ДоРейса_МедосмотрСторонняяОрганизация = Истина Тогда
		НазваниеСобытия_ = Строка(Перечисления.ESD_ТипТитулаЭПЛ.ПредрейсовыйМедосмотр);
		АльтернативноеНазвание_ = НазваниеСобытия_ 
			+ " (" + События_АльтернативноеНазвание_ПредрейсовыйМО() + ")";
		АльтернативныеНазвания_.Вставить(НРег(НазваниеСобытия_), АльтернативноеНазвание_);
	КонецЕсли;
	
	Если Объект.ПослерейсовыйМедосмотрТребуется И Объект.ПослеРейса_МедосмотрСторонняяОрганизация Тогда
		НазваниеСобытия_ = Строка(Перечисления.ESD_ТипТитулаЭПЛ.ПослерейсовыйМедосмотр);
		АльтернативноеНазвание_ = НазваниеСобытия_ 
			+ " (" + События_АльтернативноеНазвание_ПослерейсовыйМО() + ")";
		АльтернативныеНазвания_.Вставить(НРег(НазваниеСобытия_), АльтернативноеНазвание_);
	КонецЕсли;
	
	Возврат ESD_ОбщийФункционалКлиентСервер.События_ДополнительныеПараметры(АльтернативныеНазвания_);
КонецФункции

&НаСервере
Функция События_АльтернативноеНазвание_ПредрейсовыйМО()
	РезультатФункции = "";
	Если ЗначениеЗаполнено(Объект.ДоРейса_МедицинскаяОрганизация) Тогда
		РезультатФункции = Перечисления.ESD_МедицинскиеОрганизации
			.ПредставлениеПоЗначению(Объект.ДоРейса_МедицинскаяОрганизация);
	Иначе
		РезультатФункции = ЭтаФорма.ДоРейса_ОрганизацияСтрокой;
	КонецЕсли;
	
	Возврат РезультатФункции;
КонецФункции

&НаСервере
Функция События_АльтернативноеНазвание_ПослерейсовыйМО()
	РезультатФункции = "";
	Если ЗначениеЗаполнено(Объект.ПослеРейса_МедицинскаяОрганизация) Тогда
		РезультатФункции = Перечисления.ESD_МедицинскиеОрганизации
			.ПредставлениеПоЗначению(Объект.ПослеРейса_МедицинскаяОрганизация);
	Иначе
		РезультатФункции = ЭтаФорма.ПослеРейса_ОрганизацияСтрокой;
	КонецЕсли;
	
	Возврат РезультатФункции;
КонецФункции

&НаСервере
Функция Подключаемый_События_СлужебныеПараметры()
	Возврат ESD_ОбщийФункционалКлиентСервер.События_СлужебныеПараметры();
