Процедура ЗаполнитьРеквизитыДляФормыСписка()
	
	ЗаполнитьОтветственныхЛиц();
	
	ЭтотОбъект.Организация = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ДанныеЮрЛицаПоРоли(
		ЭтотОбъект.ДанныеЮрЛиц, "Оформитель").НаименованиеОрганизации;
	
КонецПроцедуры

Процедура ЗаполнитьОтветственныхЛиц()
	
	ЗаполнитьОтветственногоМедосмотр();
	
	РольВодитель = ЗначениеМетаданных("ESD_РолиОтветственных.Водитель");
	РольМеханик  = ЗначениеМетаданных("ESD_РолиОтветственных.Техосмотр");
	
	СтруктураОтветственных = Новый Структура;
	СтруктураОтветственных.Вставить("Водитель",  Новый Массив);
	СтруктураОтветственных.Вставить("Техосмотр", Новый Массив);
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");

	Для Каждого ОтветственноеЛицо Из ОтветственныеЛица Цикл		
		
		ПодходящаяРоль = (ОтветственноеЛицо.Роль = РольВодитель 
			Или ОтветственноеЛицо.Роль = РольМеханик);
		
		Если ПодходящаяРоль Тогда			
			
			РольСтрокой = СокрЛП(ОтветственноеЛицо.Роль);
			НаименованиеСтрокой = МодульТНОбщегоНазначенияКлиентСервер.ПредставлениеФИО(ОтветственноеЛицо);
			
			СтруктураОтветственных[РольСтрокой].Добавить(НаименованиеСтрокой);
			
		Иначе 		
			Продолжить;
		КонецЕсли;
		
	КонецЦикла;
	
	ЭтотОбъект.Водитель = МодульТНОбщегоНазначенияКлиентСервер.СтрСоединитьЭПД(СтруктураОтветственных.Водитель,  ",");
	ЭтотОбъект.Механик  = МодульТНОбщегоНазначенияКлиентСервер.СтрСоединитьЭПД(СтруктураОтветственных.Техосмотр, ",");
	
КонецПроцедуры

Процедура ЗаполнитьОтветственногоМедосмотр()
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	
	Если ЭтотОбъект.ДоРейса_МедосмотрСторонняяОрганизация Тогда
		Если ЗначениеЗаполнено(ЭтотОбъект.ДоРейса_МедицинскаяОрганизация) Тогда
			ЭтотОбъект.Медик = ЭтотОбъект.ДоРейса_МедицинскаяОрганизация;	
		Иначе	
			ЭтотОбъект.Медик = МодульТНОбщегоНазначенияКлиентСервер.ДанныеЮрЛицаПоРоли(
				ЭтотОбъект.ДанныеЮрЛиц, "МедосмотрВыезд").НаименованиеОрганизации;
		КонецЕсли;
	Иначе
		
		РольМедик = ЗначениеМетаданных("ESD_РолиОтветственных.МедосмотрВыезд");
		
		Отбор = Новый Структура;
		Отбор.Вставить("Роль", РольМедик);
		
		НайденныеСтроки = МодульТНОбщегоНазначенияКлиентСервер.НайтиСтрокиУниверсально(ЭтотОбъект.ОтветственныеЛица, Отбор);
		Если НайденныеСтроки.Количество() Тогда
			Значение = МодульТНОбщегоНазначенияКлиентСервер.ПредставлениеФИО(НайденныеСтроки[0]);
		Иначе 	
			Значение = "";
		КонецЕсли;	
		
		ЭтотОбъект.Медик = Значение;
		
	КонецЕсли;
		
КонецПроцедуры

#Область ЗаполнениеНаОснованииПутевогоЛиста

Процедура ЗаполнитьНаОснованииПутевогоЛиста(ДанныеЗаполнения)
		
	ДанныеСостояния = МодульКода("ESD_ТНОбщегоНазначенияСервер").ДанныеСостоянияОбъекта(ДанныеЗаполнения);		
	
	НеНайденыДанные = Не ЗначениеЗаполнено(ДанныеСостояния);						
	Если Не НеНайденыДанные Тогда
				
		Если МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ЕстьРеквизитИлиСвойство(ДанныеСостояния, "UID") Тогда 
			ИДСбис = ДанныеСостояния.UID;
		Иначе 
			ИДСбис = ДанныеСостояния.ИД;
		КонецЕсли;	
		
		ЭтотОбъект.ПЛПредыдущий = ИДСбис;
		
		НеНайденыДанные = Не ЗначениеЗаполнено(ИДСбис);
					
	КонецЕсли;	
		
	Если НеНайденыДанные Тогда
		ВызватьИсключение("Документ не найден в SABY! Проверьте данные авторизации и статус документа");
    КонецЕсли;
	
	ЗапросДанных = Новый Запрос;
	ЗапросДанных.Текст =
	"ВЫБРАТЬ
	|	ESD_ПутевойЛист.ВидПеревозки КАК ВидПеревозки,
	|	ESD_ПутевойЛист.ВидТранспортногоСообщения КАК ВидТранспортногоСообщения,
	|	ESD_ПутевойЛист.МестоОтправления КАК МестоОтправления,
	|	ESD_ПутевойЛист.ИнформацияДляВодителя КАК ИнформацияДляВодителя,
	|	ESD_ПутевойЛист.Организация КАК Организация,
	|	ЗНАЧЕНИЕ(Перечисление.ESD_ПризнакНачалаРейса.ПриемСдачаПослеСмены) КАК ПризнакНачалаРейса,
	|	ESD_ПутевойЛист.ПослерейсовыйМедосмотрТребуется КАК ПослерейсовыйМедосмотрТребуется,
	|	ESD_ПутевойЛист.ВидКоммерческойПеревозки КАК ВидКоммерческойПеревозки,
	|	ESD_ПутевойЛист.ДатаНачалаИсполнения КАК ДатаНачалаИсполнения,
	|	ESD_ПутевойЛист.ДатаОкончанияИсполнения КАК ДатаОкончанияИсполнения,
	|	ESD_ПутевойЛист.ДоРейса_МедосмотрСторонняяОрганизация КАК ДоРейса_МедосмотрСторонняяОрганизация,
	|	ESD_ПутевойЛист.ПослеРейса_МедосмотрСторонняяОрганизация КАК ПослеРейса_МедосмотрСторонняяОрганизация
	|ИЗ
