
#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
		
	ЭтотОбъект.ТранспортноеСредство_РегНомер = 
		МодульКода("ESD_ТНОбщегоНазначенияСервер").ТранспортныеСредстваСтрокой(ЭтотОбъект);
	
	ЗаполнитьРеквизитыДляФормыСписка();
	КонтактныеДанные_ПередЗаписью();
	
	МодульКода("ESD_ТНОбщегоНазначенияСервер").ESD_УстановитьНомерДокумента(ЭтотОбъект);
	
	Если Не ЗначениеЗаполнено(ЭтотОбъект.Направление) Тогда
		ЭтотОбъект.Направление = Метаданные().Реквизиты.Направление.ЗначениеЗаполнения;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("ТитулыДляПривязки") Тогда
		МодульКода("РегистрыСведений.ESD_ДанныеТитулов").ПривязатьТитулыКДокументу(
			Ссылка,
			ДополнительныеСвойства.ТитулыДляПривязки);
	КонецЕсли;
	
	МодульКода("ESD_ТНОбщегоНазначенияСервер").ПривязатьДокументОснование(
		Ссылка,
		ДокументОснование_ОбъектМетаданных,
		ДокументОснование_Идентификатор);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	РеквизитыДляОчистки = Новый Массив;
	
	// Служебные
	РеквизитыДляОчистки.Добавить("ПЛПредыдущий");
	РеквизитыДляОчистки.Добавить("ПЛСледующий");
	РеквизитыДляОчистки.Добавить("ДатаИзменения");
	РеквизитыДляОчистки.Добавить("НомерСбис");
	РеквизитыДляОчистки.Добавить("Комментарий");
	РеквизитыДляОчистки.Добавить("КомментарийУведомление");
	РеквизитыДляОчистки.Добавить("ТекущиеЭтапы");
	РеквизитыДляОчистки.Добавить("ДокументОснование_Идентификатор");
	РеквизитыДляОчистки.Добавить("ДокументОснование_ОбъектМетаданных");
	РеквизитыДляОчистки.Добавить("Направление");
	РеквизитыДляОчистки.Добавить("ГИС_УИД");
	
	// Предрейсовый МО
	РеквизитыДляОчистки.Добавить("ДоРейса_ДатаВремяМедосмотра");
	РеквизитыДляОчистки.Добавить("ДоРейса_КомментарииМедосмотра");
	РеквизитыДляОчистки.Добавить("ДоРейса_НеДопущенПослеМедосмотра");
	
	// ТО
	РеквизитыДляОчистки.Добавить("ТО_ДатаВремя");
	РеквизитыДляОчистки.Добавить("ТО_ДатаВремяВыпускаВРейс");
	РеквизитыДляОчистки.Добавить("ТО_Комментарий");
	РеквизитыДляОчистки.Добавить("ТО_НеРазрешенВыпускПосле");
	
	// Выезд
	РеквизитыДляОчистки.Добавить("Выезд_ДатаВремя");
	РеквизитыДляОчистки.Добавить("Выезд_Одометр");
	РеквизитыДляОчистки.Добавить("Выезд_ОдометрКомментарии");
	
	// Заезд
	РеквизитыДляОчистки.Добавить("Заезд_ДатаВремя");
	РеквизитыДляОчистки.Добавить("Заезд_Одометр");
	РеквизитыДляОчистки.Добавить("Заезд_ОдометрКомментарии");

	МодульКода("ESD_ТНОбщегоНазначенияСервер").ОчисткаРеквизитовОбъекта(ЭтотОбъект, РеквизитыДляОчистки);
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	
	// Записи по ответственным
	Если ДоРейса_МедосмотрСторонняяОрганизация Тогда
		МодульТНОбщегоНазначенияКлиентСервер.УдалитьСтрокиПоРоли(ЭтотОбъект.ОтветственныеЛица, "МедосмотрВыезд", Истина);		
	КонецЕсли;	
		
	Если ПослеРейса_МедосмотрСторонняяОрганизация Тогда
		МодульТНОбщегоНазначенияКлиентСервер.УдалитьСтрокиПоРоли(ЭтотОбъект.ОтветственныеЛица, "МедосмотрЗаезд", Истина);
	КонецЕсли;	
	
	// Установим дефолтные значения
	ЭтотОбъект.ПризнакНачалаРейса = ЗначениеМетаданных("ESD_ПризнакНачалаРейса.ВыездСПарковки");
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	ТипЗначенияЗаполнения = ТипЗнч(ДанныеЗаполнения);
	
	Если ТипЗначенияЗаполнения = Тип("Структура") Тогда
		Если ДанныеЗаполнения.Свойство("НовыйРедактор") Тогда
			МодульКода("ESD_ТНОбщегоНазначенияСервер").ЗаполнитьНаОснованииИспользуяНастройкиСопоставления(ЭтотОбъект, ДанныеЗаполнения);
		КонецЕсли;
	ИначеЕсли ТипЗначенияЗаполнения = Тип("ДокументСсылка." + ПутевойЛист()) Тогда
		ЗаполнитьНаОснованииПутевогоЛиста(ДанныеЗаполнения);
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	
	Префикс = "00";
	
КонецПроцедуры

#КонецОбласти // ОбработчикиСобытий 

#Область СлужебныйПрограммныйИнтерфейс

Функция ПризнакиДокумента() Экспорт
	
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("Этапы",     Новый Структура);
	РезультатФункции.Вставить("Исходящий", Направление = ЗначениеМетаданных("ESD_Направление.Исходящий"));
	
	РезультатФункции.Вставить("ЭтоЗаменаВодителя", ЗначениеЗаполнено(ПЛПредыдущий));
	
	МодульТНОбщегоНазначенияСервер = МодульКода("ESD_ТНОбщегоНазначенияСервер");
	
	ТипыТитулов = МодульТНОбщегоНазначенияСервер.ВсеЗначенияПеречисления(ТипТитулаЭПЛ());
	
	ДанныеЭтапа = МодульТНОбщегоНазначенияСервер.АктивныйЭтапДокумента(Ссылка);
	
	ДОЗавершен = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ДокументооборотЗавершен(ДанныеЭтапа.ИндексКартинки);
	
	ЭмуляцияФормы = Новый Структура();
	ЭмуляцияФормы.Вставить("ИмяФормы",       "Форма." + ПутевойЛист());
	ЭмуляцияФормы.Вставить("ИндексКартинки", ДанныеЭтапа.ИндексКартинки);
	ВыпускДоступен = МодульТНОбщегоНазначенияСервер.ТипТитулаДоступенУчастнику(
		ЭмуляцияФормы,
		ТекущиеЭтапы,
		ТипыТитулов["Выпуск"],
		ДОЗавершен);
		
	РезультатФункции.Этапы.Вставить("ВыпускДоступен", ВыпускДоступен);
	
	ПредрейсовыйМедосмотрДоступен = МодульТНОбщегоНазначенияСервер.ТипТитулаДоступенУчастнику(
		ЭмуляцияФормы,
		ТекущиеЭтапы,
		ТипыТитулов["ПредрейсовыйМедосмотр"],
		ДОЗавершен);
	
	РезультатФункции.Этапы.Вставить("ПредрейсовыйМедосмотрДоступен", ПредрейсовыйМедосмотрДоступен Или ВыпускДоступен);
	
	ПредрейсовыйТехосмотрДоступен = МодульТНОбщегоНазначенияСервер.ТипТитулаДоступенУчастнику(
		ЭмуляцияФормы,
		ТекущиеЭтапы,
		ТипыТитулов["ПредрейсовыйТехосмотр"],
		ДОЗавершен);
		
	РезультатФункции.Этапы.Вставить("ПредрейсовыйТехосмотрДоступен", ПредрейсовыйТехосмотрДоступен Или ВыпускДоступен);
	
	ВыпускающийДоступен = МодульТНОбщегоНазначенияСервер.ТипТитулаДоступенУчастнику(
		ЭмуляцияФормы,
		ТекущиеЭтапы,
		ТипыТитулов["Выпускающий"],
		ДОЗавершен);
		
	РезультатФункции.Этапы.Вставить("ВыпускающийДоступен", ВыпускающийДоступен Или ВыпускДоступен);
	
	ПринимающийДоступен = МодульТНОбщегоНазначенияСервер.ТипТитулаДоступенУчастнику(
		ЭмуляцияФормы,
		ТекущиеЭтапы,
		ТипыТитулов["Принимающий"],
		ДОЗавершен);
		
	РезультатФункции.Этапы.Вставить("ТекущийЭтапПринимающий", ПринимающийДоступен);
		
	РезультатФункции.Этапы.Вставить("ПринимающийДоступен", ПринимающийДоступен Или ВыпускДоступен);
	
	ПослерейсовыйМедосмотрДоступен = МодульТНОбщегоНазначенияСервер.ТипТитулаДоступенУчастнику(
		ЭмуляцияФормы,
		ТекущиеЭтапы,
		ТипыТитулов["ПослерейсовыйМедосмотр"],
		ДОЗавершен);
		
	РезультатФункции.Этапы.Вставить("ПослерейсовыйМедосмотрДоступен", ПослерейсовыйМедосмотрДоступен Или ВыпускДоступен);
	
	РезультатФункции.Этапы.Вставить("ДОЗавершен", ДОЗавершен);
	
	Если РезультатФункции.Этапы.ВыпускДоступен Тогда
		ПорядковыйНомер = 9;
	ИначеЕсли РезультатФункции.Этапы.ПредрейсовыйМедосмотрДоступен Тогда
		ПорядковыйНомер = 2;
	ИначеЕсли РезультатФункции.Этапы.ПредрейсовыйТехосмотрДоступен Тогда
		ПорядковыйНомер = 3;
	ИначеЕсли РезультатФункции.Этапы.ВыпускающийДоступен Тогда
		ПорядковыйНомер = 4;
	ИначеЕсли РезультатФункции.Этапы.ПринимающийДоступен Тогда
		ПорядковыйНомер = 5;
	ИначеЕсли РезультатФункции.Этапы.ПослерейсовыйМедосмотрДоступен Тогда
		ПорядковыйНомер = 6;
	ИначеЕсли ДОЗавершен Тогда
		ПорядковыйНомер = 7;
	Иначе
		ПорядковыйНомер = 8;
	КонецЕсли;
	
	РезультатФункции.Этапы.Вставить("Номер", ПорядковыйНомер);
	
	Возврат РезультатФункции;
	
КонецФункции

Функция РезультатПроверкиДоступностиЗаменыВодителя(ПризнакиДокумента = Неопределено) Экспорт
	
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("ОК",             Истина);
	РезультатФункции.Вставить("ОписаниеОшибки", "");
	
	Признаки = ПризнакиДокумента;
	Если Признаки = Неопределено Тогда
		Признаки = ПризнакиДокумента();
	КонецЕсли;
	
	Если Признаки.Этапы.ДОЗавершен Тогда
		РезультатФункции.ОК = Ложь;
		РезультатФункции.ОписаниеОшибки = "Документооборот по данному документу завершен.";
	ИначеЕсли Не Признаки.Этапы.ТекущийЭтапПринимающий Тогда
		РезультатФункции.ОК = Ложь;
		РезультатФункции.ОписаниеОшибки = "Замена водителя доступна только на этапе приемки.";
	Иначе
		РезультатФункции.ОК = Истина;
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

#КонецОбласти // СлужебныйПрограммныйИнтерфейс

