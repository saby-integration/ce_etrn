	|ГДЕ
	|	ESD_ПутевойЛистДанныеЮрЛиц.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	""КонтактныеДанные"" КАК ИмяТабличнойЧасти,
	|	ESD_ПутевойЛистКонтактныеДанные.НомерСтроки КАК НомерСтроки,
	|	ESD_ПутевойЛистКонтактныеДанные.Роль КАК Роль,
	|	ESD_ПутевойЛистКонтактныеДанные.Тип КАК Тип,
	|	ESD_ПутевойЛистКонтактныеДанные.Значение КАК Значение,
	|	ESD_ПутевойЛистКонтактныеДанные.Структура КАК Структура,
	|	ESD_ПутевойЛистКонтактныеДанные.КлючСтроки_ДанныеЮрЛиц КАК КлючСтроки_ДанныеЮрЛиц
	|ИЗ
	|	Документ.ESD_ПутевойЛист.КонтактныеДанные КАК ESD_ПутевойЛистКонтактныеДанные
	|ГДЕ
	|	ESD_ПутевойЛистКонтактныеДанные.Ссылка = &Ссылка";
	
	ЗапросДанных.Текст = СтрЗаменить(ЗапросДанных.Текст, "ESD_ПутевойЛист", ПутевойЛист());
	ЗапросДанных.Текст = СтрЗаменить(ЗапросДанных.Текст, "ESD_ПризнакНачалаРейса", ПризнакНачалаРейса());
	
	ЗапросДанных.УстановитьПараметр("Ссылка",        ДанныеЗаполнения);
	ЗапросДанных.УстановитьПараметр("РольТехосмотр", ЗначениеМетаданных("ESD_РолиОтветственных.Техосмотр"));
	ЗапросДанных.УстановитьПараметр("РольВодитель",  ЗначениеМетаданных("ESD_РолиОтветственных.Водитель"));
	
	Результат = ЗапросДанных.ВыполнитьПакет();
	ВыборкаРеквизитов = Результат[0].Выбрать();
	
	Если ВыборкаРеквизитов.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ВыборкаРеквизитов);
	КонецЕсли;
	
	Для Индекс = 1 По Результат.ВГраница() Цикл
		
		ВыборкаТабличнойЧасти = Результат[Индекс].Выбрать();
		
		Пока ВыборкаТабличнойЧасти.Следующий() Цикл
			
			СтрокаТабличнойЧасти = ЭтотОбъект[ВыборкаТабличнойЧасти.ИмяТабличнойЧасти].Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, ВыборкаТабличнойЧасти);
			
		КонецЦикла;
		
	КонецЦикла;
	
	ЭтотОбъект.ДокументОснование_Идентификатор    = ДанныеЗаполнения.УникальныйИдентификатор();
	ЭтотОбъект.ДокументОснование_ОбъектМетаданных = МодульКода("ESD_ТНОбщегоНазначенияСервер").ИмяМетаданныхДокумента(
		ДанныеЗаполнения);
				
КонецПроцедуры

#КонецОбласти // ЗаполнениеНаОснованииПутевогоЛиста

#Область ЗаполнениеНаОснованииИспользуяНастройкиСопоставления

Функция ДоступныеПоляПоЭтапу(ТипТитула) Экспорт
	
	// Для первого титула фильтр не выполняется, так как по умолчанию на первом этапе можем заполнить все реквизиты.
	
	РезультатФункции = Новый Соответствие;
	ДобавитьДоступныеПоляПредрейсовогоМедосмотра(РезультатФункции, ТипТитула);
	ДобавитьДоступныеПоляПредрейсовогоТехосмотра(РезультатФункции, ТипТитула);
	ДобавитьДоступныеПоляВыпускающего(РезультатФункции, ТипТитула);
	ДобавитьДоступныеПоляПринимающего(РезультатФункции, ТипТитула);
	ДобавитьДоступныеПоляПослерейсовогоМедосмотра(РезультатФункции, ТипТитула);
	
	Возврат РезультатФункции;
	
КонецФункции

Процедура ДобавитьДоступныеПоляПредрейсовогоМедосмотра(ДоступныеПоля, ТипТитула)
	
	Если ТипТитула <> Перечисления.ESD_ТипТитулаЭПЛ.ПредрейсовыйМедосмотр Тогда
		Возврат;
	КонецЕсли;
	
	ДоступныеПоля.Вставить("ДоРейса_ДатаВремяМедосмотра",           Истина);
	ДоступныеПоля.Вставить("ДоРейса_КомментарииМедосмотра",         Истина);
	ДоступныеПоля.Вставить("ДоРейса_НеДопущенПослеМедосмотра",      Истина);
	ДоступныеПоля.Вставить("ДоРейса_МедосмотрСторонняяОрганизация", Истина);
	ДоступныеПоля.Вставить("Ответственный_МедосмотрВыезд",          Истина);
	ДоступныеПоля.Вставить("МедосмотрВыезд",                        Истина);
	
КонецПроцедуры

Процедура ДобавитьДоступныеПоляПредрейсовогоТехосмотра(ДоступныеПоля, ТипТитула)
	
	Если ТипТитула <> Перечисления.ESD_ТипТитулаЭПЛ.ПредрейсовыйТехосмотр Тогда
		Возврат;
	КонецЕсли;
	
	ДоступныеПоля.Вставить("Ответственный_Техосмотр",  Истина);
	ДоступныеПоля.Вставить("ТО_НеРазрешенВыпускПосле", Истина);
	ДоступныеПоля.Вставить("ТО_Комментарий",           Истина);
	ДоступныеПоля.Вставить("ТО_ДатаВремяВыпускаВРейс", Истина);
	ДоступныеПоля.Вставить("ТО_ДатаВремя",             Истина);
	
КонецПроцедуры

Процедура ДобавитьДоступныеПоляВыпускающего(ДоступныеПоля, ТипТитула)
	
	Если ТипТитула <> Перечисления.ESD_ТипТитулаЭПЛ.Выпускающий Тогда
		Возврат;
	КонецЕсли;
	
	ДоступныеПоля.Вставить("Ответственный_ОдометрВыезд", Истина);
	ДоступныеПоля.Вставить("Выезд_Одометр",              Истина);
	ДоступныеПоля.Вставить("Выезд_ДатаВремя",            Истина);
	ДоступныеПоля.Вставить("Выезд_ОдометрКомментарии",   Истина);
	
	ДоступныеПоля.Вставить("Ответственный_ОдометрЗаезд", Истина);
	
КонецПроцедуры

Процедура ДобавитьДоступныеПоляПринимающего(ДоступныеПоля, ТипТитула)
	
	Если ТипТитула <> Перечисления.ESD_ТипТитулаЭПЛ.Принимающий Тогда
		Возврат;
	КонецЕсли;
	
	ДоступныеПоля.Вставить("Ответственный_ОдометрЗаезд", Истина);
	ДоступныеПоля.Вставить("Заезд_Одометр",              Истина);
	ДоступныеПоля.Вставить("Заезд_ОдометрКомментарии",   Истина);
	ДоступныеПоля.Вставить("Заезд_ДатаВремя",            Истина);
	
КонецПроцедуры

Процедура ДобавитьДоступныеПоляПослерейсовогоМедосмотра(ДоступныеПоля, ТипТитула)
	
	Если ТипТитула <> Перечисления.ESD_ТипТитулаЭПЛ.ПослерейсовыйМедосмотр Тогда
		Возврат;
	КонецЕсли;
	
	ДоступныеПоля.Вставить("ПослерейсовыйМедосмотрТребуется",          Истина);
	ДоступныеПоля.Вставить("ПослеРейса_КомментарииМедосмотра",         Истина);
	ДоступныеПоля.Вставить("МедосмотрЗаезд",                           Истина);
	ДоступныеПоля.Вставить("ПослеРейса_ДатаВремяМедосмотра",           Истина);
	ДоступныеПоля.Вставить("ПослеРейса_МедосмотрСторонняяОрганизация", Истина);
	ДоступныеПоля.Вставить("Ответственный_МедосмотрЗаезд",             Истина);
	
КонецПроцедуры

Процедура ЗаполнитьНаОснованииРасчетаСопоставлений(РезультатРасчетаПолей, ТипТитула, ПервоеОснование) Экспорт
	
	МодульТНОбщегоНазначенияСервер = МодульКода("ESD_ТНОбщегоНазначенияСервер");
	
	МодульТНОбщегоНазначенияСервер.ЗаполнитьСсылкиНаОбъекты(РезультатРасчетаПолей);
	
	МодульТНОбщегоНазначенияСервер.ЗаполнитьРеквизитыОбъекта(ЭтотОбъект, РезультатРасчетаПолей, ПервоеОснование);
	
	МассивЮрЛиц = Новый Массив;
	МассивЮрЛиц.Добавить("Оформитель");
	МассивЮрЛиц.Добавить("МедосмотрВыезд");
	МассивЮрЛиц.Добавить("МедосмотрЗаезд");
	МодульТНОбщегоНазначенияСервер.ЗаполнитьДанныеЮрЛиц(ЭтотОбъект, РезультатРасчетаПолей, МассивЮрЛиц);
	
	МассивОтветственных = Новый Массив;
	МассивОтветственных.Добавить("Ответственный_МедосмотрВыезд");
	МассивОтветственных.Добавить("Ответственный_МедосмотрЗаезд");
	МассивОтветственных.Добавить("Ответственный_Техосмотр");
	МассивОтветственных.Добавить("Ответственный_ОдометрВыезд");
	МассивОтветственных.Добавить("Ответственный_ОдометрЗаезд");
	МодульТНОбщегоНазначенияСервер.ЗаполнитьОтветственных(ЭтотОбъект, РезультатРасчетаПолей, МассивОтветственных);
	
	МодульТНОбщегоНазначенияСервер.ЗаполнитьТранспортныеСредства(ЭтотОбъект, РезультатРасчетаПолей);
	
	МодульТНОбщегоНазначенияСервер.ЗаполнитьВодителей(ЭтотОбъект, РезультатРасчетаПолей);
	
	ЗаполнитьАдресаПунктовВыгрузки(РезультатРасчетаПолей);
	
КонецПроцедуры

Процедура ЗаполнитьАдресаПунктовВыгрузки(РезультатРасчетаПолей)
	
	ДанныеАдресовПунктовВыгрузки = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ЗначениеИзКоллекции(
		РезультатРасчетаПолей, "АдресаПунктовВыгрузки", Новый Массив);
	Для Каждого ДанныеАдресаПунктаВыгрузки Из ДанныеАдресовПунктовВыгрузки Цикл
		СтрокаАдреса = АдресаПунктовВыгрузки.Добавить();
		МодульКода("ESD_ТНОбщегоНазначенияСервер").ЗаполнитьЗначенияИзСоответствия(СтрокаАдреса, ДанныеАдресаПунктаВыгрузки);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти // ЗаполнениеНаОснованииИспользуяНастройкиСопоставления

