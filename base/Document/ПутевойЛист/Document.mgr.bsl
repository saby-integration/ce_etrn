		Ответственный = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ДанныеСоответствия(Вложение, "Приемка.Ответственный");
		
		ОтветственныеЗаПрием = Новый Массив;
		СтруктураПринимающего = Новый Структура;
		МодульКода("ESD_ТНЗагрузкаСервер").ЗагрузитьОтветственного(СтруктураПринимающего, Ответственный);
		СтруктураПринимающего.Вставить("Роль", ЗначениеМетаданных("ESD_РолиОтветственных.ОдометрЗаезд"));
		ОтветственныеЗаПрием.Добавить(СтруктураПринимающего);
		ДляДокумента.Вставить("ОтветственныеЗаПрием", ОтветственныеЗаПрием);
		
		ДляРегистра = СтруктураДанныхДляРегистра(ОбъектДок, Вложение, Титул, ДопПараметры.ИмяМетаданных);
		
		РезультатФункции.Добавить(МодульКода("ESD_ТНЗагрузкаСервер").СтруктураТитула(Титул, ДляДокумента, ДляРегистра));
		
	КонецЦикла;
	
	Возврат РезультатФункции;
	
КонецФункции
	
Функция ДанныеПослерейсовыйМедосмотр(ОбъектДок, Вложения, Титул, ДопПараметры)
	
