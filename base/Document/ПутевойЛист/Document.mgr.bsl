КонецФункции

Процедура ДополнитьПроверяемыеРеквизитыЭтапаВыпуск(ДанныеДокумента, ПроверяемыеРеквизиты)
	
	ПроверяемыеРеквизиты.Добавить(ФЛК("Оформитель", "ОрганизацияСтрокой", "Не заполнен оформитель документа"));
	ПроверяемыеРеквизиты.Добавить(ФЛК("ДанныеЮрЛиц.ИНН", "ОрганизацияСтрокой", "Не заполнен ИНН организации"));
	
	ПрицепыРегистрационныйНомер = "ПрицепыРегистрационныйНомер";
	
	ПроверяемыеРеквизиты.Добавить(
		ФЛК("ТранспортныеСредства.РегистрационныйНомер", ПрицепыРегистрационныйНомер, "Не заполнен регистрационный номер"));
	ПроверяемыеРеквизиты.Добавить(ФЛК("ТранспортныеСредства.Тип", ПрицепыРегистрационныйНомер, "Не заполнен тип"));
	ПроверяемыеРеквизиты.Добавить(ФЛК("ТранспортныеСредства.Марка", "ПрицепыМарка", "Не заполнена марка"));
	ПроверяемыеРеквизиты.Добавить(ФЛК("ТранспортныеСредства.Модель", "ПрицепыМодель", "Не заполнена модель"));
	ПроверяемыеРеквизиты.Добавить(
		ФЛК("ТранспортныеСредства.ИнвентарныйНомер", ПрицепыРегистрационныйНомер, "Не заполнен инвентарный номер"));
		
	ВодителиФИО = "ВодителиФИО";
	ВодителиВУ  = "ВодителиВУ";
	
	ПроверяемыеРеквизиты.Добавить(ФЛК("Водители",         "Водители",    "В списке водителей не введено ни одной строки"));
	ПроверяемыеРеквизиты.Добавить(ФЛК("Водители.Фамилия", ВодителиФИО,   "Не заполнена фамилия водителя"));
	ПроверяемыеРеквизиты.Добавить(ФЛК("Водители.Имя",     ВодителиФИО,   "Не заполнено имя водителя")); 
	ПроверяемыеРеквизиты.Добавить(ФЛК("Водители.Серия",   ВодителиВУ,    "Не заполнена серия водительского удостоверения"));
	ПроверяемыеРеквизиты.Добавить(ФЛК("Водители.Номер",   ВодителиВУ,    "Не заполнена номер водительского удостоверения"));	
	ПроверяемыеРеквизиты.Добавить(
		ФЛК("Водители.ДатаВыдачи", ВодителиВУ, "Не заполнена дата выдачи водительского удостоверения"));
		
	// СНИЛС	
	ИспользоватьСНИЛС = ХранилищеОбщихНастроек.Загрузить("Saby", "ИспользоватьСНИЛС");
	Если ИспользоватьСНИЛС = Истина Тогда
		ПроверяемыеРеквизиты.Добавить(ФЛК("Водители.СНИЛС", "ВодителиСНИЛС", "Не заполнен СНИЛС водителя"));
	КонецЕсли;	
	
	ПроверяемыеРеквизиты.Добавить(
		ФЛК("ДатаНачалаИсполнения", "ДатаНачалаИсполнения", "Не заполнена дата начала исполнения путевого листа"));
	ПроверяемыеРеквизиты.Добавить(
		ФЛК("ДатаОкончанияИсполнения", "ДатаОкончанияИсполнения", "Не заполнена дата окончания исполнения путевого листа"));
	ПроверяемыеРеквизиты.Добавить(ФЛК("ПризнакНачалаРейса", "ПризнакНачалаРейса", "Не заполнен признак начала рейса"));
	ПроверяемыеРеквизиты.Добавить(ФЛК("ВидПеревозки", "ВидПеревозки", "Не заполнен вид перевозки"));
	
	Если ДанныеДокумента.ВидПеревозки = ЗначениеМетаданных("ESD_ВидПеревозки.КоммерческиеПеревозки") Тогда
		ПроверяемыеРеквизиты.Добавить(
			ФЛК("ВидКоммерческойПеревозки", "ВидКоммерческойПеревозки", "Не заполнен вид коммерческой перевозки"));
	КонецЕсли;
	
	ПроверяемыеРеквизиты.Добавить(
		ФЛК("ВидТранспортногоСообщения", "ВидТранспортногоСообщения", "Не заполнен вид транспортного сообщения"));
	ПроверяемыеРеквизиты.Добавить(ФЛК("МестоОтправления", "ДекорацияЗаполнитьМестоОтправления", "Не заполнено место отправления"));
	
	ВидПеревозкаГрузов = ЗначениеМетаданных("ESD_ВидКоммерческойПеревозки.ПеревозкаНаОснованииДоговораПеревозки");
	
	Если ДанныеДокумента.ВидКоммерческойПеревозки = ВидПеревозкаГрузов Тогда
		
		ПроверяемыеРеквизиты.Добавить(ФЛК("АдресаПунктовВыгрузки", "АдресаПунктовВыгрузки", "Не заполнен маршрут следования"));
		ПроверяемыеРеквизиты.Добавить(
			ФЛК("АдресаПунктовВыгрузки.Значение", "АдресаПунктовВыгрузкиЗначение", "Не заполнен адрес пункта"));
			
	КонецЕсли;
	
	// Медосмотры - предрейсовый и послерейсовый
	ДополнитьПроверкуМедосмотра(ДанныеДокумента, ПроверяемыеРеквизиты);
	
	// для замены водителя ТО не нужен
	Если ПустаяСтрока(ДанныеДокумента.ПЛПредыдущий) Тогда
		
		ТехосмотрСтрокой = "ТехосмотрСтрокой";
		ПроверяемыеРеквизиты.Добавить(ФЛК("ОтветственныйТехосмотр", ТехосмотрСтрокой, "Не заполнен ответственный за техосмотр"));
		ПроверяемыеРеквизиты.Добавить(
			ФЛК("ОтветственныйТехосмотр.Фамилия", ТехосмотрСтрокой, "Не заполнена фамилия ответственного за техосмотр"));
		ПроверяемыеРеквизиты.Добавить(
			ФЛК("ОтветственныйТехосмотр.Имя", ТехосмотрСтрокой, "Не заполнено имя ответственного за техосмотр"));
		
	КонецЕсли;	
		
КонецПроцедуры

