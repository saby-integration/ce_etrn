
Функция ТекущиеЭтапыДокумента(ОбъектДокумента, ИндексКартинки) Экспорт
	РезультатФункции = ТекущиеЭтапыОбъекта(ОбъектДокумента);
	Если РезультатФункции.Количество() = 0 И ИндексКартинки = 0 Тогда
		ПервыйТитул_ = ESD_ТНОбщегоНазначенияСервер.РезультатФункцииТитулов(ИмяМетаданных(), "ПервыйТитул");
		РезультатФункции.Добавить(ПервыйТитул_);
	КонецЕсли;
	
	Возврат РезультатФункции;
КонецФункции

