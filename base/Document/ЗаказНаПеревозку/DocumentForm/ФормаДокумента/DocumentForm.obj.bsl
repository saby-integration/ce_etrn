		Год(СтрокаПункта.ДатаВремя),
		Месяц(СтрокаПункта.ДатаВремя),
		День(СтрокаПункта.ДатаВремя),
		Час(СтрокаПункта.ДопустимоеВремя),
		Минута(СтрокаПункта.ДопустимоеВремя),
		Секунда(СтрокаПункта.ДопустимоеВремя));
	
