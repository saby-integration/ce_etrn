&НаКлиенте
Процедура ПроверкаГрузовПунктовВыгрузки()
	ЗаполнитьСписокВыбораГрузовАдресов();
	ДоступныеПунктыПогрузки = ЭтаФорма.Элементы.Груз_АдресаПунктовПорядковыйНомерПунктаПогрузки.СписокВыбора.ВыгрузитьЗначения();
	ДоступныеПунктыВыгрузки = ЭтаФорма.Элементы.Груз_АдресаПунктовПорядковыйНомерПунктаВыгрузки.СписокВыбора.ВыгрузитьЗначения();
	
	Для Каждого Груз_Адрес Из Объект.Груз_АдресаПунктов Цикл
		Если ДоступныеПунктыВыгрузки.Найти(Груз_Адрес.Выгрузка_КлючСтроки) = Неопределено Тогда
			Груз_Адрес.Выгрузка_КлючСтроки = 0;
		КонецЕсли;
		
		Если ДоступныеПунктыПогрузки.Найти(Груз_Адрес.Погрузка_КлючСтроки) = Неопределено Тогда
			Груз_Адрес.Погрузка_КлючСтроки = 0;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокВыбораГрузовАдресов()
	ЭтаФорма.Элементы.Груз_АдресаПунктовПорядковыйНомерПунктаВыгрузки.СписокВыбора.Очистить();
	ЭтаФорма.Элементы.Груз_АдресаПунктовПорядковыйНомерПунктаПогрузки.СписокВыбора.Очистить();
	Для Каждого Пункт Из Объект.АдресаПунктовВыгрузки Цикл 
		НомерСтроки = Пункт.НомерСтроки;
		Если Пункт.ЭтоПогрузка Тогда
			ЭтаФорма.Элементы.Груз_АдресаПунктовПорядковыйНомерПунктаПогрузки.СписокВыбора.Добавить(НомерСтроки, НомерСтроки);
		Иначе
			ЭтаФорма.Элементы.Груз_АдресаПунктовПорядковыйНомерПунктаВыгрузки.СписокВыбора.Добавить(НомерСтроки, НомерСтроки);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура АктуализироватьНомераПунктовВГрузах(НомерУдаленнойСтроки)
	Индекс = Объект.Груз_АдресаПунктов.Количество() - 1;
	Пока Индекс >= 0 Цикл
		СтрокаТЧ = Объект.Груз_АдресаПунктов[Индекс];
		
		Если СтрокаТЧ.Погрузка_КлючСтроки = НомерУдаленнойСтроки Тогда	 
			СтрокаТЧ.Погрузка_КлючСтроки = 0;
		КонецЕсли;
		
		Если СтрокаТЧ.Погрузка_КлючСтроки > НомерУдаленнойСтроки Тогда
			СтрокаТЧ.Погрузка_КлючСтроки = СтрокаТЧ.Погрузка_КлючСтроки - 1;
		КонецЕсли;
		
		Если СтрокаТЧ.Выгрузка_КлючСтроки = НомерУдаленнойСтроки Тогда
			СтрокаТЧ.Выгрузка_КлючСтроки = 0;
		КонецЕсли;
		
		Если СтрокаТЧ.Выгрузка_КлючСтроки > НомерУдаленнойСтроки Тогда
			СтрокаТЧ.Выгрузка_КлючСтроки = СтрокаТЧ.Выгрузка_КлючСтроки - 1;
		КонецЕсли;
		
		Если СтрокаТЧ.Погрузка_КлючСтроки = 0 И СтрокаТЧ.Выгрузка_КлючСтроки = 0 Тогда
			Объект.Груз_АдресаПунктов.Удалить(СтрокаТЧ.НомерСтроки - 1);
		КонецЕсли;
		
		Индекс = Индекс - 1;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура АдресаПунктовВыгрузкиПередУдалением(Элемент, Отказ)
	АктуализироватьНомераПунктовВГрузах(Элементы.АдресаПунктовВыгрузки.ТекущиеДанные.НомерСтроки);
КонецПроцедуры

#КонецОбласти // СлужебныеПроцедурыИФункции
