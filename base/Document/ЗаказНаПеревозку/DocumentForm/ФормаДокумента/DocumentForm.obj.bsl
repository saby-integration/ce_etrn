&НаКлиенте
Процедура НастроитьОтображениеДанных()
	ЗаполнитьСписокВыбораГрузовАдресов();
	Грузы_УстановитьОтборПоСвязаннымТаблицам();	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРасчетныеРеквизиты()
	
	МодульТНОбщегоНазначенияСервер       = МодульКода("ESD_ТНОбщегоНазначенияСервер");
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	
	// Активный этап и индикация состояния
	МодульТНОбщегоНазначенияСервер.ОтобразитьНаФормеСбисЭтапИСостояние(ЭтаФорма);
	
	// Документ основание
	Если ЗначениеЗаполнено(Объект.ДокументОснование_Идентификатор) Тогда
		ДокументОснование = МодульТНОбщегоНазначенияСервер.СсылкаНаОбъектОснование(
			Объект.ДокументОснование_ОбъектМетаданных, Объект.ДокументОснование_Идентификатор);
		Элементы.ДекорацияДокументОснование.Заголовок = СокрЛП(ДокументОснование);
	КонецЕсли;
	
	ЭтаФорма.ОтправительСтрокой = МодульТНОбщегоНазначенияКлиентСервер.ПредставлениеЮрЛицаПоРоли(
		Объект.ДанныеЮрЛиц, "Отправитель");
		
	ИмяРолиОформитель = "Оформитель";
	ЭтаФорма.ОформительСтрокой = МодульТНОбщегоНазначенияКлиентСервер.ПредставлениеЮрЛицаПоРоли(
		Объект.ДанныеЮрЛиц, ИмяРолиОформитель);
	СтрокаЮрЛиц = МодульТНОбщегоНазначенияКлиентСервер.ДанныеЮрЛицаПоРоли(Объект.ДанныеЮрЛиц, ИмяРолиОформитель);
	МодульТНОбщегоНазначенияКлиентСервер.ЗаполнитьДополнительныеПоляЮрЛица(
		ЭтаФорма, СтрокаЮрЛиц, "Основание", ИмяРолиОформитель);
		
	ЭтаФорма.ПеревозчикСтрокой = МодульТНОбщегоНазначенияКлиентСервер.ПредставлениеЮрЛицаПоРоли(
		Объект.ДанныеЮрЛиц, "Перевозчик");
	
	ИмяРолиУполномоченноеЛицоПеревозчика = "УполномоченноеЛицоПеревозчика";
	ЭтаФорма.УполномоченноеЛицоПеревозчикаСтрокой = МодульТНОбщегоНазначенияКлиентСервер.ПредставлениеЮрЛицаПоРоли(
		Объект.ДанныеЮрЛиц, ИмяРолиУполномоченноеЛицоПеревозчика);
	СтрокаЮрЛиц = МодульТНОбщегоНазначенияКлиентСервер.ДанныеЮрЛицаПоРоли(
		Объект.ДанныеЮрЛиц, ИмяРолиУполномоченноеЛицоПеревозчика);
	МодульТНОбщегоНазначенияКлиентСервер.ЗаполнитьДополнительныеПоляЮрЛица(
		ЭтаФорма, СтрокаЮрЛиц, "Полномочия,Основание", ИмяРолиУполномоченноеЛицоПеревозчика);
	
	// Телефоны
	РолиЮрЛиц = МодульТНОбщегоНазначенияКлиентСервер.РолиЮрЛиц(
		ЭтаФорма, "Отправитель,Перевозчик,УполномоченноеЛицо,УполномоченноеЛицоПеревозчика");
	ДопПараметры = МодульТНОбщегоНазначенияКлиентСервер.ДопПараметрыОбновленияКИ(РолиЮрЛиц);
	МодульТНОбщегоНазначенияКлиентСервер.ОбновитьОсновнойНомерТелефона(ЭтаФорма, ДопПараметры);
	
	// ТС
	МодульТНОбщегоНазначенияКлиентСервер.ОбновитьТранспортныеСредстваНаФорме(ЭтаФорма);
	
	// Водители
	МодульТНОбщегоНазначенияКлиентСервер.ОбновитьВодителейНаФорме(ЭтаФорма);
	
	СтруктураОтветственного = МодульТНОбщегоНазначенияКлиентСервер.СтруктураОтветственного(
		Объект.ОтветственныеЛица, "Ответственный");
	
	МодульТНОбщегоНазначенияСервер.ОбновитьОтветственногоНаФорме(
		ЭтаФорма, "ОтветственныйЗаПеревозкуСтрокой", СтруктураОтветственного);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьИДоступностьЭлементов()
	Признаки = ПризнакиДокумента();
	// Завершен ДО, блокируем все изменения
	Если Признаки.Этапы.ДОЗавершен Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	Элементы.ГруппаПредставительЗаказчика.Видимость = Объект.ПредставительЗаказчика;
		
	МассивЭлементов = Новый Массив;
	МассивЭлементов.Добавить("ТипДокумента");
	МассивЭлементов.Добавить("ДекорацияЗаполнитьПодачаТС");
	МассивЭлементов.Добавить("ПодачаАдрес");
	МассивЭлементов.Добавить("ДекорацияЗаполнитьКонечнаяТочка");
	МассивЭлементов.Добавить("КонечнаяТочкаАдрес");
	МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ИзменитьСвойствоЭлементовФормы(
		ЭтаФорма, "Доступность", НЕ Элементы.Группа_ДанныеОформителя.ТолькоПросмотр, МассивЭлементов);
		
	// если еще доступно то проверяем на "типдокумента"	
	Элементы.Договор.ТолькоПросмотр = (Объект.ТипДокумента = ЗначениеМетаданных("ESD_ТипДокументаЗнП.Заказ"));
	
	Элементы.ДекорацияЗаполнитьПодачаТС.Видимость      = Не ЗначениеЗаполнено(Объект.ПодачаАдрес);
	Элементы.ДекорацияЗаполнитьКонечнаяТочка.Видимость = Не ЗначениеЗаполнено(Объект.КонечнаяТочкаАдрес);
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьПоЭтапуИУчастнику()
	Признаки = ПризнакиДокумента();
	
	Элементы.ГруппаДокументОснование.Видимость = Признаки.Исходящий;
	Элементы.НастройкаДокументовОснований.Видимость = Ложь;
	Элементы.ГруппаКомандыДокументаОснования.Видимость = Признаки.Этапы.ОформлениеДоступно 
		И Не Этаформа.ТолькоПросмотр;
	Элементы.ДекорацияДокументОснование.Видимость = Признаки.Этапы.ОформлениеДоступно 
		Или ЗначениеЗаполнено(ДокументОснование);
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	Если Элементы.Найти("ФормаСоздать_ТранспортнаяНакладная") <> Неопределено Тогда
		ДоЗавершенПоложительно = МодульТНОбщегоНазначенияКлиентСервер.ИндексКартинки_ДОЗавершенПоложительно();	
		Элементы.ФормаСоздать_ТранспортнаяНакладная.Доступность = (ЭтаФорма.ИндексКартинки = ДоЗавершенПоложительно);	
	КонецЕсли;
	
	ПризнакТолькоПросмотр = Не Признаки.Этапы.ОформлениеДоступно Или ЭтаФорма.ТолькоПросмотр;
	СписокЭлементов = Новый Массив;	
	СписокЭлементов.Добавить("Группа_ДанныеОформителя");
	СписокЭлементов.Добавить("ГруппаОсновноеВерх");
	СписокЭлементов.Добавить("ГруппаЗаказчик");
	СписокЭлементов.Добавить("ГруппаПеревозчик");
	СписокЭлементов.Добавить("Договор");
	СписокЭлементов.Добавить("СтраницаПунктыМаршрута");
	СписокЭлементов.Добавить("СтраницаГруз");
	СписокЭлементов.Добавить("ГруппаПараметрыТС");
	СписокЭлементов.Добавить("ГруппаСпециальныеУсловия");
	СписокЭлементов.Добавить("ГруппаУполномоченныеЛицаЗаказчика");
	МодульТНОбщегоНазначенияКлиентСервер.ИзменитьСвойствоЭлементовФормы(
		ЭтаФорма, "ТолькоПросмотр", ПризнакТолькоПросмотр, СписокЭлементов, Истина);
		
	ПризнакТолькоПросмотр = Не (Признаки.Этапы.ОформлениеДоступно Или Признаки.Этапы.УтверждениеДоступно) 
		Или ЭтаФорма.ТолькоПросмотр;
	СписокЭлементов = Новый Массив;
	СписокЭлементов.Добавить("ГруппаОплата");
	СписокЭлементов.Добавить("ГруппаУполномоченныеЛицаПеревозчика");
	СписокЭлементов.Добавить("СтраницаВодителиИТС");
	МодульТНОбщегоНазначенияКлиентСервер.ИзменитьСвойствоЭлементовФормы(
		ЭтаФорма, "ТолькоПросмотр", ПризнакТолькоПросмотр, СписокЭлементов, Истина);
		
	СписокЭлементов = Новый Массив;
	СписокЭлементов.Добавить("ПрицепыДобавить");
	СписокЭлементов.Добавить("ВодителиДобавить");
	МодульТНОбщегоНазначенияКлиентСервер.ИзменитьСвойствоЭлементовФормы(
		ЭтаФорма, "Доступность", Не ПризнакТолькоПросмотр, СписокЭлементов, Ложь);
КонецПроцедуры

&НаСервере
Функция ПризнакиДокумента()
	
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("Этапы",     Новый Структура);
	РезультатФункции.Вставить("Исходящий", Объект.Направление <> ЗначениеМетаданных("ESD_Направление.Входящий"));
		
	ДОЗавершен = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").ДокументооборотЗавершен(ЭтаФорма.ИндексКартинки);
	
	ОформлениеДоступно = МодульКода("ESD_ТНОбщегоНазначенияСервер").ТипТитулаДоступенУчастнику(
		ЭтаФорма,
		Объект.ТекущиеЭтапы,
		ЗначениеМетаданных("ESD_ТипТитулаЗнП.Оформление"),
		ДОЗавершен);
	РезультатФункции.Этапы.Вставить("ОформлениеДоступно", ОформлениеДоступно);
		
	УтверждениеДоступно = МодульКода("ESD_ТНОбщегоНазначенияСервер").ТипТитулаДоступенУчастнику(
		ЭтаФорма,
	    Объект.ТекущиеЭтапы,
		ЗначениеМетаданных("ESD_ТипТитулаЗнП.Утверждение"),
		ДОЗавершен);
	РезультатФункции.Этапы.Вставить("УтверждениеДоступно", УтверждениеДоступно);
	
	РезультатФункции.Этапы.Вставить("ДОЗавершен", ДОЗавершен);
	
	Если РезультатФункции.Этапы.ОформлениеДоступно Тогда
		ПорядковыйНомер = 1;
	ИначеЕсли РезультатФункции.Этапы.УтверждениеДоступно Тогда
		ПорядковыйНомер = 2;
	ИначеЕсли ДОЗавершен Тогда
		ПорядковыйНомер = 3;
	Иначе
		ПорядковыйНомер = 4;
	КонецЕсли;
	
	РезультатФункции.Этапы.Вставить("Номер", ПорядковыйНомер);
	
	Возврат РезультатФункции;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСписокВыбораСтавокНДС()
	Элементы.СтавкаНДС.СписокВыбора.Очистить();
	
	СтавкиНДС_ = ESD_ТНОбщегоНазначенияКлиентСервер.СтавкиНДС_СписокВыбора();
	Для Каждого СтавкаНДС_ Из СтавкиНДС_ Цикл
		Элементы.СтавкаНДС.СписокВыбора.Добавить(СтавкаНДС_.Представление, СтавкаНДС_.Представление);	
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОбменДаннымиЗнП(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяКоманды = Результат;
	Если ДополнительныеПараметры <> Неопределено И ДополнительныеПараметры.Свойство("ИмяКоманды") Тогда
		ИмяКоманды = ДополнительныеПараметры.ИмяКоманды;
	КонецЕсли;
	
	Если ИмяКоманды = "ВыгрузитьВСбис" Тогда
		ДанныеДляОбработки = Новый Массив;
		ПараметрыВыгрузки = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер").ПараметрыВыгрузки(Объект.Ссылка);
		ДанныеДляОбработки.Добавить(ПараметрыВыгрузки);
	Иначе
		ДанныеДляОбработки = Новый Массив;
		ПараметрыЗагрузки = МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер").ПараметрыЗагрузки(Объект.Ссылка);
		Если ИмяКоманды = "ОбновитьАктивныйЭтап" Тогда
			ПараметрыЗагрузки.ТекущийТитул = АктивныйЭтапСтрокой;
			ПараметрыЗагрузки.ТолькоАктивныйЭтап = Истина;
		КонецЕсли;
		ПараметрыЗагрузки.ИзДокумента = Истина;
		ПараметрыЗагрузки.ИмяМетаданных = ЗаказНаПеревозкуКлиент();
		ДанныеДляОбработки.Добавить(ПараметрыЗагрузки);
	КонецЕсли;
	
	ДополнительныеПараметрыОбмена = Новый Структура;
	ДополнительныеПараметрыОбмена.Вставить("ДвоичныеДанныеОбработки", Неопределено);
	
	МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиент").ВыполнитьКомандуСбис(
		ЭтаФорма,
		ИмяКоманды,
		ДанныеДляОбработки,
		ДополнительныеПараметрыОбмена);
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьНовуюСтрокуКонтактнойИнформации(ИмяТЧ)
	
	Роль = ЗначениеМетаданныхКлиент("ESD_РолиКонтрагентов.ПустаяСсылка");
	
    Отбор = Новый Структура;
	Отбор.Вставить("Роль", Роль);
	
	НайденныеСтроки = Объект.КонтактныеДанные.НайтиСтроки(Отбор);
	Для Каждого Строка Из НайденныеСтроки Цикл 
		Строка.Роль                   = Элементы[ИмяТЧ].ОтборСтрок.Роль;
		Строка.КлючСтроки_ДанныеЮрЛиц = Элементы[ИмяТЧ].ОтборСтрок.КлючСтроки_ДанныеЮрЛиц;
	КонецЦикла;
				
КонецПроцедуры

&НаКлиенте
Функция ЕстьДанныеЮрЛица(Роль)
	
	Отбор = Новый Структура;
	Отбор.Вставить("Роль", ЗначениеМетаданныхКлиент("ESD_РолиКонтрагентов." + Роль));
	
	Возврат Объект.ДанныеЮрЛиц.НайтиСтроки(Отбор).Количество() > 0;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьВидимостьИДоступностьЭлементовНаКлиенте() Экспорт
	
	ОбновитьВидимостьИДоступностьЭлементов();
	
КонецПроцедуры

&НаСервере
Функция ДОЗавершен() Экспорт
	
	МодульТНОбщегоНазначенияКлиентСервер = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер");
	ДОЗавершенОтрицательно = МодульТНОбщегоНазначенияКлиентСервер.ИндексКартинки_ДОЗавершенОтрицательно();
	ДОЗавершенПоложительно = МодульТНОбщегоНазначенияКлиентСервер.ИндексКартинки_ДОЗавершенПоложительно();
	
	Завершен = ИндексКартинки = ДОЗавершенОтрицательно
		Или ИндексКартинки = ДОЗавершенПоложительно;
	
	Возврат Завершен;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СвязанныеСГрузомТаблицы()
	
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("Грузы", Новый Массив);
	
	РезультатФункции.Грузы.Добавить("Груз_АдресаПунктов");
	
	Возврат РезультатФункции;
	
КонецФункции

&НаСервере
Процедура УстановитьОтборУполномоченныхЛиц()
	
	Отбор = Новый Структура;
	Отбор.Вставить("Роль", ЗначениеМетаданных("ESD_РолиКонтрагентов.УполномоченноеЛицо"));
	
	ОтборСтрок = Новый ФиксированнаяСтруктура(Отбор);
	
	Элементы.УполномоченныеЛицаЗаказчика.ОтборСтрок = ОтборСтрок;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОбновленияДанныхТранспортныхСредств(Результат, ДополнительныеПараметры) Экспорт
		
	МодульКодаКлиент("ESD_ТНОбщегоНазначенияКлиентСервер").ОбновитьТранспортныеСредстваНаФорме(ЭтаФорма);
	
