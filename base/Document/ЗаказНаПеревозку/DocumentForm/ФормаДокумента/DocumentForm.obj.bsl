&НаСервере
Процедура ПриЧтенииСозданииПослеЗаписиНаСервере() Экспорт
	ЗаполнитьРасчетныеРеквизиты();
	ЗаполнитьСписокВыбораСтавокНДС();
	
	МодульТНОбщегоНазначенияСервер = МодульКода("ESD_ТНОбщегоНазначенияСервер");
	
	МодульТНОбщегоНазначенияСервер.ОбновитьЛенту(ЭтаФорма, Истина);
	МодульТНОбщегоНазначенияСервер.ОбновитьВнешнийВидЭлементовОшибок(ЭтаФорма);
		
	ОбновитьВидимостьИДоступностьЭлементов();
	ОбновитьВидимостьПоЭтапуИУчастнику();
	УстановитьОтборУполномоченныхЛиц();
	
	МодульТНОбщегоНазначенияСервер.УстановитьОтборТаблицыОтветственных(Элементы.Водители, "Водитель");
	
	МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").НастроитьДополнительныеКонтакты(
		ЭтаФорма, "Отправитель,Перевозчик,УполномоченноеЛицоПеревозчика");
		
	Если ЭтоУниверсальноеРасширение() Тогда
		ЭтаФорма.АвтоЗаголовок = Не МодульТНОбщегоНазначенияСервер.ЭтоCF();
		Если Не ЭтаФорма.АвтоЗаголовок Тогда
			ЭтаФорма.Заголовок = МодульТНОбщегоНазначенияСервер.ПредставлениеДокумента(ЭтаФорма.Объект);
		КонецЕсли;
	КонецЕсли;
	
	ПриЧтенииСозданииПослеЗаписиНаСервереПереопределяемый();
КонецПроцедуры

