		ФЛК("ТранспортныеСредства.ТипВладения", ПрицепыРегистрационныйНомер, "Не заполнен тип владения"));
	ПроверяемыеРеквизиты.Добавить(ФЛК("ТранспортныеСредства.Тип", ПрицепыРегистрационныйНомер, "Не заполнен тип"));
	ПроверяемыеРеквизиты.Добавить(ФЛК("ТранспортныеСредства.Марка", "ПрицепыМарка", "Не заполнена марка"));
	ПроверяемыеРеквизиты.Добавить(
		ФЛК("ТранспортныеСредства.Грузоподъемность", ПрицепыРегистрационныйНомер, "Не заполнена грузоподъемность"));
	ПроверяемыеРеквизиты.Добавить(
		ФЛК("ТранспортныеСредства.Вместимость", ПрицепыРегистрационныйНомер, "Не заполнена вместимость"));
	
	ПолеОтветственныйЗаПеревозкуСтрокой = "ОтветственныйЗаПеревозкуСтрокой";
	
	ПроверяемыеРеквизиты.Добавить(
		ФЛК("ОтветственныеЛица.Фамилия", ПолеОтветственныйЗаПеревозкуСтрокой, "Не заполнена фамилия ответственного"));
	ПроверяемыеРеквизиты.Добавить(
		ФЛК("ОтветственныеЛица.Имя", ПолеОтветственныйЗаПеревозкуСтрокой, "Не заполнено имя ответственного"));
	ПроверяемыеРеквизиты.Добавить(ФЛК("ОтветственныеЛица.ИНН", "", ""));
	ПроверяемыеРеквизиты.Добавить(ФЛК("ОтветственныеЛица.Серия", "", ""));
	ПроверяемыеРеквизиты.Добавить(ФЛК("ОтветственныеЛица.Номер", "", ""));
	ПроверяемыеРеквизиты.Добавить(ФЛК("ОтветственныеЛица.ДатаВыдачи", "", ""));
	ПроверяемыеРеквизиты.Добавить(
		ФЛК("ОтветственныеЛица.Телефоны", ПолеОтветственныйЗаПеревозкуСтрокой, "Не заполнен телефон ответственного"));
		
	ФЛК = ФЛК("ДанныеЮрЛиц.Полномочия",
		"УполномоченноеЛицоПеревозчика_Полномочия",
		"Не заполнены полномочия уполномоченного лица перевозчика");
	ПроверяемыеРеквизиты.Добавить(ФЛК);
	ФЛК = ФЛК("ДанныеЮрЛиц.Основание",
		"УполномоченноеЛицоПеревозчика_Основание",
		"Не заполнено основание уполномоченного лица перевозчика");
	ПроверяемыеРеквизиты.Добавить(ФЛК);
	ПроверяемыеРеквизиты.Добавить(ФЛК("ДанныеЮрЛиц.Адрес", "", "Не заполнен адрес юр. лица"));
	
	ПроверяемыеРеквизиты.Добавить(ФЛК("СпецРазрешения.Вид", "СпецРазрешенияВид", "Не заполнен вид в списке спец разрешений"));
	ПроверяемыеРеквизиты.Добавить(ФЛК("СпецРазрешения.Дата", "СпецРазрешенияДата", "Не заполнена дата в списке спец разрешений"));
	ПроверяемыеРеквизиты.Добавить(ФЛК("СпецРазрешения.Номер", "СпецРазрешенияНомер", "Не заполнен номер в списке спец разрешений"));
	ПроверяемыеРеквизиты.Добавить(ФЛК("СпецРазрешения.Срок", "СпецРазрешенияСрок", "Не заполнен срок в списке спец разрешений"));
	ФЛК = ФЛК("СпецРазрешения.НаименованиеОрганаВласти",
		"СпецРазрешенияНаименованиеОрганаВласти",
		"Не заполнено наименование органа власти в списке спец разрешений");
	ПроверяемыеРеквизиты.Добавить(ФЛК);
	ПроверяемыеРеквизиты.Добавить(
		ФЛК("СпецРазрешения.ИД", "СпецРазрешенияИД", "Не заполнен идентификатор в списке спец разрешений"));
	
	ПроверяемыеРеквизиты.Добавить(ФЛК("ДанныеЮрЛиц.ИНН",     "", "Не заполнен ИНН юр. лица"));
	ПроверяемыеРеквизиты.Добавить(ФЛК("ДанныеЮрЛиц.Имя",     "", "Не заполнено Имя юр. лица"));
	ПроверяемыеРеквизиты.Добавить(ФЛК("ДанныеЮрЛиц.Фамилия", "", "Не заполнена Фамилия юр. лица"));
	
КонецПроцедуры

Процедура ДопПроверкиФЛКОформление(ДанныеДокумента, ПараметрыВыгрузки, Ошибки)
	
	МодульТНОбщегоНазначенияСервер = МодульКода("ESD_ТНОбщегоНазначенияСервер");
	
	ИмяТелефон = "Телефон";
	
	СтруктураОшибки = ФЛК("Отправитель_Телефон", "Отправитель_Телефон", "Не заполнен Телефон заказчика");
	МодульТНОбщегоНазначенияСервер.ПроверитьКонтактныеДанные(
		ДанныеДокумента, "Отправитель", ИмяТелефон, Ошибки, СтруктураОшибки);
	
	СтруктураОшибки = ФЛК("Перевозчик_Телефон", "Перевозчик_Телефон", "Не заполнен Телефон перевозчика");
	МодульТНОбщегоНазначенияСервер.ПроверитьКонтактныеДанные(
		ДанныеДокумента, "Перевозчик", ИмяТелефон, Ошибки, СтруктураОшибки);
		
	МодульТНОбщегоНазначенияСервер.ПроверитьЗаполнениеСторонДокументовЭПД(ДанныеДокумента, Ошибки);
	
КонецПроцедуры

Процедура ДопПроверкиФЛКУтверждение(ДанныеДокумента, ПараметрыВыгрузки, Ошибки)
	
	МодульТНОбщегоНазначенияСервер = МодульКода("ESD_ТНОбщегоНазначенияСервер");
	
	СоответствиеОшибок = Новый Соответствие;
	СоответствиеОшибок.Вставить(
		"ТранспортноеСредствоДокумент",
		ФЛК("ТранспортноеСредствоДокумент", "ТранспортноеСредствоСтрокой", "Не заполнен документ владения у транспортного средства"));
	СоответствиеОшибок.Вставить(
		"Прицепы.ПрицепДокумент",
		ФЛК("Прицепы.ПрицепДокумент", "ПрицепыРегистрационныйНомер", "Не заполнен документ владения в списке прицепов"));
	МодульТНОбщегоНазначенияСервер.ПроверитьЗаполнениеТипаВладения(ДанныеДокумента, Ошибки, СоответствиеОшибок);
	
	ОтборЮрЛица = Новый Структура("Роль", ЗначениеМетаданных("ESD_РолиКонтрагентов.УполномоченноеЛицоПеревозчика"));
	НайденныеСтроки = МодульКода("ESD_ТНОбщегоНазначенияКлиентСервер").НайтиСтрокиУниверсально(
		ДанныеДокумента.ДанныеЮрЛиц, ОтборЮрЛица);
	Если НайденныеСтроки.Количество() > 0 Тогда
		СтруктураОшибки = ФЛК(
			"УполномоченноеЛицоПеревозчика_Телефон",
			"УполномоченноеЛицоПеревозчика_Телефон",
			"Не заполнен Телефон уполномоченного лица перевозчика");
		МодульТНОбщегоНазначенияСервер.ПроверитьКонтактныеДанные(
			ДанныеДокумента, "УполномоченноеЛицоПеревозчика", "Телефон", Ошибки, СтруктураОшибки);
	КонецЕсли;
	
	МодульТНОбщегоНазначенияСервер.ПроверитьЗаполнениеСторонДокументовЭПД(ДанныеДокумента, Ошибки);
	
КонецПроцедуры

Функция ПроверятьРеквизитОтветственного(СтрокаТЧ, ИмяРеквизита)
	
	Возврат СтрокаТЧ.Роль = ЗначениеМетаданных("ESD_РолиОтветственных.Ответственный")
		И (ИмяРеквизита = "Фамилия" Или ИмяРеквизита = "Имя" Или ИмяРеквизита = "Телефоны");
	
КонецФункции

// Возвращает признак необходимости проверки реквизитов спец разрешений
//
// Параметры:
//  СтрокаТЧ - СтрокаТаблицыЗначений - строка таблицы, в которой проверяются реквизиты
//  ИмяРеквизита - Строка - имя текущего проверяемого реквизита
//
// Возвращаемое значение:
//   Булево - Истина, если реквизит необходимо проверять
//
Функция ПроверятьРеквизитыСпецРазрешения(СтрокаТЧ, ИмяРеквизита)
		
	Если ИмяРеквизита = "ИД" Тогда
		
		Возврат
			Не ЗначениеЗаполнено(СтрокаТЧ.Номер) 
			Или Не ЗначениеЗаполнено(СтрокаТЧ.Дата)
			Или Не ЗначениеЗаполнено(СтрокаТЧ.Срок)
			Или Не ЗначениеЗаполнено(СтрокаТЧ.Вид)
			Или Не ЗначениеЗаполнено(СтрокаТЧ.НаименованиеОрганаВласти);
			
	Иначе
		Возврат Не ЗначениеЗаполнено(СтрокаТЧ.ИД);
	КонецЕсли;	
		
КонецФункции

Функция РеквизитВодителя(ИмяРеквизита)
	
	ВодителиВУ = "ВодителиВУ";
	
	Если ИмяРеквизита = "Фамилия" Тогда
		РезультатФункции = ФЛК("Фамилия", "ВодителиФИО", "Не заполнена фамилия водителя");
	ИначеЕсли ИмяРеквизита = "Имя" Тогда
		РезультатФункции = ФЛК("Имя", "ВодителиФИО", "Не заполнена имя водителя");
	ИначеЕсли ИмяРеквизита = "ИНН" Тогда
		РезультатФункции = ФЛК("ИНН", "ВодителиИНН", "Не заполнена ИНН водителя");
	ИначеЕсли ИмяРеквизита = "Серия" Тогда
		РезультатФункции = ФЛК("Серия", ВодителиВУ, "Не заполнена серия водительского удостоверения");
	ИначеЕсли ИмяРеквизита = "Номер" Тогда
		РезультатФункции = ФЛК("Номер", ВодителиВУ, "Не заполнен номер водительского удостоверения");
	ИначеЕсли ИмяРеквизита = "ДатаВыдачи" Тогда
		РезультатФункции = ФЛК("ДатаВыдачи", ВодителиВУ, "Не заполнена дата выдачи водительского удостоверения");
	ИначеЕсли ИмяРеквизита = "Телефоны" Тогда
		РезультатФункции = ФЛК("Телефоны", ВодителиВУ, "Не заполнен телефон водителя");
	Иначе
		РезультатФункции = Неопределено;
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция РеквизитУполномоченногоЛицаЗаказчика(СтрокаТЧ, Реквизит, ДанныеДокумента)
	
	ЭтоРеквизитЮрЛица = Реквизит.РеквизитОбъекта = "Адрес" Или Реквизит.РеквизитОбъекта = "Имя"
		Или Реквизит.РеквизитОбъекта = "Фамилия" Или Реквизит.РеквизитОбъекта = "ИНН";
	
	Если Реквизит.РеквизитОбъекта = "Полномочия" Тогда
		РезультатФункции = ФЛК(
			"Полномочия", "УполномоченныеЛицаЗаказчикаПолномочия", "Не заполнены полномочия уполномоченного лица заказчика");
	ИначеЕсли Реквизит.РеквизитОбъекта = "Основание" Тогда
		РезультатФункции = ФЛК(
			"Основание", "УполномоченныеЛицаЗаказчикаОснование", "Не заполнено основание уполномоченного лица заказчика");
	ИначеЕсли ЭтоРеквизитЮрЛица Тогда
		РезультатФункции = ФЛК(
			Реквизит.РеквизитОбъекта,
			"УполномоченныеЛицаЗаказчикаНаименованиеОрганизации",
			"Не заполнен " + Реквизит.РеквизитОбъекта + " уполномоченного лица заказчика");
		МодульКода("ESD_ТНОбщегоНазначенияСервер").ИсправитьТекстОшибкиФЛК(РезультатФункции);
	Иначе
		РезультатФункции = Неопределено;
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция НовыйРеквизитЮрЛица(СтрокаТЧ, Реквизит, ДанныеДокумента)
	
	ЭтоНеРеквизитЮрЛица = Реквизит.РеквизитОбъекта <> "Адрес" И Реквизит.РеквизитОбъекта <> "Имя"
		И Реквизит.РеквизитОбъекта <> "Фамилия" И Реквизит.РеквизитОбъекта <> "ИНН"
		И Реквизит.РеквизитОбъекта <> "Телефон";
	
	Если ЭтоНеРеквизитЮрЛица Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЭтоОформление = ДанныеДокумента.ТипТитула = ЗначениеМетаданных("ESD_ТипТитулаЗнП.Оформление");
	
	Если СтрокаТЧ.Роль = ЗначениеМетаданных("ESD_РолиКонтрагентов.Отправитель") И ЭтоОформление Тогда
		ЭлементФормы = "ОтправительСтрокой";
		РольСтрокой  = "заказчика";
	ИначеЕсли СтрокаТЧ.Роль = ЗначениеМетаданных("ESD_РолиКонтрагентов.Перевозчик") И ЭтоОформление Тогда
		ЭлементФормы = "ПеревозчикСтрокой";
		РольСтрокой  = "перевозчика";
	ИначеЕсли СтрокаТЧ.Роль = ЗначениеМетаданных("ESD_РолиКонтрагентов.УполномоченноеЛицоПеревозчика")
		И ДанныеДокумента.ТипТитула = ЗначениеМетаданных("ESD_ТипТитулаЗнП.Утверждение") Тогда
		ЭлементФормы = "УполномоченноеЛицоПеревозчикаСтрокой";
		РольСтрокой  = "уполномоченного лица перевозчика";
	ИначеЕсли СтрокаТЧ.Роль = ЗначениеМетаданных("ESD_РолиКонтрагентов.Оформитель") И ЭтоОформление Тогда
		ЭлементФормы = "ОформительСтрокой";
		РольСтрокой  = "организации";
	ИначеЕсли СтрокаТЧ.Роль = ЗначениеМетаданных("ESD_РолиКонтрагентов.Заказчик") И ЭтоОформление Тогда
		ЭлементФормы = "ГрузыЗаказчикСтрока";
		РольСтрокой  = "заказчика";
	Иначе
		ЭлементФормы = Реквизит.ЭлементФормы;
		РольСтрокой  = "юр. лица";
	КонецЕсли;
	
	ФЛК = ФЛК(Реквизит.РеквизитОбъекта, ЭлементФормы, "Не заполнен " + Реквизит.РеквизитОбъекта + " " + РольСтрокой);
	МодульКода("ESD_ТНОбщегоНазначенияСервер").ИсправитьТекстОшибкиФЛК(ФЛК);
	
	Возврат ФЛК;
	
КонецФункции

Функция ПроверятьДанныеЮрЛица(СтрокаТЧ, ИмяТЧ, Реквизит, ДанныеДокумента)
	
	РольУполномоченноеЛицоПеревозчика = ЗначениеМетаданных("ESD_РолиКонтрагентов.УполномоченноеЛицоПеревозчика");
	
	Если ДанныеДокумента.ТипТитула = ЗначениеМетаданных("ESD_ТипТитулаЗнП.Оформление") Тогда
		ПроверятьРоль = СтрокаТЧ.Роль <> РольУполномоченноеЛицоПеревозчика;
	Иначе
		ПроверятьРоль = СтрокаТЧ.Роль = РольУполномоченноеЛицоПеревозчика;
	КонецЕсли;
	
	ПроверятьРеквизиты = Истина;
	
	Если Реквизит.РеквизитОбъекта = "Адрес" Тогда
		ПроверятьРеквизиты = ЗначениеЗаполнено(Реквизит.ЭлементФормы);
	КонецЕсли;
	
	Если Реквизит.РеквизитОбъекта = "Имя" Или Реквизит.РеквизитОбъекта = "Фамилия" Тогда
		ПроверятьРеквизиты = ПроверятьДанныеИП(СтрокаТЧ, Реквизит);
	КонецЕсли;
	
	Если Реквизит.РеквизитОбъекта = "Полномочия" Или Реквизит.РеквизитОбъекта = "Основание" Тогда
		ПроверятьРеквизиты = СтрокаТЧ.Роль = РольУполномоченноеЛицоПеревозчика
			Или СтрокаТЧ.Роль = ЗначениеМетаданных("ESD_РолиКонтрагентов.УполномоченноеЛицо");
	КонецЕсли;
		
	Если Реквизит.РеквизитОбъекта = "Телефон" Тогда
		ПроверятьРеквизиты = СтрокаТЧ.Роль = ЗначениеМетаданных("ESD_РолиКонтрагентов.УполномоченноеЛицо");
	КонецЕсли;
	
	Возврат ПроверятьРоль И ПроверятьРеквизиты;
	
КонецФункции

Функция ПроверятьДанныеИП(СтрокаТЧ, Реквизит)
	
	ПроверятьИмяФамилию = СтрокаТЧ.ЮрФизЛицо = ЗначениеМетаданных("ESD_ЮрФизЛицо.ИндивидуальныйПредприниматель")
		И (Реквизит.РеквизитОбъекта = "Имя" Или Реквизит.РеквизитОбъекта = "Фамилия");
		
	Возврат ПроверятьИмяФамилию;
		
КонецФункции

Функция ПроверятьДанныеАдресовПунктовВыгрузки(СтрокаТЧ, ИмяТЧ, Реквизит, ДанныеДокумента)
	
	Если Реквизит.РеквизитОбъекта = "ОрганизацияСтрока" Тогда
		РезультатФункции = СтрокаТЧ.ЭтоПогрузка;
	ИначеЕсли Реквизит.РеквизитОбъекта = "Адрес" Тогда
		РезультатФункции = Ложь;
	Иначе
		РезультатФункции = Реквизит.РеквизитОбъекта <> "Полномочия" И Реквизит.РеквизитОбъекта <> "Основание";
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ПроверятьРеквизитыГруза(СтрокаТЧ, Реквизит)
	
	Если Реквизит.РеквизитОбъекта = "Полномочия" Или Реквизит.РеквизитОбъекта = "Основание" Тогда
		РезультатФункции = Ложь;
	ИначеЕсли Реквизит.РеквизитОбъекта = "Имя" Или Реквизит.РеквизитОбъекта = "Фамилия" Тогда
		РезультатФункции = ПроверятьДанныеИП(СтрокаТЧ, Реквизит);
	Иначе
		РеквизитыОпасногоГруза = Новый Соответствие;
		РеквизитыОпасногоГруза.Вставить("ОпасныйГрузНаименование",        Истина);
		РеквизитыОпасногоГруза.Вставить("НомерООН",                       Истина);
		РеквизитыОпасногоГруза.Вставить("Класс",                          Истина);
		РеквизитыОпасногоГруза.Вставить("КлассификационныйКод",           Истина);
		РеквизитыОпасногоГруза.Вставить("ГруппаУпаковкиЗначение",         Истина);
		РеквизитыОпасногоГруза.Вставить("ЗнакОпасности",                  Истина);
		РеквизитыОпасногоГруза.Вставить("ОграничениеПроездаЧерезТуннели", Истина);
		
		РезультатФункции = РеквизитыОпасногоГруза[Реквизит.РеквизитОбъекта] = Неопределено Или ЗначениеЗаполнено(СтрокаТЧ.ОпасныйГруз);
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ПроверятьДанныеУполномоченногоЛицаЗаказчика(СтрокаТЧ, Реквизит, ДанныеДокумента)
	
	РезультатФункции = МодульКода("ESD_ТНОбщегоНазначенияСервер").РезультатФункцииТитулов(
		ЗаказНаПеревозку(), "ЭтоПервыйТитул", ДанныеДокумента.ТипТитула);
	
	Если Реквизит.РеквизитОбъекта = "Имя" Или Реквизит.РеквизитОбъекта = "Фамилия" Тогда
		РезультатФункции = РезультатФункции И ПроверятьДанныеИП(СтрокаТЧ, Реквизит);
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

