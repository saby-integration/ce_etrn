Функция ПользовательскиеТипыДляЗаполненияНаОсновании()
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	РезультатФункции = ХранилищеОбщихНастроек.Загрузить("Saby", "ТипыДляЗаполненияНаОснованииДокументаЗнП");
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ТипыПоУмолчаниюДляЗаполненияНаОсновании()
	
	МодульТНОбщегоНазначенияСервер = МодульКода("ESD_ТНОбщегоНазначенияСервер");
	
	ДокументыОснования = Новый Массив;
	
	ДоступнаяКонфигурация = МодульТНОбщегоНазначенияСервер.ЭтоДоступнаяКонфигурация();			
	НашаКонфигурация       = ДоступнаяКонфигурация.Имя;
	
	Если Не ДоступнаяКонфигурация.Поддержана Или НашаКонфигурация = "УАТ" Тогда
		Возврат ДокументыОснования;
	КонецЕсли;
		
	ДокументыОснования.Добавить("Документы.РеализацияТоваровУслуг");
	Если НашаКонфигурация = "УТ10" Или НашаКонфигурация = "УПП" Тогда
		ДокументыОснования = МодульТНОбщегоНазначенияСервер.ДоступныеТипыМетаданных(ДокументыОснования);
		Возврат ДокументыОснования.Типы();
	КонецЕсли;
	
	ДокументыОснования.Добавить("Документы.ВозвратТоваровПоставщику");
	ДокументыОснования.Добавить("Документы.КорректировкаРеализации");
	ДокументыОснования.Добавить("Документы.ПеремещениеТоваров");
	
	Если НашаКонфигурация <> "Бух3" Тогда
		
		ДокументыОснования.Добавить("Документы.ТранспортнаяНакладная");
		ДокументыОснования.Добавить("Документы.ОтгрузкаТоваровСХранения");
		ДокументыОснования.Добавить("Документы.ПередачаТоваровХранителю");
		
	КонецЕсли;	
	
	Если НашаКонфигурация = "ERP" Тогда
		
		ДокументыОснования.Добавить("Документы.ВозвратСырьяДавальцу");
		ДокументыОснования.Добавить("Документы.ПередачаДавальцу");
		ДокументыОснования.Добавить("Документы.ПередачаСырьяПереработчику");
		
	КонецЕсли;
			
	Если НашаКонфигурация = "КА" Тогда
		ДокументыОснования.Добавить("Документы.ПередачаСырьяПереработчику");
	КонецЕсли;
	
	ДокументыОснования = МодульТНОбщегоНазначенияСервер.ДоступныеТипыМетаданных(ДокументыОснования);
	
	Возврат ДокументыОснования.Типы();
	
КонецФункции

