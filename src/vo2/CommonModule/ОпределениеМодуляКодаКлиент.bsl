
&НаКлиенте
Функция МодульКодаКлиент(ИмяМодуля)
	
	ИмяМодуляСтрокой = СтрЗаменить(ИмяМодуля, "Saby", "ESD");
	
	// типовой модуль
	Если ИмяМодуляСтрокой = "ФайловаяСистемаКлиент" 
		Или ИмяМодуляСтрокой = "УправлениеКонтактнойИнформациейКлиент" Тогда
		
		Возврат Вычислить(ИмяМодуляСтрокой);
		
	Иначе
		Возврат ЭтаФорма;
	КонецЕсли;
	
КонецФункции

